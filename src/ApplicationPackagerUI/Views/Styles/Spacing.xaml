<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- The spacing scale of the V1 workspace (overhaul V1, Q-126): 4, 8, 12, 16 and 24 device-independent units, every value a
         multiple of 4 (R-05, R-06). Space is the gap as a number, Inset is the same value as a margin or padding on all four sides.
         A page that adopts the scale reads these keys; a test pins the values. -->
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <Thickness x:Key="Inset4">4</Thickness>
    <Thickness x:Key="Inset8">8</Thickness>
    <Thickness x:Key="Inset12">12</Thickness>
    <Thickness x:Key="Inset16">16</Thickness>
    <Thickness x:Key="Inset24">24</Thickness>
</ResourceDictionary>
