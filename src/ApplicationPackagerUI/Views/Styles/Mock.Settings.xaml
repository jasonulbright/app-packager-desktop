<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock">

    <!-- The controls of the Settings screens of the approved mock that the shared dictionary does not draw: the settings tree, the drop-down
         list with its dashed disabled state, its editable form and its cell size, the secret and number boxes of the other sections, the
         check box whose text wraps, the bold link of a notice and the scroll bars that show only while the pointer or the keyboard is on them. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- A scroll bar of the mock takes no room: it lies over the right edge of the content and shows while the area is in use. -->
    <Style x:Key="Mk.Settings.OverlayScroll" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Style="{StaticResource Mk.ScrollBar}" Opacity="0"
                                   Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Style="{StaticResource Mk.ScrollBar}"
                                   Orientation="Horizontal" Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The select element: the list of Mock.xaml with the dashed disabled state and with a text box for a list that also takes typed text.
         The Padding is the place of the text in the closed box. -->
    <Style x:Key="Mk.Settings.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource Mk.ComboBox}">
        <Setter Property="Padding" Value="15,0,24,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton x:Name="Toggle" Focusable="False" IsTabStop="False" ClickMode="Press" AutomationProperties.Name="Open the list"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False" />
                        <Rectangle x:Name="Dashes" Stroke="{DynamicResource MkEdgeBrush}" StrokeThickness="1" StrokeDashArray="4 2" RadiusX="5" RadiusY="5"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                        <ContentPresenter x:Name="Shown" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"><ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources></ContentPresenter>
                        <TextBox x:Name="PART_EditableTextBox" Margin="12,1,22,1" VerticalAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed"
                                 IsReadOnly="{TemplateBinding IsReadOnly}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
                                    <Setter Property="CaretBrush" Value="{DynamicResource MkTextBrush}" />
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Path x:Name="Arrow" Data="M 0,0 L 3.75,4 L 7.5,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,5,0" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource MkSurfaceBrush}" BorderBrush="{DynamicResource MkEdgeBrush}" BorderThickness="1" CornerRadius="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Shown" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkSubBrush}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Dashes" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource MkMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- td select { min-height:27px; padding:3px 6px; font-size:13px } -->
    <Style x:Key="Mk.Settings.CellComboBox" TargetType="ComboBox" BasedOn="{StaticResource Mk.Settings.ComboBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="Height" Value="27" />
        <Setter Property="Padding" Value="11,0,22,0" />
    </Style>

    <!-- A text cell of the application grid has the size of a cell list. -->
    <Style x:Key="Mk.Settings.CellTextBox" TargetType="TextBox" BasedOn="{StaticResource Mk.TextBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="Height" Value="27" />
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <!-- .fieldinput on the controls of WPF-UI: the same box, with their placeholder text. -->
    <Style x:Key="Mk.Settings.UiTextBox" TargetType="ui:TextBox" BasedOn="{StaticResource Mk.TextBox}">
        <Setter Property="mk:Mk.Placeholder" Value="{Binding PlaceholderText, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Padding" Value="10,0,10,0" />
    </Style>

    <!-- The same box for a secret; the button at the right shows or hides the typed characters. -->
    <Style x:Key="Mk.Settings.UiPasswordBox" TargetType="ui:PasswordBox" BasedOn="{StaticResource Mk.TextBox}">
        <Setter Property="mk:Mk.Placeholder" Value="{Binding PlaceholderText, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:PasswordBox">
                    <Grid>
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" />
                        <DockPanel>
                            <Button x:Name="Reveal" DockPanel.Dock="Right" Margin="0,0,3,0" Width="28" Height="26" Focusable="False" IsTabStop="False"
                                    Command="{Binding TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="reveal"
                                    AutomationProperties.Name="Show or hide the typed characters" ToolTip="Show or hide the typed characters.">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <ui:SymbolIcon Symbol="Eye24" FontSize="14" Foreground="{DynamicResource MkMutedBrush}" />
                            </Button>
                            <Grid Margin="10,0,4,0">
                                <TextBlock x:Name="Hint" Margin="1,-1,1,0" VerticalAlignment="Center" Foreground="{DynamicResource MkMutedBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                           Text="{Binding PlaceholderText, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="-1,-1,-1,0" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                            <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The number box: the same box with its two step buttons at the right. -->
    <Style x:Key="Mk.Settings.NumberBox" TargetType="ui:NumberBox" BasedOn="{StaticResource Mk.TextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:NumberBox">
                    <Grid>
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,3,0">
                                <RepeatButton Width="24" Height="26" Focusable="False" IsTabStop="False" AutomationProperties.Name="Decrease"
                                              Command="{Binding TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="decrement">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent">
                                                <ui:SymbolIcon Symbol="Subtract24" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MkTextBrush}" />
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                                <RepeatButton Width="24" Height="26" Focusable="False" IsTabStop="False" AutomationProperties.Name="Increase"
                                              Command="{Binding TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}" CommandParameter="increment">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MkTextBrush}" />
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </StackPanel>
                            <Grid Margin="10,0,4,0">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="-1,-1,-1,0" VerticalAlignment="Center" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                            <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .tickrow: the check box of Mock.xaml with a text that wraps in a narrow column. -->
    <Style x:Key="Mk.Settings.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource Mk.CheckBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box" Background="{DynamicResource MkSurfaceBrush}" BorderBrush="{DynamicResource MkEdgeBrush}" BorderThickness="1" CornerRadius="3" />
                            <Path x:Name="Tick" Data="M 4.2,8 L 6.8,10.6 L 11.8,5.6" Stroke="{DynamicResource MkOnBrush}" StrokeThickness="2" Visibility="Collapsed" />
                            <Rectangle x:Name="Dash" Width="8" Height="2" Fill="{DynamicResource MkOnBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="Body" Grid.Column="1" Margin="8,-1,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources></ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource MkAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource MkAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A bold word of a notice that opens a page. -->
    <Style x:Key="Mk.Settings.TextLink" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mk.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Words" Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Words" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .treebtn { min-height:29px; padding:3px 10px } .treebtn.sub { padding-left:25px } .treegroup { margin:10px 7px 3px; 12px, 650 }.
         An item with items of its own is a group: its name is a caption and its items are always listed below it. -->
    <Style x:Key="Mk.Settings.TreeNode" TargetType="TreeViewItem">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
        <Setter Property="Padding" Value="11,0,0,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid x:Name="Row" Height="29" Background="Transparent">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" />
                        <Rectangle x:Name="Bar" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="1,0,0,0" VerticalAlignment="Center"
                                   Fill="{DynamicResource MkAccentBrush}" Visibility="Collapsed" />
                        <ContentPresenter x:Name="PART_Header" ContentSource="Header" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources></ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- A border draws no fill under its edge, so the edge takes the color of the fill. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkSubBrush}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MkSubBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkTintBrush}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MkTintBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Mk.Settings.TreeSubNode" TargetType="TreeViewItem" BasedOn="{StaticResource Mk.Settings.TreeNode}">
        <Setter Property="Padding" Value="26,0,0,0" />
    </Style>
    <Style x:Key="Mk.Settings.TreeGroup" TargetType="TreeViewItem">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Mk.Settings.TreeSubNode}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <!-- The edge shows the keyboard focus; it takes 1 px of the padding, so the name stays in place. -->
                        <Border x:Name="Face" Height="29" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="6,9,6,2">
                            <TextBlock x:Name="PART_Header" Text="{TemplateBinding Header}" VerticalAlignment="Center" Margin="0,-1,0,0"
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MkMutedBrush}" />
                        </Border>
                        <ItemsPresenter />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The .tree: 10 px above and below and 7 px at the sides of the items, inside the panel. -->
    <Style x:Key="Mk.Settings.Tree" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <ScrollViewer Style="{StaticResource Mk.Settings.OverlayScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter Margin="7,10" />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
