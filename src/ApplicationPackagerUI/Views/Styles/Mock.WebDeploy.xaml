<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock">

    <!-- The mock styles that Add from web and the Deployment Helper share, on top of Mock.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource Mk.ScrollBar}" />
    <Style TargetType="TextBox" BasedOn="{StaticResource Mk.TextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource Mk.ComboBox}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource Mk.CheckBox}" />
    <Style TargetType="RadioButton" BasedOn="{StaticResource Mk.Radio}" />

    <!-- A box of several lines: the text starts at the top. -->
    <Style x:Key="WD.TextArea" TargetType="TextBox" BasedOn="{StaticResource Mk.TextBox}">
        <Setter Property="Padding" Value="10,7,4,6" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The button that is the default one of its window is the primary one. -->
    <Style x:Key="WD.DefaultButton" TargetType="Button" BasedOn="{StaticResource Mk.Button}">
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource MkAccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MkOnBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A button of a row of actions that wraps. -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Mk.Button}">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- A button that opens the plan of a destructive change: red text and edge, so it never looks like an approval. -->
    <Style x:Key="ToolButton.Danger" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Foreground" Value="{DynamicResource MkBadBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MkBadBrush}" />
    </Style>
    <Style x:Key="ToolButton.Primary" TargetType="Button" BasedOn="{StaticResource Mk.Button.Primary}">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Text roles of the two pages. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Mk.FieldName}">
        <Setter Property="Height" Value="19" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Mk.H3}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Mk.Help}" />
    <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Mk.Help}">
        <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
    </Style>
    <!-- A note that takes no room while it says nothing. -->
    <Style x:Key="QuietNote" TargetType="TextBlock" BasedOn="{StaticResource Mk.Help}">
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A string Content renders as one non-wrapping line, which a narrow window clips. -->
    <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource Mk.CheckBox}">
        <Setter Property="Margin" Value="0,0,16,8" />
        <Setter Property="MinHeight" Value="29" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="460" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Mk.Panel}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- table.compact td { height:31px } : each row draws the line above it, so the last row of a grid has no line under it, as in the mock.
         The line above the first row lies under the header, which has its own. -->
    <Style x:Key="WD.GridRow" TargetType="DataGridRow" BasedOn="{StaticResource Mk.GridRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid>
                        <Border x:Name="DGR_Border" Margin="0,-1,0,0" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource MkLineBrush}"
                                BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="True" />
                                <DataGridDetailsPresenter Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}" SelectiveScrollingGrid.SelectiveScrollingOrientation="Both" />
                            </SelectiveScrollingGrid>
                        </Border>
                        <Rectangle x:Name="ActiveRectangle" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource MkAccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource MkSubBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource MkTintBrush}" />
                            <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The border of the cell template is 1 unit, so the padding of 11 puts the text 12 from the left edge of the column. -->
    <Style x:Key="WD.GridCell" TargetType="DataGridCell" BasedOn="{StaticResource Mk.GridCell}">
        <Setter Property="Padding" Value="11,0,4,0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{StaticResource Mk.CellText}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!-- The flat tabs of the mock: .tabs { gap:4px; border-bottom:1px } .tab { min-height:35px; padding:5px 12px }. -->
    <Style x:Key="WD.TabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MkLineBrush}" SnapsToDevicePixels="True">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="Transparent" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WD.TabItem" TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mk.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Face" Height="35" Margin="0,0,3.9,0" Padding="13,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            CornerRadius="4,4,0,0" TextElement.FontFamily="Segoe UI" TextElement.FontSize="14">
                        <ContentPresenter x:Name="Head" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkSubBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkTintBrush}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                            <Setter TargetName="Face" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The object type list is a second row of tabs. -->
    <Style x:Key="WD.ObjectTab" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mk.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Face" Height="35" Margin="0,0,3.9,0" Padding="13,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            CornerRadius="4,4,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"><ContentPresenter.Resources><Style TargetType="TextBlock" /></ContentPresenter.Resources></ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkSubBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkTintBrush}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                            <Setter TargetName="Face" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WD.ObjectTabs" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource WD.ObjectTab}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MkLineBrush}" SnapsToDevicePixels="True">
                        <ItemsPresenter Margin="0,0,-3.9,0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A date box that looks like a text field of the mock. The calendar opens with Alt+Down, a double click or the menu of the box. -->
    <Style x:Key="WD.DatePickerText" TargetType="DatePickerTextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource MkTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ContextMenu" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="-1,-1,-1,0" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WD.DatePicker" TargetType="DatePicker">
        <Setter Property="helpers:DateBoxCalendar.OnDemand" Value="True" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="Face" Background="{DynamicResource MkSurfaceBrush}" BorderBrush="{DynamicResource MkEdgeBrush}" BorderThickness="1" CornerRadius="5" />
                        <DatePickerTextBox x:Name="PART_TextBox" Margin="10,2,6,0" VerticalAlignment="Center" Style="{StaticResource WD.DatePickerText}" />
                        <Button x:Name="PART_Button" Visibility="Collapsed" Focusable="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}" StaysOpen="False" AllowsTransparency="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                            <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The save button of the last step of Add from web: the primary button with the arrow of its menu. -->
    <Style x:Key="WD.SplitButton" TargetType="ui:SplitButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource MkOnBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Mk.Focus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SplitButton">
                    <Border x:Name="Face" Background="{DynamicResource MkAccentBrush}" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <mk:Ico Glyph="save" Margin="12,0,7,0" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Margin="1,-1,11,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Rectangle Width="1" Margin="0,6" Fill="{TemplateBinding Foreground}" Opacity="0.5" />
                            <ToggleButton x:Name="PART_ToggleButton" Width="28" Cursor="Hand" AutomationProperties.Name="More save choices"
                                          ToolTip="Shows Save and open in Workbench.">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <mk:Ico Glyph="chevron_down" FontSize="14" HorizontalAlignment="Center"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:SplitButton}}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkSubBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource MkMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
