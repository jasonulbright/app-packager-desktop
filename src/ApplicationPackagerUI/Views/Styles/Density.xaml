<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The density of the app is measured on the work area of a maximized window on a 1080p display (1920 x 1032 at 100 percent):
         a row of a grid or a list is 28 to 32 px high at 14 pt (4 px above and below the text), on the 4 px grid. One style for every grid. -->
    <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
</ResourceDictionary>
