<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- The Cancel button of a run (overhaul V1, Q-126, Q-125). One width and one danger look on every page, so the button takes the
         same room and the same height as the buttons beside it. The host row sets the margin, and the host keeps the room while
         the button is hidden: a hidden Cancel uses Visibility="Hidden" or a fixed column, never Collapsed, so the row does not
         shift when a run starts. A render test draws the style in a row with a neighbor and compares the top and the bottom. -->
    <Style x:Key="CancelSlot" TargetType="ui:Button">
        <Setter Property="Appearance" Value="Danger" />
        <Setter Property="MinWidth" Value="90" />
    </Style>
</ResourceDictionary>
