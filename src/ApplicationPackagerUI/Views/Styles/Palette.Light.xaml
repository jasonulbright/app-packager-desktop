<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The fixed brand palette of the Light theme. It replaces the Windows accent and the control library values that fail
         the contrast ratios (text 4.5 to 1, borders and focus rings 3 to 1). The theme applier merges this file after
         the theme file and swaps it with the theme. A test reads every pair in this file. -->

    <!-- One app accent. The accent fill is the secondary color: the theme files take it for the default fill. -->
    <Color x:Key="SystemAccentColor">#0B5FA5</Color>
    <Color x:Key="SystemAccentColorPrimary">#0A5599</Color>
    <Color x:Key="SystemAccentColorSecondary">#0B5FA5</Color>
    <Color x:Key="SystemAccentColorTertiary">#094C8A</Color>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0B5FA5" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#0A5599" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#094C8A" />

    <!-- Text below the primary and secondary levels. Disabled text keeps the library value: the WCAG rules exempt it. -->
    <Color x:Key="TextFillColorTertiary">#6B6B6B</Color>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6B6B6B" />

    <!-- Status colors for text and icons: success, warning, error, information and neutral. -->
    <Color x:Key="StatusSuccessColor">#0B6A0B</Color>
    <Color x:Key="StatusWarningColor">#8A4B00</Color>
    <Color x:Key="StatusErrorColor">#B3261E</Color>
    <Color x:Key="StatusInfoColor">#00579E</Color>
    <Color x:Key="StatusNeutralColor">#5C5C5C</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{DynamicResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{DynamicResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{DynamicResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{DynamicResource StatusInfoColor}" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="{DynamicResource StatusNeutralColor}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{DynamicResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{DynamicResource StatusWarningColor}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{DynamicResource StatusErrorColor}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{DynamicResource StatusInfoColor}" />

    <!-- Borders that mark a control or a card: 3 to 1 against every surface. -->
    <Color x:Key="BorderStrongColor">#858585</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{DynamicResource BorderStrongColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{DynamicResource BorderStrongColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource BorderStrongColor}" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{DynamicResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{DynamicResource BorderStrongColor}" />
</ResourceDictionary>
