<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.ImportSiteSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    Title="Import settings from another site"
    Width="940" Height="720"
    MinWidth="760" MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Import settings from another site" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,0,16,8">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"
                       Text="Copy the site-scoped settings of another site into the active site. The source site is only read and is not changed. Nothing is written until you select Import." />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Copy from (source site)" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="cmbSource" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Source site" AutomationProperties.AutomationId="cmbImportSource"
                              ToolTip="The site to copy the settings from. Its files are only read." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Copy into (active site)" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding TargetText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                               AutomationProperties.AutomationId="txtImportTarget" ToolTip="The active site. It receives the values that you tick." />
                </StackPanel>
            </Grid>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="gridItems" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" GridLinesVisibility="Horizontal" Margin="16,0,16,8"
                  HorizontalScrollBarVisibility="Auto" helpers:DataGridColumnSizing.FixStarWidthsOnResize="True"
                  RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource FocusableCell}" AutomationProperties.AutomationId="dgImportItems"
                  AutomationProperties.Name="Settings to import">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Copy" Width="56" MinWidth="56" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" Padding="0"
                                      ToolTip="{Binding ToolTipText}" AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Setting" Binding="{Binding Label, Mode=OneWay}" Width="2*" MinWidth="170" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" Width="120" MinWidth="110" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Source value" Binding="{Binding SourceText, Mode=OneWay}" Width="2*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Active site value" Binding="{Binding TargetText, Mode=OneWay}" Width="2*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Result" Binding="{Binding PlanText, Mode=OneWay}" Width="*" MinWidth="130" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTemplateColumn Header="If both have a value" Width="190" MinWidth="170" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Choices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedIndex="{Binding ChoiceIndex}"
                                      IsEnabled="{Binding IsConflict}" MinHeight="0" Padding="6,1" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{Binding Label, StringFormat=Conflict choice for {0}}"
                                      ToolTip="Used when the active site already has another value. Keep is the default: the active site value stays." />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="16,0,16,8" Padding="10,8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Never copied" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="txtImportNever"
                           Text="The site code (the active site keeps its own), every record that describes the source site (check results, versions, ring plans, audit, findings, saved runs), and every secret and token (GitHub token, Intune client secret, NVD API key, feed credentials). Secrets are global and work in every site." />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Content="Import" Appearance="Primary" MinWidth="110" Margin="0,0,8,0" Command="{Binding ImportCommand}"
                               IsEnabled="{Binding CanImport}" AutomationProperties.AutomationId="btnImportSettings"
                               ToolTip="Copy the ticked settings into the active site. A value that the active site already has is kept unless you chose Replace. The source site is not changed." />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnImportCancel"
                               ToolTip="Close the window and write nothing." />
                </WrapPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" AutomationProperties.AutomationId="txtImportSummary" />
                    <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               AutomationProperties.AutomationId="txtImportMessage" AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
