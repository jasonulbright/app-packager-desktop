<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.PublishResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Publish results"
    Width="1190" Height="600"
    MinWidth="900" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="ShowWhen" />
            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource SurfacePageBrush}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="96" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Publish results" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,0,16,8">
            <TextBlock Text="{Binding SiteLine}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="txtResultsSite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SiteLine}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Headline}" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level1"
                       AutomationProperties.AutomationId="txtResultsHeadline" AutomationProperties.LiveSetting="Polite" />
            <!-- The three counts as tiles: a glyph, the word and the number, so no count is read by color alone. -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" AutomationProperties.AutomationId="pnlResultTiles">
                <Border Style="{StaticResource Tile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource StatusSuccessBrush}" />
                        <TextBlock Text="{Binding PublishedText}" FontSize="16" Foreground="{DynamicResource StatusSuccessBrush}" AutomationProperties.AutomationId="txtResultsPublished" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DismissCircle24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource StatusErrorBrush}" />
                        <TextBlock Text="{Binding FailedText}" FontSize="16" Foreground="{DynamicResource StatusErrorBrush}" AutomationProperties.AutomationId="txtResultsFailed" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="SubtractCircle24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding SkippedText}" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="txtResultsSkipped" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding DeploymentNotice}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtResultsDeployment">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DeploymentNotice}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Notices}" Margin="0,8,0,0" Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="lstResultsNotices">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource StatusWarningBrush}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <DataGrid x:Name="Matrix" Grid.Row="2" Margin="16,0,16,8" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AutomationProperties.AutomationId="gridResultsMatrix" AutomationProperties.Name="Publish results matrix">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="2*" MinWidth="160" />
            </DataGrid.Columns>
        </DataGrid>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Details}" Margin="16,0,16,8" MaxHeight="96" Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="lstResultsDetails">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- One entry for each failed destination: the retry button where the app can verify the destination, else what to verify by hand. -->
        <StackPanel Grid.Row="4" Margin="16,0,16,8">
            <TextBlock Text="{Binding RetryNote}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource StatusWarningBrush}"
                       AutomationProperties.AutomationId="txtResultsRetryNote" AutomationProperties.LiveSetting="Assertive">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RetryNote}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Retries}" Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="lstResultsRetries">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,4">
                                <ui:Button DockPanel.Dock="Right" Content="Retry failed destination" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="8,0,0,0"
                                           Click="Retry_Click" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="btnResultsRetry" AutomationProperties.Name="{Binding ButtonName}"
                                           ToolTip="Opens the publish review for this application and this system only. Nothing is published until you confirm.">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanRetry}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8">
            <DockPanel LastChildFill="False">
                <ui:Button DockPanel.Dock="Left" x:Name="btnResultsHistory" Content="Operation history" Icon="{ui:SymbolIcon History24}" Margin="0,0,8,0"
                           Click="History_Click" Visibility="{Binding HasHistory, Converter={StaticResource ShowWhen}}"
                           AutomationProperties.AutomationId="btnResultsHistory" ToolTip="View the recorded operations of the application that is selected in the list. With no selection, the first failed one." />
                <ui:Button DockPanel.Dock="Left" x:Name="btnResultsReport" Content="Open report" Icon="{ui:SymbolIcon Open24}" Margin="0,0,8,0"
                           Click="Report_Click" Visibility="{Binding HasReport, Converter={StaticResource ShowWhen}}"
                           AutomationProperties.AutomationId="btnResultsReport" ToolTip="Open the report of this run." />
                <ui:Button DockPanel.Dock="Left" x:Name="btnResultsLogs" Content="Logs" Icon="{ui:SymbolIcon DocumentText24}" Margin="0,0,8,0"
                           Click="Logs_Click" Visibility="{Binding HasLogs, Converter={StaticResource ShowWhen}}"
                           AutomationProperties.AutomationId="btnResultsLogs" ToolTip="Open the log of this session." />
                <ui:Button DockPanel.Dock="Right" Content="Done" Appearance="Primary" MinWidth="110" IsDefault="True" IsCancel="True" Click="Done_Click"
                           AutomationProperties.AutomationId="btnResultsDone" ToolTip="Close the results. The grid keeps its filter, its sort and its place." Margin="8,0,0,0" />
                <ui:Button DockPanel.Dock="Right" x:Name="btnResultsReview" Content="Review failed application" Margin="0,0,0,0" Click="Review_Click"
                           Visibility="{Binding HasFailure, Converter={StaticResource ShowWhen}}"
                           AutomationProperties.AutomationId="btnResultsReview" ToolTip="Close the results and select the first failed application in the grid." />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
