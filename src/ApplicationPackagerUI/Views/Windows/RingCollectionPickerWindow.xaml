<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.RingCollectionPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    Title="{Binding Title}"
    Width="820" Height="560"
    MinWidth="560" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="PickerVisibility" />
            <helpers:BindingProxy x:Key="PickerProxy" Data="{Binding}" />
            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style x:Key="TabStopCell" TargetType="DataGridCell" BasedOn="{StaticResource FocusableCell}">
                <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <DockPanel Grid.Row="1" Margin="16,0,16,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="txtPickerCount" />
            <ui:TextBox x:Name="txtFilter" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, ID or folder" Icon="{ui:SymbolIcon Search24}"
                        AutomationProperties.Name="Collection filter" AutomationProperties.AutomationId="txtPickerFilter" />
        </DockPanel>

        <DataGrid Grid.Row="2" x:Name="dgPickerCollections" Margin="16,0,16,8" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal" SelectionMode="Single" CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource TabStopCell}"
                  helpers:DataGridKeyboard.SelectsFocusedRow="True" helpers:DataGridRightClick.SelectsRow="True" helpers:DataGridColumnSizing.FixStarWidthsOnResize="True"
                  MouseDoubleClick="OnGridDoubleClick" AutomationProperties.Name="Device collections" AutomationProperties.AutomationId="dgPickerCollections">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="48" MinWidth="48" Visibility="{Binding Data.MultiSelect, Source={StaticResource PickerProxy}, Converter={StaticResource PickerVisibility}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanCheck}" HorizontalAlignment="Center" MinWidth="0" Padding="0"
                                      AutomationProperties.Name="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="ID" Binding="{Binding CollectionId}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Content="Check shown" MinWidth="100" Margin="0,0,8,0" Command="{Binding CheckShownCommand}" Visibility="{Binding MultiSelect, Converter={StaticResource PickerVisibility}}"
                               AutomationProperties.Name="Check every collection the filter shows" AutomationProperties.AutomationId="btnPickerCheckShown" />
                    <ui:Button Content="Clear" MinWidth="80" Margin="0,0,8,0" Command="{Binding ClearChecksCommand}" Visibility="{Binding MultiSelect, Converter={StaticResource PickerVisibility}}"
                               AutomationProperties.Name="Clear every check" AutomationProperties.AutomationId="btnPickerClear" />
                    <ui:Button Content="{Binding PickText}" Appearance="Primary" MinWidth="100" Margin="0,0,8,0" Command="{Binding PickCommand}" IsDefault="True"
                               AutomationProperties.Name="{Binding PickText}" AutomationProperties.AutomationId="btnPickerPick" />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnPickerCancel" />
                </WrapPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtPickerMessage" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
