<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.DpContentPairsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    Title="{Binding Title}"
    Width="900" Height="560"
    MinWidth="620" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <!-- The cells of a row form a Local Tab group, so only the first cell is a Tab stop: Tab enters the grid once and the next Tab leaves it. -->
            <Style x:Key="TabStopCell" TargetType="DataGridCell" BasedOn="{StaticResource FocusableCell}">
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="0">
                        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <!-- Tab order: the pair grid, Check shown and Clear, Continue and Cancel, then the filter. -->
    <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,4,16,8">
            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtPairsIntro" />
            <WrapPanel Margin="0,8,0,0">
                <ui:TextBox x:Name="txtPairsFilter" KeyboardNavigation.TabIndex="4" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by content, PackageID, DP or state" Icon="{ui:SymbolIcon Search24}"
                            MinWidth="280" Margin="0,0,8,8" AutomationProperties.Name="Pair filter" AutomationProperties.AutomationId="txtPairsFilter" />
                <ui:Button KeyboardNavigation.TabIndex="1" Content="Check shown" Command="{Binding CheckShownCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="btnPairsCheckShown" />
                <ui:Button KeyboardNavigation.TabIndex="2" Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,8,8" ToolTip="Clears every pair, also the pairs the filter hides."
                           AutomationProperties.Name="Clear every pair" AutomationProperties.AutomationId="btnPairsClear" />
                <TextBlock Text="{Binding CountText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtPairsCount" AutomationProperties.LiveSetting="Polite" />
            </WrapPanel>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="gridPairs" KeyboardNavigation.TabIndex="0" KeyboardNavigation.TabNavigation="Once" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" GridLinesVisibility="Horizontal" Margin="16,0,16,8"
                  CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource TabStopCell}"
                  helpers:DataGridKeyboard.SelectsFocusedRow="True" helpers:DataGridRightClick.SelectsRow="True" helpers:DataGridColumnSizing.FixStarWidthsOnResize="True"
                  PreviewKeyDown="OnGridPreviewKeyDown" AutomationProperties.AutomationId="gridPairs" AutomationProperties.Name="Pairs">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Include" Width="72" MinWidth="72" CanUserResize="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" Padding="0" Focusable="False"
                                      AutomationProperties.Name="{Binding CheckName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" MinWidth="110" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Content" Binding="{Binding ContentName}" Width="3*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="PackageID" Binding="{Binding PackageId}" Width="104" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="DP" Binding="{Binding DpName}" Width="2*" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="State" Binding="{Binding StateName}" Width="*" MinWidth="110" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,10" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Space checks or clears the selected pair." VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="btnContinue" Content="Continue to the plan" MinWidth="150" Margin="0,0,8,0" Appearance="Primary" Command="{Binding ContinueCommand}"
                               AutomationProperties.AutomationId="btnPairsContinue" />
                    <ui:Button x:Name="btnCancel" Content="_Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnPairsCancel" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
