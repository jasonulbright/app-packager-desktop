<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.MaintenanceWindowEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ApplicationPackagerUI.ViewModels.Windows"
    Title="{Binding Title}"
    Width="{Binding Width, Mode=TwoWay}" Height="{Binding Height, Mode=TwoWay}"
    MinWidth="620" MinHeight="520"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="EditorVisibility" />
            <Style x:Key="EditorLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,8,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Visibility="{Binding IsWindow, Converter={StaticResource EditorVisibility}}" AutomationProperties.AutomationId="pnlEditorCollection">
                        <TextBlock Text="Collection" Style="{StaticResource EditorLabel}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding CollectionFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, ID or folder"
                                    Icon="{ui:SymbolIcon Search24}" IsEnabled="{Binding CanPickCollection}" Margin="0,0,0,4"
                                    AutomationProperties.Name="Collection filter" AutomationProperties.AutomationId="txtCollectionFilter" />
                        <ListBox ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" Height="140"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 IsEnabled="{Binding CanPickCollection}" AutomationProperties.Name="Collection" AutomationProperties.AutomationId="lstCollections">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableListItem}">
                                    <EventSetter Event="GotKeyboardFocus" Handler="OnCollectionItemFocused" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding FolderPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="txtSelectedFolder">
                            <Run Text="Folder:" />
                            <Run Text="{Binding SelectedFolderPath, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="Name" Style="{StaticResource EditorLabel}" />
                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" AutomationProperties.AutomationId="txtWindowName" />

                    <StackPanel Visibility="{Binding IsTemplate, Converter={StaticResource EditorVisibility}}">
                        <TextBlock Text="Description" Style="{StaticResource EditorLabel}" />
                        <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"
                                    AutomationProperties.Name="Description" AutomationProperties.AutomationId="txtTemplateDescription" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowsWindowDescription, Converter={StaticResource EditorVisibility}}"
                                AutomationProperties.AutomationId="pnlWindowDescription">
                        <TextBlock Text="Description" Style="{StaticResource EditorLabel}" />
                        <TextBox Text="{Binding WindowDescription, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AutomationProperties.Name="Description" AutomationProperties.AutomationId="txtWindowDescription" />
                        <TextBlock Text="{x:Static vm:MaintenanceWindowEditorViewModel.DescriptionKeptNote}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.AutomationId="txtDescriptionKept" />
                    </StackPanel>

                    <TextBlock Text="Type" Style="{StaticResource EditorLabel}" />
                    <ComboBox ItemsSource="{Binding WindowTypes}" SelectedValue="{Binding WindowType}" SelectedValuePath="Value" DisplayMemberPath="Text"
                              AutomationProperties.Name="Type" AutomationProperties.AutomationId="cboWindowType" />

                    <TextBlock Text="Recurrence" Style="{StaticResource EditorLabel}" />
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedValue="{Binding Kind}" SelectedValuePath="Value" DisplayMemberPath="Text"
                              AutomationProperties.Name="Recurrence" AutomationProperties.AutomationId="cboKind" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start date" Style="{StaticResource EditorLabel}" />
                            <DatePicker SelectedDate="{Binding StartDate}" SelectedDateFormat="Short" MinWidth="140" ToolTip="{Binding StartDateTip}" DisplayDateStart="{Binding FirstStartDate, Mode=OneTime}"
                                        DisplayDateEnd="{Binding LastStartDate, Mode=OneTime}"
                                        AutomationProperties.Name="Start date" AutomationProperties.AutomationId="dpStartDate" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hour" Style="{StaticResource EditorLabel}" />
                            <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding StartHour}" MinWidth="70"
                                      AutomationProperties.Name="Start hour" AutomationProperties.AutomationId="cboStartHour" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Minute" Style="{StaticResource EditorLabel}" />
                            <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding StartMinute}" MinWidth="70"
                                      AutomationProperties.Name="Start minute" AutomationProperties.AutomationId="cboStartMinute" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Duration hours" Style="{StaticResource EditorLabel}" />
                            <ComboBox ItemsSource="{Binding DurationHourChoices}" SelectedItem="{Binding DurationHours}" MinWidth="70"
                                      AutomationProperties.Name="Duration hours" AutomationProperties.AutomationId="cboDurationHours" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Minutes" Style="{StaticResource EditorLabel}" />
                            <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding DurationMinutes}" MinWidth="70"
                                      AutomationProperties.Name="Duration minutes" AutomationProperties.AutomationId="cboDurationMinutes" />
                        </StackPanel>
                        <CheckBox Grid.Column="4" Content="UTC" IsChecked="{Binding IsUtc}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                  ToolTip="Off: the window follows the local time of each client. On: the window starts at the same moment on every client."
                                  AutomationProperties.AutomationId="chkUtc" />
                    </Grid>

                    <StackPanel Visibility="{Binding ShowInterval, Converter={StaticResource EditorVisibility}}">
                        <TextBlock Text="{Binding IntervalLabel}" Style="{StaticResource EditorLabel}" />
                        <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}"
                                  AutomationProperties.Name="Interval" AutomationProperties.AutomationId="cboInterval" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowWeekOrder, Converter={StaticResource EditorVisibility}}">
                        <TextBlock Text="Week of the month" Style="{StaticResource EditorLabel}" />
                        <ComboBox ItemsSource="{Binding WeekOrders}" SelectedValue="{Binding WeekOrder}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  AutomationProperties.Name="Week of the month" AutomationProperties.AutomationId="cboWeekOrder" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowDayOfWeek, Converter={StaticResource EditorVisibility}}">
                        <TextBlock Text="Day" Style="{StaticResource EditorLabel}" />
                        <ComboBox ItemsSource="{Binding Days}" SelectedValue="{Binding DayOfWeek}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  AutomationProperties.Name="Day" AutomationProperties.AutomationId="cboDayOfWeek" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowDayOfMonth, Converter={StaticResource EditorVisibility}}">
                        <TextBlock Text="Day of the month" Style="{StaticResource EditorLabel}" />
                        <ComboBox ItemsSource="{Binding DaysOfMonth}" SelectedValue="{Binding DayOfMonth}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  AutomationProperties.Name="Day of the month" AutomationProperties.AutomationId="cboDayOfMonth" />
                        <TextBlock Text="{Binding DayOfMonthNote}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasDayOfMonthNote, Converter={StaticResource EditorVisibility}}"
                                   AutomationProperties.AutomationId="txtDayOfMonthNote" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowWeekdayOffset, Converter={StaticResource EditorVisibility}}">
                        <TextBlock Text="Days after that weekday" Style="{StaticResource EditorLabel}" />
                        <ComboBox ItemsSource="{Binding WeekdayOffsets}" SelectedItem="{Binding WeekdayOffsetDays}"
                                  AutomationProperties.Name="Days after that weekday" AutomationProperties.AutomationId="cboWeekdayOffset" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowPatchOffset, Converter={StaticResource EditorVisibility}}">
                        <TextBlock Text="Days after Patch Tuesday (the second Tuesday)" Style="{StaticResource EditorLabel}" />
                        <ComboBox ItemsSource="{Binding PatchTuesdayOffsets}" SelectedItem="{Binding PatchTuesdayOffsetDays}"
                                  AutomationProperties.Name="Days after Patch Tuesday" AutomationProperties.AutomationId="cboPatchOffset" />
                    </StackPanel>
                    <TextBlock Text="{x:Static vm:MaintenanceWindowEditorViewModel.NoEndDateNote}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsRecurring, Converter={StaticResource EditorVisibility}}"
                               AutomationProperties.AutomationId="txtNoEndDate" />
                </StackPanel>

                <Border Grid.Column="2" BorderThickness="1" CornerRadius="6" Padding="12" VerticalAlignment="Top"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        AutomationProperties.AutomationId="pnlPreview">
                    <StackPanel>
                        <TextBlock Text="Schedule" Style="{StaticResource EditorLabel}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ScheduleText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   AutomationProperties.AutomationId="txtScheduleText" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Next 5 occurrences" Style="{StaticResource EditorLabel}" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding Preview}" AutomationProperties.AutomationId="lstPreview">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Content="{Binding SaveText}" Appearance="Primary" MinWidth="110" Margin="0,0,8,0" Command="{Binding SaveCommand}"
                               AutomationProperties.AutomationId="btnEditorSave" />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}"
                               AutomationProperties.AutomationId="btnEditorCancel" />
                </WrapPanel>
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           AutomationProperties.AutomationId="txtEditorMessage" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
