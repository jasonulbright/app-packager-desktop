<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.PivotsCommentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="560" Height="340"
    MinWidth="420" MinHeight="260"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <TextBlock Grid.Row="1" Margin="16,4,16,8" Text="{Binding Prompt}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   AutomationProperties.AutomationId="txtCommentPrompt" />

        <TextBox Grid.Row="2" x:Name="txtComment" Margin="16,0,16,8" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False"
                 MaxLength="1000" VerticalScrollBarVisibility="Auto" KeyboardNavigation.TabIndex="0"
                 AutomationProperties.Name="{Binding Prompt}" AutomationProperties.AutomationId="txtComment" />

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,10"
                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button x:Name="btnOk" Content="OK" MinWidth="100" Margin="0,0,8,0" Appearance="Primary" IsDefault="True" Command="{Binding OkCommand}"
                           AutomationProperties.AutomationId="btnCommentOk" />
                <ui:Button x:Name="btnCancel" Content="_Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnCommentCancel" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
