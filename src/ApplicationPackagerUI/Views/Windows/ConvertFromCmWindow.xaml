<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.ConvertFromCmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Convert from ConfigMgr"
    Width="920" Height="680"
    MinWidth="720" MinHeight="520"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Convert from ConfigMgr" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,4,16,8">
            <TextBlock x:Name="txtIntro" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="txtConvertIntro" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Application name" VerticalAlignment="Center" />
                <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                            Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding Idle}" PlaceholderText="Exact name in the console"
                            AutomationProperties.AutomationId="txtCmApplicationName"
                            AutomationProperties.Name="Application name" />
                <TextBlock Grid.Row="1" Text="Output folder" VerticalAlignment="Center" />
                <ui:TextBox Grid.Row="1" Grid.Column="1"
                            Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding Idle}"
                            AutomationProperties.AutomationId="txtCmOutputFolder"
                            AutomationProperties.Name="Output folder" />
            </Grid>
            <WrapPanel>
                <CheckBox Content="Assign by group" Margin="0,0,16,0" IsChecked="{Binding AssignByGroup}" IsEnabled="{Binding Idle}"
                          ToolTip="Make one app per variant group of deployment types, instead of one per deployment type."
                          AutomationProperties.AutomationId="chkAssignByGroup" />
                <CheckBox Content="Native detection only" Margin="0,0,16,0" IsChecked="{Binding NativeDetectionOnly}" IsEnabled="{Binding Idle}"
                          ToolTip="Refuse a deployment type whose detection needs a script."
                          AutomationProperties.AutomationId="chkNativeOnly" />
                <CheckBox Content="Allow untranslated requirements" Margin="0,0,16,0" IsChecked="{Binding AllowUntranslated}" IsEnabled="{Binding Idle}"
                          ToolTip="Convert even when a requirement has no Intune equivalent. The report lists each one."
                          AutomationProperties.AutomationId="chkAllowUntranslated" />
                <CheckBox Content="Skip content" Margin="0,0,16,0" IsChecked="{Binding SkipContent}" IsEnabled="{Binding Idle}"
                          ToolTip="Write the plan and the reports without copying the content."
                          AutomationProperties.AutomationId="chkSkipContent" />
                <CheckBox Content="Build the .intunewin files" Margin="0,0,16,0" IsChecked="{Binding BuildIntuneWin}" IsEnabled="{Binding Idle}"
                          AutomationProperties.AutomationId="chkBuildIntuneWin" />
                <CheckBox Content="Publish to Intune" IsChecked="{Binding Publish}" IsEnabled="{Binding Idle}"
                          ToolTip="Publish each app with the Intune values stored in Settings."
                          AutomationProperties.AutomationId="chkPublish" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.AutomationId="txtConvertStatus"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TextBox Grid.Row="0" Text="{Binding ReportText}" IsReadOnly="True" PlaceholderText="The plan shows here after you select Preview." FontFamily="Consolas" FontSize="12"
                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True" Margin="0,0,0,8"
                     AutomationProperties.AutomationId="txtConvertReport" AutomationProperties.Name="Conversion report" />
            <ui:TextBox Grid.Row="1" Text="{Binding LogText}" IsReadOnly="True" PlaceholderText="The progress of each step shows here." FontFamily="Consolas" FontSize="12"
                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     AutomationProperties.AutomationId="txtConvertLog" AutomationProperties.Name="Progress log" />
        </Grid>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button Content="_Preview" MinWidth="110" Margin="0,0,8,0" IsDefault="True" Command="{Binding PreviewCommand}"
                           ToolTip="Read the application and show the plan. Nothing is written."
                           AutomationProperties.AutomationId="btnConvertPreview" />
                <ui:Button Content="_Convert" Appearance="Primary" MinWidth="110" Margin="0,0,8,0"
                           Command="{Binding ConvertCommand}"
                           ToolTip="Copy the content and write the files. Builds and publishes when you ask for it."
                           AutomationProperties.AutomationId="btnConvertRun" />
                <ui:Button Content="C_ancel" MinWidth="100" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                           AutomationProperties.AutomationId="btnConvertCancel" />
                <ui:Button x:Name="btnClose" Content="_Close" MinWidth="100" IsCancel="True" Click="Close_Click"
                           AutomationProperties.AutomationId="btnConvertClose" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
