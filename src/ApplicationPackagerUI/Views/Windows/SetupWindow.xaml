<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    Title="Setup"
    Width="620"
    Height="600"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <helpers:StepVisibilityConverter x:Key="StepVisibilityConverter" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Setup" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,8,28,8">

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
                    <TextBlock Text="Welcome to AppPackager" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="Select the systems you publish to, then fill in their settings. The Packages page has a publish button for each system. Everything here can be changed later in Settings."
                               Style="{StaticResource HintText}" />

                    <TextBlock Text="Systems in use" Style="{StaticResource FieldLabel}" />
                    <CheckBox Content="ConfigMgr" IsChecked="{Binding UseConfigMgr}" Margin="0,0,0,4"
                              AutomationProperties.AutomationId="chkSetupConfigMgr"
                              ToolTip="ConfigMgr applications. Needs the ConfigMgr console, a site and a content share." />
                    <TextBlock Text="ConfigMgr applications. Needs the ConfigMgr console, a site and a content share."
                               Style="{StaticResource HintText}" Margin="28,0,0,10" />

                    <CheckBox Content="Intune" IsChecked="{Binding UseIntune}" Margin="0,0,0,4"
                              AutomationProperties.AutomationId="chkSetupIntune"
                              ToolTip="Intune Win32 apps published through Microsoft Graph. Needs an app registration." />
                    <TextBlock Text="Intune Win32 apps published through Microsoft Graph. Needs an app registration."
                               Style="{StaticResource HintText}" Margin="28,0,0,10" />

                    <CheckBox Content="WSUS" IsChecked="{Binding UseWsus}" Margin="0,0,0,4"
                              AutomationProperties.AutomationId="chkSetupWsus"
                              ToolTip="Locally published WSUS updates for computers that have an older version. Needs a WSUS server." />
                    <TextBlock Text="Locally published WSUS updates for computers that have an older version. Needs a WSUS server."
                               Style="{StaticResource HintText}" Margin="28,0,0,10" />
                </StackPanel>

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
                    <TextBlock Text="Connection details" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />

                    <StackPanel Visibility="{Binding ShowMecmFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="ConfigMgr" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Site Code" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding SiteCode, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="MCM" Margin="0,0,0,12" />

                        <TextBlock Text="Site Server / SMS Provider" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding ProviderMachine, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Empty uses the local machine" Margin="0,0,0,12" />

                        <TextBlock Text="File Share Root" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding FileShareRoot, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="\\fileserver\sccm$" Margin="0,0,0,12" />

                        <TextBlock Text="Download Root" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding DownloadRoot, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="C:\temp\ap" Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowIntuneFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Intune" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding IntuneTenantId, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="contoso.onmicrosoft.com or a GUID" Margin="0,0,0,12" />

                        <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding IntuneClientId, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="App registration (client) ID" Margin="0,0,0,12" />

                        <TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" />
                        <ui:PasswordBox Password="{Binding IntuneClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{Binding IntuneSecretHint}" Margin="0,0,0,4" />
                        <TextBlock Text="Stored encrypted for the current Windows user. Leave empty to keep the saved secret. Publishing needs an Entra app registration with the application permission DeviceManagementApps.ReadWrite.All, admin-consented."
                                   Style="{StaticResource HintText}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowWsusFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="WSUS" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="WSUS server" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding WsusServerName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="wsus01.contoso.com" Margin="0,0,0,12"
                                    AutomationProperties.Name="WSUS server" AutomationProperties.AutomationId="txtSetupWsusServer"
                                    ToolTip="WSUS server name. For ConfigMgr, the top-level software update point." />
                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:TextBox Text="{Binding WsusPort, UpdateSourceTrigger=PropertyChanged}" Width="100" MaxLength="5"
                                        AutomationProperties.Name="WSUS port" AutomationProperties.AutomationId="txtSetupWsusPort"
                                        ToolTip="8530 for HTTP, 8531 for HTTPS on a default WSUS install." />
                            <CheckBox Content="Use SSL" IsChecked="{Binding WsusUseSsl}" Margin="16,0,0,0" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="chkSetupWsusSsl"
                                      ToolTip="Connect to the WSUS administration API over HTTPS." />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="No system is selected. Save stores that, and the publish buttons stay disabled until a system is selected in Settings."
                               Style="{StaticResource HintText}"
                               Visibility="{Binding ShowNoFields, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="28,12">
            <DockPanel>
                <CheckBox DockPanel.Dock="Left" Content="Don't show this again"
                          IsChecked="{Binding DontShowAgain}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0"
                               Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}" />
                    <ui:Button Content="Skip" Command="{Binding SkipCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Next" Appearance="Primary" Command="{Binding NextCommand}"
                               Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}" />
                    <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}"
                               Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
