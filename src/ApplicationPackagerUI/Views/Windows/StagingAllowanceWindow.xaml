<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.StagingAllowanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Allow this folder anyway"
    Width="560" SizeToContent="Height"
    MinWidth="420"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Allow this folder anyway" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="16,4,16,16">
            <TextBlock x:Name="txtFolder" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtAllowFolder" />
            <TextBlock x:Name="txtReason" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtAllowReason" />
            <CheckBox x:Name="chkAcknowledge" Content="I understand the risk and allow staging in this folder."
                      AutomationProperties.AutomationId="chkAllowAcknowledge" />
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button x:Name="btnAccept" Content="_Accept" MinWidth="100" Margin="0,0,8,0"
                           IsEnabled="{Binding IsChecked, ElementName=chkAcknowledge}" Click="OnAccept"
                           AutomationProperties.AutomationId="btnAllowAccept" />
                <ui:Button x:Name="btnCancel" Content="_Cancel" MinWidth="100" Appearance="Primary" IsDefault="True" IsCancel="True"
                           AutomationProperties.AutomationId="btnAllowCancel" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
