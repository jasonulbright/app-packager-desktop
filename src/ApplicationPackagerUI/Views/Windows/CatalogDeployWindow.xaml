<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.CatalogDeployWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="760" Height="680"
    MinWidth="560" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="DeployVisibility" />
            <Style x:Key="DeployLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,8,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DeployNote" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Margin="16,0,8,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="scrollDeploy">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           AutomationProperties.AutomationId="txtDeploySummary" />
                <TextBlock Text="Fields with * are required." Style="{StaticResource DeployNote}" Margin="0,4,0,0" />

                <ItemsControl x:Name="lstFields" ItemsSource="{Binding Fields}" IsTabStop="False" Focusable="False" IsEnabled="{Binding CanEditFields}"
                              AutomationProperties.AutomationId="lstDeployFields">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4">
                                <StackPanel Visibility="{Binding IsText, Converter={StaticResource DeployVisibility}}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource DeployLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                                                    AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="{Binding Name, StringFormat='txtParam{0}'}" />
                                        <ui:Button Grid.Column="1" Content="Pick" Margin="8,0,0,0" Icon="{ui:SymbolIcon Search24}"
                                                   Command="{Binding DataContext.PickCollectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" Visibility="{Binding IsCollection, Converter={StaticResource DeployVisibility}}"
                                                   AutomationProperties.Name="{Binding Name, StringFormat='Pick {0}'}" AutomationProperties.AutomationId="{Binding Name, StringFormat='btnPick{0}'}" />
                                    </Grid>
                                </StackPanel>
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding IsChecked}" Visibility="{Binding IsSwitch, Converter={StaticResource DeployVisibility}}"
                                          AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="{Binding Name, StringFormat='chkParam{0}'}">
                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </CheckBox>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource DeployNote}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="{Binding ModeText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               AutomationProperties.AutomationId="txtDeployMode" AutomationProperties.LiveSetting="Polite" />
                </Border>

                <StackPanel Visibility="{Binding HasDependencies, Converter={StaticResource DeployVisibility}}">
                    <TextBlock Text="Needs" Style="{StaticResource DeployLabel}" />
                    <ItemsControl ItemsSource="{Binding Dependencies}" IsTabStop="False" Focusable="False" AutomationProperties.AutomationId="lstDependencies">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <ui:Button DockPanel.Dock="Right" Content="Create" Margin="8,0,0,0" Icon="{ui:SymbolIcon Add24}"
                                               Command="{Binding DataContext.CreateDependencyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" Visibility="{Binding CanCreate, Converter={StaticResource DeployVisibility}}"
                                               AutomationProperties.Name="{Binding Name, StringFormat='Create {0}'}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="pnlDeployFooter" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,10"
                AutomationProperties.AutomationId="pnlDeployFooter">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Content="Show plan" Appearance="Primary" MinWidth="110" Margin="0,0,8,0" Command="{Binding DeployCommand}" IsDefault="True"
                               AutomationProperties.AutomationId="btnDeployShowPlan" />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnDeployCancel" />
                </WrapPanel>
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" AutomationProperties.AutomationId="txtDeployMessage"
                           AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
