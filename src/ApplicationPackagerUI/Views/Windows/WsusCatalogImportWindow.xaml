<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.WsusCatalogImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Catalog Import"
    Width="780" Height="600"
    MinWidth="620" MinHeight="460"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Catalog Import" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,4,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Paste update IDs or catalog links, one or more per line. The Copy button on a catalog update details page copies its update ID. The WSUS server downloads the update metadata itself, so it needs internet access; update files follow the server's Update files setting." />
            <TextBox Grid.Row="1" x:Name="txtInput" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" AutomationProperties.Name="Update IDs" AutomationProperties.AutomationId="txtInput" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                <ui:Button x:Name="btnImport" Content="Import" Appearance="Primary" MinWidth="110" Margin="0,0,8,0"
                           Command="{Binding ImportCommand}" AutomationProperties.AutomationId="btnImport" />
                <ui:Button x:Name="btnLoadFile" Content="Load IDs from file..." MinWidth="150" Margin="0,0,8,0"
                           Command="{Binding LoadFileCommand}" AutomationProperties.AutomationId="btnLoadFile" />
                <ui:Button x:Name="btnOpenCatalog" Content="Open the catalog" MinWidth="130" Margin="0,0,8,0"
                           Command="{Binding OpenCatalogCommand}" AutomationProperties.AutomationId="btnOpenCatalog" />
                <ui:Button x:Name="btnCancel" Content="Cancel" Appearance="Danger" MinWidth="90" Command="{Binding CancelCommand}"
                           Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="btnCancel" />
            </StackPanel>
            <TextBox Grid.Row="3" x:Name="txtResults" Text="{Binding ResultsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     AutomationProperties.Name="Import results" AutomationProperties.AutomationId="txtResults" />
            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <ui:Button x:Name="btnClose" DockPanel.Dock="Right" Content="Close" MinWidth="90" IsCancel="True" Click="Close_Click"
                           Margin="8,0,0,0" AutomationProperties.AutomationId="btnClose" />
                <TextBlock x:Name="txtStatus" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="txtStatus" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </Grid>

        <ui:ContentDialogHost x:Name="PromptHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
