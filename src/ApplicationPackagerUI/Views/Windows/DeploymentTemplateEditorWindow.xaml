<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.DeploymentTemplateEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="600" Height="600"
    MinWidth="460" MinHeight="420"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="EditorVisibility" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- A string Content renders as one non-wrapping line, which the minimum width clips. -->
        <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="520" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="scrollTemplateEditor">
            <StackPanel Margin="16,0,16,8">
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <ui:TextBox x:Name="txtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template name"
                            AutomationProperties.AutomationId="txtTemplateName" />
                <TextBlock Text="Purpose" Style="{StaticResource FieldLabel}" />
                <CheckBox Content="Required (installs at the deadline)" IsChecked="{Binding IsRequired}" Style="{StaticResource Option}"
                          AutomationProperties.AutomationId="chkTemplateRequired" />
                <StackPanel Visibility="{Binding IsRequired, Converter={StaticResource EditorVisibility}}">
                    <TextBlock Text="Deadline, hours after the available time (0 for none)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding DeadlineOffsetText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"
                                AutomationProperties.Name="Deadline offset in hours" AutomationProperties.AutomationId="txtTemplateOffset" />
                </StackPanel>
                <TextBlock Text="User notification" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Notifications}" SelectedItem="{Binding Notification}" DisplayMemberPath="Text"
                          AutomationProperties.Name="User notification" AutomationProperties.AutomationId="cboTemplateNotification" />
                <TextBlock Text="Options" Style="{StaticResource FieldLabel}" />
                <CheckBox Content="Use UTC instead of local time" IsChecked="{Binding UtcBasis}" Style="{StaticResource Option}" AutomationProperties.AutomationId="chkTemplateUtc" />
                <CheckBox Content="Override maintenance windows" IsChecked="{Binding OverrideServiceWindow}" Style="{StaticResource Option}" AutomationProperties.AutomationId="chkTemplateOverride" />
                <CheckBox Content="Allow restart outside maintenance windows" IsChecked="{Binding RebootOutsideServiceWindow}" Style="{StaticResource Option}"
                          AutomationProperties.AutomationId="chkTemplateReboot" />
                <CheckBox Content="Allow download on a metered connection" IsChecked="{Binding AllowMetered}" Style="{StaticResource Option}" AutomationProperties.AutomationId="chkTemplateMetered" />
                <CheckBox Content="Allow fallback to neighbor boundary groups" IsChecked="{Binding AllowBoundaryFallback}" Style="{StaticResource Option}"
                          AutomationProperties.AutomationId="chkTemplateFallback" />
                <CheckBox Content="Allow Microsoft Update when no distribution point has the content" IsChecked="{Binding AllowMicrosoftUpdate}" Style="{StaticResource Option}"
                          AutomationProperties.AutomationId="chkTemplateMicrosoftUpdate" />
                <CheckBox Content="Require a full scan after the restart" IsChecked="{Binding PostRebootScan}" Style="{StaticResource Option}" AutomationProperties.AutomationId="chkTemplateScan" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Content="Save template" Appearance="Primary" MinWidth="120" Margin="0,0,8,0" Command="{Binding SaveCommand}"
                               AutomationProperties.AutomationId="btnTemplateSave" />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnTemplateCancel" />
                </WrapPanel>
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtTemplateMessage" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
