<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.CollectionPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    Title="{Binding Title}"
    Width="760" Height="600"
    MinWidth="560" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <TextBlock Grid.Row="1" Margin="16,0,16,8" Text="{Binding Prompt}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   AutomationProperties.AutomationId="txtPickerPrompt" />

        <WrapPanel Grid.Row="2" Margin="16,0,16,8">
            <ui:TextBox x:Name="txtFilter" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, ID or folder" Icon="{ui:SymbolIcon Search24}"
                        MinWidth="260" Margin="0,0,8,0" AutomationProperties.Name="Collection filter" AutomationProperties.AutomationId="txtPickerFilter" />
            <ui:Button Content="Check shown" Command="{Binding CheckShownCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="btnPickerCheckShown" />
            <ui:Button Content="Clear" Command="{Binding ClearChecksCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="btnPickerClear" />
            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="txtPickerCount">
                <Run Text="{Binding CheckedCount, Mode=OneWay}" />
                <Run Text="checked" />
            </TextBlock>
        </WrapPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" GridLinesVisibility="Horizontal" Margin="16,0,16,8"
                  HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" helpers:DataGridColumnSizing.FixStarWidthsOnResize="True"
                  RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource FocusableCell}" AutomationProperties.AutomationId="dgPickerTargets"
                  AutomationProperties.Name="Collections">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="64" MinWidth="64" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" Padding="0"
                                      AutomationProperties.Name="{Binding Text}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Collection" Binding="{Binding Name, Mode=OneWay}" Width="2*" MinWidth="180" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="ID" Binding="{Binding CollectionId, Mode=OneWay}" Width="100" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath, Mode=OneWay}" Width="*" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Content="{Binding ActionText}" Appearance="Primary" MinWidth="110" Margin="0,0,8,0" Command="{Binding AcceptCommand}"
                               AutomationProperties.AutomationId="btnPickerAccept" />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnPickerCancel" />
                </WrapPanel>
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" AutomationProperties.AutomationId="txtPickerMessage" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
