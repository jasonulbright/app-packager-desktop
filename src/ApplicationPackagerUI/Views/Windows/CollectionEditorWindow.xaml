<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.CollectionEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ApplicationPackagerUI.ViewModels.Windows"
    Title="{Binding Title}"
    Width="{Binding Width, Mode=TwoWay}" Height="{Binding Height, Mode=TwoWay}"
    MinWidth="480" MinHeight="420"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="EditorVisibility" />
            <Style x:Key="EditorLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,8,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <StackPanel Visibility="{Binding IsCopy, Converter={StaticResource EditorVisibility}}">
                    <TextBlock Text="Source" Style="{StaticResource EditorLabel}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SourceText}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               AutomationProperties.AutomationId="txtCopySource" />
                </StackPanel>
                <TextBlock Text="Name" Style="{StaticResource EditorLabel}" />
                <ui:TextBox x:Name="txtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="For example Workstations - Pilot ring"
                            AutomationProperties.Name="Name" AutomationProperties.AutomationId="txtCollectionName" />
                <StackPanel Visibility="{Binding CanEditProperties, Converter={StaticResource EditorVisibility}}">
                    <TextBlock Text="Comment" Style="{StaticResource EditorLabel}" />
                    <ui:TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" PlaceholderText="Optional"
                                AutomationProperties.Name="Comment" AutomationProperties.AutomationId="txtCollectionComment" />
                    <TextBlock Text="Refresh type" Style="{StaticResource EditorLabel}" />
                    <ComboBox ItemsSource="{x:Static vm:CollectionEditorViewModel.RefreshTypes}" SelectedItem="{Binding RefreshType}"
                              AutomationProperties.Name="Refresh type" AutomationProperties.AutomationId="cboRefreshType" />
                    <TextBlock Text="Limiting collection" Style="{StaticResource EditorLabel}" />
                    <ui:TextBox Text="{Binding LimitingFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, ID or folder"
                                Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,4" AutomationProperties.Name="Limiting collection filter"
                                AutomationProperties.AutomationId="txtLimitingFilter" />
                </StackPanel>
            </StackPanel>
            <DockPanel Grid.Row="1" Visibility="{Binding CanEditProperties, Converter={StaticResource EditorVisibility}}">
                <TextBlock DockPanel.Dock="Bottom" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtSelectedLimiting">
                    <Run Text="Selected:" />
                    <Run Text="{Binding SelectedLimitingText, Mode=OneWay}" />
                </TextBlock>
                <ListBox x:Name="lstLimiting" ItemsSource="{Binding LimitingChoices}" SelectedItem="{Binding SelectedLimiting, Mode=OneWay}"
                         SelectionChanged="OnLimitingSelectionChanged" MinHeight="100" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Limiting collection" AutomationProperties.AutomationId="lstLimiting">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableListItem}">
                            <EventSetter Event="GotKeyboardFocus" Handler="OnLimitingItemFocused" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding FolderPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Content="Show plan" Appearance="Primary" MinWidth="110" Margin="0,0,8,0" Command="{Binding SaveCommand}" IsDefault="True"
                               AutomationProperties.AutomationId="btnCollectionSave" />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnCollectionCancel" />
                </WrapPanel>
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" AutomationProperties.AutomationId="txtCollectionMessage"
                           AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
