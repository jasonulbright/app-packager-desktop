<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.WsusPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Certificate Password"
    Width="440" SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">
    <StackPanel>
        <ui:TitleBar Title="Certificate Password" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="20,4,20,16">
            <TextBlock x:Name="txtPrompt" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <PasswordBox x:Name="pwdValue" Margin="0,0,0,14" AutomationProperties.Name="Password" AutomationProperties.AutomationId="pwdValue" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="btnOk" Content="OK" Appearance="Primary" MinWidth="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
                <ui:Button x:Name="btnCancel" Content="Cancel" MinWidth="90" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
