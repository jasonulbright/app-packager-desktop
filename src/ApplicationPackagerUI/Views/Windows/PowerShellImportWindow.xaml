<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.PowerShellImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Import from App Packager (PowerShell)"
    Width="1200" Height="760"
    MinWidth="640" MinHeight="400"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Import from App Packager (PowerShell)" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="16,4,16,8">
            <TextBlock x:Name="txtSource" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="txtImportSource" />
            <TextBlock x:Name="txtSummary" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtImportSummary" />
            <TextBlock Text="The import writes the checked rows to the saved settings. Credentials are never imported. The PowerShell file is not changed. Unsaved edits on the Settings page are discarded."
                       Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="grid" Margin="16,0,16,8" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" IsReadOnly="False" SelectionMode="Single"
                  BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  AutomationProperties.AutomationId="dgImportRows">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Import" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Differs}" HorizontalAlignment="Center"
                                      AutomationProperties.Name="{Binding Key, StringFormat=Import {0}}" ToolTip="Import this setting from the PowerShell file. You can select it only when the two values differ." />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Result" Width="88" Binding="{Binding OutcomeText}" IsReadOnly="True" />
                <DataGridTextColumn Header="Key" Width="260" Binding="{Binding Key}" IsReadOnly="True" />
                <DataGridTextColumn Header="PowerShell value" Width="180" Binding="{Binding PowerShellValue}" IsReadOnly="True" />
                <DataGridTextColumn Header="APD value" Width="120" Binding="{Binding ApdValue}" IsReadOnly="True" />
                <DataGridTextColumn Header="Note" Width="*" MinWidth="160" Binding="{Binding Note}" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="ToolTip" Value="{Binding Note}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8">
            <DockPanel>
                <ui:Button DockPanel.Dock="Left" x:Name="btnOther" Content="Choose another file..." Click="OnChooseAnother"
                           AutomationProperties.AutomationId="btnImportOther" ToolTip="Close this preview and select a different preferences file." />
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="btnImport" Content="_Import" MinWidth="100" Margin="0,0,8,0" Appearance="Primary" Click="OnImport"
                               AutomationProperties.AutomationId="btnImportAccept" ToolTip="Write the checked rows to the saved settings. The PowerShell file is not changed." />
                    <ui:Button x:Name="btnCancel" Content="_Cancel" MinWidth="100" IsCancel="True" IsDefault="True"
                               AutomationProperties.AutomationId="btnImportCancel" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
