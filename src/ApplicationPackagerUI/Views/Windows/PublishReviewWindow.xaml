<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.PublishReviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    Title="Review publish"
    Width="1190" Height="540"
    MinWidth="900" MinHeight="480"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Ideal"
    WindowBackdropType="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <!-- A warning shows only while the plan has that problem. -->
            <helpers:HasTextConverter x:Key="HasText" />
            <!-- The matrix of several systems: the mock sets some of its texts one pixel above the middle. A row replaces these. -->
            <TranslateTransform x:Key="CellShift" />
            <TranslateTransform x:Key="NameShift" />
            <Style x:Key="MatrixCell" TargetType="DataGridCell" BasedOn="{StaticResource Mk.GridCell}">
                <Setter Property="RenderTransform" Value="{DynamicResource CellShift}" />
            </Style>
            <Style x:Key="MatrixHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Mk.GridHeader}">
                <Setter Property="Padding" Value="12,0,4,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <mk:DialogFrame Title="Review publish">
        <mk:DialogFrame.Body>
            <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <!-- The heading, the systems and the word Preview. -->
                    <DockPanel Height="51">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform X="1" Y="1" />
                            </StackPanel.RenderTransform>
                            <mk:Ico x:Name="icoPreview" Glyph="info" Foreground="{DynamicResource MkAccentBrush}" />
                            <TextBlock Text="Preview" Margin="6,-1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MkAccentBrush}" />
                        </StackPanel>
                        <StackPanel>
                            <mk:TrackedText Style="{StaticResource Mk.H2}" Text="{Binding HeadingText}" AutomationProperties.HeadingLevel="Level1"
                                            AutomationProperties.AutomationId="txtReviewHeading" />
                            <TextBlock Text="{Binding SubLine}" Margin="0,5,0,-1" Height="21" Foreground="{DynamicResource MkMutedBrush}"
                                       AutomationProperties.AutomationId="txtReviewScope" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Mk.Banner}" Margin="0,13,0,0" MinHeight="43">
                        <DockPanel>
                            <mk:Ico x:Name="icoBanner" DockPanel.Dock="Left" Glyph="info" Foreground="{DynamicResource MkTextBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MkTextBrush}"
                                       AutomationProperties.AutomationId="txtReviewCounts" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>

                    <Border Margin="0,13,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Mk.Notice.Warn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChangedText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ChangedText}" TextWrapping="Wrap" Foreground="{DynamicResource MkTextBrush}"
                                   AutomationProperties.AutomationId="txtReviewChanged" AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                    <Border Margin="0,13,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Mk.Notice.Warn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NothingText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding NothingText}" TextWrapping="Wrap" Foreground="{DynamicResource MkTextBrush}" AutomationProperties.AutomationId="txtReviewNothing" />
                    </Border>
                    <Border Margin="0,13,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Mk.Notice.Warn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BlockedText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BlockedText}" TextWrapping="Wrap" Foreground="{DynamicResource MkTextBrush}"
                                   AutomationProperties.AutomationId="txtReviewBlocked" AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <!-- What the run risks: the warnings of the plan and the prompt that can overwrite an application. -->
                    <Border Margin="0,13,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Mk.Notice.Warn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RiskText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RiskText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource MkTextBrush}"
                                   AutomationProperties.AutomationId="txtReviewRisk" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <!-- The comment of the run, when it is not empty: it was typed on the page, so it shows here before it is published. -->
                    <StackPanel Margin="0,13,0,0" Visibility="{Binding ShowsComment, Converter={StaticResource Visible}, Mode=OneWay}">
                        <TextBlock Text="Administrative comment" Style="{StaticResource Mk.Help}" Margin="0,0,0,4" />
                        <TextBox x:Name="txtReviewComment" Style="{StaticResource Mk.TextBox}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="txtReviewComment" AutomationProperties.Name="Administrative comment"
                                 ToolTip="The comment that the run writes to each published application. It may stay empty." />
                    </StackPanel>

                    <!-- One system: one line for each application. -->
                    <Border Style="{StaticResource Mk.Panel}" Margin="0,13,0,0" Visibility="{Binding SingleSystem, Converter={StaticResource Visible}}">
                        <DataGrid x:Name="LineGrid" Style="{StaticResource Mk.PlainGrid}" ItemsSource="{Binding Lines}" MaxHeight="177"
                                  AutomationProperties.AutomationId="gridReviewLines" AutomationProperties.Name="Publish review">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Application" Width="236.1*" MinWidth="160" SortMemberPath="Application">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel Background="Transparent">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource Mk.AppMark}">
                                                    <TextBlock Style="{StaticResource Mk.AppMarkText}" Text="{Binding Mark}" />
                                                </Border>
                                                <TextBlock Text="{Binding Application}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,-2,0,1" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Current &#x2192; planned" Binding="{Binding Versions}" Width="202*" MinWidth="120" ElementStyle="{StaticResource Mk.CellText}" />
                                <DataGridTextColumn Header="System" Binding="{Binding System}" Width="141.3*" MinWidth="90" ElementStyle="{StaticResource Mk.CellText}" />
                                <DataGridTextColumn Header="Application change" Binding="{Binding Change}" Width="424.8*" MinWidth="220" ElementStyle="{StaticResource Mk.CellText}" />
                                <DataGridTextColumn Header="Deployment" Binding="{Binding Deployment}" Width="145.8*" MinWidth="100" ElementStyle="{StaticResource Mk.CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Several systems: one column for each system (the system columns are added in code). -->
                    <Border Style="{StaticResource Mk.Panel}" Margin="0,13,0,0" Visibility="{Binding SeveralSystems, Converter={StaticResource Visible}}">
                        <DataGrid x:Name="Matrix" Style="{StaticResource Mk.PlainGrid}" CellStyle="{StaticResource MatrixCell}" ColumnHeaderStyle="{StaticResource MatrixHeader}" ItemsSource="{Binding Rows}" MaxHeight="178"
                                  AutomationProperties.AutomationId="gridReviewMatrix" AutomationProperties.Name="Publish review matrix">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Application" Width="264*" MinWidth="160" SortMemberPath="Application">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel Background="Transparent">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource Mk.AppMark}">
                                                    <TextBlock Style="{StaticResource Mk.AppMarkText}" Text="{Binding Mark}" />
                                                </Border>
                                                <TextBlock Text="{Binding Application}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,-1,0,0" TextTrimming="CharacterEllipsis" RenderTransform="{DynamicResource NameShift}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Latest version" Binding="{Binding Version}" Width="158.2*" MinWidth="100" ElementStyle="{StaticResource Mk.CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- One system: what the run does with the content, and what else changes. -->
                    <UniformGrid Rows="1" Margin="-7,13,-7,0" Visibility="{Binding SingleSystem, Converter={StaticResource Visible}}"
                                 AutomationProperties.AutomationId="pnlReviewCards">
                        <Border Style="{StaticResource Mk.Panel}" Margin="7,0" Padding="16" ToolTip="{Binding SystemDetail}" AutomationProperties.HelpText="{Binding SystemDetail, TargetNullValue=''}">
                            <StackPanel>
                                <TextBlock Text="Content and detection" Style="{StaticResource Mk.H3}" AutomationProperties.HeadingLevel="Level2" />
                                <ItemsControl ItemsSource="{Binding ContentLines}" Margin="0,14,0,-10" Focusable="False" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="142" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MkMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource MkTextBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Mk.Panel}" Margin="7,0" Padding="16" ToolTip="{Binding SystemDetail}" AutomationProperties.HelpText="{Binding SystemDetail, TargetNullValue=''}">
                            <StackPanel>
                                <TextBlock Text="Other changes" Style="{StaticResource Mk.H3}" AutomationProperties.HeadingLevel="Level2" />
                                <ItemsControl ItemsSource="{Binding OtherLines}" Margin="0,14,0,-10" Focusable="False" IsTabStop="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="142" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MkMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource MkTextBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Several systems: one card for each. -->
                    <ItemsControl ItemsSource="{Binding SystemCards}" Margin="-7,13,-7,0" Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="pnlReviewSystemCards"
                                  Visibility="{Binding SeveralSystems, Converter={StaticResource Visible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Mk.Panel}" Margin="7,0" Padding="16" MinHeight="110" ToolTip="{Binding Detail}" AutomationProperties.HelpText="{Binding Detail}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Destination}" Style="{StaticResource Mk.H3}" AutomationProperties.HeadingLevel="Level2" />
                                        <TextBlock Text="{Binding Text}" Margin="0,15,0,-1" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource MkTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Before confirmation, a live plan shows the exact target identifiers, detection rules and content paths for each application."
                               Style="{StaticResource Mk.Help}" Margin="0,14,0,-1" Visibility="{Binding SeveralSystems, Converter={StaticResource Visible}}" />
                </StackPanel>
            </ScrollViewer>
        </mk:DialogFrame.Body>
        <mk:DialogFrame.FootLeft>
            <Button x:Name="btnReviewBack" Style="{StaticResource Mk.Button}" mk:Mk.Icon="arrow_left" Content="Back" IsCancel="True" Command="{Binding BackCommand}"
                    AutomationProperties.AutomationId="btnReviewBack" ToolTip="Close the review. Nothing is published and the checks stay as they are." />
        </mk:DialogFrame.FootLeft>
        <mk:DialogFrame.FootRight>
            <Button x:Name="btnReviewConfirm" Style="{StaticResource Mk.Button.Primary}" mk:Mk.Icon="cloud_arrow_up" Content="{Binding ConfirmText}" IsDefault="True"
                    Command="{Binding AcceptCommand}" AutomationProperties.AutomationId="btnReviewConfirm" ToolTip="{Binding ConfirmToolTip}" ToolTipService.ShowOnDisabled="True" />
        </mk:DialogFrame.FootRight>
    </mk:DialogFrame>
</ui:FluentWindow>
