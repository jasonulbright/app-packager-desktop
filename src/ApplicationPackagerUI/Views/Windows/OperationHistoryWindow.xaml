<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.OperationHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Operation history"
    Width="1180"
    Height="760"
    MinWidth="900"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Operation history" ShowMinimize="False" />
        <TextBlock Grid.Row="1"
                   Text="Showing the latest 100 operations for this application. Times use your local time zone."
                   Margin="0,10,0,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="2">
            <DataGrid x:Name="OperationsGrid"
                      ItemsSource="{Binding Operations}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="OperationsGrid_SelectionChanged"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Operation" Binding="{Binding Kind}" Width="150" />
                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="170" />
                    <DataGridTextColumn Header="Started" Binding="{Binding StartedAt.LocalDateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="175" />
                    <DataGridTextColumn Header="Finished" Binding="{Binding FinishedAt.LocalDateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="175" />
                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="120" ElementStyle="{StaticResource StatusCell}" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyHistoryText"
                       Text="No operations have been recorded for this application."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       IsHitTestVisible="False" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="Operation events"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,12,0,8"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <Grid Grid.Row="4">
            <DataGrid x:Name="EventsGrid"
                      ItemsSource="{Binding Events}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding OccurredAt.LocalDateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="175" />
                    <DataGridTextColumn Header="Event" Binding="{Binding Kind}" Width="135" />
                    <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="115" />
                    <DataGridTextColumn Header="Environment" Binding="{Binding EnvironmentKey}" Width="180" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="105" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="95" />
                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="105" ElementStyle="{StaticResource StatusCell}" />
                    <DataGridTextColumn Header="Object" Binding="{Binding ObjectId}" Width="150" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyEventsText"
                       Text="Select an operation to see its recorded events."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       IsHitTestVisible="False" />
        </Grid>
    </Grid>
</ui:FluentWindow>
