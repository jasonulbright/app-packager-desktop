<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.OneClickPlanWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="One Click"
    Width="1336" Height="625"
    MinWidth="1100" MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Ideal"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- A row whose texts the mock sets lower replaces this. -->
            <TranslateTransform x:Key="CellShift" />
            <TranslateTransform x:Key="FlowShift" />
            <TranslateTransform x:Key="MarkShift" />
            <TranslateTransform x:Key="NameShift" />
            <sys:Double x:Key="CheckDrop">0</sys:Double>
            <sys:Double x:Key="RowContent">0</sys:Double>
            <Style x:Key="WrapCell" TargetType="TextBlock">
                <Setter Property="RenderTransform" Value="{DynamicResource CellShift}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,2" />
            </Style>
            <Style x:Key="PlanRow" TargetType="DataGridRow" BasedOn="{StaticResource Mk.GridRow}">
                
                <Setter Property="DetailsVisibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DetailsOpen}" Value="True">
                        <Setter Property="DetailsVisibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SignalText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="good">
                        <Setter Property="Foreground" Value="{DynamicResource MkOkBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OptionalNotice" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,13,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource MkBadBrush}" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <mk:DialogFrame Title="One Click">
            <mk:DialogFrame.Body>
                <!-- The table takes the room that the parts above it leave, and never less than a few rows. Where the window cannot give that,
                     the code puts the body into a scroll area. It is not in one before, because a scroll area changes how its text is drawn. -->
                <Border x:Name="BodyHost">
                <controls:LeastFillPanel x:Name="pnlBody">
                    <!-- The title, the count line and the way to the saved settings. -->
                    <DockPanel Height="51">
                        <Button x:Name="btnOneClickSettings" DockPanel.Dock="Right" Style="{StaticResource Mk.Button}" mk:Mk.Icon="settings" Content="One Click settings"
                                VerticalAlignment="Center" Click="Settings_Click" IsEnabled="{Binding CanClose}" AutomationProperties.AutomationId="btnOneClickSettings"
                                ToolTip="Closes this plan and opens Settings, One Click, where the action, the destinations and the tracked applications are saved. Select One Click again to plan with the saved values. The button is off while a run is active." />
                        <StackPanel>
                            <mk:TrackedText Style="{StaticResource Mk.H2}" Text="Review One Click plan" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock Text="{Binding PlanLine}" Margin="0,5,0,-1" Height="21" Foreground="{DynamicResource MkMutedBrush}" ToolTip="{Binding PlanDetail}"
                                       AutomationProperties.AutomationId="txtPlanHeader" />
                        </StackPanel>
                    </DockPanel>

                    <!-- The action of the run, the systems and the steps. -->
                    <Border Style="{StaticResource Mk.Panel}" Margin="0,13,0,0" Padding="16">
                        <StackPanel>
                            <DockPanel Height="35">
                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding SystemSignals}" Focusable="False" IsTabStop="False" VerticalAlignment="Center"
                                              Visibility="{Binding IsPublishRun, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtPlanSystems" AlternationCount="3">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel x:Name="Signal" Orientation="Horizontal" Margin="8,0,0,0">
                                                <mk:Ico Glyph="{Binding Icon}" Foreground="{Binding Foreground, ElementName=Words}" />
                                                <TextBlock x:Name="Words" Text="{Binding Text}" Style="{StaticResource SignalText}" Margin="6,-1,0,0">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform Y="1" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- The widths of the mock are fractions: the third signal rounds to the next pixel. -->
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" Value="0">
                                                    <Setter TargetName="Signal" Property="Margin" Value="7,0,1,0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" Value="1">
                                                    <Setter TargetName="Signal" Property="Margin" Value="7,0,1,0" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CheckSiteText}" VerticalAlignment="Center" Foreground="{DynamicResource MkMutedBrush}"
                                           Visibility="{Binding IsCheckRun, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Action" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MkTextBrush}" />
                                    <ComboBox x:Name="cboPlanAction" Style="{StaticResource Mk.ComboBox}" Height="35" MinWidth="254" Margin="8,0,0,0"
                                              ItemsSource="{Binding ActionChoices}" SelectedItem="{Binding ActionChoice, Mode=OneWay}" IsEnabled="{Binding CanPlanOnly}"
                                              SelectionChanged="Action_SelectionChanged" AutomationProperties.AutomationId="txtPlanAction" AutomationProperties.Name="One Click action"
                                              ToolTip="The action is a saved setting. Choosing another one opens Settings, One Click, where you save it." />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="lstFlow" ItemsSource="{Binding FlowSteps}" Margin="0,14,0,0" Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="txtPlanFlow">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Height="18">
                                            <mk:Ico Glyph="arrow_right" FontSize="15" Margin="5,0,5,0"
                                                    Visibility="{Binding HasArrow, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Text}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MkTextBrush}" RenderTransform="{DynamicResource FlowShift}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Mk.Notice}" Margin="0,13,0,0" Height="38.5"
                            Visibility="{Binding ShowsHint, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel ToolTip="{Binding PlanDetail}">
                            <mk:Ico DockPanel.Dock="Left" Glyph="info" Foreground="{DynamicResource MkTextBrush}" FontSize="16" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock VerticalAlignment="Center" Margin="0,-1,0,0" Foreground="{DynamicResource MkTextBrush}" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="txtPlanHint"><Run FontWeight="Bold" Text="Changes apply to this run." /> Review destination overrides and application changes before you start.</TextBlock>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Mk.Banner}" Margin="0,13,0,0" Height="43"
                            Visibility="{Binding IsCheckRun, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel ToolTip="{Binding PlanDetail}">
                            <mk:Ico DockPanel.Dock="Left" Glyph="info" Foreground="{DynamicResource MkTextBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CheckBanner}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MkTextBrush}" />
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="txtPlanBlocking" Text="{Binding BlockingText}" Style="{StaticResource OptionalNotice}"
                               AutomationProperties.AutomationId="txtPlanBlocking" Visibility="{Binding HasBlocking, Converter={StaticResource BoolToVisibility}}" />

                    <!-- What the run risks, in the place of the general note; then the state of the run and a comment that is not empty. A plan with none
                         of them is the window of the mock. -->
                    <Border Margin="0,13,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Mk.Notice.Warn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RiskText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding RiskText}" TextWrapping="Wrap" Foreground="{DynamicResource MkTextBrush}" ToolTip="{Binding RiskDetail}"
                                   AutomationProperties.AutomationId="txtPlanRisk" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <TextBlock Text="{Binding StatusLine}" TextWrapping="Wrap" Margin="0,13,0,0" Foreground="{DynamicResource MkTextBrush}"
                               AutomationProperties.AutomationId="txtPlanSummary" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusLine}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel Margin="0,13,0,0" Visibility="{Binding ShowsComment, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Administrative comment" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MkTextBrush}" />
                        <TextBox x:Name="txtPlanComment" Style="{StaticResource Mk.TextBox}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanPlanOnly}" AutomationProperties.AutomationId="txtPlanComment" AutomationProperties.Name="Administrative comment"
                                 ToolTip="The comment that the run writes to each published application. It may stay empty." />
                    </DockPanel>

                    <!-- The grid takes the room that is left and scrolls in it. A short plan stands at the top, with the note directly under it. -->
                    <Grid VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <Border Style="{StaticResource Mk.Panel}" Margin="0,13,0,0" VerticalAlignment="Top">
                        <DataGrid x:Name="gridPlan" Style="{StaticResource Mk.Grid}" Background="Transparent" RowStyle="{StaticResource PlanRow}"
                                  ItemsSource="{Binding Rows}" SelectionMode="Single" AutomationProperties.AutomationId="gridPlan" AutomationProperties.Name="One Click plan">
                            <DataGrid.ContextMenu>
                                <ContextMenu Opened="PlanMenu_Opened" />
                            </DataGrid.ContextMenu>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ChangeDetails}" Margin="24,4,8,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MkTextBrush}" />
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="colInclude" Header="Include" Width="65.4*" MinWidth="60" SortMemberPath="Include">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource Mk.CheckBox}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0" mk:Mk.IconDrop="{DynamicResource CheckDrop}"
                                                      IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      IsEnabled="{Binding DataContext.CanPlanOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      ToolTip="Include this application in this run. The choice applies to this run only. You cannot change it while a run is active."
                                                      AutomationProperties.Name="{Binding Application, StringFormat=Include {0}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="colApplication" Header="Application" Width="250.1*" MinWidth="160" SortMemberPath="Application">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel Background="Transparent" ToolTip="{Binding SourceToolTip}" MinHeight="{DynamicResource RowContent}">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource Mk.AppMark}" RenderTransform="{DynamicResource MarkShift}">
                                                    <TextBlock Style="{StaticResource Mk.AppMarkText}" Text="{Binding Mark}" />
                                                </Border>
                                                <TextBlock Text="{Binding Application}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,-1,0,0" TextTrimming="CharacterEllipsis" RenderTransform="{DynamicResource NameShift}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="colPlainApplication" Header="Application" Binding="{Binding Application}" Width="290*" MinWidth="160" IsReadOnly="True"
                                                    ElementStyle="{StaticResource WrapCell}" Visibility="Collapsed" />
                                <DataGridTextColumn x:Name="colVersion" Header="Latest" Binding="{Binding Version}" Width="93*" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource WrapCell}" />
                <DataGridTemplateColumn x:Name="colMecm" Header="ConfigMgr" Width="125.2*" MinWidth="64" SortMemberPath="ConfigMgr">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource Mk.CheckBox}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,5,-1,0" mk:Mk.IconDrop="{DynamicResource CheckDrop}"
                                      IsChecked="{Binding ConfigMgr, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsEnabled="{Binding DataContext.ConfigMgrInUse, RelativeSource={RelativeSource AncestorType=DataGrid}}" ToolTip="Publish this application to ConfigMgr in this run."
                                      AutomationProperties.Name="{Binding Application, StringFormat=ConfigMgr for {0}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="colWsus" Header="WSUS" Width="85.5*" MinWidth="64" SortMemberPath="Wsus">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource Mk.CheckBox}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0" mk:Mk.IconDrop="{DynamicResource CheckDrop}"
                                      IsChecked="{Binding Wsus, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsEnabled="{Binding DataContext.WsusInUse, RelativeSource={RelativeSource AncestorType=DataGrid}}" ToolTip="Publish this application to WSUS in this run."
                                      AutomationProperties.Name="{Binding Application, StringFormat=WSUS for {0}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="colIntune" Header="Intune" Width="89.3*" MinWidth="64" SortMemberPath="Intune">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource Mk.CheckBox}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,5,0,0" mk:Mk.IconDrop="{DynamicResource CheckDrop}"
                                      IsChecked="{Binding Intune, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsEnabled="{Binding DataContext.IntuneInUse, RelativeSource={RelativeSource AncestorType=DataGrid}}" ToolTip="Publish this application to Intune in this run."
                                      AutomationProperties.Name="{Binding Application, StringFormat=Intune for {0}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="colLast" Header="Last published" Binding="{Binding LastPublishedShown}" Width="187.5*" MinWidth="116" IsReadOnly="True"
                                                    ElementStyle="{StaticResource WrapCell}" />
                                <DataGridTextColumn x:Name="colPlanned" Header="Planned action / reason" Binding="{Binding PlannedLine}" Width="400*" MinWidth="200" IsReadOnly="True"
                                                    ElementStyle="{StaticResource WrapCell}" />
                                <DataGridTextColumn x:Name="colWord" Header="Planned action" Binding="{Binding PlannedWord}" Width="157*" MinWidth="110" IsReadOnly="True"
                                                    ElementStyle="{StaticResource WrapCell}" Visibility="Collapsed" />
                <DataGridTextColumn x:Name="colStep" Header="Step" Binding="{Binding Step}" Width="130" IsReadOnly="True" Visibility="Collapsed"
                                    ElementStyle="{StaticResource WrapCell}" />
                <DataGridTextColumn x:Name="colResultMecm" Header="ConfigMgr result" Binding="{Binding ResultConfigMgr}" Width="1.2*" MinWidth="180"
                                    IsReadOnly="True" Visibility="Collapsed" ElementStyle="{StaticResource WrapCell}" />
                <DataGridTextColumn x:Name="colResultWsus" Header="WSUS result" Binding="{Binding ResultWsus}" Width="1.2*" MinWidth="180"
                                    IsReadOnly="True" Visibility="Collapsed" ElementStyle="{StaticResource WrapCell}" />
                <DataGridTextColumn x:Name="colResultIntune" Header="Intune result" Binding="{Binding ResultIntune}" Width="1.2*" MinWidth="180"
                                    IsReadOnly="True" Visibility="Collapsed" ElementStyle="{StaticResource WrapCell}" />
                                <DataGridTextColumn x:Name="colReason" Header="Reason" Binding="{Binding Reason}" Width="320*" MinWidth="170" IsReadOnly="True"
                                                    ElementStyle="{StaticResource WrapCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <!-- The note of this run and the box that ignores the cadence. -->
                    <DockPanel Grid.Row="1" Height="29" Margin="0,13,0,0">
                        <CheckBox x:Name="chkForce" DockPanel.Dock="Right" Style="{StaticResource Mk.CheckBox}" Content="{Binding ForceText}" VerticalAlignment="Center"
                                  IsChecked="{Binding Force}" IsEnabled="{Binding CanPlanOnly}" AutomationProperties.AutomationId="chkForce"
                                  ToolTip="Ignores the publish cadence and publishes again, even when the application is not due. You cannot change it while a run is active." />
                        <TextBlock x:Name="txtFootNote" Text="{Binding FootNote}" Style="{StaticResource Mk.Help}" Margin="0,4,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>

                    </Grid>
                </controls:LeastFillPanel>
                </Border>
            </mk:DialogFrame.Body>
            <!-- The report commands stand apart at the left (R-14); the buttons that start or end the work stand at the right, Run last (R-13). -->
            <mk:DialogFrame.FootLeft>
                <StackPanel Orientation="Horizontal" UseLayoutRounding="False">
                    <Button x:Name="btnPlanOnly" Style="{StaticResource Mk.Button}" mk:Mk.Icon="document" Content="Plan only" Command="{Binding PlanOnlyCommand}"
                            ToolTip="Writes the plan as a report without running anything." AutomationProperties.AutomationId="btnPlanOnly" />
                    <Button x:Name="btnHistory" Style="{StaticResource Mk.Button}" mk:Mk.Icon="history" Content="Run history" Margin="8,0,0,0" Click="History_Click"
                            ToolTip="Lists the reports of earlier runs." AutomationProperties.AutomationId="btnHistory" />
                    <Button x:Name="btnOpenReport" Style="{StaticResource Mk.Button}" mk:Mk.Icon="open" Content="Open report" Margin="8,0,0,0" Click="OpenReport_Click"
                            IsEnabled="{Binding CanOpenReport}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="btnOpenReport"
                            ToolTip="Opens the latest report of this window. The button is available after a plan or a run wrote a report." />
                    <Button x:Name="btnResults" Style="{StaticResource Mk.Button}" mk:Mk.Icon="list" Content="Results" Margin="8,0,0,0" Click="Results_Click"
                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="btnResults"
                            ToolTip="Shows the result of each application and system of the finished run." />
                    <Button x:Name="btnReviewFailed" Style="{StaticResource Mk.Button}" mk:Mk.Icon="arrow_right" Content="Review failed application" Margin="8,0,0,0" Click="ReviewFailed_Click"
                            Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="btnReviewFailed"
                            ToolTip="Selects the first application that failed in this run." />
                </StackPanel>
            </mk:DialogFrame.FootLeft>
            <mk:DialogFrame.FootRight>
                <StackPanel Orientation="Horizontal" UseLayoutRounding="False">
                    <Button x:Name="btnCancelRun" Style="{StaticResource Mk.Button}" mk:Mk.Icon="dismiss" Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="btnCancelRun"
                            ToolTip="Stop the run that is active." />
                    <Button x:Name="btnClose" Style="{StaticResource Mk.Button}" Content="Close" Click="Close_Click" IsEnabled="{Binding CanClose}" AutomationProperties.AutomationId="btnClose" />
                    <Button x:Name="btnRun" Style="{StaticResource Mk.Button.Primary}" mk:Mk.Icon="play" Content="{Binding RunText}" Margin="8,0,0,0" Command="{Binding RunCommand}"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="btnRun"
                            ToolTip="Runs One Click for the included applications and destinations. The button is disabled while a run is active or when no application is included." />
                </StackPanel>
            </mk:DialogFrame.FootRight>
        </mk:DialogFrame>

        <ui:ContentDialogHost x:Name="PromptHost" />
    </Grid>
</ui:FluentWindow>
