<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.RemovalConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Remove deployment"
    Width="520" SizeToContent="Height"
    MinWidth="420"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Remove deployment" ShowMinimize="False" ShowMaximize="False" />

        <TextBlock Grid.Row="1" x:Name="txtQuestion" Margin="16,4,16,16" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   AutomationProperties.AutomationId="txtRemovalQuestion" />

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,10">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button x:Name="btnRemove" Content="_Remove deployment" MinWidth="150" Margin="0,0,8,0" Click="OnRemoveClick"
                           AutomationProperties.AutomationId="btnRemovalConfirm" />
                <ui:Button x:Name="btnCancel" Content="_Cancel" MinWidth="100" Appearance="Primary" IsDefault="True" IsCancel="True"
                           AutomationProperties.AutomationId="btnRemovalCancel" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
