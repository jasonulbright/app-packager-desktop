<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:ApplicationPackagerUI.Views.Pages"
    Title="App Packager Desktop"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Loaded="FluentWindow_Loaded"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            Title="App Packager Desktop" />

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="220">

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Settings"
                    ToolTip="Open Settings: the connections, folders, packaging defaults, supersedence and security options of the application."
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>

        </ui:NavigationView>

        <!-- The footer of every ConfigMgr tool of the suite: the site code and the site server, lower right, one font, size and style in both themes (only the color follows the theme).
             Here it is also the site switcher: a click lists the known sites and Add site. The site code and the server are edited in Settings. -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,2">
            <ui:Button x:Name="btnSiteSwitcher" HorizontalAlignment="Right" Appearance="Transparent" Padding="8,2" Click="SiteSwitcher_Click"
                       AutomationProperties.AutomationId="btnSiteSwitcher" AutomationProperties.Name="{Binding FooterText, StringFormat=Site switcher. {0}}"
                       ToolTip="The active site. Select it to switch to another site or to add a site. Each site keeps its own settings and data. The site cannot change while a run is active.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="txtSiteFooter" Text="{Binding FooterText}" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" FontWeight="Normal" FontStyle="Normal" TextDecorations="{x:Null}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtSiteFooter"
                               AutomationProperties.Name="Site code and site server" />
                    <ui:SymbolIcon Symbol="ChevronUp16" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
