<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:ApplicationPackagerUI.Views.Pages"
    Title="Application Packager"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Loaded="FluentWindow_Loaded"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            Title="Application Packager" />

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="220">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Packages"
                    Icon="{ui:SymbolIcon Box24}"
                    TargetPageType="{x:Type pages:PackagesPage}" />
                <ui:NavigationViewItem
                    Content="Applications"
                    Icon="{ui:SymbolIcon Apps24}"
                    TargetPageType="{x:Type pages:ApplicationsPage}" />
                <ui:NavigationViewItem
                    Content="Add App"
                    Icon="{ui:SymbolIcon Add24}"
                    TargetPageType="{x:Type pages:AddAppPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Settings"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>

        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
