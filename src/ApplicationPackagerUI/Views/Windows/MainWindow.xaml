<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:ApplicationPackagerUI.Views.Pages"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock"
    Title="App Packager Desktop"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Loaded="FluentWindow_Loaded"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI"
    FontSize="14"
    TextOptions.TextFormattingMode="Ideal"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Shell.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A button of the title bar: 46 px wide, a 13 px glyph. -->
            <Style x:Key="Mk.SystemButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Background="{TemplateBinding Background}">
                                <mk:Ico Glyph="{TemplateBinding Tag}" FontSize="13" Width="46" Height="13" Foreground="{TemplateBinding Foreground}" Margin="0,-2,0,0" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkSubBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The right text of the status bar is also the site switcher: it looks like the text of the mock. -->
            <Style x:Key="Mk.FooterSwitcher" TargetType="ui:Button">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource MkMutedBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Mk.Focus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <!-- .mock { grid-template: 40px 1fr 32px / 216px 1fr } -->
    <Grid x:Name="Frame" Background="{DynamicResource MkBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MkLineBrush}" Background="{DynamicResource MkBaseBrush}"
                SnapsToDevicePixels="True" AutomationProperties.AutomationId="pnlTitleBar">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="btnMinimize" Style="{StaticResource Mk.SystemButton}" Tag="subtract" Click="Minimize_Click" AutomationProperties.Name="Minimize" ToolTip="Minimize the window." AutomationProperties.AutomationId="btnMinimize" />
                    <Button x:Name="btnMaximize" Style="{StaticResource Mk.SystemButton}" Tag="square" Click="Maximize_Click" AutomationProperties.Name="Maximize" ToolTip="Maximize the window." AutomationProperties.AutomationId="btnMaximize" />
                    <Button x:Name="btnCloseWindow" Style="{StaticResource Mk.SystemButton}" Tag="dismiss" Click="CloseWindow_Click" AutomationProperties.Name="Close" ToolTip="Close the window." AutomationProperties.AutomationId="btnCloseWindow" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <mk:Ico Glyph="box" Foreground="{DynamicResource MkTextBrush}">
                        <mk:Ico.RenderTransform>
                            <TranslateTransform Y="1" />
                        </mk:Ico.RenderTransform>
                    </mk:Ico>
                    <TextBlock Text="App Packager Desktop" FontSize="12" Margin="9,2,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MkTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            Style="{StaticResource Mk.Navigation}"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="216">

            <!-- The context strip (overhaul V1, phase 2): the site, the host and the state of each system, on every page. -->
            <ui:NavigationView.Header>
                <controls:ContextStrip x:Name="ContextStripHost" />
            </ui:NavigationView.Header>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Settings"
                    mk:Mk.Icon="settings"
                    Style="{StaticResource Mk.NavItem}"
                    ToolTip="Open Settings: the connections, folders, packaging defaults, supersedence and security options of the application."
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" Margin="216,0,0,0" />

        <!-- .statusbar { border-top; font-size:12px; padding 0 18px; color:muted } The right text is the site code and the site server of the
             suite footer and the site switcher: a click lists the known sites and Add site. -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MkLineBrush}" Padding="18,0" Background="{DynamicResource MkBaseBrush}" SnapsToDevicePixels="True">
            <DockPanel>
                <ui:Button x:Name="btnSiteSwitcher" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mk.FooterSwitcher}" Click="SiteSwitcher_Click"
                           AutomationProperties.AutomationId="btnSiteSwitcher" AutomationProperties.Name="{Binding FooterText, StringFormat=Site switcher. {0}}"
                           ToolTip="The active site. Select it to switch to another site or to add a site. Each site keeps its own settings and data. The site cannot change while a run is active.">
                    <TextBlock x:Name="txtSiteFooter" Text="{Binding FooterText}" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" FontWeight="Normal" FontStyle="Normal" TextDecorations="{x:Null}"
                               Foreground="{DynamicResource MkMutedBrush}" AutomationProperties.AutomationId="txtSiteFooter"
                               AutomationProperties.Name="Site code and site server" />
                </ui:Button>
                <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,24,0"
                           Foreground="{DynamicResource MkMutedBrush}" AutomationProperties.AutomationId="txtStatus" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- .scrim: the dim layer over the workspace while a window of the app is open on top of it. It takes no clicks: a modal window blocks the
             input itself, and beside a window that is not modal the main window stays usable. -->
        <Border x:Name="Scrim" Grid.Row="1" Background="{DynamicResource MkScrimBrush}" Visibility="Collapsed" IsHitTestVisible="False" />

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
