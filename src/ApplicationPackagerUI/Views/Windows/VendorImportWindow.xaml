<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.VendorImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="1000" Height="760"
    MinWidth="760" MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/DetailBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <ScrollViewer x:Name="scrollImport" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,8">
            <StackPanel>
                <TextBlock Text="Address of the feed (HTTPS)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtFeedAddress" Grid.Column="0" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" AutomationProperties.AutomationId="txtFeedAddress" />
                    <ui:Button x:Name="btnFetchFeed" Grid.Column="2" Content="Fetch" MinWidth="100" Appearance="Primary"
                               FontWeight="SemiBold" Command="{Binding FetchCommand}" AutomationProperties.AutomationId="btnFetchFeed" />
                    <ui:Button x:Name="btnCancelFetch" Grid.Column="4" Content="Cancel Fetch" MinWidth="110" FontWeight="SemiBold"
                               Command="{Binding CancelFetchCommand}" AutomationProperties.AutomationId="btnCancelFetch" />
                </Grid>

                <TextBlock Text="Pinned SHA-256 of the document (optional, from the vendor's other channel)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="txtPinnedDigest" Text="{Binding PinnedDigest, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                         VerticalContentAlignment="Center" FontFamily="Consolas" AutomationProperties.AutomationId="txtPinnedDigest" />

                <TextBlock Text="Pinned publisher (optional): subject | issuer of the code-signing certificate, or key: and the SHA-256 of its public key" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBox x:Name="txtPinnedPublisher" Text="{Binding PinnedPublisher, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                         VerticalContentAlignment="Center" AutomationProperties.AutomationId="txtPinnedPublisher" />

                <TextBlock x:Name="txtImportStatus" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="txtImportStatus" />

                <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Source" Margin="0,0,0,4" />
                    <TextBox x:Name="txtImportSource" Text="{Binding SourceText, Mode=OneWay}" Style="{StaticResource DetailBox}" MaxHeight="120" Margin="0,0,0,8"
                             AutomationProperties.Name="Source of the document, read only" AutomationProperties.AutomationId="txtImportSource" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vendor" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Vendor, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                     AutomationProperties.AutomationId="txtImportVendor" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Feed Id (names the folder of the definitions)" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FeedId, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                     AutomationProperties.AutomationId="txtImportFeedId" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Definitions" Margin="0,0,0,4" />
                    <DataGrid x:Name="gridImportRows" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              SelectionMode="Single" GridLinesVisibility="Horizontal" MinHeight="120" MaxHeight="220" Margin="0,0,0,8"
                              PreviewMouseWheel="OnGridPreviewMouseWheel" AutomationProperties.AutomationId="gridImportRows">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Replace shipped" Width="140" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  Visibility="{Binding IsShippedConflict, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  AutomationProperties.Name="{Binding Id}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="160" IsReadOnly="True" />
                            <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="*" MinWidth="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Installer" Binding="{Binding InstallerType}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Hosts" Binding="{Binding Hosts}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="Payload hash" Binding="{Binding PayloadHash}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="260" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="The definition (read only)" Margin="0,0,0,4" />
                    <TextBox x:Name="txtImportDetails" Text="{Binding SelectedRow.Details, Mode=OneWay}" Style="{StaticResource DetailBox}" FontFamily="Consolas"
                             MinHeight="100" MaxHeight="200" Margin="0,0,0,8"
                             AutomationProperties.Name="The selected definition, read only" AutomationProperties.AutomationId="txtImportDetails" />

                    <WrapPanel Margin="0,0,0,8">
                        <ui:Button x:Name="btnUnblockSelected" Content="Unblock Selected" Margin="0,0,8,8" Command="{Binding UnblockSelectedCommand}"
                                   ToolTip="Shows the full text of every script and command of the selected definition with its SHA-256, and unblocks the definition after a confirmation. A path to a local file or a bootstrapper is never unblocked."
                                   AutomationProperties.AutomationId="btnUnblockSelected" />
                        <ui:Button x:Name="btnBlockAgain" Content="Block Again" Margin="0,0,8,8" Command="{Binding BlockAgainCommand}"
                                   AutomationProperties.AutomationId="btnBlockAgain" />
                    </WrapPanel>

                    <TextBlock Text="Findings" Margin="0,0,0,4" />
                    <TextBox x:Name="txtImportFindings" Text="{Binding FindingsText, Mode=OneWay}" Style="{StaticResource DetailBox}" MaxHeight="120" Margin="0,0,0,8"
                             AutomationProperties.Name="Findings of the validation, read only" AutomationProperties.AutomationId="txtImportFindings" />

                    <CheckBox x:Name="chkConfirmNotVerified" IsChecked="{Binding ConfirmedNotVerified}" Margin="0,0,0,8"
                              Visibility="{Binding NeedsNotVerifiedConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Content="I confirm the state of this document: Definition document NOT verified. Nothing proves where it came from."
                              AutomationProperties.AutomationId="chkConfirmNotVerified" />
                </StackPanel>

                <TextBlock Text="Imported feeds" Margin="0,8,0,4" />
                <DataGrid x:Name="gridFeeds" ItemsSource="{Binding Feeds}" SelectedItem="{Binding SelectedFeed}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal" MinHeight="80" MaxHeight="160" Margin="0,0,0,8"
                          PreviewMouseWheel="OnGridPreviewMouseWheel" AutomationProperties.AutomationId="gridFeeds">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Feed Id" Binding="{Binding FeedId}" Width="160" />
                        <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="180" />
                        <DataGridTextColumn Header="Definitions" Binding="{Binding Count}" Width="100" />
                        <DataGridTextColumn Header="Trust" Binding="{Binding Trust}" Width="220" />
                        <DataGridTextColumn Header="Imported" Binding="{Binding FetchedAt}" Width="140" />
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" MinWidth="160" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,0,0,8">
                    <ui:Button x:Name="btnCheckForUpdate" Content="Check for Update" Margin="0,0,8,8" Command="{Binding CheckForUpdateCommand}"
                               ToolTip="Fetches the selected feed again (at its stored address, or at the address above) and shows what changed. Nothing is stored until you select Apply Update."
                               AutomationProperties.AutomationId="btnCheckForUpdate" />
                    <ui:Button x:Name="btnApplyUpdate" Content="Apply Update" Margin="0,0,8,8" Appearance="Primary" Command="{Binding ApplyUpdateCommand}"
                               AutomationProperties.AutomationId="btnApplyUpdate" />
                    <ui:Button x:Name="btnRemoveFeed" Content="Remove Feed" MinWidth="130" Margin="0,0,8,8" Appearance="Danger"
                               Command="{Binding RemoveFeedCommand}" AutomationProperties.AutomationId="btnRemoveFeed" />
                </WrapPanel>
                <TextBlock Text="Access to an authenticated feed" Margin="0,8,0,4" />
                <TextBlock Text="{Binding AccessStatus}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtAccessStatus" />
                <DataGrid x:Name="gridAccess" ItemsSource="{Binding Access}" SelectedItem="{Binding SelectedAccess}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal" MinHeight="60" MaxHeight="140" Margin="0,0,0,8"
                          PreviewMouseWheel="OnGridPreviewMouseWheel" AutomationProperties.AutomationId="gridAccess">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Entry" Binding="{Binding Id}" Width="160" />
                        <DataGridTextColumn Header="Bound host" Binding="{Binding Host}" Width="220" />
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="140" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" MinWidth="120" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,0,0,4">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Entry id" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Width="160" Text="{Binding AccessId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="txtAccessId" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Address of the feed (binds the host)" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Width="320" Text="{Binding AccessAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="txtAccessAddress" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Method" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox Width="160" SelectedIndex="{Binding AccessMethod}" AutomationProperties.AutomationId="cboAccessMethod">
                            <ComboBoxItem Content="Key in a header" />
                            <ComboBoxItem Content="Basic" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8" Visibility="{Binding AccessIsHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Header name" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Width="160" Text="{Binding AccessHeader, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="txtAccessHeader" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8" Visibility="{Binding AccessIsBasic, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="User name" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Width="160" Text="{Binding AccessUser, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="txtAccessUser" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="Key or password" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:PasswordBox Width="240" Password="{Binding AccessSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="pwdAccessSecret" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                    <ui:Button x:Name="btnAddAccess" Content="Add and Test" Margin="0,0,8,8" Command="{Binding AddAccessCommand}" AutomationProperties.AutomationId="btnAddAccess" />
                    <ui:Button x:Name="btnRotateAccess" Content="Rotate Secret" Margin="0,0,8,8" Command="{Binding RotateAccessCommand}"
                               ToolTip="Replaces the secret of the selected entry with the one in the box." AutomationProperties.AutomationId="btnRotateAccess" />
                    <ui:Button x:Name="btnRemoveAccess" Content="Remove Access" Margin="0,0,8,8" Appearance="Danger" Command="{Binding RemoveAccessCommand}"
                               AutomationProperties.AutomationId="btnRemoveAccess" />
                </WrapPanel>
                <StackPanel Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Update of the selected feed (read only)" Margin="0,0,0,4" />
                    <TextBox x:Name="txtUpdateDiff" Text="{Binding UpdateText, Mode=OneWay}" Style="{StaticResource DetailBox}" FontFamily="Consolas" MinHeight="100" MaxHeight="240"
                             Margin="0,0,0,8" AutomationProperties.Name="Changes of the update, read only" AutomationProperties.AutomationId="txtUpdateDiff" />
                    <CheckBox x:Name="chkConfirmUpdateNotVerified" IsChecked="{Binding ConfirmedUpdateNotVerified}" Margin="0,0,0,8"
                              Visibility="{Binding NeedsUpdateNotVerifiedConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Content="I confirm the state of this document: Definition document NOT verified. Nothing proves where it came from."
                              AutomationProperties.AutomationId="chkConfirmUpdateNotVerified" />
                    <CheckBox x:Name="chkConfirmOlder" IsChecked="{Binding ConfirmedOlder}" Margin="0,0,0,8"
                              Visibility="{Binding NeedsOlderConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Content="I want the older document: its Updated is earlier than the stored one."
                              AutomationProperties.AutomationId="chkConfirmOlder" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8"
                KeyboardNavigation.TabNavigation="Local">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button x:Name="btnImportFeed" Content="Import" MinWidth="100" Margin="0,0,8,0" Appearance="Primary" FontWeight="SemiBold"
                           Command="{Binding ImportCommand}" AutomationProperties.AutomationId="btnImportFeed" />
                <ui:Button x:Name="btnCloseImport" Content="_Close" MinWidth="100" FontWeight="SemiBold" IsCancel="True"
                           Command="{Binding CloseCommand}" AutomationProperties.AutomationId="btnCloseImport" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
