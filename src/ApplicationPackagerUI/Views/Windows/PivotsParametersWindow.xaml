<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.PivotsParametersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="680" Height="520"
    MinWidth="480" MinHeight="320"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="ParameterVisibility" />
    </ui:FluentWindow.Resources>

    <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <TextBlock Grid.Row="1" Margin="16,4,16,8" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   AutomationProperties.AutomationId="txtParametersSummary" AutomationProperties.LiveSetting="Polite" />

        <ScrollViewer Grid.Row="2" Margin="16,0,16,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0" AutomationProperties.AutomationId="scrollParameters">
            <ItemsControl x:Name="listParameters" ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.AutomationId="listParameters">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Details, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding HasDescription, Converter={StaticResource ParameterVisibility}}" />
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" AutomationProperties.Name="{Binding Name}" />
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Visibility="{Binding HasError, Converter={StaticResource ParameterVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8"
                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button x:Name="btnOk" Content="OK" MinWidth="100" Margin="0,0,8,0" Appearance="Primary" IsDefault="True" Command="{Binding OkCommand}"
                           AutomationProperties.AutomationId="btnParametersOk" />
                <ui:Button x:Name="btnCancel" Content="_Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnParametersCancel" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
