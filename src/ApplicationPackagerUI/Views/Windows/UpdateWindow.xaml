<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Check for updates"
    Width="640" Height="520"
    MinWidth="520" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Check for updates" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,4,16,8">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Installed version" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVersion}" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="txtUpdateCurrent" />
                <TextBlock Grid.Row="1" Text="Latest version" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersion}" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="txtUpdateLatest" />
                <TextBlock Grid.Row="2" Text="Release notes" />
                <TextBlock Grid.Row="2" Grid.Column="1">
                    <Hyperlink x:Name="lnkNotes" Click="Notes_Click" AutomationProperties.AutomationId="lnkUpdateNotes">Open the release page</Hyperlink>
                </TextBlock>
            </Grid>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"
                       AutomationProperties.AutomationId="txtUpdateStatus"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,8,0,0"
                         Visibility="{Binding Busy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <TextBox Grid.Row="2" Margin="16,0,16,8" Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                 AutomationProperties.AutomationId="txtUpdateNotes" AutomationProperties.Name="Release notes" />

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button Content="Check _again" MinWidth="110" Margin="0,0,8,0" Command="{Binding CheckCommand}"
                           AutomationProperties.AutomationId="btnUpdateCheck" />
                <ui:Button Content="_Download" MinWidth="110" Margin="0,0,8,0" Command="{Binding DownloadCommand}"
                           ToolTip="Download the installer and check its checksum and signature. Nothing starts."
                           AutomationProperties.AutomationId="btnUpdateDownload" />
                <ui:Button Content="_Install and close" Appearance="Primary" MinWidth="140" Margin="0,0,8,0" Command="{Binding InstallCommand}"
                           ToolTip="Close this app and run the installer."
                           AutomationProperties.AutomationId="btnUpdateInstall" />
                <ui:Button Content="C_lose" MinWidth="90" IsCancel="True" Click="Close_Click"
                           AutomationProperties.AutomationId="btnUpdateClose" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
