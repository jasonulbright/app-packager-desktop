<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.WorkbenchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    Title="Workbench"
    Width="1280" Height="820"
    MinWidth="1024" MinHeight="700"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <helpers:StepVisibilityConverter x:Key="SectionVisibility" />
        <helpers:PathToImageConverter x:Key="PathToImage" />
        <helpers:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="WbLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="WbSource" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,8,8" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="WbHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="WbNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="WbField" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="ClearButtonEnabled" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, Converter={x:Static helpers:ToolTipTextConverter.Instance}}" />
        </Style>
        <Style x:Key="WbCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, Converter={x:Static helpers:ToolTipTextConverter.Instance}}" />
        </Style>
        <Style x:Key="WbInlineButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="WbFooterButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="WbCode" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, Converter={x:Static helpers:ToolTipTextConverter.Instance}}" />
        </Style>
        <Style x:Key="WbGutter" TargetType="TextBox" BasedOn="{StaticResource WbCode}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Width" Value="48" />
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="WbDiagnostics" TargetType="ListBox">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="8,3" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WbGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Workbench" />

        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320*" MinWidth="170" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200*" MinWidth="130" MaxWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="240*" MinWidth="160" MaxWidth="240" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Application" Style="{StaticResource WbLabel}" Margin="0,0,8,0" />
            <ComboBox helpers:TemplatePartNames.FromOwner="True" Grid.Column="1" x:Name="cboApplication" AutomationProperties.Name="Application" AutomationProperties.HelpText="The application that the Workbench edits." IsEditable="True" IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True" Margin="0,0,12,0"
                      ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}"
                      DisplayMemberPath="DisplayLabel" TextSearch.TextPath="DisplayLabel"
                      ToolTip="{Binding SelectedApplication.DisplayLabel}" />

            <TextBlock Grid.Column="2" Text="Profile" Style="{StaticResource WbLabel}" Margin="0,0,8,0" />
            <ComboBox Grid.Column="3" x:Name="cboProfile" AutomationProperties.Name="Profile" AutomationProperties.HelpText="The profile of the application that the Workbench edits. Save as... makes a new profile." Margin="0,0,8,0"
                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                      ToolTip="{Binding SelectedProfile.Name}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <ui:Button x:Name="btnOpenDefinition" Content="Open definition..." Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0"
                           Click="OpenDefinition_Click"
                           ToolTip="Lists the definitions made by Add from file, the shipped definitions and the definitions made by Add from web."
                           AutomationProperties.AutomationId="btnOpenDefinition" />
                <ui:Button x:Name="btnProfileRename" Content="Rename" Icon="{ui:SymbolIcon Edit24}" MinWidth="90"
                           Command="{Binding RenameProfileCommand}" ToolTip="Rename the selected custom profile." />
                <ui:DropDownButton x:Name="btnBundle" Content="Bundle" Margin="8,0,0,0"
                                   ToolTip="Export this application with its profiles and assets as a portable bundle, or import a bundle.">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="Export bundle..." Click="ExportBundle_Click" />
                            <MenuItem Header="Import bundle..." Click="ImportBundle_Click" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </StackPanel>
            <TextBlock Grid.Column="5" x:Name="txtSourceType" Text="{Binding SourceTypeText}" Style="{StaticResource WbSource}"
                       Margin="12,0,12,0" ToolTip="Where this application definition comes from." />

            <TextBlock Grid.Column="7" Text="Build" Style="{StaticResource WbLabel}" Margin="0,0,8,0" />
            <ComboBox Grid.Column="8" x:Name="cboBuild" AutomationProperties.Name="Build" AutomationProperties.HelpText="Sealed builds for this application and profile. A publish uses the selected build." ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}"
                      ToolTip="Sealed builds for this application and profile. Package consumes the selected build." />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <Grid Grid.Row="3" x:Name="gridBody" SizeChanged="Body_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="lstSections" AutomationProperties.Name="Sections" BorderThickness="0" Padding="0,8,0,0" Background="Transparent"
                     ItemsSource="{Binding Sections}" SelectedIndex="{Binding SelectedSectionIndex}" SelectionChanged="Sections_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome" Margin="4,2" CornerRadius="4" Background="Transparent">
                                        <Grid>
                                            <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                            <ContentPresenter Margin="12,8,8,8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Border Grid.Column="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2" x:Name="gridEditor" Margin="16,12,16,8">

                <ScrollViewer x:Name="pnlApplication" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibility}, ConverterParameter=0}">
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Display name" Style="{StaticResource WbLabel}" />
                        <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="txtDisplayName" AutomationProperties.Name="Display name" Style="{StaticResource WbField}"
                                    Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the display name for this application.">
                            <AutomationProperties.HelpText>
                                <MultiBinding StringFormat="{}{0}. {1}">
                                    <Binding Path="DisplayNameSource" />
                                    <Binding Path="ToolTip" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </AutomationProperties.HelpText>
                        </ui:TextBox>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="lblDisplayNameSrc" Text="{Binding DisplayNameSource}" Style="{StaticResource WbSource}" />
                        <ui:Button Grid.Row="0" Grid.Column="3" x:Name="btnDisplayNameReset" Content="Reset" Style="{StaticResource WbInlineButton}"
                                   Command="{Binding ResetFieldCommand}" CommandParameter="Application.DisplayName" ToolTip="Remove your override and use the display name from the packager definition." />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Publisher" Style="{StaticResource WbLabel}" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPublisher" AutomationProperties.Name="Publisher" Style="{StaticResource WbField}"
                                    Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the publisher name for this application.">
                            <AutomationProperties.HelpText>
                                <MultiBinding StringFormat="{}{0}. {1}">
                                    <Binding Path="PublisherSource" />
                                    <Binding Path="ToolTip" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </AutomationProperties.HelpText>
                        </ui:TextBox>
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="lblPublisherSrc" Text="{Binding PublisherSource}" Style="{StaticResource WbSource}" />
                        <ui:Button Grid.Row="1" Grid.Column="3" x:Name="btnPublisherReset" Content="Reset" Style="{StaticResource WbInlineButton}"
                                   Command="{Binding ResetFieldCommand}" CommandParameter="Application.Publisher" ToolTip="Remove your override and use the publisher from the packager definition." />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Description" Style="{StaticResource WbLabel}" VerticalAlignment="Top" Margin="0,4,12,8" />
                        <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDescription" AutomationProperties.Name="Description" Height="72" Margin="0,0,0,8"
                                    AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                    ClearButtonEnabled="False"
                                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the description for this application.">
                            <AutomationProperties.HelpText>
                                <MultiBinding StringFormat="{}{0}. {1}">
                                    <Binding Path="DescriptionSource" />
                                    <Binding Path="ToolTip" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </AutomationProperties.HelpText>
                        </ui:TextBox>
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="lblDescriptionSrc" Text="{Binding DescriptionSource}" Style="{StaticResource WbSource}"
                                   VerticalAlignment="Top" Margin="8,8,8,8" />
                        <ui:Button Grid.Row="2" Grid.Column="3" x:Name="btnDescriptionReset" Content="Reset" Style="{StaticResource WbInlineButton}"
                                   VerticalAlignment="Top" Command="{Binding ResetFieldCommand}" CommandParameter="Application.Description" ToolTip="Remove your override and use the description from the packager definition." />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Application title" Style="{StaticResource WbLabel}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboTitleMode" AutomationProperties.Name="Application title" Style="{StaticResource WbCombo}"
                                  ItemsSource="{Binding TitleModeOptions}" SelectedItem="{Binding TitleMode}"
                                  AutomationProperties.AutomationId="cboTitleMode"
                                  ToolTip="Versioned titles create one ConfigMgr application per release; a perpetual title updates the same application.">
                            <AutomationProperties.HelpText>
                                <MultiBinding StringFormat="{}{0}. {1}">
                                    <Binding Path="TitleModeSource" />
                                    <Binding Path="ToolTip" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </AutomationProperties.HelpText>
                        </ComboBox>
                        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="lblTitleModeSrc" Text="{Binding TitleModeSource}" Style="{StaticResource WbSource}" />
                        <ui:Button Grid.Row="3" Grid.Column="3" x:Name="btnTitleModeReset" Content="Reset" Style="{StaticResource WbInlineButton}"
                                   Command="{Binding ResetFieldCommand}" CommandParameter="Application.TitleMode" ToolTip="Remove your override and use the application title mode from the packager definition." />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Profile name" Style="{StaticResource WbLabel}" />
                        <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="txtProfileName" AutomationProperties.Name="Profile name" Style="{StaticResource WbField}"
                                    Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the name that identifies this profile in the profile list." />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Icon" Style="{StaticResource WbLabel}" VerticalAlignment="Top" Margin="0,4,12,8" />
                        <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="64" Height="64" Margin="0,0,12,0" VerticalAlignment="Top" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <Image x:Name="imgIcon" Stretch="Uniform" Margin="4"
                                       Source="{Binding IconPreviewPath, Converter={StaticResource PathToImage}}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="btnIconChoose" Content="Choose file..." Icon="{ui:SymbolIcon FolderOpen24}" Style="{StaticResource WbInlineButton}" MinWidth="110"
                                               Command="{Binding ChooseIconCommand}" ToolTip="Select an image file (PNG, ICO, JPG or BMP) to use as the application icon." />
                                    <ui:Button x:Name="btnIconReset" Content="Reset" Style="{StaticResource WbInlineButton}"
                                               Command="{Binding ResetIconCommand}" ToolTip="Remove your icon override and use the icon from the packager definition." />
                                    <ui:Button x:Name="btnIconRemove" Content="Remove" Icon="{ui:SymbolIcon Delete24}" Style="{StaticResource WbInlineButton}"
                                               Command="{Binding RemoveIconCommand}"
                                               ToolTip="Explicitly publish no icon, rather than inheriting the packager's icon." />
                                </StackPanel>
                                <TextBlock x:Name="txtIconState" Text="{Binding IconStateText}" Style="{StaticResource WbNote}" Margin="0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" x:Name="txtAppNote" Style="{StaticResource WbNote}" Margin="0,8,0,0"
                                   Text="The displayed title is separate from the stable identity: renaming a profile never renames an existing site application, and the output folder keeps the packager name." />

                        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" x:Name="pnlByoSource" Margin="0,4,0,0"
                                    Visibility="{Binding IsByo, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Installer source" Style="{StaticResource WbHeading}" />
                            <TextBlock x:Name="txtByoSource" Text="{Binding ByoSourceText}" Style="{StaticResource WbNote}" />
                            <DataGrid x:Name="gridByoSources" AutomationProperties.Name="Installer source revisions" Style="{StaticResource WbGrid}" ItemsSource="{Binding ByoSources}"
                                      IsReadOnly="True" MaxHeight="190" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Revision" Width="90" Binding="{Binding Revision}" />
                                    <DataGridTextColumn Header="Installer" Width="1.2*" MinWidth="140" Binding="{Binding FileName}" />
                                    <DataGridTextColumn Header="Version" Width="90" Binding="{Binding Version}" />
                                    <DataGridTextColumn Header="Type" Width="60" Binding="{Binding InstallerType}" />
                                    <DataGridTextColumn Header="Architecture" Width="96" Binding="{Binding Architecture}" />
                                    <DataGridTextColumn Header="SHA-256" Width="112" Binding="{Binding ShortSha256}" />
                                    <DataGridTextColumn Header="Added" Width="128" Binding="{Binding Added}" />
                                    <DataGridTextColumn Header="Blocking changes" Width="*" MinWidth="200" Binding="{Binding Flags}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <ui:Button x:Name="btnReplaceInstaller" Content="Replace installer..." Icon="{ui:SymbolIcon ArrowSwap24}" MinWidth="150" HorizontalAlignment="Left"
                                       Command="{Binding ReplaceInstallerCommand}"
                                       ToolTip="Analyze a new installer, compare its identity with the current revision, and add it as the next source revision. Earlier revisions are kept." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="pnlInstall"
                      Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibility}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="110" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Editing" Style="{StaticResource WbLabel}" />
                        <ComboBox Grid.Column="1" x:Name="cboScriptTarget" AutomationProperties.Name="Editing" Style="{StaticResource WbCombo}"
                                  ItemsSource="{Binding ScriptTargetOptions}" SelectedItem="{Binding ScriptTarget}"
                                  ToolTip="Install and uninstall are configured independently." />
                        <TextBlock Grid.Column="2" Text="Mode" Style="{StaticResource WbLabel}" Margin="16,0,12,8" />
                        <ComboBox Grid.Column="3" x:Name="cboInstallMode" AutomationProperties.Name="Mode" Style="{StaticResource WbCombo}"
                                  ItemsSource="{Binding InstallModeOptions}" SelectedItem="{Binding InstallModeDisplay}"
                                  ToolTip="Generated keeps the packager wrapper. Extend generated runs before/after hooks around it as separate processes. Custom replaces the entry command entirely." />
                        <TextBlock Grid.Column="4" x:Name="lblInstallModeSrc" Text="{Binding InstallModeSource}" Style="{StaticResource WbSource}" />
                        <ui:Button Grid.Column="5" x:Name="btnInstallReset" Content="Reset section" Style="{StaticResource WbInlineButton}"
                                   HorizontalAlignment="Left" Margin="12,0,8,8" Command="{Binding ResetInstallSectionCommand}" ToolTip="Remove your overrides on this page for the target you are editing (Install or Uninstall) and use the packager values." />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Effective command" Style="{StaticResource WbLabel}" />
                        <ui:TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtEffectiveCommand" AutomationProperties.Name="Effective command" Style="{StaticResource WbField}"
                                    FontFamily="Cascadia Code, Consolas, Courier New" IsReadOnly="True"
                                    Text="{Binding EffectiveCommand, Mode=OneWay}"
                                    ToolTip="The entry command the build writes for this target. Needs staging until the packager resolves its installer." />
                        <TextBlock Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" x:Name="lblCommandSrc" Text="{Binding CommandSource}" Style="{StaticResource WbSource}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Return codes" Style="{StaticResource WbLabel}" />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="txtReturnCodes" AutomationProperties.Name="Return codes" Style="{StaticResource WbField}"
                                    Text="{Binding ReturnCodes, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="inherit (for example 0,3010=SoftReboot,1641=HardReboot)" ToolTip="Enter return codes separated by commas, for example 0,3010=SoftReboot. Leave the box empty to inherit the packager codes." />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Reboot" Style="{StaticResource WbLabel}" Margin="12,0,12,8" />
                        <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cboRebootPolicy" AutomationProperties.Name="Reboot" Style="{StaticResource WbCombo}"
                                  ItemsSource="{Binding RebootPolicyOptions}" SelectedItem="{Binding RebootPolicy}" ToolTip="Select the restart behavior for the target you are editing. Inherit uses the packager value." />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Working dir" Style="{StaticResource WbLabel}" Margin="12,0,12,8" />
                        <ui:TextBox Grid.Row="1" Grid.Column="5" x:Name="txtWorkingDirectory" AutomationProperties.Name="Working directory" Style="{StaticResource WbField}"
                                    Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="inherit" ToolTip="Enter the working directory for the command. Leave the box empty to inherit the packager value." />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Grid.Column="0" LastChildFill="False" Margin="0,4,0,4">
                            <TextBlock DockPanel.Dock="Left" x:Name="lblScriptCaption" Text="{Binding ScriptCaption}" Style="{StaticResource WbHeading}"
                                       Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" x:Name="pnlFind" Orientation="Horizontal" Visibility="Collapsed">
                                <ui:TextBox x:Name="txtFind" AutomationProperties.Name="Find in script" AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}, Converter={x:Static helpers:ToolTipTextConverter.Instance}}" Width="180" Margin="0,0,4,0" PlaceholderText="Find" KeyDown="FindBox_KeyDown" ToolTip="Enter the text to find in the script you are editing. The search ignores case." />
                                <ui:Button x:Name="btnFindNext" Content="Next" MinWidth="70" Margin="0,0,4,0" Click="FindNext_Click" ToolTip="Select the next match for the find text in the script." />
                                <ui:Button x:Name="btnFindClose" Content="Close" MinWidth="70" Click="FindClose_Click" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Grid.Column="0" BorderThickness="1" CornerRadius="4"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Left" x:Name="txtScriptGutter" Style="{StaticResource WbGutter}" Text="{Binding ScriptGutter, Mode=OneWay}" />
                                <TextBox x:Name="txtScript" AutomationProperties.Name="Script" Style="{StaticResource WbCode}" BorderThickness="0"
                                         IsReadOnly="{Binding IsScriptReadOnly}"
                                         Text="{Binding ScriptText, UpdateSourceTrigger=PropertyChanged}"
                                         ScrollViewer.ScrollChanged="Script_ScrollChanged" ToolTip="Edit the PowerShell script for the target you are editing. Parse results appear under Parse diagnostics." />
                            </DockPanel>
                        </Border>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Hooks" Style="{StaticResource WbHeading}" Margin="0,4,0,4" />
                        <Grid Grid.Row="1" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Before" Style="{StaticResource WbNote}" Margin="0,0,0,3" />
                            <TextBox Grid.Row="1" x:Name="txtHookBefore" AutomationProperties.Name="Before hook" Style="{StaticResource WbCode}" Margin="0,0,0,8"
                                     IsEnabled="{Binding HooksEnabled}" Text="{Binding HookBefore, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the PowerShell that runs before the generated step. Available when the mode is Extend generated." />
                            <TextBlock Grid.Row="2" Text="After" Style="{StaticResource WbNote}" Margin="0,0,0,3" />
                            <TextBox Grid.Row="3" x:Name="txtHookAfter" AutomationProperties.Name="After hook" Style="{StaticResource WbCode}" Margin="0,0,0,4"
                                     IsEnabled="{Binding HooksEnabled}" Text="{Binding HookAfter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the PowerShell that runs after the generated step. Available when the mode is Extend generated." />
                            <CheckBox Grid.Row="4" x:Name="chkAfterOnFailure" IsEnabled="{Binding HooksEnabled}"
                                      IsChecked="{Binding AfterRunsOnFailure}" ToolTip="Run the After hook even when the generated step fails.">
                                <TextBlock Text="After hook runs even when the generated step fails" TextWrapping="Wrap" />
                            </CheckBox>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="txtScriptNote" Text="{Binding ScriptNote}" Style="{StaticResource WbNote}" Margin="0,8,0,4" />

                    <DockPanel Grid.Row="4">
                        <TextBlock DockPanel.Dock="Top" Text="Parse diagnostics" Style="{StaticResource WbNote}" Margin="0,0,0,3" />
                        <ListBox x:Name="lstScriptDiagnostics" Style="{StaticResource WbDiagnostics}" ItemsSource="{Binding ScriptDiagnostics}"
                                 AutomationProperties.Name="Script parse diagnostics" />
                    </DockPanel>
                </Grid>

                <Grid x:Name="pnlDetection"
                      Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibility}, ConverterParameter=2}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Detection" Style="{StaticResource WbLabel}" />
                        <ComboBox Grid.Column="1" x:Name="cboDetectionMode" AutomationProperties.Name="Detection" Style="{StaticResource WbCombo}"
                                  ItemsSource="{Binding DetectionModeOptions}" SelectedItem="{Binding DetectionMode}"
                                  ToolTip="Inherit uses the packager's validated native rule. Custom takes ownership of the whole rule." />
                        <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource WbLabel}" Margin="16,0,12,8" />
                        <ComboBox Grid.Column="3" x:Name="cboDetectionType" AutomationProperties.Name="Detection type" Style="{StaticResource WbCombo}" IsEnabled="{Binding IsDetectionCustom}"
                                  ItemsSource="{Binding DetectionTypeOptions}" SelectedItem="{Binding DetectionType}" ToolTip="Select the type of detection rule. Available when Detection is Custom." />
                        <TextBlock Grid.Column="4" x:Name="lblDetectionSrc" Text="{Binding DetectionSource}" Style="{StaticResource WbSource}" />
                        <ui:Button Grid.Column="5" x:Name="btnDetectionReset" Content="Reset section" Style="{StaticResource WbInlineButton}"
                                   HorizontalAlignment="Left" Margin="12,0,8,8" Command="{Binding ResetDetectionSectionCommand}" ToolTip="Remove your detection override and use the packager's native detection rule." />
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="txtDetectionInherited" Text="{Binding DetectionInheritedText}" Style="{StaticResource WbNote}" Margin="0,4,0,4" />

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="pnlDetectionTyped" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsDetectionScript, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid IsEnabled="{Binding IsDetectionCustom}" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Registry hive" Style="{StaticResource WbLabel}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cboDetHive" AutomationProperties.Name="Registry hive" Style="{StaticResource WbCombo}"
                                          ItemsSource="{Binding HiveOptions}" SelectedItem="{Binding DetHive}" ToolTip="Select the registry hive to read." />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Registry view" Style="{StaticResource WbLabel}" Margin="12,0,12,8" />
                                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="cboDetView" AutomationProperties.Name="Registry view" Style="{StaticResource WbCombo}"
                                          ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding DetView}" ToolTip="Select whether to read the 64-bit or the 32-bit registry view." />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Key" Style="{StaticResource WbLabel}" />
                                <ui:TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtDetKey" AutomationProperties.Name="Registry key" Style="{StaticResource WbField}"
                                            FontFamily="Cascadia Code, Consolas, Courier New" Text="{Binding DetKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the registry key path to check." />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Value name" Style="{StaticResource WbLabel}" />
                                <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="txtDetValueName" AutomationProperties.Name="Value name" Style="{StaticResource WbField}"
                                            FontFamily="Cascadia Code, Consolas, Courier New" Text="{Binding DetValueName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the name of the registry value to check." />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Operator" Style="{StaticResource WbLabel}" Margin="12,0,12,8" />
                                <ComboBox Grid.Row="2" Grid.Column="3" x:Name="cboDetOperator" AutomationProperties.Name="Operator" Style="{StaticResource WbCombo}"
                                          ItemsSource="{Binding OperatorOptions}" SelectedItem="{Binding DetOperator}" ToolTip="Select how to compare the registry value with the expected value." />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Expected value" Style="{StaticResource WbLabel}" />
                                <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="txtDetExpected" AutomationProperties.Name="Expected value" Style="{StaticResource WbField}"
                                            FontFamily="Cascadia Code, Consolas, Courier New" Text="{Binding DetExpected, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the value to compare with." />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Version binding" Style="{StaticResource WbLabel}" Margin="12,0,12,8" />
                                <ComboBox Grid.Row="3" Grid.Column="3" x:Name="cboDetVersionBinding" AutomationProperties.Name="Version binding" Style="{StaticResource WbCombo}"
                                          ItemsSource="{Binding VersionBindingOptions}" SelectedItem="{Binding DetVersionBinding}"
                                          ToolTip="Follows staged version updates the expected value at every build; Pinned keeps the literal value. Vendor version strings do not all compare as numeric versions." />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="File path" Style="{StaticResource WbLabel}" />
                                <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="txtDetFilePath" AutomationProperties.Name="File path" Style="{StaticResource WbField}"
                                            FontFamily="Cascadia Code, Consolas, Courier New" Text="{Binding DetFilePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the folder that contains the file." />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="File name" Style="{StaticResource WbLabel}" Margin="12,0,12,8" />
                                <ui:TextBox Grid.Row="4" Grid.Column="3" x:Name="txtDetFileName" AutomationProperties.Name="File name" Style="{StaticResource WbField}"
                                            FontFamily="Cascadia Code, Consolas, Courier New" Text="{Binding DetFileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the name of the file to check." />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="File property" Style="{StaticResource WbLabel}" />
                                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cboDetFileProperty" AutomationProperties.Name="File property" Style="{StaticResource WbCombo}"
                                          ItemsSource="{Binding FilePropertyOptions}" SelectedItem="{Binding DetFileProperty}" ToolTip="Select the file property to check." />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="Clause logic" Style="{StaticResource WbLabel}" Margin="12,0,12,8" />
                                <ComboBox Grid.Row="5" Grid.Column="3" x:Name="cboDetLogic" AutomationProperties.Name="Clause logic" Style="{StaticResource WbCombo}"
                                          ItemsSource="{Binding LogicOptions}" SelectedItem="{Binding DetLogic}"
                                          ToolTip="The existing schema supports flat AND, flat OR, and two groups. Nested expressions are not flattened silently." />

                                <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,4">
                                    <TextBlock DockPanel.Dock="Left" Text="Clauses" Style="{StaticResource WbHeading}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button x:Name="btnDetClauseAdd" Content="Add clause" Icon="{ui:SymbolIcon Add24}" Style="{StaticResource WbInlineButton}" Command="{Binding AddClauseCommand}" ToolTip="Add a clause to the detection rule." />
                                        <ui:Button x:Name="btnDetClauseRemove" Content="Remove" Icon="{ui:SymbolIcon Delete24}" Style="{StaticResource WbInlineButton}" Margin="0,0,0,8" Command="{Binding RemoveClauseCommand}" ToolTip="Remove the selected clause from the detection rule." />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" x:Name="dgDetClauses" AutomationProperties.Name="Detection clauses" MinHeight="140" Style="{StaticResource WbGrid}"
                                          ItemsSource="{Binding Clauses}" SelectedItem="{Binding SelectedClause}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Group" Width="70" Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Type" Width="100" Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Subject" Width="*" MinWidth="120" Binding="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Operator" Width="120" Binding="{Binding Operator, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTextColumn Header="Expected" Width="160" Binding="{Binding Expected, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </ScrollViewer>

                        <Grid x:Name="pnlDetectionScript"
                              Visibility="{Binding IsDetectionScript, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="110" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="txtIntuneContract" Style="{StaticResource WbNote}"
                                       Text="Intune reads the detection result from the script: exit code 0 plus output on STDOUT means installed. Any output on STDERR is a negative result, and exit 0 with no output means not installed. A detector that only exits successfully is rejected here." />
                            <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Left" x:Name="txtDetectGutter" Style="{StaticResource WbGutter}" Text="{Binding DetectGutter, Mode=OneWay}" />
                                    <TextBox x:Name="txtDetectScript" AutomationProperties.Name="Detection script" Style="{StaticResource WbCode}" BorderThickness="0"
                                             IsEnabled="{Binding IsDetectionCustom}"
                                             Text="{Binding DetectScript, UpdateSourceTrigger=PropertyChanged}"
                                             ScrollViewer.ScrollChanged="DetectScript_ScrollChanged" ToolTip="Edit the PowerShell detection script. Exit code 0 with output on STDOUT means installed." />
                                </DockPanel>
                            </Border>
                            <CheckBox Grid.Row="2" x:Name="chkIntuneScriptConversion" Margin="0,8,0,4" IsEnabled="{Binding IsDetectionCustom}"
                                      IsChecked="{Binding IntuneScriptConversion}"
                                      Content="Allow Intune to publish this rule as a converted detection script"
                                      ToolTip="Native clauses without an Intune mapping stay blocked until this is chosen explicitly." />
                            <DockPanel Grid.Row="3">
                                <TextBlock DockPanel.Dock="Top" Text="Parse diagnostics" Style="{StaticResource WbNote}" Margin="0,0,0,3" />
                                <ListBox x:Name="lstDetectDiagnostics" Style="{StaticResource WbDiagnostics}" ItemsSource="{Binding DetectDiagnostics}"
                                         AutomationProperties.Name="Detection parse diagnostics" />
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="pnlRequirements" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibility}, ConverterParameter=3}">
                    <Grid Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource WbNote}"
                                   Text="Requirements decide eligibility; detection decides installed state. Operations are keyed by rule id so adding an application-wide rule cannot silently gate a variant fallback." />

                        <DockPanel Grid.Row="1" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Requirement operations" Style="{StaticResource WbHeading}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox x:Name="cboReqTemplate" AutomationProperties.Name="Site condition" AutomationProperties.HelpText="{Binding ToolTip, RelativeSource={RelativeSource Self}, Converter={x:Static helpers:ToolTipTextConverter.Instance}}" Width="200" Margin="0,0,8,8"
                                          ItemsSource="{Binding RequirementTemplates}" SelectedItem="{Binding SelectedRequirementTemplate}"
                                          ToolTip="Site conditions, named below; a rule attaches one to this application." />
                                <ui:Button x:Name="btnReqAdd" Content="Add" Icon="{ui:SymbolIcon Add24}" Style="{StaticResource WbInlineButton}" MinWidth="70" Command="{Binding AddRequirementCommand}" ToolTip="Add a requirement operation for the selected site condition." />
                                <ui:Button x:Name="btnReqReplace" Content="Replace" Icon="{ui:SymbolIcon ArrowSwap24}" Style="{StaticResource WbInlineButton}" Command="{Binding ReplaceRequirementCommand}" ToolTip="Set the selected requirement operation to Replace." />
                                <ui:Button x:Name="btnReqRemove" Content="Remove" Icon="{ui:SymbolIcon Delete24}" Style="{StaticResource WbInlineButton}" Margin="0,0,0,8" Command="{Binding RemoveRequirementCommand}" ToolTip="Set the selected requirement operation to Remove. The row stays in the list and suppresses the rule the packager would otherwise add." />
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Grid.Row="2" x:Name="dgRequirements" AutomationProperties.Name="Requirement operations" Style="{StaticResource WbGrid}" MinHeight="120" MaxHeight="220"
                                  ItemsSource="{Binding Requirements}" SelectedItem="{Binding SelectedRequirement}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Operation" Width="100" Binding="{Binding Op}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Rule id" Width="140" Binding="{Binding RuleId}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Rule" Width="*" MinWidth="120" Binding="{Binding Summary}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Value" Width="180" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Applies to" Width="130" Binding="{Binding AppliesTo, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="3" Margin="0,12,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Variant split" Style="{StaticResource WbLabel}" />
                            <ComboBox Grid.Column="1" x:Name="cboVariantSplit" AutomationProperties.Name="Variant split" Style="{StaticResource WbCombo}"
                                      ItemsSource="{Binding VariantSplitOptions}" SelectedItem="{Binding VariantSplit}" IsEnabled="{Binding VariantSplitEnabled}"
                                      ToolTip="Stage one application with several deployment types. Offered only where the packager declares support." />
                            <TextBlock Grid.Column="2" Text="Install for" Style="{StaticResource WbLabel}" Margin="16,0,12,8" />
                            <ComboBox Grid.Column="3" x:Name="cboInstallForMode" AutomationProperties.Name="Install for" Style="{StaticResource WbCombo}"
                                      ItemsSource="{Binding InstallForOptions}" SelectedItem="{Binding InstallFor}" IsEnabled="{Binding InstallForEnabled}"
                                      ToolTip="System installs for all users; User installs for the signed-in user. Arguments, uninstall command, detection hive and view follow this choice." />
                            <TextBlock Grid.Column="4" x:Name="lblVariantSrc" Text="{Binding VariantSource}" Style="{StaticResource WbSource}" />
                            <ui:Button Grid.Column="5" x:Name="btnInstallForReset" Content="Reset" Style="{StaticResource WbInlineButton}" HorizontalAlignment="Left"
                                       Command="{Binding ResetFieldCommand}" CommandParameter="InstallMode" ToolTip="Remove your override and use the Install for value from the packager definition." />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Installer type" Style="{StaticResource WbLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboInstallerType" AutomationProperties.Name="Installer type" Style="{StaticResource WbCombo}"
                                      ItemsSource="{Binding InstallerTypeOptions}" SelectedItem="{Binding InstallerType}" IsEnabled="{Binding InstallerTypeEnabled}"
                                      ToolTip="EXE or MSI. The application stages with that installer, its own silent switches and its own detection. Offered only where the vendor ships both types." />
                            <TextBlock Grid.Row="1" Grid.Column="4" x:Name="lblInstallerTypeSrc" Text="{Binding InstallerTypeSource}" Style="{StaticResource WbSource}" />
                            <ui:Button Grid.Row="1" Grid.Column="5" x:Name="btnInstallerTypeReset" Content="Reset" Style="{StaticResource WbInlineButton}" HorizontalAlignment="Left"
                                       Command="{Binding ResetFieldCommand}" CommandParameter="InstallerType" ToolTip="Remove your override and use the Installer type that the packager definition ships." />
                        </Grid>

                        <TextBlock Grid.Row="4" Text="Variant overrides" Style="{StaticResource WbHeading}" />

                        <DataGrid Grid.Row="5" x:Name="dgVariants" AutomationProperties.Name="Variant overrides" Style="{StaticResource WbGrid}" MinHeight="90" MaxHeight="180"
                                  ItemsSource="{Binding Variants}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Variant" Width="150" Binding="{Binding Suffix}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Install command" Width="*" MinWidth="160" Binding="{Binding InstallCommand, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Detection" Width="200" Binding="{Binding Detection, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Estimated" Width="90" Binding="{Binding Estimated, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Maximum" Width="90" Binding="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="6" Text="Site condition names" Style="{StaticResource WbHeading}" Margin="0,12,0,4" />
                        <TextBlock Grid.Row="7" Style="{StaticResource WbNote}"
                                   Text="Shared by every application. A rule attaches to the site global condition with this name, creating it on first use; change a name to reuse a condition your site already has. Saved when a field loses focus." />
                        <Grid Grid.Row="8" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU architecture condition" Style="{StaticResource WbLabel}" />
                            <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="txtSiteArchGc" AutomationProperties.Name="CPU architecture condition" Style="{StaticResource WbField}"
                                        IsEnabled="{Binding HasArchTemplate}" Text="{Binding SiteArchGc}" LostFocus="SiteCondition_LostFocus"
                                        ToolTip="Site global condition name for the WQL query on Win32_Processor.Architecture (9 = x64, 12 = ARM64)" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="OS language condition" Style="{StaticResource WbLabel}" />
                            <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="txtSiteLangGc" AutomationProperties.Name="OS language condition" Style="{StaticResource WbField}"
                                        IsEnabled="{Binding HasLangTemplate}" Text="{Binding SiteLangGc}" LostFocus="SiteCondition_LostFocus"
                                        ToolTip="Name of the built-in Operating System Language site condition. Must already exist on the site." />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="VPN condition" Style="{StaticResource WbLabel}" />
                            <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="txtSiteVpnGc" AutomationProperties.Name="VPN condition" Style="{StaticResource WbField}"
                                        IsEnabled="{Binding HasVpnTemplate}" Text="{Binding SiteVpnGc}" LostFocus="SiteCondition_LostFocus"
                                        ToolTip="Site global condition name for the script that reports whether a VPN adapter is active" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="VPN adapter patterns" Style="{StaticResource WbLabel}" />
                            <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="txtSiteVpnPatterns" AutomationProperties.Name="VPN adapter patterns" Style="{StaticResource WbField}"
                                        IsEnabled="{Binding HasVpnTemplate}" Text="{Binding SiteVpnPatterns}" LostFocus="SiteCondition_LostFocus"
                                        ToolTip="Comma-separated adapter description substrings that identify a VPN client. Applied when the condition is next created; an existing site condition keeps its script." />
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="pnlTiming" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibility}, ConverterParameter=4}">
                    <Grid Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="280" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource WbNote}"
                                   Text="Both values describe endpoint deployment behavior, not download or staging time. They inherit independently." />

                        <CheckBox Grid.Row="1" Grid.Column="0" x:Name="chkEstimatedDefault" Margin="0,0,12,8" VerticalAlignment="Center"
                                  Content="Use default estimated install duration" IsChecked="{Binding EstimatedUseDefault}" ToolTip="Use the estimated install duration from the packager definition. Clear the check box to enter your own value." />
                        <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="txtEstimatedMinutes" AutomationProperties.Name="Estimated install duration in minutes" Style="{StaticResource WbField}"
                                    IsEnabled="{Binding EstimatedUseDefault, Converter={StaticResource InverseBool}}"
                                    Text="{Binding EstimatedMinutes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the estimated install duration in minutes." />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="minutes" Style="{StaticResource WbLabel}" Margin="8,0,12,8" />
                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="lblEstimatedEffective" Text="{Binding EstimatedEffective}" Style="{StaticResource WbSource}" HorizontalAlignment="Left" />

                        <CheckBox Grid.Row="2" Grid.Column="0" x:Name="chkMaximumDefault" Margin="0,0,12,8" VerticalAlignment="Center"
                                  Content="Use default maximum runtime" IsChecked="{Binding MaximumUseDefault}" ToolTip="Use the maximum runtime from the packager definition. Clear the check box to enter your own value." />
                        <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="txtMaximumMinutes" AutomationProperties.Name="Maximum allowed runtime in minutes" Style="{StaticResource WbField}"
                                    IsEnabled="{Binding MaximumUseDefault, Converter={StaticResource InverseBool}}"
                                    Text="{Binding MaximumMinutes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the maximum allowed runtime in minutes." />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="minutes" Style="{StaticResource WbLabel}" Margin="8,0,12,8" />
                        <TextBlock Grid.Row="2" Grid.Column="3" x:Name="lblMaximumEffective" Text="{Binding MaximumEffective}" Style="{StaticResource WbSource}" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="3" Grid.ColumnSpan="4" x:Name="txtTimingTargets" Style="{StaticResource WbNote}" Margin="0,4,0,8"
                                   Text="ConfigMgr receives both values on the deployment type. The Intune publisher sends neither; the values stay in the definition and the review pane reports the gap." />

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Text="Execution" Style="{StaticResource WbHeading}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Install context" Style="{StaticResource WbLabel}" />
                        <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="cboExecContext" AutomationProperties.Name="Install context" Style="{StaticResource WbCombo}"
                                  ItemsSource="{Binding ExecContextOptions}" SelectedItem="{Binding ExecContext}" ToolTip="Select whether the installation runs as System or as the user." />
                        <TextBlock Grid.Row="5" Grid.Column="3" x:Name="lblExecContextSrc" Text="{Binding ExecContextSource}" Style="{StaticResource WbSource}" HorizontalAlignment="Left" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Logon requirement" Style="{StaticResource WbLabel}" />
                        <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" x:Name="cboExecLogon" AutomationProperties.Name="Logon requirement" Style="{StaticResource WbCombo}" HorizontalAlignment="Left" MinWidth="300"
                                  ItemsSource="{Binding ExecLogonOptions}" SelectedItem="{Binding ExecLogon}" ToolTip="Select whether the installation runs when a user is signed in, when no user is signed in, or either way." />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="User interaction" Style="{StaticResource WbLabel}" />
                        <ComboBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="cboExecInteraction" AutomationProperties.Name="User interaction" Style="{StaticResource WbCombo}"
                                  ItemsSource="{Binding ExecInteractionOptions}" SelectedItem="{Binding ExecInteraction}" ToolTip="Select how the installation window appears on the device." />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Script host" Style="{StaticResource WbLabel}" />
                        <ComboBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" x:Name="cboExecScriptHost" AutomationProperties.Name="Script host" Style="{StaticResource WbCombo}"
                                  ItemsSource="{Binding ExecScriptHostOptions}" SelectedItem="{Binding ExecScriptHost}"
                                  ToolTip="Detection and requirement scripts run in the host selected here; Intune maps this to the 32-bit flag." />
                        <ui:Button Grid.Row="8" Grid.Column="3" x:Name="btnTimingReset" Content="Reset section" Style="{StaticResource WbInlineButton}"
                                   HorizontalAlignment="Left" Margin="12,0,8,8" Command="{Binding ResetTimingSectionCommand}" ToolTip="Remove your overrides for the durations and execution settings on this page and use the packager values." />
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="pnlSources"
                      Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibility}, ConverterParameter=5}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource WbNote}"
                               Text="Bundled files travel inside the package content. A file only reaches the endpoint when the install script copies it there; destinations are relative to the content root." />

                    <DockPanel Grid.Row="1" Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="Custom source files" Style="{StaticResource WbHeading}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="btnSourceAddFile" Content="Add file..." Icon="{ui:SymbolIcon Add24}" Style="{StaticResource WbInlineButton}" Command="{Binding AddSourceFileCommand}" ToolTip="Select one or more files to bundle in the package content." />
                            <ui:Button x:Name="btnSourceAddFolder" Content="Add folder..." Icon="{ui:SymbolIcon Add24}" Style="{StaticResource WbInlineButton}" Command="{Binding AddSourceFolderCommand}" ToolTip="Select a folder to bundle every file under it in the package content." />
                            <ui:Button x:Name="btnSourceReplace" Content="Replace..." Icon="{ui:SymbolIcon ArrowSwap24}" Style="{StaticResource WbInlineButton}" Command="{Binding ReplaceSourceFileCommand}" ToolTip="Select a file to replace the selected source file." />
                            <ui:Button x:Name="btnSourceRemove" Content="Remove" Icon="{ui:SymbolIcon Delete24}" Style="{StaticResource WbInlineButton}" Margin="0,0,0,8" Command="{Binding RemoveSourceFileCommand}" ToolTip="Remove the selected source file from the bundle." />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="2" x:Name="dgSourceFiles" AutomationProperties.Name="Custom source files" Style="{StaticResource WbGrid}"
                              ItemsSource="{Binding SourceFiles}" SelectedItem="{Binding SelectedSourceFile}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Width="*" MinWidth="120" Binding="{Binding Provenance}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Destination" Width="220" Binding="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Size" Width="110" Binding="{Binding SizeText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="SHA-256" Width="160" Binding="{Binding ShortHash}" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="Linked" Width="70" Binding="{Binding Linked, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" x:Name="txtSourceNote" Style="{StaticResource WbNote}" Margin="0,8,0,0"
                               Text="Bundling a file places it inside the package content. Copying it onto the endpoint is the install script's job; a detector must not depend on package cache content." />
                </Grid>

                <Grid x:Name="pnlReview"
                      Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibility}, ConverterParameter=6}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Default versus custom" Style="{StaticResource WbHeading}" Margin="0,0,0,4" />
                    <DataGrid Grid.Row="1" Grid.Column="0" x:Name="dgDiff" AutomationProperties.Name="Default versus custom" Style="{StaticResource WbGrid}" IsReadOnly="True" ItemsSource="{Binding DiffRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Width="190" Binding="{Binding Field}" />
                            <DataGridTextColumn Header="Default" Width="*" MinWidth="120" Binding="{Binding Default}" />
                            <DataGridTextColumn Header="Custom" Width="*" MinWidth="120" Binding="{Binding Custom}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Compatibility findings" Style="{StaticResource WbHeading}" Margin="0,0,0,4" />
                    <DataGrid Grid.Row="1" Grid.Column="2" x:Name="dgFindings" AutomationProperties.Name="Compatibility findings" Style="{StaticResource WbGrid}" IsReadOnly="True" ItemsSource="{Binding Findings}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Width="80" Binding="{Binding Severity}" />
                            <DataGridTextColumn Header="Code" Width="150" Binding="{Binding Code}" />
                            <DataGridTemplateColumn Header="Message" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Resolved plan" Style="{StaticResource WbHeading}" />
                    <TextBox Grid.Row="3" Grid.Column="0" x:Name="txtResolvedPlan" AutomationProperties.Name="Resolved plan" Style="{StaticResource WbCode}" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                             Text="{Binding ResolvedPlan, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Prior builds" Style="{StaticResource WbHeading}" />
                    <DataGrid Grid.Row="3" Grid.Column="2" x:Name="dgBuilds" AutomationProperties.Name="Prior builds" Style="{StaticResource WbGrid}" IsReadOnly="True" ItemsSource="{Binding PriorBuilds}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Build id" Width="210" Binding="{Binding BuildId}" />
                            <DataGridTextColumn Header="Version" Width="80" Binding="{Binding Version}" />
                            <DataGridTextColumn Header="Revision" Width="90" Binding="{Binding Revision}" />
                            <DataGridTextColumn Header="Result" Width="*" MinWidth="120" Binding="{Binding Result}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <controls:WorkbenchSidePanel Grid.Column="3" x:Name="pnlSidePanel" Width="270" Margin="0,12,16,8" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="4" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <Grid Grid.Row="5" Margin="16,8,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The validation line stands in for the side panel while the panel is closed. -->
            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Left" x:Name="txtValidationLine" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ValidationLine}" />
                <TextBlock x:Name="txtSaveState" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SaveStateText}" />
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button x:Name="btnUseDefaults" Content="Use defaults" Style="{StaticResource WbFooterButton}" MinWidth="106"
                           Command="{Binding UseDefaultsCommand}"
                           ToolTip="Clear every override in this profile and inherit the packager defaults." />
                <ui:Button x:Name="btnSave" Content="Save" Icon="{ui:SymbolIcon Save24}" Style="{StaticResource WbFooterButton}" Command="{Binding SaveCommand}" ToolTip="Save this profile. The packager default profile asks for a name and is saved as a new profile." />
                <ui:Button x:Name="btnSaveAs" Content="Save as..." Icon="{ui:SymbolIcon Save24}" Style="{StaticResource WbFooterButton}" Command="{Binding SaveAsCommand}" ToolTip="Save a copy of this profile under a new name." />
                <ToggleButton x:Name="btnDetails" Content="Details" MinWidth="96" Click="Details_Click" Visibility="Collapsed"
                              ToolTip="Show the identity, the source and the validation results in place of the editor."
                              AutomationProperties.AutomationId="btnWorkbenchDetails" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="btnValidate" Content="Validate" Icon="{ui:SymbolIcon CheckmarkCircle24}" Style="{StaticResource WbFooterButton}" Command="{Binding ValidateCommand}" ToolTip="Check this profile and show the findings on the Review page. Nothing runs." />
                <ui:Button x:Name="btnStage" Content="Stage" Icon="{ui:SymbolIcon ArrowCircleDown24}" Style="{StaticResource WbFooterButton}" Command="{Binding StageCommand}" ToolTip="Stage this application with the saved profile. Unsaved edits are saved or discarded first, and blocking findings stop the run." />
                <ui:Button x:Name="btnPublishAll" Content="Publish All" Icon="{ui:SymbolIcon ArrowCircleUp24}" Appearance="Primary"
                           Style="{StaticResource WbFooterButton}" Margin="0"
                           Command="{Binding PublishAllCommand}" ToolTip="{Binding PublishAllToolTip}" ToolTipService.ShowOnDisabled="True"
                           AutomationProperties.AutomationId="btnWorkbenchPublishAll" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <ui:ContentDialogHost x:Name="WorkbenchDialogHost" Grid.Row="0" Grid.RowSpan="6" />
    </Grid>
</ui:FluentWindow>
