<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.OldApplicationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    Title="Old Application"
    Width="900" Height="560"
    MinWidth="640" MinHeight="400"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Old Application" ShowMinimize="False" ShowMaximize="False" />

        <TextBlock Grid.Row="1" Margin="16,0,16,8" Text="{Binding Intro}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   AutomationProperties.AutomationId="txtOldApplicationIntro" />

        <DockPanel Grid.Row="2" Margin="16,0,16,8">
            <ui:Button DockPanel.Dock="Right" Content="Search" MinWidth="88" Margin="8,0,0,0" Command="{Binding SearchCommand}"
                       ToolTip="Reads the applications of the site whose name contains your text. Wildcard characters are taken as they are."
                       AutomationProperties.AutomationId="btnOldApplicationSearch" />
            <ui:TextBox x:Name="txtSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Part of the application name"
                        Icon="{ui:SymbolIcon Search24}" ToolTip="Part of the name of the older application. Press Enter to search."
                        AutomationProperties.Name="Application name" AutomationProperties.AutomationId="txtOldApplicationSearch">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
        </DockPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" Margin="16,0,16,8" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"
                  helpers:DataGridColumnSizing.FixStarWidthsOnResize="True"
                  RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource FocusableCell}"
                  AutomationProperties.Name="Applications of the site" AutomationProperties.AutomationId="dgOldApplications">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title, Mode=OneWay}" Width="2*" MinWidth="200" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version, Mode=OneWay}" Width="120" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="State" Binding="{Binding StateText, Mode=OneWay}" Width="140" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason, Mode=OneWay}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Content="Use as Old Application" Appearance="Primary" MinWidth="168" Margin="0,0,8,0" Command="{Binding LinkCommand}"
                               ToolTip="Writes the identity marker of this line into the keywords of the selected application, after you confirm."
                               AutomationProperties.AutomationId="btnOldApplicationLink" />
                    <ui:Button Content="Remove Link" MinWidth="104" Margin="0,0,8,0" Command="{Binding ClearCommand}"
                               ToolTip="Takes the marker off the selected application. Only when the marker is its one keyword."
                               AutomationProperties.AutomationId="btnOldApplicationClear" />
                    <ui:Button Content="Close" MinWidth="88" IsCancel="True" Click="Close_Click"
                               ToolTip="Closes the window."
                               AutomationProperties.AutomationId="btnOldApplicationClose" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtOldApplicationStatus" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <ui:ContentDialogHost x:Name="PromptHost" Grid.Row="0" Grid.RowSpan="5" />
    </Grid>
</ui:FluentWindow>
