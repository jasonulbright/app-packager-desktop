<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.SupersedenceConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Supersede the older version?"
    Width="600" SizeToContent="Height"
    MinWidth="460"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Supersede the older version?" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="16,4,16,16">
            <TextBlock x:Name="txtQuestion" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtSupersedeQuestion" />
            <TextBlock x:Name="txtOld" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtSupersedeOld" />
            <TextBlock x:Name="txtNew" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtSupersedeNew" />
            <TextBlock x:Name="txtEffect" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="txtSupersedeEffect" />
            <CheckBox x:Name="chkRemember" Content="Remember this answer for the other applications of this run"
                      AutomationProperties.AutomationId="chkSupersedeRemember" />
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button x:Name="btnYes" Content="_Yes" MinWidth="100" Margin="0,0,8,0" Appearance="Primary" Click="OnYes"
                           ToolTip="Apply the supersedence after the package is created."
                           AutomationProperties.AutomationId="btnSupersedeYes" />
                <ui:Button x:Name="btnSkip" Content="_Skip" MinWidth="100" Margin="0,0,8,0" IsDefault="True" IsCancel="True" Click="OnSkip"
                           ToolTip="Package the application without the supersedence."
                           AutomationProperties.AutomationId="btnSupersedeSkip" />
                <ui:Button x:Name="btnNo" Content="_No" MinWidth="100" Click="OnNo"
                           ToolTip="Cancel: the whole package run stops and nothing is created for this application."
                           AutomationProperties.AutomationId="btnSupersedeNo" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
