<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.TextPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="560" Height="400"
    MinWidth="420" MinHeight="260"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="PromptVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <DockPanel Grid.Row="1" Margin="16,0,16,8">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Label}" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Note}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding HasNote, Converter={StaticResource PromptVisibility}}"
                       AutomationProperties.AutomationId="txtPromptNote" />
            <TextBox x:Name="txtValue" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="{Binding Multiline}" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" VerticalAlignment="Stretch"
                     AutomationProperties.Name="{Binding Label}" AutomationProperties.AutomationId="txtPromptValue" />
        </DockPanel>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,10">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <ui:Button Content="{Binding ActionText}" Appearance="Primary" MinWidth="110" Margin="0,0,8,0" Command="{Binding AcceptCommand}"
                               AutomationProperties.AutomationId="btnPromptAccept" />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="btnPromptCancel" />
                </WrapPanel>
                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" AutomationProperties.AutomationId="txtPromptMessage" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
