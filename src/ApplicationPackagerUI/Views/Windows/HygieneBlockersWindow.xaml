<ui:FluentWindow
    x:Class="ApplicationPackagerUI.Views.Windows.HygieneBlockersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    Title="{Binding Title}"
    Width="900" Height="460"
    MinWidth="620" MinHeight="340"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <!-- The cells of a row form a Local Tab group, so only the first cell is a Tab stop: Tab enters the grid once and the next Tab leaves it. -->
            <Style x:Key="TabStopCell" TargetType="DataGridCell" BasedOn="{StaticResource FocusableCell}">
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="0">
                        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMinimize="False" />

        <TextBlock Grid.Row="1" Margin="16,4,16,8" Text="{Binding Summary}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   AutomationProperties.AutomationId="txtBlockersSummary" />

        <DataGrid Grid.Row="2" x:Name="gridBlockers" KeyboardNavigation.TabIndex="0" KeyboardNavigation.TabNavigation="Once" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" Margin="16,0,16,8" CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource TabStopCell}"
                  helpers:DataGridKeyboard.SelectsFocusedRow="True" helpers:DataGridRightClick.SelectsRow="True" helpers:DataGridColumnSizing.FixStarWidthsOnResize="True"
                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.AutomationId="gridBlockers" AutomationProperties.Name="Objects that block the delete">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="170" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" MinWidth="200" IsReadOnly="True" ElementStyle="{StaticResource TrimmedCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="16,0,16,8" Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtBlockersNote" />

        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,8" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
            <WrapPanel HorizontalAlignment="Right">
                <ui:Button x:Name="btnBlockersClose" Content="_Close" MinWidth="100" IsCancel="True" IsDefault="True" Command="{Binding CloseCommand}" AutomationProperties.AutomationId="btnBlockersClose" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
