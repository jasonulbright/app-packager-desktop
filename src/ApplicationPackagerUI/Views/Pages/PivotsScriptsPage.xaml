<Page
    x:Class="ApplicationPackagerUI.Views.Pages.PivotsScriptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    xmlns:pages="clr-namespace:ApplicationPackagerUI.Views.Pages"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/PivotsScripts.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="LibraryItem">
                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                    <Run Text="{Binding Name, Mode=OneWay}" />
                </TextBlock>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="0,0,0,8" Title="Pivots and Scripts" TitleAutomationId="txtPivotsTitle" DescriptionAutomationId="txtPivotsIntro"
                             Description="Runs a CMPivot query or an approved site script on resolved devices, and submits, approves, denies or removes site scripts. Every action shows a plan first. A run cannot be undone." />

        <Border Grid.Row="1" Style="{StaticResource Caution}" Visibility="{Binding HasConnectionMessage, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="pnlPivotsConnection">
            <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtPivotsConnection" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding PageSummary}" Style="{StaticResource Note}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtPivotsSummary" />

        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.AutomationId="tabPivots">
            <TabItem Header="Pivot" AutomationProperties.AutomationId="tabPivot">
                <ScrollViewer x:Name="scrollPivotTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollPivotTab">
                    <Grid Height="{Binding ViewportHeight, ElementName=scrollPivotTab}" MinHeight="1000" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="320" />
                        </Grid.RowDefinitions>
                        <pages:PivotsTargetsPanel Grid.Row="0" KeyboardNavigation.TabIndex="0" KeyboardNavigation.TabNavigation="Local" />
                        <Grid Grid.Row="1" KeyboardNavigation.TabIndex="1" KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="280" />
                                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="360" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtQuery" Grid.Column="0" Style="{StaticResource Editor}" Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}" Height="170"
                                     KeyboardNavigation.TabIndex="0" ToolTip="{x:Static pages:PivotsScriptsPage.EditorKeyHint}" AutomationProperties.HelpText="{x:Static pages:PivotsScriptsPage.EditorKeyHint}"
                                     AutomationProperties.Name="CMPivot query" AutomationProperties.AutomationId="txtQuery" />
                            <DockPanel Grid.Column="1" Margin="8,0,0,0" KeyboardNavigation.TabIndex="1" KeyboardNavigation.TabNavigation="Local">
                                <ui:Button DockPanel.Dock="Bottom" Content="Use query" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding UseQueryItemCommand}" Margin="0,6,0,0"
                                           ToolTip="Puts the selected query of the library into the editor." AutomationProperties.AutomationId="btnUseQuery" />
                                <ListBox ItemsSource="{Binding QueryLibrary}" SelectedItem="{Binding SelectedQueryItem}" ItemTemplate="{StaticResource LibraryItem}" Height="130"
                                         ItemContainerStyle="{StaticResource LibraryListItem}" MouseDoubleClick="OnQueryLibraryDoubleClick"
                                         AutomationProperties.Name="Query library" AutomationProperties.AutomationId="lstQueryLibrary" />
                            </DockPanel>
                        </Grid>
                        <WrapPanel Grid.Row="2" Margin="0,8,0,8" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                            <ui:Button Content="Run query" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding RunPivotCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads the targets again and shows the plan of the query run." AutomationProperties.Name="Run the CMPivot query"
                                       AutomationProperties.AutomationId="btnRunPivot" />
                            <TextBlock Text="{Binding EditorPosition}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="4,0,12,8" AutomationProperties.AutomationId="txtQueryPosition" />
                            <TextBlock Text="{x:Static pages:PivotsScriptsPage.EditorKeyHint}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtQueryKeyHint" />
                        </WrapPanel>
                        <pages:PivotsResultsPanel Grid.Row="3" KeyboardNavigation.TabIndex="3" KeyboardNavigation.TabNavigation="Local" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Script" AutomationProperties.AutomationId="tabScript">
                <ScrollViewer x:Name="scrollScriptTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollScriptTab">
                    <Grid Height="{Binding ViewportHeight, ElementName=scrollScriptTab}" MinHeight="1080" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="150" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" MinHeight="320" />
                        </Grid.RowDefinitions>
                        <pages:PivotsTargetsPanel Grid.Row="0" KeyboardNavigation.TabIndex="0" KeyboardNavigation.TabNavigation="Local" />
                        <WrapPanel Grid.Row="1" Margin="0,0,0,4" KeyboardNavigation.TabIndex="1" KeyboardNavigation.TabNavigation="Local">
                            <ui:Button Content="Refresh scripts" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshScriptsCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads the site scripts again." AutomationProperties.AutomationId="btnRefreshScripts" />
                            <TextBlock Text="{Binding ScriptsCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtScriptsCount" />
                        </WrapPanel>
                        <DataGrid Grid.Row="2" x:Name="dgApproved" KeyboardNavigation.TabIndex="2" Style="{StaticResource GridBase}" ItemsSource="{Binding ApprovedScripts}" SelectedItem="{Binding SelectedApproved}"
                                  AutomationProperties.AutomationId="dgApproved" AutomationProperties.Name="Approved scripts">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="84" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*" MinWidth="170" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Approver" Binding="{Binding Approver}" Width="*" MinWidth="170" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Parameters" Binding="{Binding Parameters}" Width="110" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="3" Margin="0,8,0,8" KeyboardNavigation.TabIndex="3" KeyboardNavigation.TabNavigation="Local">
                            <TextBlock Text="{Binding ScriptDetail}" Style="{StaticResource Warning}" AutomationProperties.AutomationId="txtScriptDetail" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ParametersText}" Style="{StaticResource Note}" Margin="0,4,0,8" AutomationProperties.AutomationId="txtParametersText" />
                            <WrapPanel>
                                <ui:Button Content="Parameters" Icon="{ui:SymbolIcon Edit24}" Command="{Binding EditParametersCommand}" Style="{StaticResource ToolButton}"
                                           ToolTip="Shows one field per parameter definition the site holds for the script." AutomationProperties.AutomationId="btnParameters" />
                                <ui:Button Content="Run script" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding RunScriptCommand}" Style="{StaticResource ToolButton}"
                                           ToolTip="Reads the script and the targets again and shows the plan with the script text, its hash and the device count."
                                           AutomationProperties.Name="Run the approved script" AutomationProperties.AutomationId="btnRunScript" />
                            </WrapPanel>
                        </StackPanel>
                        <pages:PivotsResultsPanel Grid.Row="4" KeyboardNavigation.TabIndex="4" KeyboardNavigation.TabNavigation="Local" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Site scripts" AutomationProperties.AutomationId="tabSiteScripts">
                <ScrollViewer x:Name="scrollSiteScriptsTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollSiteScriptsTab">
                    <Grid Height="{Binding ViewportHeight, ElementName=scrollSiteScriptsTab}" MinHeight="860" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="160" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,4" KeyboardNavigation.TabIndex="0" KeyboardNavigation.TabNavigation="Local">
                            <ui:TextBox Text="{Binding SiteScriptText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, GUID, author or state" Icon="{ui:SymbolIcon Search24}"
                                        MinWidth="280" Margin="0,0,8,8" AutomationProperties.Name="Site script filter" AutomationProperties.AutomationId="txtSiteScriptFilter" />
                            <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshScriptsCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads the site scripts again." AutomationProperties.Name="Refresh the site scripts" AutomationProperties.AutomationId="btnRefreshSiteScripts" />
                            <TextBlock Text="{Binding SiteScriptCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtSiteScriptCount" />
                        </WrapPanel>
                        <DataGrid Grid.Row="1" x:Name="dgSiteScripts" KeyboardNavigation.TabIndex="1" Style="{StaticResource GridBase}" ItemsSource="{Binding SiteScriptRows}" SelectedItem="{Binding SelectedSiteScript}"
                                  AutomationProperties.AutomationId="dgSiteScripts" AutomationProperties.Name="Site scripts">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="170" MinWidth="170" ElementStyle="{StaticResource StatusCell}" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="84" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*" MinWidth="170" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Approver" Binding="{Binding Approver}" Width="*" MinWidth="170" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="340" MinWidth="340" ElementStyle="{StaticResource TrimmedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Margin="0,8,0,8" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                            <TextBlock Text="{Binding SiteScriptDetail}" Style="{StaticResource Warning}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtSiteScriptDetail" />
                            <WrapPanel>
                                <ui:Button Content="Approve" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding ApproveScriptCommand}" Style="{StaticResource ToolButton}"
                                           ToolTip="Shows the plan that approves the selected script. The site refuses an approval by the author by default." AutomationProperties.AutomationId="btnApproveScript" />
                                <ui:Button Content="Deny" Icon="{ui:SymbolIcon DismissCircle24}" Command="{Binding DenyScriptCommand}" Style="{StaticResource ToolButton}"
                                           ToolTip="Asks for a comment, then shows the plan that declines the selected script." AutomationProperties.AutomationId="btnDenyScript" />
                                <ui:Button Content="Remove" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Command="{Binding RemoveScriptCommand}" Style="{StaticResource ToolButton}"
                                           ToolTip="Shows the plan that removes the selected script and its run history." AutomationProperties.AutomationId="btnRemoveScript" />
                            </WrapPanel>
                            <Border Style="{StaticResource Caution}" Visibility="{Binding HasLeftover, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="pnlLeftover">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Remove created script" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Command="{Binding RemoveLeftoverCommand}" Margin="8,0,0,0"
                                               ToolTip="Shows the plan that removes only the script the failed submit created." AutomationProperties.AutomationId="btnRemoveLeftover" />
                                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtLeftover">
                                        <Run Text="The last submit created a script on the site and then failed. GUID:" />
                                        <Run Text="{Binding LeftoverGuid, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <Border Grid.Row="3" Style="{StaticResource Card}" KeyboardNavigation.TabIndex="3" KeyboardNavigation.TabNavigation="Local" AutomationProperties.AutomationId="pnlNewScript">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="280" />
                                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="360" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="New script" Style="{StaticResource CardTitle}" />
                                <ui:TextBox Grid.Row="1" Grid.Column="0" Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Script name" MaxLength="200" Margin="0,0,0,8"
                                            KeyboardNavigation.TabIndex="0" AutomationProperties.Name="Script name" AutomationProperties.AutomationId="txtDraftName" />
                                <TextBox x:Name="txtDraft" Grid.Row="2" Grid.Column="0" Style="{StaticResource Editor}" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" Height="170"
                                         KeyboardNavigation.TabIndex="1" ToolTip="{x:Static pages:PivotsScriptsPage.EditorKeyHint}" AutomationProperties.HelpText="{x:Static pages:PivotsScriptsPage.EditorKeyHint}"
                                         AutomationProperties.Name="Script text" AutomationProperties.AutomationId="txtDraft" />
                                <DockPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="8,0,0,0" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                                    <ui:Button DockPanel.Dock="Bottom" Content="Use script" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding UseScriptItemCommand}" Margin="0,6,0,0"
                                               ToolTip="Puts the selected script of the library into the editor." AutomationProperties.AutomationId="btnUseScript" />
                                    <ListBox ItemsSource="{Binding ScriptLibrary}" SelectedItem="{Binding SelectedScriptItem}" ItemTemplate="{StaticResource LibraryItem}"
                                             ItemContainerStyle="{StaticResource LibraryListItem}" MouseDoubleClick="OnScriptLibraryDoubleClick"
                                             AutomationProperties.Name="Script library" AutomationProperties.AutomationId="lstScriptLibrary" />
                                </DockPanel>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" KeyboardNavigation.TabIndex="3" KeyboardNavigation.TabNavigation="Local">
                                    <WrapPanel>
                                        <ui:Button Content="Check" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding CheckDraftCommand}" Style="{StaticResource ToolButton}"
                                                   ToolTip="Checks the syntax of the script text. It does not run the script." AutomationProperties.Name="Check the syntax" AutomationProperties.AutomationId="btnCheckDraft" />
                                        <ui:Button Content="Submit" Icon="{ui:SymbolIcon CloudArrowUp24}" Command="{Binding SubmitDraftCommand}" Style="{StaticResource ToolButton}"
                                                   ToolTip="Shows the plan that submits the script to the site. The site stores it as Waiting for approval." AutomationProperties.Name="Submit the script"
                                                   AutomationProperties.AutomationId="btnSubmitDraft" />
                                        <TextBlock Text="{Binding EditorPosition}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="4,0,12,8" AutomationProperties.AutomationId="txtDraftPosition" />
                                    </WrapPanel>
                                    <TextBlock Text="{x:Static pages:PivotsScriptsPage.EditorKeyHint}" Style="{StaticResource Note}" Margin="0,0,0,4" AutomationProperties.AutomationId="txtDraftKeyHint" />
                                    <TextBlock Text="{Binding CheckResult}" Style="{StaticResource Note}" AutomationProperties.AutomationId="txtCheckResult" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History" AutomationProperties.AutomationId="tabPivotsHistory">
                <ScrollViewer x:Name="scrollPivotsHistoryTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollPivotsHistoryTab">
                    <Grid Height="{Binding ViewportHeight, ElementName=scrollPivotsHistoryTab}" MinHeight="620" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" MinHeight="160" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,4" KeyboardNavigation.TabIndex="0" KeyboardNavigation.TabNavigation="Local">
                            <ui:TextBox Text="{Binding HistoryText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter the audit records" Icon="{ui:SymbolIcon Search24}"
                                        MinWidth="260" Margin="0,0,8,8" AutomationProperties.Name="History filter" AutomationProperties.AutomationId="txtPivotsHistoryFilter" />
                            <ui:Button Content="Refresh history" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads the saved sessions and the audit log again." AutomationProperties.AutomationId="btnPivotsHistoryRefresh" />
                            <ui:Button Content="Open session" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenSessionCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Opens the selected saved session read only in the result tabs." AutomationProperties.AutomationId="btnOpenSession" />
                            <ui:Button Content="Wait again" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding WaitAgainCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads the results of the selected saved run again for the wait time. It sends nothing to the clients." AutomationProperties.AutomationId="btnWaitAgain" />
                            <TextBlock Text="{Binding SessionCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtSessionCount" />
                        </WrapPanel>
                        <DataGrid Grid.Row="1" x:Name="dgSessions" KeyboardNavigation.TabIndex="1" Style="{StaticResource GridBase}" ItemsSource="{Binding SessionRows}" SelectedItem="{Binding SelectedSession}"
                                  AutomationProperties.AutomationId="dgSessions" AutomationProperties.Name="Saved sessions">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="166" MinWidth="166" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" MinWidth="150" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="3*" MinWidth="200" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Devices" Binding="{Binding Devices}" Width="96" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="216" MinWidth="216" ElementStyle="{StaticResource StatusCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Margin="0,8,0,8" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                            <TextBlock Style="{StaticResource Note}" AutomationProperties.AutomationId="txtPivotsHistoryPath">
                                <Run Text="Audit log:" />
                                <Run Text="{Binding HistoryPath, Mode=OneWay}" />
                                <Run Text="  " />
                                <Run Text="{Binding HistoryCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding HistoryCapText}" Style="{StaticResource Warning}" Margin="0,4,0,0"
                                       Visibility="{Binding IsHistoryCapped, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtPivotsHistoryCap" />
                        </StackPanel>
                        <DataGrid Grid.Row="3" x:Name="dgPivotsHistory" KeyboardNavigation.TabIndex="3" Style="{StaticResource GridBase}" ItemsSource="{Binding HistoryRows}" SelectedItem="{Binding SelectedHistory}"
                                  FrozenColumnCount="1" AutomationProperties.AutomationId="dgPivotsHistory" AutomationProperties.Name="Audit records">
                            <DataGrid.Columns>
                                <!-- Each fixed width holds its longest real value with room for other display scalings; the target and the script hash are in the details box. -->
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="166" MinWidth="166" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" MinWidth="150" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="112" MinWidth="112" ElementStyle="{StaticResource StatusCell}" />
                                <DataGridTextColumn Header="Verified" Binding="{Binding Verified}" Width="124" MinWidth="124" ElementStyle="{StaticResource VerifiedStatusCell}" />
                                <DataGridTextColumn Header="Devices" Binding="{Binding Devices}" Width="96" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="176" MinWidth="176" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="240" ElementStyle="{StaticResource WrappedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Grid.Row="4" KeyboardNavigation.TabIndex="4" Text="{Binding HistoryDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="{Binding HasHistoryDetails, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Details of the selected record" AutomationProperties.AutomationId="txtPivotsHistoryDetails" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Options" AutomationProperties.AutomationId="tabPivotsOptions">
                <ScrollViewer x:Name="scrollPivotsOptionsTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollPivotsOptionsTab">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Connection" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Note}" AutomationProperties.AutomationId="txtOptionsSite">
                                    <Run Text="Site code:" />
                                    <Run Text="{Binding SiteCodeText, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="  SMS Provider:" />
                                    <Run Text="{Binding ProviderText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Text="Change the site code and the SMS Provider in Settings, ConfigMgr Site Settings. The page calls only the SMS Provider: its AdminService and the ConfigMgr session."
                                           Style="{StaticResource Note}" Margin="0,4,0,8" />
                                <WrapPanel>
                                    <ui:Button Content="Test connection" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding TestConnectionCommand}" Style="{StaticResource ToolButton}"
                                               ToolTip="Asks the SMS Provider for its AdminService." AutomationProperties.AutomationId="btnTestConnection" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ConnectionResult}" Style="{StaticResource Warning}" AutomationProperties.AutomationId="txtConnectionResult" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Library folder" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="The query and script libraries show the built-in samples, then the files of this folder. Leave it empty for the samples only."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLibraryFolderCommand}" Margin="8,0,0,0" AutomationProperties.Name="Clear the library folder"
                                               AutomationProperties.AutomationId="btnClearLibraryFolder" />
                                    <ui:Button DockPanel.Dock="Right" Content="Browse" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding BrowseLibraryFolderCommand}" Margin="8,0,0,0"
                                               AutomationProperties.Name="Browse for the library folder" AutomationProperties.AutomationId="btnBrowseLibraryFolder" />
                                    <ui:TextBox Text="{Binding LibraryFolder, UpdateSourceTrigger=LostFocus}" PlaceholderText="No folder: built-in samples only"
                                                AutomationProperties.Name="Library folder" AutomationProperties.AutomationId="txtLibraryFolder" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Result wait time" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="The page polls the site for the results of a run for at most this many minutes. Stop waiting ends the wait sooner; the clients still run the request."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding WaitChoiceList}" SelectedItem="{Binding WaitMinutes}" Width="120" HorizontalAlignment="Left"
                                          AutomationProperties.Name="Result wait time in minutes" AutomationProperties.AutomationId="cboWaitMinutes" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource Note}" Margin="0,8,0,0"
                   AutomationProperties.AutomationId="txtPivotsStatus" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
