                                <TextBlock Text="Packagers Folder (leave empty for auto-detect)" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,0,0,8" Width="480" HorizontalAlignment="Left">
                                    <ui:Button DockPanel.Dock="Right" Content="Browse"
                                               Command="{Binding BrowsePackagersRootCommand}" Margin="8,0,0,0" />
                                    <ui:TextBox ToolTip="{Binding PackagersRoot}" Text="{Binding PackagersRoot, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Auto-detect" />
                                </DockPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_dtdefaults" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <TextBlock Text="Deployment Type Defaults" Style="{StaticResource SectionHeader}" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Estimated Runtime (mins)" Style="{StaticResource FieldLabel}" />
