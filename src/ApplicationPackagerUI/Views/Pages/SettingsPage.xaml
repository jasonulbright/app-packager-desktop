<Page
    x:Class="ApplicationPackagerUI.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock"
    xmlns:svc="clr-namespace:ApplicationPackagerUI.Services"
    xmlns:sup="clr-namespace:ApplicationPackagerEngine.Services.Supersedence;assembly=ApplicationPackagerEngine"
    FontFamily="Segoe UI"
    FontSize="14"
    Foreground="{DynamicResource MkTextBrush}"
    TextOptions.TextFormattingMode="Ideal"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.xaml" />
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.Settings.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <helpers:InverseBooleanConverter x:Key="InverseBool" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <!-- h2 { font-size:19px; weight 650; letter-spacing:-.15px } : the name of a section, 26 px high with 14 px under it. -->
            <Style x:Key="SectionHeader" TargetType="mk:TrackedText">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Tracking" Value="-0.15" />
                <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
                <Setter Property="Height" Value="26" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
            <!-- .field > span { weight 550 } with 5 px between the name and its box. -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
                <Setter Property="Height" Value="19" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>
            <!-- One size for every input: the 34 px of the mock's field. -->
            <Style TargetType="ui:TextBox" BasedOn="{StaticResource Mk.Settings.UiTextBox}">
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <Style TargetType="ui:PasswordBox" BasedOn="{StaticResource Mk.Settings.UiPasswordBox}">
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource Mk.Settings.ComboBox}">
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <!-- The lists of the mock's section Application settings are 35 px high; the column of text of the bulk edit takes typed text. -->
            <Style x:Key="TallList" TargetType="ComboBox" BasedOn="{StaticResource Mk.Settings.ComboBox}">
                <Setter Property="Height" Value="35" />
            </Style>
            <Style x:Key="BulkValueList" TargetType="ComboBox" BasedOn="{StaticResource TallList}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BulkValues.Count}" Value="0">
                        <Setter Property="IsEditable" Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ui:NumberBox" BasedOn="{StaticResource Mk.Settings.NumberBox}" />
            <Style TargetType="CheckBox" BasedOn="{StaticResource Mk.Settings.CheckBox}" />
            <Style TargetType="RadioButton" BasedOn="{StaticResource Mk.Radio}" />
            <Style TargetType="ui:Button" BasedOn="{StaticResource Mk.Button}">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="SectionDivider" TargetType="Border">
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource MkLineBrush}" />
                <Setter Property="Margin" Value="0,12,0,12" />
            </Style>
            <!-- small { font-size:12px; color:the muted color } -->
            <Style x:Key="FieldHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource MkMutedBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="FieldSmall" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                <Setter Property="MinHeight" Value="16" />
                <Setter Property="Margin" Value="0,5,0,0" />
            </Style>
            <!-- h3 { font-size:15px; weight 650 } -->
            <Style x:Key="SubHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <!-- td of the application grid: 12 px at each side (one of them is the focus border of the cell). -->
            <Style x:Key="SettingsCell" TargetType="DataGridCell" BasedOn="{StaticResource Mk.GridCell}">
                <Setter Property="Padding" Value="11,0,11,0" />
            </Style>
            <!-- th of the application grid: the name stands as high as the mock sets it. -->
            <Style x:Key="SettingsHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Mk.GridHeader}">
                <Setter Property="Padding" Value="12,0,4,2" />
            </Style>
            <!-- tbody td:first-child { border-left:3px solid transparent } : the line under a row starts after that border. The chosen row has
                 the tint and the accent bar there. -->
            <Style x:Key="SettingsRow" TargetType="DataGridRow" BasedOn="{StaticResource Mk.GridRow}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Grid>
                                <Border x:Name="Face" Background="{TemplateBinding Background}" />
                                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="3,0,0,0" Fill="{DynamicResource MkLineBrush}" />
                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,0,1" SnapsToDevicePixels="True" />
                                <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,0,0,1" Fill="{DynamicResource MkAccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkSubBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource MkTintBrush}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BlockHeader" TargetType="TextBlock" BasedOn="{StaticResource SubHeader}">
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- .workspace { padding:0 24px 16px; gap:14px } : the header, the tree beside the section, and the line of unsaved changes. -->
    <Grid Margin="24,0,24,16" PreviewKeyDown="Search_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Settings" Icon="Settings24" Compact="True" TitleAutomationId="txtSettingsTitle">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" UseLayoutRounding="False">
                    <ui:Button Content="Discard changes"
                               Command="{Binding DiscardChangesCommand}"
                               Margin="0,0,8,0"
                               AutomationProperties.AutomationId="btnDiscardChanges"
                               ToolTip="Reloads every setting on this page from the saved settings. Unsaved edits are lost." />
                    <ui:Button Content="Save settings"
                               Style="{StaticResource Mk.Button.Primary}"
                               mk:Mk.Icon="save"
                               Command="{Binding SaveSettingsCommand}"
                               AutomationProperties.AutomationId="btnSaveSettings"
                               ToolTip="Saves the settings on this page. Discard changes reloads the saved values instead." />
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" MinWidth="205" MaxWidth="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
            <!-- The search shows on request (Ctrl+F or the menu of the list of pages) and stays while it holds text. -->
            <ui:TextBox x:Name="txtSettingsSearch" DockPanel.Dock="Top" Margin="0,0,0,8" PlaceholderText="Search settings" Visibility="Collapsed"
                        TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                        AutomationProperties.AutomationId="txtSettingsSearch" AutomationProperties.Name="Search settings"
                        ToolTip="Type the name of a setting; Enter opens the first match." />
            <TextBlock x:Name="txtSettingsSearchCount" DockPanel.Dock="Top" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                       Foreground="{DynamicResource MkMutedBrush}" AutomationProperties.AutomationId="txtSettingsSearchCount"
                       AutomationProperties.LiveSetting="Polite" />
            <Border Style="{StaticResource Mk.Panel}">
            <Grid>
            <TreeView x:Name="OptionsTree" AutomationProperties.AutomationId="tvOptions" Style="{StaticResource Mk.Settings.Tree}"
                      AutomationProperties.Name="Settings sections" SelectedItemChanged="OptionsTree_SelectedItemChanged">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Search settings" InputGestureText="Ctrl+F" Click="ShowSearch_Click" AutomationProperties.AutomationId="miSearchSettings" />
                        <MenuItem Header="Discovery connection options" Click="ShowDiscoveryOptions_Click" AutomationProperties.AutomationId="miTreeDiscoveryOptions" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource Mk.Settings.TreeNode}" />
                </TreeView.ItemContainerStyle>
                <TreeViewItem Header="General" ToolTip="Holds the theme, the update check, your company name and the import from the PowerShell app." Tag="general" IsSelected="True" AutomationProperties.AutomationId="nav_general" />
                <TreeViewItem Header="Sidebar" ToolTip="Select which entries the sidebar shows and set their order." Tag="sidebar" AutomationProperties.AutomationId="nav_sidebar" />
                <TreeViewItem Header="Connections" ToolTip="Holds the connection settings of ConfigMgr, WSUS, Intune and the GitHub API." IsExpanded="True" AutomationProperties.AutomationId="nav_connections" Style="{StaticResource Mk.Settings.TreeGroup}">
                    <TreeViewItem Header="Systems in use" ToolTip="Select the systems that you publish to." Tag="systems" AutomationProperties.AutomationId="nav_systems" />
                    <TreeViewItem Header="ConfigMgr" ToolTip="Holds the site code, the site server, the Discover unmanaged software settings and the file share." Tag="configmgr" AutomationProperties.AutomationId="nav_configmgr" />
                    <TreeViewItem Header="WSUS" ToolTip="Holds the WSUS server, the signing certificate and the publishing options." Tag="wsus" AutomationProperties.AutomationId="nav_wsus" />
                    <TreeViewItem Header="Intune" ToolTip="Holds the tenant ID, the client ID, the client secret and the minimum Windows release." Tag="intune" AutomationProperties.AutomationId="nav_intune" />
                    <TreeViewItem Header="GitHub API" ToolTip="Holds the GitHub token and shows the API request limit." Tag="github" AutomationProperties.AutomationId="nav_github" />
                </TreeViewItem>
                <TreeViewItem Header="Packaging" ToolTip="Holds the settings for packaging applications." IsExpanded="True" AutomationProperties.AutomationId="nav_packaging" Style="{StaticResource Mk.Settings.TreeGroup}">
                    <TreeViewItem Header="Folders" ToolTip="Holds the content layout, the Download Root and the Packagers folder." Tag="folders" AutomationProperties.AutomationId="nav_folders" />
                    <TreeViewItem Header="Deployment Type Defaults" ToolTip="Holds the default runtimes and the distribution point fallback settings of Deployment Types." Tag="dtdefaults" AutomationProperties.AutomationId="nav_dtdefaults" />
                    <TreeViewItem Header="Application Title" ToolTip="Holds the options that build Application names." Tag="title" AutomationProperties.AutomationId="nav_title" />
                    <TreeViewItem Header="Post Packaging" ToolTip="Holds the optional steps after the ConfigMgr Application exists: content distribution and a test deployment." Tag="postpackaging" AutomationProperties.AutomationId="nav_postpackaging" />
                    <TreeViewItem Header="Application Settings" ToolTip="Holds the version rules, the supersedence mode and the architecture, install scope and version in the title of each Application." Tag="supersedence" AutomationProperties.AutomationId="nav_supersedence" />
                </TreeViewItem>
                <TreeViewItem Header="Applications" ToolTip="Holds the settings of individual applications and installers." IsExpanded="True" AutomationProperties.AutomationId="nav_applications" Style="{StaticResource Mk.Settings.TreeGroup}">
                    <TreeViewItem Header="Citrix Workspace App" ToolTip="Holds the store, installation, plugin and component switches for the Citrix Workspace app installer." Tag="citrix" AutomationProperties.AutomationId="nav_citrix" helpers:SettingsSearchHints.Keywords="store installation plugins components addlocal" />
                    <TreeViewItem Header="Citrix Updates and Policy" ToolTip="Holds the update, telemetry, store policy and HDX switches for the Citrix Workspace app installer." Tag="citrixpolicy" AutomationProperties.AutomationId="nav_citrixpolicy" helpers:SettingsSearchHints.Keywords="citrix workspace update telemetry store policy hdx" />
                    <TreeViewItem Header="M365 Apps" ToolTip="Holds the update channel for the M365 Apps, Project and Visio packagers." Tag="m365" AutomationProperties.AutomationId="nav_m365" />
                    <TreeViewItem Header="Install Parameters" ToolTip="Holds the installer switches and choices that are saved for each application." Tag="installparams" AutomationProperties.AutomationId="nav_installparams" />
                    <TreeViewItem Header="Local Installer Sources" ToolTip="Holds the folders that supply installers that a script cannot download." Tag="localsources" AutomationProperties.AutomationId="nav_localsources" />
                    <TreeViewItem Header="Packager Files" ToolTip="Holds the files that an installer reads from its own folder, such as a license key." Tag="packagerfiles" AutomationProperties.AutomationId="nav_packagerfiles" />
                </TreeViewItem>
                <TreeViewItem Header="Updates and CVEs" ToolTip="Holds the One Click and CVE lookup settings." IsExpanded="True" AutomationProperties.AutomationId="nav_updates" Style="{StaticResource Mk.Settings.TreeGroup}">
                    <TreeViewItem Header="One Click" ToolTip="Holds the action, cadence, destinations and tracked applications of One Click." Tag="oneclick" AutomationProperties.AutomationId="nav_oneclick" />
                    <TreeViewItem Header="CVE Lookup" ToolTip="Holds the NVD API key and the CVE lookup option." Tag="cve" AutomationProperties.AutomationId="nav_cve" />
                </TreeViewItem>
                <TreeViewItem Header="Security" ToolTip="Holds the security settings." IsExpanded="True" AutomationProperties.AutomationId="nav_security" Style="{StaticResource Mk.Settings.TreeGroup}">
                    <TreeViewItem Header="Script Signing" ToolTip="Holds the Authenticode signing settings for the scripts that the app generates." Tag="signing" AutomationProperties.AutomationId="nav_signing" />
                </TreeViewItem>
                <TreeViewItem Header="Tools" ToolTip="Shows the status of the helper tools and downloads the Win32 Content Prep Tool and the icon pack." Tag="tools" AutomationProperties.AutomationId="nav_tools" />
                <TreeViewItem Header="About" ToolTip="Shows what the app does and opens the releases page." Tag="about" AutomationProperties.AutomationId="nav_about" />
            </TreeView>
            <ListBox x:Name="lstSettingsSearch" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Margin="2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Once"
                     PreviewKeyDown="SearchList_PreviewKeyDown" PreviewMouseLeftButtonUp="SearchList_MouseUp"
                     AutomationProperties.AutomationId="lstSettingsSearch" AutomationProperties.Name="Search results"
                     ToolTip="Select a search result to open the setting." />
            </Grid>
            </Border>
            </DockPanel>

            <GridSplitter x:Name="NavigationSplitter" Grid.Column="1" Width="16" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Focusable="False"
                          ToolTip="Drag to change the width of the list of pages." />

            <Grid Grid.Column="2">
            <ScrollViewer x:Name="page_general" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                    <mk:TrackedText Text="General" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="Appearance" Style="{StaticResource SubHeader}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton Content="Dark Theme" helpers:SettingsSearchHints.Keywords="appearance" Margin="0,0,16,0"
                                                 IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark}"
                                                 Command="{Binding ChangeThemeCommand}" CommandParameter="Dark"
                                                 ToolTip="Switches the app to the dark theme." />
                                    <RadioButton Content="Light Theme" helpers:SettingsSearchHints.Keywords="appearance"
                                                 IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light}"
                                                 Command="{Binding ChangeThemeCommand}" CommandParameter="Light"
                                                 ToolTip="Switches the app to the light theme." />
                                </StackPanel>

                    <TextBlock Text="Updates" Style="{StaticResource SubHeader}" />
                                <CheckBox Content="Check for a new version when the app starts" helpers:SettingsSearchHints.Keywords="update release startup" IsChecked="{Binding CheckForUpdatesAtStartup}"
                                          AutomationProperties.AutomationId="chkCheckForUpdatesAtStartup"
                                          ToolTip="Asks GitHub for the latest release. No sign-in and no data from this computer are sent. A newer version opens the update window; nothing installs until you confirm. Save settings stores this choice." />
                                <ui:Button Content="Check for updates" mk:Mk.Icon="arrow_sync" Margin="0,8,0,8"
                                           Click="CheckForUpdates_Click"
                                           AutomationProperties.AutomationId="btnCheckForUpdates"
                                           ToolTip="Look up the latest release now." />

                    <TextBlock Text="Setup" Style="{StaticResource SubHeader}" />
                                <ui:Button Content="Setup checklist" mk:Mk.Icon="list" Margin="0,0,0,8" HorizontalAlignment="Left"
                                           Click="ShowSetupChecklist_Click" AutomationProperties.AutomationId="btnSettingsSetupChecklist"
                                           ToolTip="Open the setup checklist beside the application grid." />

                    <TextBlock Text="Organization" Style="{StaticResource SubHeader}" />
                                <TextBlock Text="Company Name" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox AutomationProperties.Name="Company Name" Width="360" HorizontalAlignment="Left" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Contoso, Ltd." Margin="0,0,0,8"
                                            ToolTip="Enter the name of your organization. Save settings stores it." />

                    <TextBlock Text="Import" Style="{StaticResource SubHeader}" Margin="0,8,0,8" />
                    <ui:Button Content="Import from App Packager (PowerShell)" mk:Mk.Icon="arrow_download"
                               Command="{Binding ImportFromPowerShellCommand}" HorizontalAlignment="Left" Margin="0,0,0,4"
                               AutomationProperties.AutomationId="btnImportFromPowerShell"
                               ToolTip="Reads AppPackager.preferences.json of the PowerShell app, next to its script or from a file you choose, and shows what would change before it writes anything. Credentials are never imported and the PowerShell file is not changed." />
                    <TextBlock Text="Shows a preview first. Credentials are never imported."
                               Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_sidebar" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="Sidebar" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Select the entries that the sidebar shows and set their order. Each change applies at once; Save settings is not necessary. An entry moves only inside its group. App Packager is the start page and stays first."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Sidebar.Rows}" Focusable="False" Margin="0,0,0,8"
                                              AutomationProperties.AutomationId="lstSidebar">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding GroupCaption}"
                                                           Visibility="{Binding IsGroupStart, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           AutomationProperties.Name="{Binding GroupAutomationName}"
                                                           FontSize="12" Margin="0,8,0,4"
                                                           Foreground="{DynamicResource MkMutedBrush}" />
                                                <DockPanel Margin="0,0,0,4" Width="360" HorizontalAlignment="Left">
                                                    <ui:Button DockPanel.Dock="Right" Content="{ui:SymbolIcon ArrowDown24}"
                                                               Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                                                               Margin="4,0,0,0" ToolTip="Move down"
                                                               AutomationProperties.Name="{Binding Title, StringFormat=Move {0} down}" />
                                                    <ui:Button DockPanel.Dock="Right" Content="{ui:SymbolIcon ArrowUp24}"
                                                               Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                                                               Margin="4,0,0,0" ToolTip="Move up"
                                                               AutomationProperties.Name="{Binding Title, StringFormat=Move {0} up}" />
                                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding Shown}" IsEnabled="{Binding CanHide}"
                                                              VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding Title, StringFormat=Show {0}}"
                                                              ToolTip="Show this entry in the sidebar. The box is disabled for an entry that must stay visible." />
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Content="Reset sidebar" mk:Mk.Icon="history"
                                           Command="{Binding Sidebar.ResetCommand}"
                                           AutomationProperties.AutomationId="btnResetSidebar"
                                           ToolTip="Restores the default order and shows every entry." />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_systems" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="Systems in use" Style="{StaticResource SectionHeader}"
                                           ToolTip="Publish All on the App Packager page publishes to each system in use. It does not publish to a system that is not in use." />
                                <TextBlock Text="Publish All on the App Packager page publishes to each system in use. It does not publish to a system that is not in use."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="ConfigMgr" IsChecked="{Binding UseConfigMgr}" Margin="0,0,24,0"
                                              AutomationProperties.AutomationId="chkSystemsConfigMgr"
                                              ToolTip="ConfigMgr applications. Needs the ConfigMgr console, a site and a content share." />
                                    <CheckBox Content="Intune" IsChecked="{Binding UseIntune}" Margin="0,0,24,0"
                                              AutomationProperties.AutomationId="chkSystemsIntune"
                                              ToolTip="Intune Win32 apps published through Microsoft Graph. Needs an app registration." />
                                    <CheckBox Content="WSUS" IsChecked="{Binding UseWsus}"
                                              AutomationProperties.AutomationId="chkSystemsWsus"
                                              ToolTip="Locally published WSUS updates for computers that have an older version. Needs a WSUS server." />
                                </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_configmgr" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid VerticalAlignment="Top">
                    <!-- .stack { max-width:1110px; gap:14px }, at the left. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100000*" MaxWidth="1110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel Height="26" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" Background="Transparent"
                                        ToolTip="{Binding ConfigMgrSignalToolTip}">
                                <mk:Ico Glyph="{Binding ConfigMgrSignalIcon, FallbackValue=info}" Foreground="{Binding Foreground, ElementName=txtConfigMgrSignalText}" />
                                <TextBlock x:Name="txtConfigMgrSignalText" Text="{Binding ConfigMgrSignalText}" VerticalAlignment="Center" Margin="6,0,0,0"
                                           AutomationProperties.AutomationId="txtConfigMgrSignal" AutomationProperties.LiveSetting="Polite">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfigMgrSignalKind}" Value="good">
                                                    <Setter Property="Foreground" Value="{DynamicResource MkOkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConfigMgrSignalKind}" Value="warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource MkWarnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConfigMgrSignalKind}" Value="bad">
                                                    <Setter Property="Foreground" Value="{DynamicResource MkBadBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <mk:TrackedText Text="ConfigMgr connection" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Top" />
                        </DockPanel>

                        <Border Style="{StaticResource Mk.Panel}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Site" Style="{StaticResource BlockHeader}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100000*" MaxWidth="720" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Site code" Style="{StaticResource FieldLabel}" />
                                            <ui:TextBox Text="{Binding SiteCode, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="site switch sites"
                                                        PlaceholderText="MCM" MaxLength="5"
                                                        AutomationProperties.Name="Site code"
                                                        ToolTip="Enter the site code of your ConfigMgr site. Up to five characters." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="SMS Provider host" Style="{StaticResource FieldLabel}" />
                                            <ui:TextBox Text="{Binding ProviderMachine, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="smsprovider provider site server"
                                                        PlaceholderText="cm01.contoso.com" AutomationProperties.Name="SMS Provider host"
                                                        AutomationProperties.HelpText="Leave empty when this computer is the SMS Provider."
                                                        ToolTip="Host the generated CMSite drive connects to. Leave empty to use the local computer, which only reaches the site when this computer is itself the SMS Provider." />
                                            <TextBlock Text="Leave empty when this computer is the SMS Provider." Style="{StaticResource FieldSmall}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <TextBlock Text="Content share root (UNC)" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox ToolTip="{Binding FileShareRoot}" Text="{Binding FileShareRoot, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="content share unc file"
                                            PlaceholderText="\\fileserver\sccm$"
                                            AutomationProperties.AutomationId="txtFileShareRoot" AutomationProperties.Name="Content share root (UNC)"
                                            AutomationProperties.HelpText="The UNC share where the content of each application goes. The ConfigMgr site must reach it." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Mk.Panel}" Padding="20" Margin="0,0,0,14">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Discovery connection options" Click="ShowDiscoveryOptions_Click" AutomationProperties.AutomationId="miDiscoveryOptions" />
                                    <MenuItem Header="Test connection" Command="{Binding TestDiscoveryConnectionCommand}" AutomationProperties.AutomationId="miDiscoveryTestConnection" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Background="Transparent">
                                <TextBlock Text="Discover unmanaged software" Style="{StaticResource BlockHeader}"
                                           ToolTip="Right-click this panel for Test connection and the connection options of Discover." />
                                <TextBlock Text="Discover matches installed software names and versions against the APD catalog. Results help you choose applications to package."
                                           FontSize="12" LineHeight="18" TextWrapping="Wrap" MinHeight="18" Margin="0,1,0,13" Foreground="{DynamicResource MkMutedBrush}"
                                           ToolTip="Reads the hardware inventory of the site and lists the products that are installed on devices and have no ConfigMgr application. A scan only offers products; nothing changes until you choose." />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Discovery SQL Server" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding Discovery.SqlServer, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="discover unmanaged software sql instance port"
                                                    PlaceholderText="Site SQL Server" MaxLength="200"
                                                    AutomationProperties.AutomationId="txtDiscoverySqlServer" AutomationProperties.Name="Discovery SQL Server"
                                                    AutomationProperties.HelpText="Leave empty to use the SQL Server from the SMS Provider."
                                                    ToolTip="SQL Server instance of the ConfigMgr site database for Discover unmanaged software. The server accepts a name, name,port or name\instance, for example cm01.contoso.com,1433. Windows authentication only." />
                                        <TextBlock Text="Leave empty to use the SQL Server from the SMS Provider." Style="{StaticResource FieldSmall}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Discovery database" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding Discovery.SqlDatabase, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="discover unmanaged software sql cm_ database name"
                                                    PlaceholderText="CM_ and the site code" MaxLength="128"
                                                    AutomationProperties.AutomationId="txtDiscoverySqlDatabase" AutomationProperties.Name="Discovery database"
                                                    AutomationProperties.HelpText="Leave empty to use the site database."
                                                    ToolTip="Name of the ConfigMgr site database, for example CM_MCM. The account needs db_datareader on this database." />
                                        <TextBlock Text="Leave empty to use the site database." Style="{StaticResource FieldSmall}" />
                                    </StackPanel>
                                </Grid>
                                <DockPanel Height="32" UseLayoutRounding="False" LastChildFill="False">
                                    <ui:Button DockPanel.Dock="Right" Content="Clear list" Command="{Binding Discovery.ClearDismissedCommand}"
                                               helpers:SettingsSearchHints.Title="Applications hidden from Discover" helpers:SettingsSearchHints.Keywords="discover unmanaged dismissed not offered clear list"
                                               helpers:SettingsSearchHints.Unavailable="The button is available when Discover hides at least one application."
                                               AutomationProperties.AutomationId="btnClearDiscoveryDismissed"
                                               ToolTip="Offer these apps again in later discoveries. Takes effect on Save." />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Discovery.DismissedSummary}" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource MkMutedBrush}" AutomationProperties.AutomationId="txtDiscoveryDismissed"
                                               ToolTip="Apps that Discover unmanaged software leaves out after Don't ask again for selected." />
                                    <ui:Button DockPanel.Dock="Left" Content="Discover not selected" mk:Mk.Icon="search" Command="{Binding DiscoverNotSelectedCommand}"
                                               AutomationProperties.AutomationId="btnDiscoverNotSelected"
                                               ToolTip="Scan only the products that you have not selected in the Catalog and did not dismiss. Starts at once; the result or the error shows below the buttons and in the log." />
                                    <ui:Button DockPanel.Dock="Left" Content="Discover all" mk:Mk.Icon="search" Command="{Binding DiscoverAllCommand}" Margin="8,0,0,0"
                                               AutomationProperties.AutomationId="btnDiscoverAll"
                                               ToolTip="Scan every product, also the ones that you selected or dismissed. Starts at once; the result or the error shows below the buttons and in the log." />
                                </DockPanel>
                                <!-- The connection options and the result of a run: shown on request, after a run or a test, and while an option is set. -->
                                <StackPanel x:Name="pnlDiscoveryOptions" Margin="0,14,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Discovery.EncryptConnection}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Discovery.TrustServerCertificate}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="Tag" Value="shown">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <WrapPanel>
                                        <CheckBox Content="Encrypt the connection" helpers:SettingsSearchHints.Keywords="discovery sql" IsChecked="{Binding Discovery.EncryptConnection}" Margin="0,0,24,8"
                                                  VerticalAlignment="Center" AutomationProperties.AutomationId="chkDiscoveryEncrypt"
                                                  ToolTip="Ask SQL Server for an encrypted connection (Encrypt=True). Leave it cleared to keep the default of the SQL client. Stored for this site." />
                                        <CheckBox Content="Trust server certificate" helpers:SettingsSearchHints.Keywords="discovery sql" IsChecked="{Binding Discovery.TrustServerCertificate}" Margin="0,0,24,8"
                                                  VerticalAlignment="Center" AutomationProperties.AutomationId="chkDiscoveryTrustCertificate"
                                                  ToolTip="Do not validate the certificate chain of the SQL Server (TrustServerCertificate=True). Select it when the SQL Server certificate is self-signed or issued by an authority that this computer does not trust. The connection stays encrypted. The same option as in Site Hygiene, Live. Stored for this site." />
                                        <ui:Button Content="Test connection" Command="{Binding TestDiscoveryConnectionCommand}" helpers:SettingsSearchHints.Keywords="discovery sql discover" Margin="0,0,0,8"
                                                   AutomationProperties.AutomationId="btnDiscoveryTestConnection"
                                                   ToolTip="Connect to the site database with the values on this page (not yet saved) and read one row of the inventory views. Shows the result or the exact error below." />
                                    </WrapPanel>
                                    <TextBlock Text="The server accepts a name, name,port or name\instance, for example cm01.contoso.com,1433 or cm01.contoso.com\SCCM." Style="{StaticResource FieldHint}" Margin="0" />
                                    <TextBlock Text="{Binding DiscoverStatus}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                               AutomationProperties.AutomationId="txtDiscoverStatus" AutomationProperties.Name="{Binding DiscoverStatus}"
                                               Foreground="{DynamicResource MkTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- .notice { background:the sub color; border-left:3px; padding:9px 13px } -->
                        <Border Style="{StaticResource Mk.Notice}" Height="39" Padding="13,0,13,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <mk:Ico Glyph="info" Foreground="{DynamicResource MkTextBrush}" Margin="0,3,3.8,0" />
                                <TextBlock Text="Change which systems appear in the publish plan in " VerticalAlignment="Center" Margin="0,-1,0,0" />
                                <Button Style="{StaticResource Mk.Settings.TextLink}" Content="Systems in use" VerticalAlignment="Center" Margin="0,-1,0,0"
                                        helpers:SettingsSearchHints.Exclude="True" Click="OpenSystemsInUse_Click"
                                        AutomationProperties.AutomationId="btnOpenSystemsInUse" AutomationProperties.Name="Open Systems in use"
                                        ToolTip="Opens the page Systems in use." />
                                <TextBlock Text="." VerticalAlignment="Center" Margin="0,-1,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <ScrollViewer x:Name="page_wsus" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="WSUS" Style="{StaticResource SectionHeader}" />
                                <TextBlock Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="A publish to WSUS sends the installer of each checked app to the server as a locally published update. The WSUS Updates entry of the sidebar lists and manages the published updates. This computer needs the WSUS console or RSAT WSUS tools at the server's version, an account in the WSUS Administrators group, and file-share access to the server. When this computer is not the WSUS server, it must also trust the signing certificate." />

                                <TextBlock Text="Server" Style="{StaticResource SubHeader}" />
                                <TextBlock Text="WSUS server" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Width="360" HorizontalAlignment="Left" Text="{Binding Wsus.ServerName, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="wsus server" PlaceholderText="wsus01.contoso.com" Margin="0,0,0,8"
                                            AutomationProperties.Name="WSUS server" AutomationProperties.AutomationId="txtWsusServer"
                                            ToolTip="Host name of the WSUS server. With ConfigMgr, the WSUS server of the top-level software update point." />
                                <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,0,0,4">
                                    <ui:Button DockPanel.Dock="Right" Content="Cancel" helpers:SettingsSearchHints.Exclude="True" Command="{Binding Wsus.CancelCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding Wsus.Busy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               AutomationProperties.AutomationId="btnWsusCancel" Style="{StaticResource CancelSlot}"
                                               ToolTip="Cancels the WSUS operation that is running." />
                                    <ui:Button DockPanel.Dock="Right" Content="Test connection" Command="{Binding Wsus.TestConnectionCommand}" helpers:SettingsSearchHints.Keywords="wsus server" Margin="8,0,0,0"
                                               VerticalAlignment="Center" AutomationProperties.AutomationId="btnWsusTest" ToolTipService.ShowOnDisabled="True"
                                               ToolTip="Connects with the values in the boxes and reads the server version, the account role and the signing certificate." />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBox Text="{Binding Wsus.Port, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="wsus port 8530 8531" Width="100" MaxLength="5"
                                                    AutomationProperties.Name="WSUS port" AutomationProperties.AutomationId="txtWsusPort"
                                                    ToolTip="8530 for HTTP and 8531 for HTTPS on a default WSUS install." />
                                        <CheckBox Content="Use SSL" helpers:SettingsSearchHints.Keywords="wsus https tls" IsChecked="{Binding Wsus.UseSsl}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="chkWsusSsl" ToolTip="Connect to the WSUS administration API over HTTPS." />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Wsus.StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="txtWsusStatus" Foreground="{DynamicResource MkMutedBrush}" />

                                <TextBlock Text="Signing Certificate" Style="{StaticResource SubHeader}" />
                                <TextBlock Text="{Binding Wsus.CertificateText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="txtWsusCert" Foreground="{DynamicResource MkMutedBrush}" />
                                <WrapPanel Margin="0,0,0,8">
                                    <ui:Button Content="Create self-signed..." helpers:SettingsSearchHints.Keywords="wsus signing certificate" Command="{Binding Wsus.CreateSelfSignedCommand}" Margin="0,0,8,4"
                                               AutomationProperties.AutomationId="btnWsusCertCreate" ToolTipService.ShowOnDisabled="True"
                                               ToolTip="Has the WSUS server create and use a self-signed signing certificate." />
                                    <ui:Button Content="Import PFX..." helpers:SettingsSearchHints.Keywords="wsus signing certificate" Command="{Binding Wsus.ImportPfxCommand}" Margin="0,0,8,4"
                                               AutomationProperties.AutomationId="btnWsusCertImport" ToolTipService.ShowOnDisabled="True"
                                               ToolTip="Sets a code-signing certificate with its private key from a PFX file, for example one issued by your PKI." />
                                    <ui:Button Content="Export certificate..." helpers:SettingsSearchHints.Keywords="wsus signing certificate" Command="{Binding Wsus.ExportCertificateCommand}" Margin="0,0,8,4"
                                               AutomationProperties.AutomationId="btnWsusCertExport" ToolTipService.ShowOnDisabled="True"
                                               ToolTip="Saves the public signing certificate (.cer) for distribution to clients by Group Policy." />
                                </WrapPanel>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource MkMutedBrush}"
                                           AutomationProperties.AutomationId="txtWsusClientTrust"
                                           Text="Devices install locally published updates only when the signing certificate is in their Trusted Publishers store (and Trusted Root Certification Authorities when it is self-signed) and the policy Allow signed updates from an intranet Microsoft update service location is enabled: HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate, AcceptTrustedPublisherCerts = 1 (DWORD)." />

                                <TextBlock Text="Publishing" Style="{StaticResource SubHeader}" />
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource MkMutedBrush}"
                                           AutomationProperties.AutomationId="txtWsusPolicy"
                                           Text="Each update installs only where an older version of the application is installed. A computer without the application does not get the update." />
                                <TextBlock Text="Classification" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Wsus.ClassificationOptions}" DisplayMemberPath="Label" SelectedValuePath="Name"
                                          SelectedValue="{Binding Wsus.Classification}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          AutomationProperties.Name="Classification" AutomationProperties.AutomationId="cboWsusClassification"
                                          ToolTip="WSUS classification of every published update. With ConfigMgr, the software update point must synchronize it." />
                                <TextBlock Text="Approve for group" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="Load groups" helpers:SettingsSearchHints.Exclude="True" Command="{Binding Wsus.LoadGroupsCommand}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" AutomationProperties.AutomationId="btnWsusGroups" ToolTipService.ShowOnDisabled="True"
                                               ToolTip="Lists the computer groups of the server in the box." />
                                    <ComboBox helpers:TemplatePartNames.FromOwner="True" IsEditable="True" ItemsSource="{Binding Wsus.Groups}" helpers:SettingsSearchHints.Keywords="wsus computer group approval load groups" Text="{Binding Wsus.ApprovalGroup, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="Approve for group" AutomationProperties.AutomationId="cboWsusGroup"
                                              ToolTip="Computer group the update is approved for right after it publishes. Leave empty to approve later from WSUS Updates (sidebar): the WSUS console does not list locally published updates." />
                                </DockPanel>
                                <CheckBox Content="Decline earlier versions of the same application after publishing" helpers:SettingsSearchHints.Keywords="wsus decline superseded supersedence" IsChecked="{Binding Wsus.DeclineSuperseded}" Margin="0,0,0,8"
                                          AutomationProperties.AutomationId="chkWsusDecline"
                                          ToolTip="Declines the AppPackager updates of the same application that have a lower version. Approving one again reverses it." />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_intune" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="Intune" Style="{StaticResource SectionHeader}" />

                                <TextBlock Text="Publishing needs an Entra app registration with the application permission DeviceManagementApps.ReadWrite.All, admin-consented."
                                           Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox AutomationProperties.Name="Tenant ID" Width="360" HorizontalAlignment="Left" Text="{Binding IntuneTenantId, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="entra azure"
                                            PlaceholderText="contoso.onmicrosoft.com or a GUID" Margin="0,0,0,8"
                                            ToolTip="Enter the tenant ID or the primary domain of your Microsoft Entra tenant. The app uses it to sign in to Microsoft Graph." />

                                <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox AutomationProperties.Name="Client ID" Width="360" HorizontalAlignment="Left" Text="{Binding IntuneClientId, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="app registration graph"
                                            PlaceholderText="App registration (client) ID" Margin="0,0,0,8"
                                            ToolTip="Enter the application (client) ID of the Entra app registration that publishes to Intune." />

                                <TextBlock Text="Minimum Windows release" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding IntuneWindowsReleaseChoices}" helpers:SettingsSearchHints.Keywords="minimum supported windows release"
                                          SelectedItem="{Binding IntuneMinimumWindowsRelease}"
                                          Width="240" HorizontalAlignment="Left" Margin="0,0,0,4"
                                          AutomationProperties.Name="Minimum Windows release" AutomationProperties.AutomationId="cboIntuneMinimumWindowsRelease"
                                          ToolTip="The oldest Windows release that an Intune app is offered to. Every app that this program publishes to Intune gets it. Default: Windows10_21H2." />
                                <TextBlock Text="Every Intune app that is published gets this minimum release. Default: Windows10_21H2."
                                           Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" />
                                <ui:PasswordBox AutomationProperties.Name="Client Secret" Width="360" HorizontalAlignment="Left" Password="{Binding IntuneClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="dpapi"
                                                PlaceholderText="{Binding IntuneSecretHint}" Margin="0,0,0,4"
                                                ToolTip="Enter the client secret of the app registration. Save settings stores it encrypted for the current Windows user. Leave it empty to keep the saved secret." />
                                <TextBlock Text="Stored encrypted for the current Windows user. Leave empty to keep the saved secret."
                                           Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="Only a publish to Intune builds the .intunewin; the first build downloads the Win32 Content Prep Tool when it is missing."
                                           Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_github" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="GitHub API" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="About a third of the catalog reads api.github.com. Without a token, requests share 60 per hour per address; a token saved below, an environment variable or a sign-in with the GitHub CLI raises that to 5,000. The line below says which one is in use."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="Refresh"
                                               mk:Mk.Icon="arrow_sync"
                                               Command="{Binding RefreshGitHubApiStatusCommand}" helpers:SettingsSearchHints.Title="GitHub API status" helpers:SettingsSearchHints.Keywords="authentication token rate limit refresh"
                                               IsEnabled="{Binding GitHubApiIdle}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               ToolTip="Asks api.github.com for the request quota of the credentials that the app uses and shows it here." />
                                    <TextBlock Text="{Binding GitHubApiStatus}"
                                               Foreground="{DynamicResource MkMutedBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBlock Text="GitHub token" Style="{StaticResource FieldLabel}" />
                                <ui:PasswordBox AutomationProperties.Name="GitHub token" Width="360" HorizontalAlignment="Left" Password="{Binding GitHubToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="github key personal access token pat"
                                                PlaceholderText="{Binding GitHubTokenHint}" Margin="0,0,0,4"
                                                AutomationProperties.AutomationId="pwdGitHubToken"
                                                ToolTip="Enter a GitHub personal access token to override the token of the environment or the GitHub CLI. Save settings stores it encrypted for the current Windows user. Leave it empty to keep the saved token." />
                                <TextBlock Text="{Binding GitHubTokenNote}"
                                           Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <CheckBox Content="Remove the saved token on Save"
                                          IsChecked="{Binding RemoveGitHubToken}"
                                          IsEnabled="{Binding HasStoredGitHubToken}" helpers:SettingsSearchHints.Unavailable="The box is disabled when no token is saved."
                                          Margin="0,0,0,8"
                                          AutomationProperties.AutomationId="chkRemoveGitHubToken"
                                          ToolTip="Select to delete the saved token when you select Save settings. The box is disabled when no token is saved." />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_folders" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                    <mk:TrackedText Text="Folders" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Content Layout" Style="{StaticResource FieldLabel}" />
                                <ComboBox AutomationProperties.Name="Content Layout" SelectedValue="{Binding ContentLayout}" helpers:SettingsSearchHints.Keywords="share folder structure"
                                          SelectedValuePath="Tag"
                                          Width="320" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          ToolTip="Folder shape under the share's Applications folder. Nested keeps one folder per vendor and application with a version folder inside; Flat puts every version in one level named Vendor-App-Version.">
                                    <ComboBoxItem Content="Nested - Applications\Vendor\App\Version" Tag="Nested" />
                                    <ComboBoxItem Content="Flat - Applications\Vendor-App-Version" Tag="Flat" />
                                </ComboBox>

                                <TextBlock Text="Download Root (local staging)" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,0,0,8" Width="480" HorizontalAlignment="Left">
                                    <ui:Button DockPanel.Dock="Right" Content="Browse"
                                               Command="{Binding BrowseDownloadRootCommand}" helpers:SettingsSearchHints.Exclude="True" Margin="8,0,0,0"
                                               ToolTip="Select the Download Root folder." />
                                    <ui:TextBox AutomationProperties.Name="Download Root (local staging)" Text="{Binding DownloadRoot, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DownloadRoot}" helpers:SettingsSearchHints.Keywords="stage download folder browse"
                                                PlaceholderText="C:\temp\ap" />
                                </DockPanel>
                    <TextBlock Text="{Binding StagingWarning}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding ShowStagingWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource MkWarnBrush}"
                               AutomationProperties.AutomationId="txtStagingWarning" />
                    <WrapPanel Margin="0,0,0,8" Visibility="{Binding ShowStagingWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:Button Content="Create a safe folder" Command="{Binding CreateSafeStagingFolderCommand}" helpers:SettingsSearchHints.Keywords="staging download root folder" Margin="0,0,8,4"
                                   AutomationProperties.AutomationId="btnStagingSafeFolder"
                                   ToolTip="Makes the staging folder in your data folder, which only your account and administrators can write, and puts it in the box." />
                        <ui:Button Content="Allow this folder anyway..." Command="{Binding AllowStagingFolderCommand}" helpers:SettingsSearchHints.Keywords="staging download root folder" Margin="0,0,8,4"
                                   AutomationProperties.AutomationId="btnStagingAllow"
                                   ToolTip="Asks you to accept the risk for this folder. The allowance ends when the folder or its access list changes." />
                    </WrapPanel>
                    <DockPanel Margin="0,0,0,8" Visibility="{Binding ShowStagingAllowed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:Button DockPanel.Dock="Right" Content="End the allowance" Command="{Binding RemoveStagingAllowanceCommand}" helpers:SettingsSearchHints.Keywords="staging download root folder" Margin="8,0,0,0"
                                   AutomationProperties.AutomationId="btnStagingRevoke"
                                   ToolTip="Ends the allowance for the folder in the box. Staging there is blocked again." />
                        <TextBlock Text="{Binding StagingAllowedText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MkMutedBrush}" AutomationProperties.AutomationId="txtStagingAllowed" />
                    </DockPanel>

                                <TextBlock Text="Packagers Folder (leave empty for auto-detect)" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,0,0,8" Width="480" HorizontalAlignment="Left">
                                    <ui:Button DockPanel.Dock="Right" Content="Browse"
                                               Command="{Binding BrowsePackagersRootCommand}" helpers:SettingsSearchHints.Exclude="True" Margin="8,0,0,0"
                                               ToolTip="Select the Packagers folder." />
                                    <ui:TextBox AutomationProperties.Name="Packagers Folder (leave empty for auto-detect)" ToolTip="{Binding PackagersRoot}" Text="{Binding PackagersRoot, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="catalog browse"
                                                PlaceholderText="Auto-detect" />
                                </DockPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_dtdefaults" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="Deployment Type Defaults" Style="{StaticResource SectionHeader}" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Estimated Runtime (mins)" Style="{StaticResource FieldLabel}" />
                                        <ui:NumberBox AutomationProperties.Name="Estimated Runtime (mins)" Value="{Binding EstimatedRuntimeMins, Mode=TwoWay}"
                                                      Minimum="1" Maximum="120" SmallChange="5" LargeChange="15"
                                                      SpinButtonPlacementMode="Compact"
                                                      Width="140" HorizontalAlignment="Left"
                                                      ToolTip="Estimated time for the installer to complete. Used by ConfigMgr for deployment scheduling." />
