                                        <CheckBox Content="DesktopViewer" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.DesktopViewer}" Margin="16,0,0,4"
                                                  ToolTip="Checked adds DesktopViewer to ADDLOCAL. Works only when Customize (ADDLOCAL) is checked." />
                                        <CheckBox Content="WebHelper" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.WebHelper}" Margin="16,0,0,4"
                                                  ToolTip="Checked adds WebHelper to ADDLOCAL. Works only when Customize (ADDLOCAL) is checked." />
                                        <CheckBox Content="BCR__Client" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.BCR_Client}" Margin="16,0,0,4"
                                                  ToolTip="Checked adds BCR_Client to ADDLOCAL. Works only when Customize (ADDLOCAL) is checked." />
                                        <CheckBox Content="USB" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.USB}" Margin="16,0,0,4"
                                                  ToolTip="Checked adds USB to ADDLOCAL. Works only when Customize (ADDLOCAL) is checked." />
                                        <CheckBox Content="SSON" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.SSON}" Margin="16,0,0,4"
                                                  ToolTip="Checked adds SSON to ADDLOCAL. Works only when Customize (ADDLOCAL) is checked." />
                                        <CheckBox Content="CitrixEnterpriseBrowser" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.CitrixEnterpriseBrowser}" Margin="16,0,0,4"
                                                  ToolTip="LTSR only. Installs the Citrix Enterprise Browser. Current releases do not carry it." />
                                    </StackPanel>
                                </Grid>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_citrixpolicy" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                    <mk:TrackedText Text="Citrix Updates and Policy" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Updates, Telemetry and Store Policy" Style="{StaticResource SubHeader}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="AutoUpdateCheck" Style="{StaticResource FieldLabel}" />
                                        <ComboBox AutomationProperties.Name="AutoUpdateCheck" SelectedValue="{Binding CwaSwitches.UpdateAndTelemetry.AutoUpdateCheck}" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                                  ToolTip="Passes AutoUpdateCheck=auto, manual or disabled. (not set) passes nothing.">
                                            <ComboBoxItem Content="(not set)" Tag="" />
                                            <ComboBoxItem Content="auto" Tag="auto" />
                                            <ComboBoxItem Content="manual" Tag="manual" />
                                            <ComboBoxItem Content="disabled" Tag="disabled" />
                                        </ComboBox>
                                        <CheckBox Content="EnableCEIP" IsThreeState="True" IsChecked="{Binding CwaSwitches.UpdateAndTelemetry.EnableCEIP}" Margin="0,8,0,4"
                                                  ToolTip="Checked passes EnableCEIP=True and cleared passes EnableCEIP=False. Shaded passes nothing." />
                                        <CheckBox Content="EnableTracing" IsThreeState="True" IsChecked="{Binding CwaSwitches.UpdateAndTelemetry.EnableTracing}" Margin="0,0,0,4"
                                                  ToolTip="Checked passes EnableTracing=true and cleared passes EnableTracing=false. Shaded passes nothing." />
                                        <TextBlock Text="AutoUpdateStream" Style="{StaticResource FieldLabel}" />
                                        <ComboBox AutomationProperties.Name="AutoUpdateStream" SelectedValue="{Binding CwaSwitches.UpdateAndTelemetry.AutoUpdateStream}" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                                  ToolTip="Selects the update channel. Works only with AutoUpdateCheck. Use LTSR on devices that stay on a long-term build.">
                                            <ComboBoxItem Content="(not set)" Tag="" />
                                            <ComboBoxItem Content="LTSR" Tag="LTSR" />
                                            <ComboBoxItem Content="Current" Tag="Current" />
                                        </ComboBox>
                                        <TextBlock Text="AURolloutPriority" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                        <ComboBox AutomationProperties.Name="AURolloutPriority" SelectedValue="{Binding CwaSwitches.UpdateAndTelemetry.AURolloutPriority}" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                                  ToolTip="Sets when in the Citrix delivery period a device gets an update. Works only with AutoUpdateCheck.">
                                            <ComboBoxItem Content="(not set)" Tag="" />
                                            <ComboBoxItem Content="Auto" Tag="Auto" />
                                            <ComboBoxItem Content="Fast" Tag="Fast" />
                                            <ComboBoxItem Content="Medium" Tag="Medium" />
                                            <ComboBoxItem Content="Slow" Tag="Slow" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ALLOWADDSTORE" Style="{StaticResource FieldLabel}" />
                                        <ComboBox AutomationProperties.Name="ALLOWADDSTORE" SelectedValue="{Binding CwaSwitches.StorePolicy.AllowAddStore}" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                                  ToolTip="Passes ALLOWADDSTORE=S, A or N. (not set) passes nothing.">
                                            <ComboBoxItem Content="(not set)" Tag="" />
                                            <ComboBoxItem Content="S - secure stores only" Tag="S" />
                                            <ComboBoxItem Content="A - secure and non-secure stores" Tag="A" />
                                            <ComboBoxItem Content="N - never" Tag="N" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="ALLOWSAVEPWD" Style="{StaticResource FieldLabel}" />
                                        <ComboBox AutomationProperties.Name="ALLOWSAVEPWD" SelectedValue="{Binding CwaSwitches.StorePolicy.AllowSavePwd}" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                                  ToolTip="Passes ALLOWSAVEPWD=S, A or N. (not set) passes nothing.">
                                            <ComboBoxItem Content="(not set)" Tag="" />
                                            <ComboBoxItem Content="S - secure stores only" Tag="S" />
                                            <ComboBoxItem Content="A - all stores" Tag="A" />
                                            <ComboBoxItem Content="N - never" Tag="N" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="HDX Features and Display" Style="{StaticResource SubHeader}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox Content="Bidirectional content redirection" IsThreeState="True" IsChecked="{Binding CwaSwitches.Hdx.BidirectionalContentRedirection}" Margin="0,0,0,4"
                                                  ToolTip="ALLOW_BIDIRCONTENTREDIRECTION: allows content redirection between the client and the host in both directions. Checked passes 1, cleared passes 0." />
                                        <CheckBox Content="Local App Access" IsThreeState="True" IsChecked="{Binding CwaSwitches.Hdx.LocalAppAccess}" Margin="0,0,0,4"
                                                  ToolTip="FORCE_LAA: installs the Local App Access component. Needs an admin install." />
                                        <CheckBox Content="URL redirection" IsThreeState="True" IsChecked="{Binding CwaSwitches.Hdx.ClientHostedAppsUrl}" Margin="0,0,0,4"
                                                  ToolTip="ALLOW_CLIENTHOSTEDAPPSURL: turns on URL redirection on the device." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox Content="Hide file-type icons" IsThreeState="True" IsChecked="{Binding CwaSwitches.Hdx.LegacyFileTypeIcons}" Margin="0,0,0,4"
                                                  ToolTip="LEGACYFTAICONS: True hides the file-type icons of subscribed apps." />
                                        <TextBlock Text="DisableSetting" Style="{StaticResource FieldLabel}" />
                                        <ComboBox AutomationProperties.Name="DisableSetting" SelectedValue="{Binding CwaSwitches.Hdx.DisableSetting}" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                                  ToolTip="Hides the Shortcuts and Reconnect options in Advanced Preferences.">
                                            <ComboBoxItem Content="(not set)" Tag="" />
                                            <ComboBoxItem Content="0 - show both" Tag="0" />
                                            <ComboBoxItem Content="1 - show Reconnect only" Tag="1" />
                                            <ComboBoxItem Content="2 - show Shortcuts only" Tag="2" />
                                            <ComboBoxItem Content="3 - hide both" Tag="3" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Left" Content="Preview" Command="{Binding PreviewCwaCommand}" helpers:SettingsSearchHints.Keywords="command line arguments citrix" VerticalAlignment="Top"
                                               ToolTip="Shows the Current Release and LTSR install arguments these choices produce." />
                                    <TextBlock Text="{Binding CwaPreview}" Margin="12,0,0,0" TextWrapping="Wrap" FontFamily="Consolas"
                                               Foreground="{DynamicResource MkMutedBrush}" />
                                </DockPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_m365" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="M365 Apps" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Update channel for M365 Apps, Project, and Visio packagers."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" />

                                <ComboBox SelectedValue="{Binding M365Channel}" helpers:SettingsSearchHints.Title="Channel" helpers:SettingsSearchHints.Keywords="update channel office microsoft 365" AutomationProperties.Name="Channel"
                                          SelectedValuePath="Tag"
                                          Width="320" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          ToolTip="Update channel that the M365 Apps, Project and Visio packagers use.">
                                    <ComboBoxItem Content="Monthly Enterprise Channel" Tag="MonthlyEnterprise" />
                                    <ComboBoxItem Content="Current Channel" Tag="Current" />
                                    <ComboBoxItem Content="Semi-Annual Enterprise Channel (kiosk)" Tag="SemiAnnual" />
                                </ComboBox>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="page_installparams" Visibility="Collapsed" MaxWidth="960" HorizontalAlignment="Left" Margin="0,0,0,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                                <mk:TrackedText Text="Install Parameters" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Switches and choices each installer takes, saved per application. Stage starts from these values: the review dialog shows them first unless it is skipped, in which case they apply as they are."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <CheckBox Content="Skip the review dialog before staging and use the saved values" helpers:SettingsSearchHints.Keywords="install options configuration review stage prompt" IsChecked="{Binding SkipConfigReview}" Margin="0,0,0,8"
                                          ToolTip="Applications marked for review in their definition still show the dialog." />
                                <TextBlock Text="{Binding InstallParameterSummary}" Foreground="{DynamicResource MkMutedBrush}" FontSize="12" Margin="0,0,0,8" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InstallParameterGroups}" Margin="0,0,16,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:CardExpander helpers:TemplatePartNames.FromOwner="True" AutomationProperties.Name="{Binding Header}" Margin="0,0,0,8" IsExpanded="False">
                                                <ui:CardExpander.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Header}" Foreground="{DynamicResource MkTextBrush}" />
                                                        <TextBlock Text="{Binding SubHeader}" FontSize="12" Foreground="{DynamicResource MkMutedBrush}" />
                                                    </StackPanel>
                                                </ui:CardExpander.Header>
                                                <controls:InstallerSettingsPanel Parameters="{Binding Parameters}" Store="{Binding Values}" />
                                            </ui:CardExpander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="page_localsources" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="Local Installer Sources" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Folders that hold an installer that a script cannot download (a vendor sign-in or a bot protection). You put the file in the folder by hand. Stage takes the highest file version found in the folder, and the installer must carry a valid signature unless the row says otherwise."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding LocalSourceRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                                                <DockPanel>
                                                    <ui:Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" Margin="8,0,0,0"
                                                               ToolTip="Select the folder that holds the installer." />
                                                    <ui:TextBox AutomationProperties.Name="{Binding Label}" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="No folder chosen"
                                                                ToolTip="Enter the path of the folder that holds the installer, or select Browse." />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_packagerfiles" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                    <mk:TrackedText Text="Packager Files" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Files an installer reads from its own folder, such as a license key. The file is copied beside the installer at Stage and is never read."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding SideFileRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                                                <DockPanel>
                                                    <ui:Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" Margin="8,0,0,0"
                                                               ToolTip="Select the file to copy beside the installer." />
                                                    <ui:TextBox AutomationProperties.Name="{Binding Label}" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="No file chosen"
                                                                ToolTip="Enter the path of the file, or select Browse." />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_oneclick" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="One Click" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="One Click opens a plan of the apps you track here, then runs Check (and optionally Stage / Publish) without further prompts. Each row publishes to its own destinations; a row with no box checked is skipped. Rows that keep the default follow it when the default changes. Publish All on the App Packager page does not use these destinations. It publishes to the systems in Settings, Systems in use."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Action on update" Style="{StaticResource FieldLabel}" />
                                        <ComboBox SelectedValue="{Binding OneClickAction}" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Action on update" AutomationProperties.AutomationId="cboOneClickAction"
                                                  ToolTip="Report only lists the newer versions. Stage downloads and prepares them. Stage and Publish also publishes each application to its destinations, using the comment in the One Click plan window.">
                                            <ComboBoxItem Content="Report only" Tag="Report" />
                                            <ComboBoxItem Content="Stage" Tag="Stage" />
                                            <ComboBoxItem Content="Stage and Publish" Tag="StageAndPackage" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Default cadence (days)" Style="{StaticResource FieldLabel}" />
                                        <ui:NumberBox AutomationProperties.Name="Default cadence (days)" Value="{Binding OneClickCadenceDays, Mode=TwoWay}" helpers:SettingsSearchHints.Keywords="days check fresh"
                                                      Minimum="1" Maximum="365" SmallChange="1" LargeChange="7"
                                                      SpinButtonPlacementMode="Compact" Width="140" HorizontalAlignment="Left"
                                                      ToolTip="Days a version check stays fresh. A Report only run skips a tracked application checked more recently than this." />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Force on launch (ignore cadence)" IsChecked="{Binding OneClickForce}" Margin="0,0,0,8"
                                          AutomationProperties.AutomationId="chkOneClickForce"
                                          ToolTip="The plan opens with Force set: the cadence, the refusal memory and the already-published guard are ignored." />

                                <TextBlock Text="Default destinations" Style="{StaticResource FieldLabel}" helpers:SettingsSearchHints.Keywords="configmgr wsus intune" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                            ToolTip="The destinations of every tracked app that has no selection of its own in the grid.">
                                    <CheckBox Content="ConfigMgr" IsChecked="{Binding OneClickDefaultConfigMgr}" Margin="0,0,24,0" AutomationProperties.AutomationId="chkOneClickMecm"
                                              ToolTip="Use ConfigMgr as a default destination of One Click." />
                                    <CheckBox Content="WSUS" IsChecked="{Binding OneClickDefaultWsus}" Margin="0,0,24,0" AutomationProperties.AutomationId="chkOneClickWsus"
                                              ToolTip="Use WSUS as a default destination of One Click." />
                                    <CheckBox Content="Intune" IsChecked="{Binding OneClickDefaultIntune}" AutomationProperties.AutomationId="chkOneClickIntune"
                                              ToolTip="Use Intune as a default destination of One Click." />
                                </StackPanel>

                                <TextBlock Text="Existing ConfigMgr app" Style="{StaticResource FieldLabel}" />
                                <ComboBox SelectedValue="{Binding OneClickOnExisting}" SelectedValuePath="Tag" Width="240" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          AutomationProperties.Name="Existing ConfigMgr app" AutomationProperties.AutomationId="cboOneClickOnExisting"
                                          ToolTip="What a run does when the ConfigMgr application already exists with another version. One Click never asks during the run.">
                                    <ComboBoxItem Content="Skip the application" Tag="Skip" />
                                    <ComboBoxItem Content="Overwrite it" Tag="Overwrite" />
                                </ComboBox>

                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="Track none" Command="{Binding TrackNoneOneClickCommand}" helpers:SettingsSearchHints.Exclude="True" Margin="8,0,0,0"
                                               ToolTip="Clears the Track box of every application in the list." />
                                    <ui:Button DockPanel.Dock="Right" Content="Track all" Command="{Binding TrackAllOneClickCommand}" helpers:SettingsSearchHints.Exclude="True" Margin="8,0,0,0"
                                               ToolTip="Selects the Track box of every application in the list." />
                                    <ui:Button DockPanel.Dock="Right" Content="Refresh list" mk:Mk.Icon="arrow_sync"
                                               Command="{Binding RefreshOneClickRowsCommand}" helpers:SettingsSearchHints.Exclude="True" Margin="8,0,0,0"
                                               ToolTip="Rebuilds the list from the applications the App Packager page shows." />
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MkMutedBrush}">
                                        <Run Text="{Binding OneClickTrackedCount, Mode=OneWay}" /><Run Text=" tracked" />
                                    </TextBlock>
                                </DockPanel>

                                <DataGrid AutomationProperties.Name="Tracked applications" Style="{StaticResource Mk.Grid}" RowHeight="35" ItemsSource="{Binding OneClickRows}" helpers:SettingsSearchHints.Title="Tracked applications" helpers:SettingsSearchHints.Keywords="track all none refresh list cadence grid" AutoGenerateColumns="False" CanUserAddRows="False"
                                          CanUserDeleteRows="False" BorderThickness="1" BorderBrush="{DynamicResource MkLineBrush}"
                                          Height="280" Margin="0,0,0,8" IsTextSearchEnabled="True" TextSearch.TextPath="Application"
                                          AutomationProperties.AutomationId="dgOneClickApps">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Track" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox AutomationProperties.Name="Track" IsChecked="{Binding Tracked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                              ToolTip="Track this application in One Click." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Application" Width="*" MinWidth="130" Binding="{Binding Application}" IsReadOnly="True" ElementStyle="{StaticResource Mk.CellText}" />
                                        <DataGridTextColumn Header="Vendor" Width="120" Binding="{Binding Vendor}" IsReadOnly="True" ElementStyle="{StaticResource Mk.CellText}" />
                                        <DataGridTemplateColumn Header="ConfigMgr" Width="100" SortMemberPath="ConfigMgr">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding ConfigMgr, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                              AutomationProperties.Name="ConfigMgr"
                                                              ToolTip="Publish this application to ConfigMgr in a One Click run." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="WSUS" Width="64" SortMemberPath="Wsus">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Wsus, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                              AutomationProperties.Name="WSUS"
                                                              ToolTip="Publish this application to WSUS in a One Click run." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Intune" Width="72" SortMemberPath="Intune">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Intune, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                              AutomationProperties.Name="Intune"
                                                              ToolTip="Publish this application to Intune in a One Click run." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Cadence (days)" Width="122">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox AutomationProperties.Name="Cadence (days)" Text="{Binding CadenceDisplay, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                             Style="{StaticResource Mk.Settings.CellTextBox}"
                                                             ToolTip="Days for this application only. Empty uses the default cadence." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_cve" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="CVE Lookup" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Check CVEs asks the NIST NVD API for the CVEs between the ConfigMgr version and the latest version of each application. Without a key NVD allows 5 requests in 30 seconds; with a key it allows 50."
                                           Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="NVD API key" Style="{StaticResource FieldLabel}" />
                                <ui:PasswordBox AutomationProperties.Name="NVD API key" Width="360" HorizontalAlignment="Left" Password="{Binding NvdApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="{Binding NvdApiKeyHint}" Margin="0,0,0,4"
                                                AutomationProperties.AutomationId="pwdNvdApiKey"
                                                ToolTip="Enter an NVD API key to raise the request limit of Check CVEs. Save settings stores it encrypted for the current Windows user. Leave it empty to keep the saved key." />
                                <TextBlock Text="Stored encrypted for the current Windows user. Leave empty to keep the saved key. Without a saved key the NVD_API_KEY environment variable is used."
                                           Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <CheckBox Content="Remove the saved key on Save"
                                          IsChecked="{Binding RemoveNvdApiKey}"
                                          IsEnabled="{Binding HasStoredNvdApiKey}" helpers:SettingsSearchHints.Unavailable="The box is disabled when no key is saved."
                                          Margin="0,0,0,8"
                                          AutomationProperties.AutomationId="chkRemoveNvdApiKey"
                                          ToolTip="Select to delete the saved key when you select Save settings. The box is disabled when no key is saved." />
                                <CheckBox Content="Look up CVEs after Check ConfigMgr"
                                          IsChecked="{Binding LookupCvesAfterCheckMecm}"
                                          Margin="0,0,0,8"
                                          AutomationProperties.AutomationId="chkCveAfterCm"
                                          ToolTip="Looks up CVEs after Check ConfigMgr finishes." />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_signing" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="Script Signing" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Authenticode signing for the scripts AppPackager generates. Signing a detection script does not sign install wrappers, and signing deployment scripts does not sign requirement scripts. A local signature check does not prove the certificate is trusted on your devices."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <TextBlock Text="Sign" Style="{StaticResource SubHeader}" />
                                <CheckBox Content="Sign detection scripts" IsChecked="{Binding Signing.SignDetection}" Margin="0,0,0,4"
                                          ToolTip="Signs generated and custom detection scripts. An unchanged import carrying a valid third-party signature is left alone." />
                                <CheckBox Content="Sign requirement scripts and script global conditions" IsChecked="{Binding Signing.SignRequirements}" Margin="0,0,0,4"
                                          ToolTip="Covers script-based requirement rules including the VPN predicate. WQL and native rules need no signature." />
                                <CheckBox Content="Sign install and uninstall PowerShell scripts" IsChecked="{Binding Signing.SignDeployment}" Margin="0,0,0,8"
                                          ToolTip="Signs the deployment execution chain and removes the execution-policy argument from its generated launchers, letting the configured endpoint policy govern. A vendor script that already carries an intact signature is left alone; an unsigned one is signed with this certificate." />

                                <TextBlock Text="Require Valid Signatures" Style="{StaticResource SubHeader}" />
                                <TextBlock Text="A publishing constraint, not a change to client execution policy. When a required category fails verification the build stops; there is no unsigned fallback."
                                           Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <CheckBox Content="Require valid detection signatures" IsChecked="{Binding Signing.RequireDetection}" Margin="0,0,0,4"
                                          ToolTip="Stops the build when the signature of a detection script fails verification." />
                                <CheckBox Content="Require valid requirement signatures" IsChecked="{Binding Signing.RequireRequirements}" Margin="0,0,0,4"
                                          ToolTip="Stops the build when the signature of a requirement script fails verification." />
                                <CheckBox Content="Require valid deployment script signatures" IsChecked="{Binding Signing.RequireDeployment}" Margin="0,0,0,8"
                                          ToolTip="Stops the build when the signature of a deployment script fails verification." />

                                <TextBlock Text="Signing Identity" Style="{StaticResource SubHeader}" />
                                <TextBlock Text="Certificate store" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Signing.StoreLocationOptions}" SelectedItem="{Binding Signing.StoreLocation}"
                                          AutomationProperties.Name="Certificate store" AutomationProperties.AutomationId="SigningStore"
                                          Width="320" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          ToolTip="CurrentUser\My is the supported identity. LocalMachine\My needs an explicit choice and tested private-key access." />

                                <TextBlock Text="Certificate" Style="{StaticResource FieldLabel}" />
                                <DockPanel Margin="0,0,0,4">
                                    <ui:Button DockPanel.Dock="Right" Content="Refresh" mk:Mk.Icon="arrow_sync"
                                               Command="{Binding Signing.RefreshCertificatesCommand}" helpers:SettingsSearchHints.Exclude="True" Margin="8,0,0,0" VerticalAlignment="Center"
                                               ToolTip="Reads the certificate store again and keeps the selected certificate when it is still listed." />
                                    <ComboBox ItemsSource="{Binding Signing.Certificates}" helpers:SettingsSearchHints.Keywords="thumbprint" SelectedItem="{Binding Signing.SelectedCertificate}"
                                              DisplayMemberPath="Label" AutomationProperties.Name="Certificate" AutomationProperties.AutomationId="SigningCertificate"
                                              ToolTip="Selected by thumbprint. A renewed certificate is a new thumbprint and needs reselecting here." />
                                </DockPanel>
                                <TextBlock Text="{Binding Signing.CertificateDetail}" Foreground="{DynamicResource MkMutedBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="Timestamp server" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Width="360" HorizontalAlignment="Left" Text="{Binding Signing.TimestampServer, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="none"
                                            AutomationProperties.Name="Timestamp server" AutomationProperties.AutomationId="SigningTimestamp" Margin="0,0,0,4"
                                            ToolTip="A timestamped signature stays valid after the certificate expires. A signature that exists is not the same as a verified timestamp." />
                                <CheckBox Content="Timestamp required" IsChecked="{Binding Signing.TimestampRequired}" Margin="0,0,0,8"
                                          ToolTip="With this on, a timestamp server failure fails the signed build instead of producing an untimestamped signature." />

                                <ui:Button Content="Test signing configuration" Command="{Binding Signing.TestConfigurationCommand}"
                                           IsEnabled="{Binding Signing.TestIdle}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                           ToolTip="Signs and verifies a temporary file with the selected certificate. Nothing is published." />
                                <TextBlock Text="{Binding Signing.TestResult}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="SigningTestResult"
                                           Foreground="{DynamicResource MkMutedBrush}" />
                                <TextBlock Text="Private keys are never exported and never reach profiles, manifests, logs or command lines. A key held on a hardware token may require a PIN and can prevent unattended runs."
                                           Foreground="{DynamicResource MkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_tools" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="Tools" Style="{StaticResource SectionHeader}" />

                                <TextBlock Text="Configuration Manager console" Style="{StaticResource FieldLabel}" helpers:SettingsSearchHints.Keywords="configmgr adminui" />
                                <TextBlock Text="{Binding ConsoleStatus}" Foreground="{DynamicResource MkMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="7-Zip command line" Style="{StaticResource FieldLabel}" helpers:SettingsSearchHints.Keywords="7z" />
                                <TextBlock Text="{Binding SevenZipStatus}" Foreground="{DynamicResource MkMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="Win32 Content Prep Tool" Style="{StaticResource FieldLabel}" helpers:SettingsSearchHints.Keywords="intunewin intunewinapputil download" />
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="Download"
                                               mk:Mk.Icon="arrow_download"
                                               Command="{Binding DownloadContentPrepCommand}" helpers:SettingsSearchHints.Exclude="True"
                                               IsEnabled="{Binding ContentPrepIdle}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               ToolTip="Fetches IntuneWinAppUtil.exe from its Microsoft repository and checks its publisher signature before use." />
                                    <TextBlock Text="{Binding ContentPrepStatus}"
                                               Foreground="{DynamicResource MkMutedBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBlock Text="Packager Icon Pack" Style="{StaticResource SubHeader}" />
                                <TextBlock Text="Application icons for definitions tagged IconSource External. Downloaded from the icon pack release and stored in your LocalAppData definition folder; bundled icons remain read-only."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <CheckBox Content="Show icons from the icon pack" helpers:SettingsSearchHints.Keywords="icon pack letters placeholder"
                                          AutomationProperties.AutomationId="chkShowPackIcons" IsChecked="{Binding ShowPackIcons}" Margin="0,0,0,8"
                                          ToolTip="Off: the application list shows two letters of each name, and the app does not download or update the icon pack when it starts. A staged application takes the icon of an installed pack either way." />

                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="Install from file..."
                                               mk:Mk.Icon="folder_open"
                                               Command="{Binding InstallIconPackFromFileCommand}" helpers:SettingsSearchHints.Keywords="packager icon pack icons"
                                               IsEnabled="{Binding IconPackIdle}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               ToolTip="Installs the icon pack from a zip file that you select. Use it when your proxy blocks the download." />
                                    <ui:Button DockPanel.Dock="Right" Content="Download icon pack"
                                               mk:Mk.Icon="arrow_download"
                                               Command="{Binding DownloadIconPackCommand}" helpers:SettingsSearchHints.Keywords="packager icons"
                                               IsEnabled="{Binding IconPackIdle}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               ToolTip="Downloads the icon pack from its release and installs it." />
                                    <TextBlock Text="{Binding IconPackStatus}"
                                               Foreground="{DynamicResource MkMutedBrush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_about" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="About" Style="{StaticResource SectionHeader}" />
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="Releases"
                                               mk:Mk.Icon="open"
                                               Command="{Binding OpenReleasesCommand}" helpers:SettingsSearchHints.Keywords="version release update"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               ToolTip="Opens the releases page of the app on GitHub in your browser." />
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource MkMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                   AutomationProperties.AutomationId="txtAboutDescription"
                                                   Text="Automated application packaging for ConfigMgr, Intune and WSUS: vendor version checks, silent install wrappers, detection rules, and one Publish All run for the systems in use." />
                                        <TextBlock Foreground="{DynamicResource MkMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <Run Text="App Packager Desktop " /><Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text=" - MIT License. Settings are stored under %LOCALAPPDATA%\AppPackager." />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="txtUnsavedChanges" Grid.Row="2" Text="{Binding UnsavedChangesText}" FontSize="12" Height="18" Margin="0,15,0,-1"
                   Foreground="{DynamicResource MkMutedBrush}" AutomationProperties.AutomationId="txtUnsavedChanges"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
