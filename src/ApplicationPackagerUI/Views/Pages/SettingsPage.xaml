                                          Width="360" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          ToolTip="Deployment option when the client uses a distribution point in a neighbor boundary group or the site default boundary group.">
                                    <ComboBoxItem Content="Download content and install" Tag="Download" />
                                    <ComboBoxItem Content="Do not download content" Tag="DoNothing" />
                                </ComboBox>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_title" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                    <mk:TrackedText Text="Application Title" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Application title" Style="{StaticResource FieldLabel}"
                                           ToolTip="Default application naming for every Package run." />
                                <CheckBox Content="Include version in application name" IsChecked="{Binding TitleOptions.IncludeVersionInTitle}" Margin="0,0,0,4"
                                          ToolTip="Adds the version to every application name, creating one ConfigMgr application per release. A per-application choice in the Workbench overrides this. Existing applications are not renamed." />
                                <CheckBox Content="Remove version from application name" IsChecked="{Binding TitleOptions.RemoveVersionFromTitle}"
                                          IsEnabled="{Binding TitleOptions.RemoveVersionFromTitleAvailable}" helpers:SettingsSearchHints.Unavailable="Available while the version is not added to the name." Margin="0,0,0,4"
                                          ToolTip="Strips the release version from a vendor product name that carries it (7-Zip 26.03, Slido 2.3.1, Tableau 2026.2). Available while the version is not added to the name. A per-application choice in the Workbench overrides this." />

                                <CheckBox Content="Add the architecture to application names" IsChecked="{Binding TitleOptions.AppendArchitectureToTitle}" Margin="0,0,0,8"
                                          AutomationProperties.AutomationId="AppendArchitectureToTitle"
                                          ToolTip="When a name that the program builds has no architecture yet, it adds (x64), (x86) or (ARM64). Clear this box to keep the name without it. A name that already has the architecture never gets a second one, and an application with a deployment type for each architecture (7-Zip) has none. Existing applications are not renamed." />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_postpackaging" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="Post Packaging" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Optional steps once the ConfigMgr application exists. Content goes to a distribution point group first; the test deployment is created only after that distribution is targeted."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <CheckBox Content="Distribute content after Package" IsChecked="{Binding AutoDistribute}" Margin="0,0,0,8"
                                          ToolTip="Runs Start-CMContentDistribution for the new application against the group below. A group that already holds the content is treated as done." />

                                <TextBlock Text="Distribution point group" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox AutomationProperties.Name="Distribution point group" Text="{Binding DpGroupName, UpdateSourceTrigger=PropertyChanged}" helpers:SettingsSearchHints.Keywords="dp group"
                                            IsEnabled="{Binding AutoDistribute}" helpers:SettingsSearchHints.Unavailable="The box is available when Distribute content after Package is selected."
                                            PlaceholderText="All DPs" Width="320" HorizontalAlignment="Left" Margin="0,0,0,8"
                                            ToolTip="Name of the distribution point group that receives the content. The box is available when Distribute content after Package is selected." />

                                <CheckBox Content="Deploy to a test collection after distribution" IsChecked="{Binding DeployToTestCollection}"
                                          IsEnabled="{Binding TestDeploymentAvailable}" helpers:SettingsSearchHints.Unavailable="Content goes to a distribution point group first; the test deployment is created only after that distribution is targeted." Margin="0,0,0,8"
                                          ToolTip="Creates an Available deployment, effective immediately, to the collection below. An existing deployment is treated as done." />

                                <TextBlock Text="Test collection" Style="{StaticResource FieldLabel}" />
                                <CheckBox Content="Use a user collection" IsChecked="{Binding TestCollectionIsUser}"
                                          IsEnabled="{Binding TestDeploymentAvailable}" helpers:SettingsSearchHints.Unavailable="Content goes to a distribution point group first; the test deployment is created only after that distribution is targeted." Margin="0,0,0,8"
                                          ToolTip="Select to target users. When cleared, the test deployment targets a device collection. This does not change the application's install context." />
                                <ui:TextBox AutomationProperties.Name="Test collection" Text="{Binding TestCollectionName, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding TestDeploymentAvailable}" helpers:SettingsSearchHints.Unavailable="Content goes to a distribution point group first; the test deployment is created only after that distribution is targeted."
                                            PlaceholderText="Application pilot collection" Width="320" HorizontalAlignment="Left" Margin="0,0,0,8"
                                            ToolTip="Enter the name of the collection that receives the test deployment." />

                                <CheckBox Content="Create the collection if it does not exist" IsChecked="{Binding CreateTestCollectionIfMissing}"
                                          IsEnabled="{Binding TestDeploymentAvailable}" helpers:SettingsSearchHints.Unavailable="Content goes to a distribution point group first; the test deployment is created only after that distribution is targeted." Margin="0,0,0,8"
                                          ToolTip="A missing collection starts empty, limited to All Users for a user collection or All Systems for a device collection. Add pilot members in ConfigMgr." />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_supersedence" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" ScrollChanged="Supersedence_ScrollChanged">
                <!-- Aligned to the top: a stretched panel in a scroll viewer is as tall as the view, and the height of the grid is computed from the height of this content. -->
                <StackPanel x:Name="pnlApplicationSettings" VerticalAlignment="Top">
                    <DockPanel Height="26" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" Background="Transparent"
                                    ToolTip="The shipped values are Minimum and Off, so nothing changes until you choose. The command line options --version-rule and --supersedence outrank these values and the overrides. A package run finds the older version by title and publisher, the same query as Check ConfigMgr, and asks before it applies the supersedence.">
                            <mk:Ico Glyph="info" Foreground="{DynamicResource MkAccentBrush}" />
                            <TextBlock Text="Applies to new publishes" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource MkAccentBrush}"
                                       AutomationProperties.AutomationId="txtAppliesToNewPublishes" />
                        </StackPanel>
                        <mk:TrackedText Text="Application settings" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Top" />
                    </DockPanel>

                    <Border Style="{StaticResource Mk.Panel}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Defaults" Style="{StaticResource BlockHeader}" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ConfigMgr version rule" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding VersionRuleChoices}" SelectedItem="{Binding ConfigMgrVersionRule}" helpers:SettingsSearchHints.Keywords="detection operator equals greater version rule, configmgr"
                                              Style="{StaticResource TallList}"
                                              AutomationProperties.Name="ConfigMgr version rule" AutomationProperties.AutomationId="cboConfigMgrVersionRule"
                                              AutomationProperties.HelpText="Minimum detects this version or later. Exact detects only this version."
                                              ToolTip="Exact writes IsEquals to the version clause of the ConfigMgr detection, and only when a value read from the installed product equals the expected value. The rule applies to the detection of the new version. Older applications do not change." />
                                    <TextBlock Text="Minimum detects this version or later. Exact detects only this version." Style="{StaticResource FieldSmall}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Intune version rule" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding VersionRuleChoices}" SelectedItem="{Binding IntuneVersionRule}" helpers:SettingsSearchHints.Keywords="detection operator equals greater"
                                              Style="{StaticResource TallList}"
                                              AutomationProperties.Name="Intune version rule" AutomationProperties.AutomationId="cboIntuneVersionRule"
                                              AutomationProperties.HelpText="Applies to the new Intune app."
                                              ToolTip="Exact writes the operator equal to the version rule of the Intune detection." />
                                    <TextBlock Text="Applies to the new Intune app." Style="{StaticResource FieldSmall}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="ConfigMgr supersedence" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding SupersedenceModeChoices}" helpers:SettingsSearchHints.Keywords="replace uninstall older version supersedence mode" SelectedItem="{Binding SupersedenceMode}"
                                              Style="{StaticResource TallList}"
                                              AutomationProperties.Name="ConfigMgr supersedence" AutomationProperties.AutomationId="cboSupersedenceMode"
                                              AutomationProperties.HelpText="Supersedence includes the version in the title."
                                              ToolTip="Replace and uninstall needs the ConfigMgr version rule Exact. A publish with Replace or Replace and uninstall writes the supersedence relation to the older application of the line. With supersedence on, the new and the older version are separate applications." />
                                    <TextBlock Text="Supersedence includes the version in the title." Style="{StaticResource FieldSmall}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Mk.Notice.Warn}" Height="39" Padding="13,0,13,0">
                                <DockPanel VerticalAlignment="Center">
                                    <mk:Ico DockPanel.Dock="Left" Glyph="warning" Margin="0,3,3.8,0" Foreground="{DynamicResource MkTextBrush}" />
                                    <TextBlock VerticalAlignment="Center" Margin="0,-1,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MkTextBrush}"
                                               ToolTip="Replace and uninstall needs the ConfigMgr version rule Exact. A publish with Minimum and Replace and uninstall is refused. Intune supersedence is not available."
                                               AutomationProperties.AutomationId="txtSupersedenceWarning"><Run FontWeight="Bold" Text="Replace and uninstall requires Exact." /><Run Text=" Intune supersedence is unavailable in APD." /></TextBlock>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Mk.Panel}">
                        <StackPanel>
                            <StackPanel Margin="16,16,16,14">
                                <DockPanel Height="20">
                                    <TextBlock DockPanel.Dock="Right" Text="Save settings to commit changes" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                                               Foreground="{DynamicResource MkMutedBrush}" />
                                    <TextBlock Text="Overrides by application" Style="{StaticResource BlockHeader}" Margin="0" />
                                </DockPanel>
                                <WrapPanel Margin="0,14,-8,0" MinHeight="35" UseLayoutRounding="False" AutomationProperties.AutomationId="pnlSupersedenceBulk">
                                    <TextBlock Text="Bulk edit" FontWeight="Bold" Height="19" VerticalAlignment="Center" Margin="0,-1,8,0" />
                                    <ComboBox ItemsSource="{Binding BulkColumns}" SelectedItem="{Binding BulkColumn}" Width="185" Style="{StaticResource TallList}" Margin="0,0,8,0"
                                              AutomationProperties.Name="Column to set" AutomationProperties.AutomationId="cboBulkColumn"
                                              ToolTip="Select the column that the button sets for several applications at once." />
                                    <ComboBox helpers:TemplatePartNames.FromOwner="True" Style="{StaticResource BulkValueList}" ItemsSource="{Binding BulkValues}" Text="{Binding BulkValue, UpdateSourceTrigger=PropertyChanged}" Width="153" Margin="0,0,8,0"
                                              AutomationProperties.Name="Value to set" AutomationProperties.AutomationId="cboBulkValue"
                                              ToolTip="Select the value that the button writes, or type it for a column of text. The first value of a column returns the application to its default. An application that the setting does not apply to keeps its value." />
                                    <ComboBox ItemsSource="{Binding BulkScopes}" SelectedItem="{Binding BulkScope}" Width="195" Style="{StaticResource TallList}" Margin="0,0,8,0"
                                              AutomationProperties.Name="Applications to set" AutomationProperties.AutomationId="cboBulkScope"
                                              ToolTip="Checked applications are the rows with a check mark. Filtered applications are the rows that the search box shows. All applications are every row of the list." />
                                    <ui:Button Content="Apply" Command="{Binding ApplyBulkNowCommand}" helpers:SettingsSearchHints.Exclude="True" Margin="0,0,8,0" VerticalAlignment="Center" mk:Mk.FaceDrop="-1" AutomationProperties.AutomationId="btnBulkApply"
                                               ToolTip="Writes the selected value into the selected column for the selected applications." />
                                    <ui:Button Content="Reset all overrides" Command="{Binding ResetAllApplicationsCommand}" helpers:SettingsSearchHints.Exclude="True" Margin="0,0,8,0" VerticalAlignment="Center" mk:Mk.FaceDrop="-1" AutomationProperties.AutomationId="btnBulkNone"
                                               ToolTip="Clears every choice of every application, so each follows its default: Off, Minimum, the packager defaults and no One Click." />
                                </WrapPanel>
                                <DockPanel Margin="0,14,0,0" UseLayoutRounding="False">
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,-1,0,0" Foreground="{DynamicResource MkMutedBrush}" AutomationProperties.AutomationId="txtCheckedCount">
                                        <Run Text="{Binding SupersedenceSelectedCount, Mode=OneWay}" /><Run Text=" checked" />
                                    </TextBlock>
                                    <WrapPanel Margin="0,0,-8,0" MinHeight="34">
                                        <Grid Margin="0,0,8,0">
                                            <TextBox Style="{StaticResource Mk.Search}" mk:Mk.Icon="{x:Null}" mk:Mk.TextDrop="-1" mk:Mk.Placeholder="Search applications" AutomationProperties.Name="Search applications"
                                                     Text="{Binding ApplicationFilter, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="txtApplicationFilter"
                                                     ToolTip="Type part of an application name or of a vendor name. The grid shows the matching applications, and Filtered applications means these rows." />
                                            <mk:Ico Glyph="search" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0" IsHitTestVisible="False"
                                                    Foreground="{DynamicResource MkMutedBrush}" />
                                        </Grid>
                                        <ui:Button Content="Check all" Command="{Binding CheckAllApplicationsCommand}" helpers:SettingsSearchHints.Exclude="True" CommandParameter="True" Margin="0,0,8,2" VerticalAlignment="Center" mk:Mk.FaceDrop="1" AutomationProperties.AutomationId="btnCheckAll"
                                                   ToolTip="Checks every application that the grid shows." />
                                        <ui:Button Content="Check none" Command="{Binding CheckAllApplicationsCommand}" helpers:SettingsSearchHints.Exclude="True" CommandParameter="False" Margin="0,0,8,2" VerticalAlignment="Center" mk:Mk.FaceDrop="1" AutomationProperties.AutomationId="btnCheckNone"
                                                   ToolTip="Clears the check box of every application that the grid shows." />
                                        <ui:Button x:Name="btnColumns" Content="Columns" mk:Mk.TrailingIcon="chevron_down" mk:Mk.IconDrop="1" Click="Columns_Click" Margin="0,0,8,2" VerticalAlignment="Center" mk:Mk.FaceDrop="1" AutomationProperties.AutomationId="btnColumns"
                                                   ToolTip="Choose which settings the grid shows as columns." />
                                        <ui:Button Content="Refresh list" mk:Mk.Icon="arrow_sync" mk:Mk.IconDrop="1" mk:Mk.FaceDrop="1" Command="{Binding RefreshSupersedenceRowsCommand}" helpers:SettingsSearchHints.Exclude="True" Margin="0,0,8,2" VerticalAlignment="Center"
                                                   ToolTip="Rebuilds the list from the applications the App Packager page shows." />
                                    </WrapPanel>
                                </DockPanel>
                            </StackPanel>
                            <DataGrid AutomationProperties.Name="Application Overrides" x:Name="dgApplications" helpers:SettingsSearchHints.Title="Application Overrides" helpers:SettingsSearchHints.Keywords="overrides by application grid bulk edit check all none reset all overrides refresh list" ItemsSource="{Binding SupersedenceRows}"
                                      Style="{StaticResource Mk.Grid}" CellStyle="{StaticResource SettingsCell}" ColumnHeaderStyle="{StaticResource SettingsHeader}" RowStyle="{StaticResource SettingsRow}" RowHeight="35" ColumnHeaderHeight="38"
                                      Height="240" GotKeyboardFocus="Applications_GotKeyboardFocus" IsTextSearchEnabled="True" TextSearch.TextPath="Application"
                                      HorizontalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="dgSupersedenceApps">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Check" Width="58" MinWidth="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource Mk.CheckBox}" AutomationProperties.Name="Check" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left"
                                                          Margin="0,3,0,0" ToolTip="Check this application to change it with the buttons above." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Application" Width="*" MinWidth="220" Binding="{Binding Application}" IsReadOnly="True" ElementStyle="{StaticResource Mk.CellText}" />
                                    <DataGridTextColumn Header="Vendor" Width="236" MinWidth="120" Binding="{Binding Vendor}" IsReadOnly="True" ElementStyle="{StaticResource Mk.CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- .logline { padding:9px 12px; border-top:1px solid the line color } -->
                            <Border Margin="0,14,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MkLineBrush}" Padding="12,10,12,8">
                                <TextBlock x:Name="txtFieldHelp" FontSize="12" LineHeight="18" MinHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource MkMutedBrush}"
                                           Text="Applications follow the defaults until you choose an override. Hover or focus an unavailable field to see why."
                                           AutomationProperties.AutomationId="txtFieldHelp" AutomationProperties.LiveSetting="Polite" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="page_citrix" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <!-- A long switch name wraps in a narrow window instead of leaving it. -->
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>
                <StackPanel Margin="0,0,0,8" MaxWidth="960" HorizontalAlignment="Left">
                                <mk:TrackedText Text="Citrix Workspace App" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Used by the Current Release and LTSR definitions. A shaded box or an empty choice is not set: no switch is passed and the installer default applies."
                                           Foreground="{DynamicResource MkMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <TextBlock Text="Store" Style="{StaticResource SubHeader}" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Store Name" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox AutomationProperties.Name="Store Name" Text="{Binding CwaSwitches.Store.Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="MyStore"
                                                    ToolTip="Enter the name of the Citrix store that the installer adds. The installer needs the store URL too." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Store URL (passed as typed)" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox AutomationProperties.Name="Store URL (passed as typed)" Text="{Binding CwaSwitches.Store.Url, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://storefront.contoso.com/Citrix/Store/discovery"
                                                    ToolTip="Enter the URL of the Citrix store. The app passes it as typed. The installer needs the store name too." />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Installation" Style="{StaticResource SubHeader}" />
                                        <CheckBox Content="Clean install" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.CleanInstall}" Margin="0,0,0,4"
                                                  ToolTip="Checked passes /CleanInstall. Cleared or shaded passes nothing." />
                                        <CheckBox Content="Include SSON" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.IncludeSSON}" Margin="0,0,0,4"
                                                  ToolTip="Checked passes /includeSSON. Cleared or shaded passes nothing." />
                                        <CheckBox Content="Enable SSON" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.EnableSSON}" Margin="16,0,0,4"
                                                  ToolTip="ENABLE_SSON is passed only together with Include SSON." />
                                        <CheckBox Content="startAppProtection" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.AppProtection}" Margin="0,0,0,4"
                                                  ToolTip="Starts the App Protection component. Since version 2212 the installer already installs it. Needs an admin install." />
                                        <CheckBox Content="Session pre-launch" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.SessionPreLaunch}" Margin="0,0,0,4"
                                                  ToolTip="Checked passes ENABLEPRELAUNCH=True and cleared passes ENABLEPRELAUNCH=False. Shaded passes nothing." />
                                        <CheckBox Content="Self-service mode" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.SelfServiceMode}" Margin="0,0,0,4"
                                                  ToolTip="Checked passes SELFSERVICEMODE=True and cleared passes SELFSERVICEMODE=False. Shaded passes nothing." />
                                        <CheckBox Content="forceinstall" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.ForceInstall}" Margin="0,0,0,4"
                                                  ToolTip="Cleans old Citrix data when an install or an upgrade of an unsupported version fails. Use it as a retry package. It replaces rcu." />
                                        <TextBlock Text="Device name (fixed)" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox AutomationProperties.Name="Device name (fixed)" Text="{Binding CwaSwitches.Installation.ClientName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="computer name"
                                                    ToolTip="Sets a fixed client device name (ENABLE_DYNAMIC_CLIENT_NAME=No and CLIENT_NAME). Up to 20 letters, digits, dots, hyphens or underscores. Empty keeps the computer name." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Plugins" Style="{StaticResource SubHeader}" />
                                        <CheckBox Content="Microsoft Teams" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.MSTeamsPlugin}" Margin="0,0,0,4"
                                                  ToolTip="Current Release only: /InstallMSTeamsPlugin=Y|N. LTSR documents no switch and ignores it." />
                                        <CheckBox Content="Zoom" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.ZoomPlugin}" Margin="0,0,0,4"
                                                  ToolTip="Current Release: cleared passes Installzoomplugin=N. LTSR: checked adds ZoomVDIPlugin to ADDONS." />
                                        <CheckBox Content="Webex" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.WebExPlugin}" Margin="0,0,0,4"
                                                  ToolTip="Checked adds WebexVDIPlugin to ADDONS. Cleared or shaded passes nothing." />
                                        <CheckBox Content="uberAgent" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.UberAgent}" Margin="0,0,0,4"
                                                  ToolTip="Checked passes /InstallUberAgent. Cleared or shaded passes nothing." />
                                        <CheckBox Content="Skip uberAgent upgrade" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.UberAgentSkipUpgrade}" Margin="16,0,0,4"
                                                  ToolTip="Checked passes /SkipUberAgentUpgrade, and only together with uberAgent. Cleared or shaded passes nothing." />
                                        <CheckBox Content="EPA client" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.EPAClient}" Margin="0,0,0,4"
                                                  ToolTip="Cleared passes InstallEPAClient=N. Checked or shaded passes nothing." />
                                        <CheckBox Content="Session recording" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.SessionRecording}" Margin="0,0,0,4"
                                                  ToolTip="Current Release only: /InstallSRAgent. LTSR documents no switch and ignores it." />
                                        <CheckBox Content="Skip session recording agent upgrade" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.SessionRecordingSkipUpgrade}" Margin="16,0,0,4"
                                                  ToolTip="Current Release only: /SkipSRAgentUpgrade, with Session recording. Keeps the agent that is already on the device. Use it when another package manages the agent." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Components" Style="{StaticResource SubHeader}" />
