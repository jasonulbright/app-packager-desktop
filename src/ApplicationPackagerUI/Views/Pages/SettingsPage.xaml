<Page
    x:Class="ApplicationPackagerUI.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,20,0,20" />
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,8,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Settings" Icon="Settings24" TitleAutomationId="txtSettingsTitle" MaxWidth="760" HorizontalAlignment="Left">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Discard changes"
                               Icon="{ui:SymbolIcon ArrowUndo24}"
                               Command="{Binding DiscardChangesCommand}"
                               Margin="0,0,8,0"
                               ToolTip="Reloads every setting on this page from the saved settings. Unsaved edits are lost." />
                    <ui:Button Content="Save Settings"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Save24}"
                               Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,32" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="Dark" Margin="0,0,16,0"
                             IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark}"
                             Command="{Binding ChangeThemeCommand}" CommandParameter="Dark" />
                <RadioButton Content="Light"
                             IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light}"
                             Command="{Binding ChangeThemeCommand}" CommandParameter="Light" />
            </StackPanel>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Sidebar" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Select the entries that the sidebar shows and set their order. Each change applies at once; Save Settings is not necessary. An entry moves only inside its group. App Packager is the start page and stays first."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Sidebar.Rows}" Focusable="False" Margin="0,0,0,8"
                          AutomationProperties.AutomationId="lstSidebar">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding GroupCaption}"
                                       Visibility="{Binding IsGroupStart, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="{Binding GroupAutomationName}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <DockPanel Margin="0,0,0,4" MaxWidth="420" HorizontalAlignment="Left">
                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowDown24}"
                                           Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                                           Margin="4,0,0,0" ToolTip="Move down"
                                           AutomationProperties.Name="{Binding Title, StringFormat=Move {0} down}" />
                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowUp24}"
                                           Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                                           Margin="4,0,0,0" ToolTip="Move up"
                                           AutomationProperties.Name="{Binding Title, StringFormat=Move {0} up}" />
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding Shown}" IsEnabled="{Binding CanHide}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Title, StringFormat=Show {0}}" />
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button Content="Reset sidebar" Icon="{ui:SymbolIcon ArrowReset24}"
                       Command="{Binding Sidebar.ResetCommand}"
                       AutomationProperties.AutomationId="btnResetSidebar"
                       ToolTip="Restores the default order and shows every entry." />

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Check for a new version when the app starts" IsChecked="{Binding CheckForUpdatesAtStartup}"
                      AutomationProperties.AutomationId="chkCheckForUpdatesAtStartup"
                      ToolTip="Asks GitHub for the latest release. No sign-in and no data from this computer are sent. A newer version opens the update window; nothing installs without your click. Save Settings stores this choice." />
            <ui:Button Content="Check for updates" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,8,0,8"
                       Click="CheckForUpdates_Click"
                       AutomationProperties.AutomationId="btnCheckForUpdates"
                       ToolTip="Look up the latest release now." />

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Organization" Style="{StaticResource SectionHeader}" />

            <TextBlock Text="Company Name" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Contoso, Ltd." Margin="0,0,0,8" />

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Systems in use" Style="{StaticResource SectionHeader}"
                       ToolTip="The App Packager page has a publish button for each system. A system that is not in use keeps its buttons disabled." />
            <TextBlock Text="The App Packager page has a publish button for each system. A system that is not in use keeps its buttons disabled."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox Content="ConfigMgr" IsChecked="{Binding UseConfigMgr}" Margin="0,0,24,0"
                          AutomationProperties.AutomationId="chkSystemsConfigMgr"
                          ToolTip="ConfigMgr applications. Needs the ConfigMgr console, a site and a content share." />
                <CheckBox Content="Intune" IsChecked="{Binding UseIntune}" Margin="0,0,24,0"
                          AutomationProperties.AutomationId="chkSystemsIntune"
                          ToolTip="Intune Win32 apps published through Microsoft Graph. Needs an app registration." />
                <CheckBox Content="WSUS" IsChecked="{Binding UseWsus}"
                          AutomationProperties.AutomationId="chkSystemsWsus"
                          ToolTip="Locally published WSUS updates for computers that have an older version. Needs a WSUS server." />
            </StackPanel>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="ConfigMgr Site Settings" Style="{StaticResource SectionHeader}" />

            <TextBlock Text="Site Code" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding SiteCode, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="MCM" MaxLength="5" Width="120" HorizontalAlignment="Left"
                        Margin="0,0,0,12" />

            <TextBlock Text="Site Server / SMS Provider Host" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding ProviderMachine, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="cm01.contoso.com" Margin="0,0,0,4"
                        ToolTip="Host the generated CMSite drive connects to. Leave empty to use the local machine, which only reaches the site when this machine is itself the SMS provider." />
            <TextBlock Text="Leave empty only when this machine is the SMS provider."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Discovery SQL Server" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding Discovery.SqlServer, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Server of the site" MaxLength="200" Margin="0,0,0,4"
                        AutomationProperties.AutomationId="txtDiscoverySqlServer"
                        ToolTip="SQL Server instance of the ConfigMgr site database for Discover unmanaged software, for example cm01.contoso.com or server\instance. Windows authentication only." />
            <TextBlock Text="Leave empty to use the SQL Server of the site, read from the SMS Provider."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Discovery Database" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding Discovery.SqlDatabase, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="CM_ and the site code" MaxLength="128" Width="240" HorizontalAlignment="Left" Margin="0,0,0,4"
                        AutomationProperties.AutomationId="txtDiscoverySqlDatabase"
                        ToolTip="Name of the ConfigMgr site database, for example CM_MCM. The account needs db_datareader on this database." />
            <TextBlock Text="Leave empty to use the database of the site."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Not offered by Discover" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding Discovery.DismissedSummary}" VerticalAlignment="Center" Margin="0,0,12,0"
                           AutomationProperties.AutomationId="txtDiscoveryDismissed"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           ToolTip="Apps that Discover unmanaged software leaves out after Don't ask again for selected." />
                <ui:Button Content="Clear list" Command="{Binding Discovery.ClearDismissedCommand}"
                           AutomationProperties.AutomationId="btnClearDiscoveryDismissed"
                           ToolTip="Offer these apps again in later discoveries. Takes effect on Save." />
            </StackPanel>

            <TextBlock Text="File Share Root (UNC)" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding FileShareRoot, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="\\fileserver\sccm$" Margin="0,0,0,12" />

            <TextBlock Text="Content Layout" Style="{StaticResource FieldLabel}" />
            <ComboBox SelectedValue="{Binding ContentLayout}"
                      SelectedValuePath="Tag"
                      Width="320" HorizontalAlignment="Left" Margin="0,0,0,12"
                      ToolTip="Folder shape under the share's Applications folder. Nested keeps one folder per vendor and application with a version folder inside; Flat puts every version in one level named Vendor-App-Version.">
                <ComboBoxItem Content="Nested - Applications\Vendor\App\Version" Tag="Nested" />
                <ComboBoxItem Content="Flat - Applications\Vendor-App-Version" Tag="Flat" />
            </ComboBox>

            <TextBlock Text="Download Root (local staging)" Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,12">
                <ui:Button DockPanel.Dock="Right" Content="Browse"
                           Command="{Binding BrowseDownloadRootCommand}" Margin="8,0,0,0" />
                <ui:TextBox Text="{Binding DownloadRoot, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DownloadRoot}"
                            PlaceholderText="C:\temp\ap" />
            </DockPanel>

            <TextBlock Text="Packagers Folder (leave empty for auto-detect)" Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Content="Browse"
                           Command="{Binding BrowsePackagersRootCommand}" Margin="8,0,0,0" />
                <ui:TextBox Text="{Binding PackagersRoot, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Auto-detect" />
            </DockPanel>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="After Package" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Optional steps once the ConfigMgr application exists. Content goes to a distribution point group first; the test deployment is created only after that distribution is targeted."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

            <CheckBox Content="Distribute content after Package" IsChecked="{Binding AutoDistribute}" Margin="0,0,0,8"
                      ToolTip="Runs Start-CMContentDistribution for the new application against the group below. A group that already holds the content is treated as done." />

            <TextBlock Text="Distribution point group" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding DpGroupName, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding AutoDistribute}"
                        PlaceholderText="All DPs" Width="320" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <CheckBox Content="Deploy to a test collection after distribution" IsChecked="{Binding DeployToTestCollection}"
                      IsEnabled="{Binding TestDeploymentAvailable}" Margin="0,0,0,8"
                      ToolTip="Creates an Available deployment, effective immediately, to the collection below. An existing deployment is treated as done." />

            <TextBlock Text="Test collection" Style="{StaticResource FieldLabel}" />
            <CheckBox Content="Use a user collection" IsChecked="{Binding TestCollectionIsUser}"
                      IsEnabled="{Binding TestDeploymentAvailable}" Margin="0,0,0,8"
                      ToolTip="Select to target users. When cleared, the test deployment targets a device collection. This does not change the application's install context." />
            <ui:TextBox Text="{Binding TestCollectionName, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding TestDeploymentAvailable}"
                        PlaceholderText="Application pilot collection" Width="320" HorizontalAlignment="Left" Margin="0,0,0,8" />

            <CheckBox Content="Create the collection if it does not exist" IsChecked="{Binding CreateTestCollectionIfMissing}"
                      IsEnabled="{Binding TestDeploymentAvailable}" Margin="0,0,0,8"
                      ToolTip="A missing collection starts empty, limited to All Users for a user collection or All Systems for a device collection. Add pilot members in ConfigMgr." />

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="One Click Settings" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="One Click opens a plan of the apps you track here, then runs Check (and optionally Stage / Publish) without further prompts. Each row publishes to its own destinations; a row with no box checked is skipped. Rows that keep the default follow it when the default changes. The publish buttons on the App Packager page choose their own destination per run."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Action on update" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding OneClickAction}" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Action on update" AutomationProperties.AutomationId="cboOneClickAction"
                              ToolTip="Report only lists the newer versions. Stage downloads and prepares them. Stage and Publish also publishes each application to its destinations, using the comment on the App Packager page.">
                        <ComboBoxItem Content="Report only" Tag="Report" />
                        <ComboBoxItem Content="Stage" Tag="Stage" />
                        <ComboBoxItem Content="Stage and Publish" Tag="StageAndPackage" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Default cadence (days)" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding OneClickCadenceDays, Mode=TwoWay}"
                                  Minimum="1" Maximum="365" SmallChange="1" LargeChange="7"
                                  SpinButtonPlacementMode="Compact" Width="140" HorizontalAlignment="Left"
                                  ToolTip="Days a version check stays fresh. A Report only run skips a tracked application checked more recently than this." />
                </StackPanel>
            </Grid>

            <CheckBox Content="Force on launch (ignore cadence)" IsChecked="{Binding OneClickForce}" Margin="0,0,0,8"
                      AutomationProperties.AutomationId="chkOneClickForce"
                      ToolTip="The plan opens with Force set: the cadence, the refusal memory and the already-published guard are ignored." />

            <TextBlock Text="Default destinations" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                        ToolTip="The destinations of every tracked app that has no selection of its own in the grid.">
                <CheckBox Content="ConfigMgr" IsChecked="{Binding OneClickDefaultConfigMgr}" Margin="0,0,24,0" AutomationProperties.AutomationId="chkOneClickMecm" />
                <CheckBox Content="WSUS" IsChecked="{Binding OneClickDefaultWsus}" Margin="0,0,24,0" AutomationProperties.AutomationId="chkOneClickWsus" />
                <CheckBox Content="Intune" IsChecked="{Binding OneClickDefaultIntune}" AutomationProperties.AutomationId="chkOneClickIntune" />
            </StackPanel>

            <TextBlock Text="Existing ConfigMgr app" Style="{StaticResource FieldLabel}" />
            <ComboBox SelectedValue="{Binding OneClickOnExisting}" SelectedValuePath="Tag" Width="240" HorizontalAlignment="Left" Margin="0,0,0,12"
                      AutomationProperties.Name="Existing ConfigMgr app" AutomationProperties.AutomationId="cboOneClickOnExisting"
                      ToolTip="What a run does when the ConfigMgr application already exists with another version. One Click never asks during the run.">
                <ComboBoxItem Content="Skip the application" Tag="Skip" />
                <ComboBoxItem Content="Overwrite it" Tag="Overwrite" />
            </ComboBox>

            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Content="Track none" Command="{Binding TrackNoneOneClickCommand}" Margin="8,0,0,0" />
                <ui:Button DockPanel.Dock="Right" Content="Track all" Command="{Binding TrackAllOneClickCommand}" Margin="8,0,0,0" />
                <ui:Button DockPanel.Dock="Right" Content="Refresh list" Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshOneClickRowsCommand}" Margin="8,0,0,0"
                           ToolTip="Rebuilds the list from the applications the App Packager page shows." />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding OneClickTrackedCount, Mode=OneWay}" /><Run Text=" tracked" />
                </TextBlock>
            </DockPanel>

            <DataGrid ItemsSource="{Binding OneClickRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" BorderThickness="1"
                      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" GridLinesVisibility="Horizontal"
                      Height="280" Margin="0,0,0,8" IsTextSearchEnabled="True" TextSearch.TextPath="Application"
                      AutomationProperties.AutomationId="dgOneClickApps">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Track" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Tracked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Application" Width="*" MinWidth="130" Binding="{Binding Application}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Vendor" Width="100" Binding="{Binding Vendor}" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="ConfigMgr" Width="100" SortMemberPath="ConfigMgr">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding ConfigMgr, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          AutomationProperties.Name="ConfigMgr" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="WSUS" Width="64" SortMemberPath="Wsus">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Wsus, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          AutomationProperties.Name="WSUS" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Intune" Width="72" SortMemberPath="Intune">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Intune, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          AutomationProperties.Name="Intune" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Cadence (days)" Width="122">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CadenceDisplay, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent" Padding="4,2"
                                         ToolTip="Days for this application only. Empty uses the default cadence." />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Detected Tools" Style="{StaticResource SectionHeader}" />

            <TextBlock Text="Configuration Manager console" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding ConsoleStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="7-Zip command line" Style="{StaticResource FieldLabel}" />
            <TextBlock Text="{Binding SevenZipStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Win32 Content Prep Tool" Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Content="Download"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Command="{Binding DownloadContentPrepCommand}"
                           IsEnabled="{Binding ContentPrepIdle}"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           ToolTip="Fetches IntuneWinAppUtil.exe from its Microsoft repository and checks its publisher signature before use." />
                <TextBlock Text="{Binding ContentPrepStatus}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Packager Icon Pack" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Application icons for definitions tagged IconSource External. Downloaded from the icon pack release and stored in your LocalAppData definition folder; bundled icons remain read-only."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Content="Install from file..."
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Command="{Binding InstallIconPackFromFileCommand}"
                           IsEnabled="{Binding IconPackIdle}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <ui:Button DockPanel.Dock="Right" Content="Download icon pack"
                           Icon="{ui:SymbolIcon ArrowDownload24}"
                           Command="{Binding DownloadIconPackCommand}"
                           IsEnabled="{Binding IconPackIdle}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding IconPackStatus}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="GitHub API" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="About a third of the catalog reads api.github.com. Anonymous requests share 60 per hour per address; a token from APP_PACKAGER_GITHUB_TOKEN, GITHUB_TOKEN or gh auth login raises that to 5,000."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Content="Refresh"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshGitHubApiStatusCommand}"
                           IsEnabled="{Binding GitHubApiIdle}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GitHubApiStatus}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Intune" Style="{StaticResource SectionHeader}" />

            <TextBlock Text="Publishing needs an Entra app registration with the application permission DeviceManagementApps.ReadWrite.All, admin-consented."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding IntuneTenantId, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="contoso.onmicrosoft.com or a GUID" Margin="0,0,0,12" />

            <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding IntuneClientId, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="App registration (client) ID" Margin="0,0,0,12" />

            <TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" />
            <ui:PasswordBox Password="{Binding IntuneClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding IntuneSecretHint}" Margin="0,0,0,4" />
            <TextBlock Text="Stored encrypted for the current Windows user. Leave empty to keep the saved secret."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="Stage builds the .intunewin when the Win32 Content Prep Tool is on this computer; Publish to ConfigMgr stores it beside the network content."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="CVE lookup" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Check CVEs asks the NIST NVD API for the CVEs between the ConfigMgr version and the latest version of each application. Without a key NVD allows 5 requests in 30 seconds; with a key it allows 50."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="NVD API key" Style="{StaticResource FieldLabel}" />
            <ui:PasswordBox Password="{Binding NvdApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{Binding NvdApiKeyHint}" Margin="0,0,0,4"
                            AutomationProperties.AutomationId="pwdNvdApiKey" />
            <TextBlock Text="Stored encrypted for the current Windows user. Leave empty to keep the saved key. Without a saved key the NVD_API_KEY environment variable is used."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <CheckBox Content="Remove the saved key on Save"
                      IsChecked="{Binding RemoveNvdApiKey}"
                      IsEnabled="{Binding HasStoredNvdApiKey}"
                      Margin="0,0,0,8"
                      AutomationProperties.AutomationId="chkRemoveNvdApiKey" />
            <CheckBox Content="Look up CVEs after Check ConfigMgr"
                      IsChecked="{Binding LookupCvesAfterCheckMecm}"
                      Margin="0,0,0,8"
                      AutomationProperties.AutomationId="chkCveAfterCm" />

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="WSUS Publishing" Style="{StaticResource SectionHeader}" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="Publish to WSUS publishes the installer of each checked app as a locally published update. WSUS Updates on the App Packager page lists and manages the published updates. This computer needs the WSUS console or RSAT WSUS tools at the server's version, an account in the WSUS Administrators group, and file-share access to the server. When this computer is not the WSUS server, it must also trust the signing certificate." />

            <TextBlock Text="Server" Style="{StaticResource SubHeader}" />
            <TextBlock Text="WSUS server" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding Wsus.ServerName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="wsus01.contoso.com" Margin="0,0,0,12"
                        AutomationProperties.Name="WSUS server" AutomationProperties.AutomationId="txtWsusServer"
                        ToolTip="Host name of the WSUS server. With ConfigMgr, the WSUS server of the top-level software update point." />
            <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,4">
                <ui:Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding Wsus.CancelCommand}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding Wsus.Busy, Converter={StaticResource BooleanToVisibilityConverter}}"
                           AutomationProperties.AutomationId="btnWsusCancel" />
                <ui:Button DockPanel.Dock="Right" Content="Test connection" Command="{Binding Wsus.TestConnectionCommand}" Margin="8,0,0,0"
                           VerticalAlignment="Center" AutomationProperties.AutomationId="btnWsusTest" ToolTipService.ShowOnDisabled="True"
                           ToolTip="Connects with the values in the boxes and reads the server version, the account role and the signing certificate." />
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox Text="{Binding Wsus.Port, UpdateSourceTrigger=PropertyChanged}" Width="100" MaxLength="5"
                                AutomationProperties.Name="WSUS port" AutomationProperties.AutomationId="txtWsusPort"
                                ToolTip="8530 for HTTP and 8531 for HTTPS on a default WSUS install." />
                    <CheckBox Content="Use SSL" IsChecked="{Binding Wsus.UseSsl}" Margin="16,0,0,0" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="chkWsusSsl" ToolTip="Connect to the WSUS administration API over HTTPS." />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Wsus.StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                       AutomationProperties.AutomationId="txtWsusStatus" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="Signing certificate" Style="{StaticResource SubHeader}" />
            <TextBlock Text="{Binding Wsus.CertificateText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.AutomationId="txtWsusCert" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <WrapPanel Margin="0,0,0,8">
                <ui:Button Content="Create self-signed..." Command="{Binding Wsus.CreateSelfSignedCommand}" Margin="0,0,8,4"
                           AutomationProperties.AutomationId="btnWsusCertCreate" ToolTipService.ShowOnDisabled="True"
                           ToolTip="Has the WSUS server create and use a self-signed signing certificate." />
                <ui:Button Content="Import PFX..." Command="{Binding Wsus.ImportPfxCommand}" Margin="0,0,8,4"
                           AutomationProperties.AutomationId="btnWsusCertImport" ToolTipService.ShowOnDisabled="True"
                           ToolTip="Sets a code-signing certificate with its private key from a PFX file, for example one issued by your PKI." />
                <ui:Button Content="Export certificate..." Command="{Binding Wsus.ExportCertificateCommand}" Margin="0,0,8,4"
                           AutomationProperties.AutomationId="btnWsusCertExport" ToolTipService.ShowOnDisabled="True"
                           ToolTip="Saves the public signing certificate (.cer) for distribution to clients by Group Policy." />
            </WrapPanel>
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       AutomationProperties.AutomationId="txtWsusClientTrust"
                       Text="Clients install locally published updates only when the signing certificate is in their Trusted Publishers store (and Trusted Root Certification Authorities when it is self-signed) and the policy Allow signed updates from an intranet Microsoft update service location is enabled: HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate, AcceptTrustedPublisherCerts = 1 (DWORD)." />

            <TextBlock Text="Publishing" Style="{StaticResource SubHeader}" />
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="txtWsusPolicy"
                       Text="Each update installs only where an older version of the application is installed. A computer without the application does not get the update." />
            <TextBlock Text="Classification" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Wsus.ClassificationOptions}" DisplayMemberPath="Label" SelectedValuePath="Name"
                      SelectedValue="{Binding Wsus.Classification}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,12"
                      AutomationProperties.Name="Classification" AutomationProperties.AutomationId="cboWsusClassification"
                      ToolTip="WSUS classification of every published update. With ConfigMgr, the software update point must synchronize it." />
            <TextBlock Text="Approve for group" Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Content="Load groups" Command="{Binding Wsus.LoadGroupsCommand}" Margin="8,0,0,0"
                           VerticalAlignment="Center" AutomationProperties.AutomationId="btnWsusGroups" ToolTipService.ShowOnDisabled="True"
                           ToolTip="Lists the computer groups of the server in the box." />
                <ComboBox IsEditable="True" ItemsSource="{Binding Wsus.Groups}" Text="{Binding Wsus.ApprovalGroup, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="Approve for group" AutomationProperties.AutomationId="cboWsusGroup"
                          ToolTip="Computer group the update is approved for right after it publishes. Leave empty to approve later from WSUS Updates on the App Packager page: the WSUS console does not list locally published updates." />
            </DockPanel>
            <CheckBox Content="Decline earlier versions of the same application after publishing" IsChecked="{Binding Wsus.DeclineSuperseded}" Margin="0,0,0,8"
                      AutomationProperties.AutomationId="chkWsusDecline"
                      ToolTip="Declines the AppPackager updates of the same application that have a lower version. Approving one again reverses it." />

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Script Signing" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Authenticode signing for the scripts AppPackager generates. Signing a detection script does not sign install wrappers, and signing deployment scripts does not sign requirement scripts. A local signature check does not prove the certificate is trusted on your clients."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

            <TextBlock Text="Sign" Style="{StaticResource SubHeader}" />
            <CheckBox Content="Sign detection scripts" IsChecked="{Binding Signing.SignDetection}" Margin="0,0,0,4"
                      ToolTip="Signs generated and custom detection scripts. An unchanged import carrying a valid third-party signature is left alone." />
            <CheckBox Content="Sign requirement scripts and script global conditions" IsChecked="{Binding Signing.SignRequirements}" Margin="0,0,0,4"
                      ToolTip="Covers script-based requirement rules including the VPN predicate. WQL and native rules need no signature." />
            <CheckBox Content="Sign install and uninstall PowerShell scripts" IsChecked="{Binding Signing.SignDeployment}" Margin="0,0,0,12"
                      ToolTip="Signs the deployment execution chain and removes the execution-policy argument from its generated launchers, letting the configured endpoint policy govern. A vendor script that already carries an intact signature is left alone; an unsigned one is signed with this certificate." />

            <TextBlock Text="Require valid signatures" Style="{StaticResource SubHeader}" />
            <TextBlock Text="A publishing constraint, not a change to client execution policy. When a required category fails verification the build stops; there is no unsigned fallback."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
            <CheckBox Content="Require valid detection signatures" IsChecked="{Binding Signing.RequireDetection}" Margin="0,0,0,4" />
            <CheckBox Content="Require valid requirement signatures" IsChecked="{Binding Signing.RequireRequirements}" Margin="0,0,0,4" />
            <CheckBox Content="Require valid deployment script signatures" IsChecked="{Binding Signing.RequireDeployment}" Margin="0,0,0,12" />

            <TextBlock Text="Signing identity" Style="{StaticResource SubHeader}" />
            <TextBlock Text="Certificate store" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Signing.StoreLocationOptions}" SelectedItem="{Binding Signing.StoreLocation}"
                      AutomationProperties.Name="Certificate store" AutomationProperties.AutomationId="SigningStore"
                      Width="320" HorizontalAlignment="Left" Margin="0,0,0,12"
                      ToolTip="CurrentUser\My is the supported identity. LocalMachine\My needs an explicit choice and tested private-key access." />

            <TextBlock Text="Certificate" Style="{StaticResource FieldLabel}" />
            <DockPanel Margin="0,0,0,4">
                <ui:Button DockPanel.Dock="Right" Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding Signing.RefreshCertificatesCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Signing.Certificates}" SelectedItem="{Binding Signing.SelectedCertificate}"
                          DisplayMemberPath="Label" AutomationProperties.Name="Certificate" AutomationProperties.AutomationId="SigningCertificate"
                          ToolTip="Selected by thumbprint. A renewed certificate is a new thumbprint and needs reselecting here." />
            </DockPanel>
            <TextBlock Text="{Binding Signing.CertificateDetail}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Timestamp server" Style="{StaticResource FieldLabel}" />
            <ui:TextBox Text="{Binding Signing.TimestampServer, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="none"
                        AutomationProperties.Name="Timestamp server" AutomationProperties.AutomationId="SigningTimestamp" Margin="0,0,0,4"
                        ToolTip="A timestamped signature stays valid after the certificate expires. A signature that exists is not the same as a verified timestamp." />
            <CheckBox Content="Timestamp required" IsChecked="{Binding Signing.TimestampRequired}" Margin="0,0,0,12"
                      ToolTip="With this on, a timestamp server failure fails the signed build instead of producing an untimestamped signature." />

            <ui:Button Content="Test signing configuration" Command="{Binding Signing.TestConfigurationCommand}"
                       IsEnabled="{Binding Signing.TestIdle}" HorizontalAlignment="Left" Margin="0,0,0,8"
                       ToolTip="Signs and verifies a temporary file with the selected certificate. Nothing is published." />
            <TextBlock Text="{Binding Signing.TestResult}" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.AutomationId="SigningTestResult"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Private keys are never exported and never reach profiles, manifests, logs or command lines. A key held on a hardware token may require a PIN and can prevent unattended runs."
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Deployment Type Defaults" Style="{StaticResource SectionHeader}" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Estimated Runtime (mins)" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding EstimatedRuntimeMins, Mode=TwoWay}"
                                  Minimum="1" Maximum="120" SmallChange="5" LargeChange="15"
                                  SpinButtonPlacementMode="Compact"
                                  Width="140" HorizontalAlignment="Left"
                                  ToolTip="Estimated time for the installer to complete. Used by ConfigMgr for deployment scheduling." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Maximum Runtime (mins)" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding MaximumRuntimeMins, Mode=TwoWay}"
                                  Minimum="1" Maximum="720" SmallChange="5" LargeChange="30"
                                  SpinButtonPlacementMode="Compact"
                                  Width="140" HorizontalAlignment="Left"
                                  ToolTip="Maximum time before ConfigMgr considers the install as failed. Default 30 minutes." />
                </StackPanel>
            </Grid>

            <TextBlock Text="Fallback DPs" Style="{StaticResource FieldLabel}"
                       ToolTip="Deployment type content option. Applies to deployment types created by future Package runs." />
            <ComboBox SelectedValue="{Binding ContentFallback}" SelectedValuePath="Tag"
                      AutomationProperties.Name="Fallback DPs" AutomationProperties.AutomationId="ContentFallback"
                      Width="360" HorizontalAlignment="Left" Margin="0,0,0,12"
                      ToolTip="Allow: when no distribution point in the current or neighbor boundary groups has the content, the client can use the site default boundary group.">
                <ComboBoxItem Content="Allow - use the site default boundary group" Tag="Allow" />
                <ComboBoxItem Content="Deny - current and neighbor groups only" Tag="Deny" />
            </ComboBox>

            <TextBlock Text="Neighbor/default DP" Style="{StaticResource FieldLabel}"
                       ToolTip="Deployment type content option. Applies to deployment types created by future Package runs." />
            <ComboBox SelectedValue="{Binding SlowNetworkDeploymentMode}" SelectedValuePath="Tag"
                      AutomationProperties.Name="Neighbor/default DP" AutomationProperties.AutomationId="SlowNetworkDeploymentMode"
                      Width="360" HorizontalAlignment="Left" Margin="0,0,0,12"
                      ToolTip="Deployment option when the client uses a distribution point in a neighbor boundary group or the site default boundary group.">
                <ComboBoxItem Content="Download content and install" Tag="Download" />
                <ComboBoxItem Content="Do not download content" Tag="DoNothing" />
            </ComboBox>

            <TextBlock Text="Application title" Style="{StaticResource FieldLabel}"
                       ToolTip="Default application naming for every Package run." />
            <CheckBox Content="Include version in application name" IsChecked="{Binding TitleOptions.IncludeVersionInTitle}" Margin="0,0,0,4"
                      ToolTip="Adds the version to every application name, creating one ConfigMgr application per release. A per-application choice in the Workbench overrides this. Existing applications are not renamed." />
            <CheckBox Content="Remove version from application name" IsChecked="{Binding TitleOptions.RemoveVersionFromTitle}"
                      IsEnabled="{Binding TitleOptions.RemoveVersionFromTitleAvailable}" Margin="0,0,0,8"
                      ToolTip="Strips the release version from a vendor product name that carries it (7-Zip 26.03, Slido 2.3.1, Tableau 2026.2). Available while the version is not added to the name. A per-application choice in the Workbench overrides this." />

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="M365 Apps — Channel" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Update channel for M365 Apps, Project, and Visio packagers."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <ComboBox SelectedValue="{Binding M365Channel}"
                      SelectedValuePath="Tag"
                      Width="320" HorizontalAlignment="Left" Margin="0,0,0,8">
                <ComboBoxItem Content="Monthly Enterprise Channel" Tag="MonthlyEnterprise" />
                <ComboBoxItem Content="Current Channel" Tag="Current" />
                <ComboBoxItem Content="Semi-Annual Enterprise Channel (kiosk)" Tag="SemiAnnual" />
            </ComboBox>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Install Parameters" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Switches and choices each installer takes, saved per application. Stage starts from these values: the review dialog shows them first unless it is skipped, in which case they apply as they are."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <CheckBox Content="Skip the review dialog before staging and use the saved values" IsChecked="{Binding SkipConfigReview}" Margin="0,0,0,8"
                      ToolTip="Applications marked for review in their definition still show the dialog." />
            <TextBlock Text="{Binding InstallParameterSummary}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding InstallParameterGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding SubHeader}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <controls:InstallerSettingsPanel Parameters="{Binding Parameters}" Store="{Binding Values}" />
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Local Installer Sources" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Folders that hold an installer whose download needs a sign-in. Stage takes the highest file version found in the folder, and the installer must carry a valid signature."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding LocalSourceRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                                <ui:TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="No folder chosen" />
                            </DockPanel>
                            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Packager Files" Style="{StaticResource SectionHeader}" Margin="0,8,0,12" />
            <TextBlock Text="Files an installer reads from its own folder, such as a license key. The file is copied beside the installer at Stage and is never read."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding SideFileRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                                <ui:TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="No file chosen" />
                            </DockPanel>
                            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="Citrix Workspace App — Install Parameters" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="Used by the Current Release and LTSR definitions. A shaded box or an empty choice is not set: no switch is passed and the installer default applies."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

            <TextBlock Text="Store" Style="{StaticResource SubHeader}" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Store Name" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding CwaSwitches.Store.Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="MyStore" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Store URL (passed as typed)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding CwaSwitches.Store.Url, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://storefront.contoso.com/Citrix/Store/discovery" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Installation" Style="{StaticResource SubHeader}" />
                    <CheckBox Content="Clean install" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.CleanInstall}" Margin="0,0,0,4" />
                    <CheckBox Content="Include SSON" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.IncludeSSON}" Margin="0,0,0,4" />
                    <CheckBox Content="Enable SSON" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.EnableSSON}" Margin="16,0,0,4"
                              ToolTip="ENABLE_SSON is passed only together with Include SSON." />
                    <CheckBox Content="startAppProtection" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.AppProtection}" Margin="0,0,0,4" />
                    <CheckBox Content="Session pre-launch" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.SessionPreLaunch}" Margin="0,0,0,4" />
                    <CheckBox Content="Self-service mode" IsThreeState="True" IsChecked="{Binding CwaSwitches.Installation.SelfServiceMode}" Margin="0,0,0,4" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Plugins" Style="{StaticResource SubHeader}" />
                    <CheckBox Content="Microsoft Teams" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.MSTeamsPlugin}" Margin="0,0,0,4"
                              ToolTip="Current Release only: /InstallMSTeamsPlugin=Y|N. LTSR documents no switch and ignores it." />
                    <CheckBox Content="Zoom" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.ZoomPlugin}" Margin="0,0,0,4"
                              ToolTip="Current Release: cleared passes Installzoomplugin=N. LTSR: checked adds ZoomVDIPlugin to ADDONS." />
                    <CheckBox Content="Webex" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.WebExPlugin}" Margin="0,0,0,4" />
                    <CheckBox Content="uberAgent" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.UberAgent}" Margin="0,0,0,4" />
                    <CheckBox Content="Skip uberAgent upgrade" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.UberAgentSkipUpgrade}" Margin="16,0,0,4" />
                    <CheckBox Content="EPA client" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.EPAClient}" Margin="0,0,0,4" />
                    <CheckBox Content="Session recording" IsThreeState="True" IsChecked="{Binding CwaSwitches.Plugins.SessionRecording}" Margin="0,0,0,4"
                              ToolTip="Current Release only: /InstallSRAgent. LTSR documents no switch and ignores it." />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Components" Style="{StaticResource SubHeader}" />
                    <CheckBox Content="Customize (ADDLOCAL)" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.Customize}" Margin="0,0,0,4" />
                    <CheckBox Content="ReceiverInside" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.ReceiverInside}" Margin="16,0,0,4" />
                    <CheckBox Content="ICA__Client" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.ICA_Client}" Margin="16,0,0,4" />
                    <CheckBox Content="AM" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.AM}" Margin="16,0,0,4" />
                    <CheckBox Content="SelfService" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.SelfService}" Margin="16,0,0,4" />
                    <CheckBox Content="DesktopViewer" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.DesktopViewer}" Margin="16,0,0,4" />
                    <CheckBox Content="WebHelper" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.WebHelper}" Margin="16,0,0,4" />
                    <CheckBox Content="BCR__Client" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.BCR_Client}" Margin="16,0,0,4" />
                    <CheckBox Content="USB" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.USB}" Margin="16,0,0,4" />
                    <CheckBox Content="SSON" IsThreeState="True" IsChecked="{Binding CwaSwitches.Components.SSON}" Margin="16,0,0,4" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Updates, telemetry and store policy" Style="{StaticResource SubHeader}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AutoUpdateCheck" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding CwaSwitches.UpdateAndTelemetry.AutoUpdateCheck}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="(not set)" Tag="" />
                        <ComboBoxItem Content="auto" Tag="auto" />
                        <ComboBoxItem Content="manual" Tag="manual" />
                        <ComboBoxItem Content="disabled" Tag="disabled" />
                    </ComboBox>
                    <CheckBox Content="EnableCEIP" IsThreeState="True" IsChecked="{Binding CwaSwitches.UpdateAndTelemetry.EnableCEIP}" Margin="0,8,0,4" />
                    <CheckBox Content="EnableTracing" IsThreeState="True" IsChecked="{Binding CwaSwitches.UpdateAndTelemetry.EnableTracing}" Margin="0,0,0,4" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ALLOWADDSTORE" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding CwaSwitches.StorePolicy.AllowAddStore}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="(not set)" Tag="" />
                        <ComboBoxItem Content="S - secure stores only" Tag="S" />
                        <ComboBoxItem Content="A - secure and non-secure stores" Tag="A" />
                        <ComboBoxItem Content="N - never" Tag="N" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="ALLOWSAVEPWD" Style="{StaticResource FieldLabel}" />
                    <ComboBox SelectedValue="{Binding CwaSwitches.StorePolicy.AllowSavePwd}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="(not set)" Tag="" />
                        <ComboBoxItem Content="S - secure stores only" Tag="S" />
                        <ComboBoxItem Content="A - all stores" Tag="A" />
                        <ComboBoxItem Content="N - never" Tag="N" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Left" Content="Preview" Command="{Binding PreviewCwaCommand}" VerticalAlignment="Top"
                           ToolTip="Shows the Current Release and LTSR install arguments these choices produce." />
                <TextBlock Text="{Binding CwaPreview}" Margin="12,0,0,0" TextWrapping="Wrap" FontFamily="Consolas"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>

            <Border Style="{StaticResource SectionDivider}" />

            <TextBlock Text="About" Style="{StaticResource SectionHeader}" />
            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Content="Releases"
                           Icon="{ui:SymbolIcon Open24}"
                           Command="{Binding OpenReleasesCommand}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                               AutomationProperties.AutomationId="txtAboutDescription"
                               Text="Automated application packaging for ConfigMgr, Intune and WSUS: vendor version checks, silent install wrappers, detection rules, and a publish button per destination." />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="App Packager Desktop " /><Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text=" - MIT License. Settings are stored under %LOCALAPPDATA%\AppPackager." />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <Border Height="32" />

        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
