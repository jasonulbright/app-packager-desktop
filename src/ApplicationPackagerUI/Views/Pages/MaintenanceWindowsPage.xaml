<Page
    x:Class="ApplicationPackagerUI.Views.Pages.MaintenanceWindowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>

            <DataTemplate x:Key="TabHeaderTemplate">
                <StackPanel>
                    <TextBlock x:Name="TabHeaderText" Text="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="TabHeaderUnderline" Height="3" CornerRadius="1.5" Margin="0,4,0,0" Background="Transparent" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                        <Setter TargetName="TabHeaderText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter TargetName="TabHeaderText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="TabHeaderUnderline" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="HeaderTemplate" Value="{StaticResource TabHeaderTemplate}" />
            </Style>

            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Maintenance Windows" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Show, create, edit and remove the maintenance windows of the device collections. Every change shows a plan first."
                       FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="12,8" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding HasConnectionMessage, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="pnlConnection">
            <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtConnectionMessage" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.AutomationId="tabMaintenanceWindows">
            <TabItem Header="Windows" AutomationProperties.AutomationId="tabWindows">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:TextBox Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by collection, window or schedule"
                                    Icon="{ui:SymbolIcon Search24}" MinWidth="280" Margin="0,0,8,8"
                                    AutomationProperties.Name="Filter" AutomationProperties.AutomationId="txtWindowFilter" />
                        <ComboBox ItemsSource="{Binding TypeFilters}" SelectedValue="{Binding TypeFilter}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  MinWidth="160" Margin="0,0,8,8" AutomationProperties.Name="Type" AutomationProperties.AutomationId="cboTypeFilter" />
                        <ComboBox ItemsSource="{Binding EnabledFilters}" SelectedItem="{Binding EnabledFilter}"
                                  MinWidth="120" Margin="0,0,8,8" AutomationProperties.Name="Status" AutomationProperties.AutomationId="cboEnabledFilter" />
                        <ComboBox ItemsSource="{Binding Folders}" SelectedValue="{Binding FolderFilter}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  MinWidth="180" Margin="0,0,8,8" AutomationProperties.Name="Folder" AutomationProperties.AutomationId="cboFolderFilter" />
                        <CheckBox Content="Only collections with windows" IsChecked="{Binding OnlyCollectionsWithWindows}" Margin="0,0,12,8"
                                  VerticalAlignment="Center" AutomationProperties.AutomationId="chkOnlyWithWindows" />
                        <TextBlock Text="{Binding RowCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8"
                                   AutomationProperties.AutomationId="txtRowCount" />
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                        <ui:Button Content="New Window" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewWindowCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnNewWindow" />
                        <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit24}" Command="{Binding EditWindowCommand}"
                                   ToolTip="{Binding EditTooltip}" ToolTipService.ShowOnDisabled="True"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnEditWindow" />
                        <ui:Button Content="Toggle Enabled" Icon="{ui:SymbolIcon ToggleLeft24}" Command="{Binding ToggleEnabledCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnToggleEnabled" />
                        <ui:Button Content="Remove" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveWindowsCommand}"
                                   ToolTip="{Binding RemoveTooltip}" ToolTipService.ShowOnDisabled="True"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnRemoveWindow" />
                        <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnRefresh" />
                        <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelLoadCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnCancelLoad"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Export CSV" Icon="{ui:SymbolIcon DocumentTable24}" Command="{Binding ExportCsvCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnExportCsv" />
                        <ui:Button Content="Export HTML" Icon="{ui:SymbolIcon Globe24}" Command="{Binding ExportHtmlCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnExportHtml" />
                    </WrapPanel>

                    <Grid Grid.Row="2" x:Name="gridWindowsLayout" SizeChanged="OnWindowsLayoutSizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="180" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="260" MinWidth="220" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Row="0" Grid.Column="0" x:Name="dgWindows" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                  SelectionChanged="OnWindowsSelectionChanged" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                                  HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True" helpers:DataGridColumnSizing.FixStarWidthsOnResize="True"
                                  RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource FocusableCell}" AutomationProperties.AutomationId="dgWindows" AutomationProperties.Name="Maintenance windows">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="76" MinWidth="76" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Collection" Binding="{Binding CollectionName}" Width="*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Window" Binding="{Binding WindowName}" Width="*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="128" MinWidth="128" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Recurrence" Binding="{Binding Recurrence}" Width="148" MinWidth="148" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Schedule" Binding="{Binding ScheduleText}" Width="1.5*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="76" MinWidth="76" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Next occurrence" Binding="{Binding Next}" Width="132" MinWidth="132" ElementStyle="{StaticResource TrimmedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="0" Grid.Column="1" x:Name="splitWindowDetails" Width="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" Focusable="True"
                                      ToolTip="Drag to change the width of the details." AutomationProperties.Name="Details width"
                                      AutomationProperties.AutomationId="splitWindowDetails" />

                        <Border Grid.Row="0" Grid.Column="2" x:Name="pnlWindowDetails" BorderThickness="1" CornerRadius="6" Padding="12"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                AutomationProperties.AutomationId="pnlWindowDetails">
                            <Grid>
                                <TextBlock Text="Select a maintenance window to see its properties and next occurrences." Style="{StaticResource Note}"
                                           Visibility="{Binding HasSelectedWindow, Converter={x:Static helpers:DetectionTesterConverters.NotVisible}}" />
                                <TabControl SelectedIndex="{Binding DetailTabIndex}" AutomationProperties.AutomationId="tabWindowDetails"
                                            Visibility="{Binding HasSelectedWindow, Converter={StaticResource BoolToVisibility}}">
                                    <TabItem Header="Properties" AutomationProperties.AutomationId="tabProperties">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Properties}" AutomationProperties.AutomationId="lstProperties">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" Margin="0" />
                                                            <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                                     AutomationProperties.Name="{Binding Name}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Next 5 occurrences" AutomationProperties.AutomationId="tabNextOccurrences">
                                        <ItemsControl ItemsSource="{Binding NextOccurrences}" Margin="0,8,0,0" AutomationProperties.AutomationId="lstNextOccurrences">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Coverage" AutomationProperties.AutomationId="tabCoverage">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                        <ui:Button Content="Apply template" Appearance="Primary" Icon="{ui:SymbolIcon CalendarAdd24}" Command="{Binding ApplyTemplateToSelectedCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnApplyTemplateCoverage"
                                   ToolTip="Create a window from a template on the selected collections. A plan lists every change first." />
                        <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnRefreshCoverage" />
                        <ComboBox ItemsSource="{Binding Folders}" SelectedValue="{Binding FolderFilter}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  MinWidth="180" Margin="0,0,8,8" AutomationProperties.Name="Folder" AutomationProperties.AutomationId="cboCoverageFolder" />
                        <CheckBox Content="Only collections without a window" IsChecked="{Binding CoverageWithoutWindowOnly}" Margin="0,0,12,8"
                                  VerticalAlignment="Center" AutomationProperties.AutomationId="chkWithoutWindow" />
                        <TextBlock Text="{Binding CoverageCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8"
                                   AutomationProperties.AutomationId="txtCoverageCount" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" x:Name="dgCoverage" ItemsSource="{Binding Coverage}" SelectionChanged="OnCoverageSelectionChanged"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              RowHeaderWidth="0" SelectionMode="Extended" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto"
                              helpers:DataGridColumnSizing.FixStarWidthsOnResize="True" RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource FocusableCell}" AutomationProperties.AutomationId="dgCoverage" AutomationProperties.Name="Coverage">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40" MinWidth="40" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                           AutomationProperties.Name="Has a window"
                                                           Visibility="{Binding HasWindow, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:SymbolIcon Symbol="DismissCircle24" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                           AutomationProperties.Name="No window"
                                                           Visibility="{Binding HasWindow, Converter={x:Static helpers:DetectionTesterConverters.NotVisible}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Coverage" Binding="{Binding Coverage}" Width="110" MinWidth="84" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Collection" Binding="{Binding Name}" Width="3*" MinWidth="180" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="ID" Binding="{Binding CollectionId}" Width="100" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="90" MinWidth="84" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Windows" Binding="{Binding WindowCount}" Width="90" MinWidth="84" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Built-in" Binding="{Binding BuiltIn}" Width="80" MinWidth="72" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Templates" AutomationProperties.AutomationId="tabTemplates">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                        <ui:Button Content="New Template" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewTemplateCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnNewTemplate" />
                        <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit24}" Command="{Binding EditTemplateCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnEditTemplate"
                                   ToolTip="Shipped templates cannot be changed." />
                        <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteTemplateCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnDeleteTemplate"
                                   ToolTip="Shipped templates cannot be deleted." />
                        <ui:Button Content="Apply" Appearance="Primary" Icon="{ui:SymbolIcon CalendarAdd24}" Command="{Binding ApplySelectedTemplateCommand}"
                                   Style="{StaticResource ToolButton}" AutomationProperties.AutomationId="btnApplyTemplate" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              RowHeaderWidth="0" SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto"
                              helpers:DataGridColumnSizing.FixStarWidthsOnResize="True" RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource FocusableCell}" AutomationProperties.AutomationId="dgTemplates" AutomationProperties.Name="Templates">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Recurrence" Binding="{Binding Recurrence}" Width="148" MinWidth="148" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="128" MinWidth="128" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="76" MinWidth="76" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80" MinWidth="68" ElementStyle="{StaticResource TrimmedCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Grid.Column="2" BorderThickness="1" CornerRadius="6" Padding="12"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            AutomationProperties.AutomationId="pnlTemplateDetails">
                        <StackPanel>
                            <TextBlock Text="Select a template to see its schedule." Style="{StaticResource Note}">
                                <TextBlock.Visibility>
                                    <Binding Path="SelectedTemplate" Converter="{x:Static helpers:MaintenanceWindowsConverters.NullVisible}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                            <StackPanel DataContext="{Binding SelectedTemplate}">
                                <StackPanel.Visibility>
                                    <Binding Converter="{x:Static helpers:MaintenanceWindowsConverters.NotNullVisible}" />
                                </StackPanel.Visibility>
                                <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           AutomationProperties.AutomationId="txtTemplateDescription" />
                                <TextBlock Text="Schedule" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding ScheduleText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           AutomationProperties.AutomationId="txtTemplateSchedule" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="pnlResults">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Content="Undo last change" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoLastCommand}"
                               AutomationProperties.AutomationId="btnUndoLast"
                               ToolTip="Shows a plan that undoes the last change set."
                               Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtResultSummary" />
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding LastResults}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                          SelectionMode="Single" GridLinesVisibility="Horizontal" RowStyle="{StaticResource SelectableRow}" CellStyle="{StaticResource FocusableCell}" AutomationProperties.AutomationId="dgResults" AutomationProperties.Name="Results">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Result" Binding="{Binding OutcomeText}" Width="90" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Item.Action}" Width="120" />
                        <DataGridTextColumn Header="Object" Binding="{Binding Item.Target}" Width="*" MinWidth="180" ElementStyle="{StaticResource TrimmedCell}" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Note}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="txtMaintenanceStatus" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Page>
