<Page
    x:Class="ApplicationPackagerUI.Views.Pages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers">

    <Page.Resources>
        <helpers:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    </Page.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Row 0: Comment + action buttons -->
        <!-- ═══════════════════════════════════════════════════ -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Text="Comment:" FontWeight="SemiBold" FontSize="13"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="WO#00000001234567"
                        Width="280" Margin="0,0,16,0" VerticalAlignment="Center" />

            <ui:Button Content="Check Latest"
                       Icon="{ui:SymbolIcon ArrowDownload24}"
                       Command="{Binding CheckLatestCommand}"
                       Margin="0,0,4,0" />
            <ui:Button Content="Check MECM"
                       Icon="{ui:SymbolIcon Search24}"
                       Command="{Binding CheckMecmCommand}"
                       Margin="0,0,4,0" />
            <ui:Button Content="Stage"
                       Icon="{ui:SymbolIcon ArrowCircleDown24}"
                       Appearance="Info"
                       Command="{Binding StageCommand}"
                       Margin="0,0,4,0" />
            <ui:Button Content="Package"
                       Icon="{ui:SymbolIcon Box24}"
                       Appearance="Primary"
                       Command="{Binding PackageCommand}"
                       Margin="0,0,4,0" />
            <ui:Button Content="Cancel"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Appearance="Danger"
                       Command="{Binding CancelOperationCommand}"
                       Visibility="{Binding IsOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </WrapPanel>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Row 1: DataGrid -->
        <!-- ═══════════════════════════════════════════════════ -->
        <DataGrid Grid.Row="1"
                  x:Name="PackagerGrid"
                  ItemsSource="{Binding Packagers}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  IsReadOnly="False"
                  RowHeight="30"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  FrozenColumnCount="1">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open Log Folder" Click="ContextMenu_OpenLogFolder">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Folder24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Staged Folder" Click="ContextMenu_OpenStagedFolder">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Network Share" Click="ContextMenu_OpenNetworkShare">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Globe24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Copy Latest Version" Click="ContextMenu_CopyLatestVersion">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Vendor URL" Click="ContextMenu_OpenVendorUrl">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Link24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- Select checkbox -->
                <DataGridTemplateColumn Width="40" CanUserResize="False" CanUserReorder="False" MinWidth="40" MaxWidth="40">
                    <DataGridTemplateColumn.Header>
                        <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=Page}}"
                                  Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                  HorizontalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsRunnable}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="2*" IsReadOnly="True" />
                <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="Current (MECM)" Binding="{Binding CurrentVersion}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="*" IsReadOnly="True" />

                <!-- Status with color coding -->
                <DataGridTemplateColumn Header="Status" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Debug columns (visibility toggled in code-behind) -->
                <DataGridTextColumn x:Name="ColCMName" Header="CMName" Binding="{Binding CMName}" Width="200" IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ColScript" Header="Script" Binding="{Binding Script}" Width="200" IsReadOnly="True"
                                    Visibility="Collapsed" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Row 2: Select helpers + debug toggle -->
        <!-- ═══════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,6">
            <ui:Button Content="Select Update Available"
                       Icon="{ui:SymbolIcon CheckboxChecked24}"
                       Command="{Binding SelectUpdateAvailableCommand}"
                       Appearance="Transparent"
                       Margin="0,0,12,0" />
            <CheckBox Content="Show debug columns"
                      IsChecked="{Binding ShowDebugColumns}"
                      VerticalAlignment="Center" />
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Row 3: Log output -->
        <!-- ═══════════════════════════════════════════════════ -->
        <TextBox Grid.Row="3"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 TextChanged="LogTextBox_TextChanged" />

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Row 4: Status bar -->
        <!-- ═══════════════════════════════════════════════════ -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Margin="0,4,0,0" />
    </Grid>
</Page>
