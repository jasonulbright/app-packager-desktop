<Page
    x:Class="ApplicationPackagerUI.Views.Pages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    ScrollViewer.CanContentScroll="False"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <helpers:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    </Page.Resources>

    <Grid Margin="16,12,16,12" Background="Transparent" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
            <ui:TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Administrative Comments"
                        Width="280" Margin="0,0,16,0" VerticalAlignment="Center" />

            <ui:Button Content="Check Latest"
                       Icon="{ui:SymbolIcon ArrowDownload24}"
                       Command="{Binding CheckLatestCommand}"
                       Margin="0,0,4,0" />
            <ui:Button Content="Check ConfigMgr"
                       Icon="{ui:SymbolIcon Search24}"
                       Command="{Binding CheckMecmCommand}"
                       ToolTip="{Binding CheckMecmToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       Margin="0,0,4,0" />
            <ui:Button Content="Stage"
                       Icon="{ui:SymbolIcon ArrowCircleDown24}"
                       Command="{Binding StageCommand}"
                       Margin="0,0,4,0" />
            <ui:Button x:Name="btnPublishConfigMgr"
                       Content="Publish to ConfigMgr"
                       Icon="{ui:SymbolIcon Server24}"
                       Command="{Binding PublishConfigMgrCommand}"
                       ToolTip="{Binding PublishConfigMgrToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="btnPublishConfigMgr"
                       Margin="0,0,4,0" />
            <ui:Button x:Name="btnPublishIntune"
                       Content="Publish to Intune"
                       Icon="{ui:SymbolIcon Cloud24}"
                       Command="{Binding PublishIntuneCommand}"
                       ToolTip="{Binding PublishIntuneToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="btnPublishIntune"
                       Margin="0,0,4,0" />
            <ui:Button x:Name="btnPublishWsus"
                       Content="Publish to WSUS"
                       Icon="{ui:SymbolIcon ArrowSyncCircle24}"
                       Command="{Binding PublishWsusCommand}"
                       ToolTip="{Binding PublishWsusToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="btnPublishWsus"
                       Margin="0,0,4,0" />
            <ui:Button x:Name="btnWsusUpdates"
                       Content="WSUS Updates"
                       Icon="{ui:SymbolIcon TextBulletListSquare24}"
                       Command="{Binding WsusUpdatesCommand}"
                       ToolTip="{Binding WsusUpdatesToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="btnWsusUpdates"
                       Margin="0,0,4,0" />
            <ui:Button Content="One Click"
                       Icon="{ui:SymbolIcon Play24}"
                       Command="{Binding OneClickCommand}"
                       AutomationProperties.AutomationId="btnOneClick"
                       ToolTip="One Click check (and optionally Stage / Publish) against your tracked apps. Configure tracked apps, action, and destinations in Settings, One Click Settings."
                       Margin="0,0,4,0" />
            <ui:Button Content="Cancel"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Appearance="Danger"
                       Command="{Binding CancelOperationCommand}"
                       Visibility="{Binding IsOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </WrapPanel>

        <ui:TextBox Grid.Row="1"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search applications..."
                    Icon="{ui:SymbolIcon Search24}"
                    Margin="0,0,0,8" />

        <ui:DataGrid Grid.Row="2"
                  x:Name="PackagerGrid"
                  ItemsSource="{Binding FilteredPackagers}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  IsReadOnly="False"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  FrozenColumnCount="1"
                  MouseDoubleClick="PackagerGrid_MouseDoubleClick"
                  ContextMenuOpening="PackagerGrid_ContextMenuOpening">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit application..." Click="ContextMenu_EditApplication">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Wrench24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Open Log Folder" Click="ContextMenu_OpenLogFolder">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Folder24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Staged Folder" Click="ContextMenu_OpenStagedFolder">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Network Share" Click="ContextMenu_OpenNetworkShare">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Globe24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Copy Latest Version" Click="ContextMenu_CopyLatestVersion">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Vendor URL" Click="ContextMenu_OpenVendorUrl">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Link24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserReorder="False" MinWidth="48" MaxWidth="48">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="IsHitTestVisible" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="Transparent">
                                            <ContentPresenter
                                                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="SelectAllCheckBox"
                                  Click="SelectAllCheckBox_Click"
                                  HorizontalAlignment="Center"
                                  Background="Transparent" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsRunnable}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- A star column without MinWidth shrinks below its header text in a narrow window. -->
                <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="2*" MinWidth="160" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultDataGridTextElementStyle}">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="140" IsReadOnly="True" />
                <DataGridTextColumn Header="Current (ConfigMgr)" Binding="{Binding CurrentVersion}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="120" IsReadOnly="True" />

                <DataGridTemplateColumn Header="Status" Width="170" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}"
                                       ToolTip="{Binding StatusDetail}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="ColIntune" Header="Intune" Binding="{Binding IntuneNote}" Width="*" MinWidth="110" IsReadOnly="True"
                                    Visibility="Collapsed" />

                <!-- Debug columns (visibility toggled in code-behind) -->
                <DataGridTextColumn x:Name="ColCMName" Header="CMName" Binding="{Binding CMName}" Width="200" IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ColScript" Header="Script" Binding="{Binding Script}" Width="200" IsReadOnly="True"
                                    Visibility="Collapsed" />
            </DataGrid.Columns>
        </ui:DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,6">
            <ui:Button Content="Select Update Available"
                       Icon="{ui:SymbolIcon CheckboxChecked24}"
                       Command="{Binding SelectUpdateAvailableCommand}"
                       Appearance="Transparent"
                       Margin="0,0,12,0" />
            <CheckBox Content="Show debug columns"
                      IsChecked="{Binding ShowDebugColumns}"
                      VerticalAlignment="Center" />
        </StackPanel>

        <TextBox Grid.Row="4"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 TextChanged="LogTextBox_TextChanged" />

        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="● ConfigMgr" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Connected">
                                <Setter Property="Foreground" Value="#2D7D46" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Failed">
                                <Setter Property="Foreground" Value="#C0392B" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Testing...">
                                <Setter Property="Foreground" Value="#E8A317" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Not configured">
                                <Setter Property="Foreground" Value="#999999" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="2"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />
            <ProgressBar Grid.Column="3"
                         Width="200" Height="8"
                         Minimum="0"
                         Maximum="{Binding ProgressTotal}"
                         Value="{Binding ProgressCurrent}"
                         Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                         VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Page>
