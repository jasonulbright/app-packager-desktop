<Page
    x:Class="ApplicationPackagerUI.Views.Pages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    ScrollViewer.CanContentScroll="False"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Density.xaml" />
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:StatusCategoryConverter x:Key="StatusCategoryConverter" />
        <helpers:EnumEqualsConverter x:Key="EnumEquals" />
        <Style x:Key="StatusTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="Padding" Value="0,4,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Cue" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="14" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cue" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cue" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <Style x:Key="TrimCell" TargetType="TextBlock" BasedOn="{StaticResource DensityTextCell}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <!-- The text takes the cell's own foreground, so the count stays readable on a selected row. -->
            <Style x:Key="CveCellButton" TargetType="Button">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="4,0">
                                <TextBlock Text="{Binding CveCount}" TextDecorations="Underline" TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24,8,24,16" Background="Transparent" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogRow" Height="*" MinHeight="72" MaxHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:PageHeader Grid.Row="0" Grid.ColumnSpan="2" Title="App Packager" Icon="Box24" Compact="True" TitleAutomationId="txtAppPackagerTitle">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                <ui:Button
                           Content="Catalog"
                           Icon="{ui:SymbolIcon AppsList24}"
                           Click="Catalog_Click"
                           ToolTip="Show or hide applications in this grid."
                           AutomationProperties.AutomationId="btnCatalog" />
                <ui:Button
                           Content="Add or import"
                           Icon="{ui:SymbolIcon Add24}"
                           Margin="8,0,0,0"
                           Click="AddOrImport_Click"
                           ToolTip="Add an application from the web or from a file, convert a ConfigMgr application, or import vendor definitions."
                           AutomationProperties.AutomationId="btnAddOrImport" />
            </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- The first-start strip (overhaul V1, phase 7d): it shows while the setup checklist has work and its panel is closed. Its bindings
             start at the page's view model: a data context set after the XAML loaded is too late for them. -->
        <Border x:Name="SetupStrip" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,4" BorderThickness="1" CornerRadius="8"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource SurfacePageBrush}"
                AutomationProperties.AutomationId="pnlSetupStrip">
            <DockPanel>
                <ui:Button x:Name="btnOpenSetupChecklist" DockPanel.Dock="Right" Content="Open Setup Checklist" Icon="{ui:SymbolIcon ArrowRight24}" Click="OpenChecklist_Click"
                           AutomationProperties.AutomationId="btnOpenSetupChecklist" ToolTip="Open the setup checklist beside the grid." />
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <WrapPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Checklist.StripTitle, FallbackValue=''}" FontSize="14" Margin="0,0,12,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               AutomationProperties.AutomationId="txtSetupStripTitle" />
                    <TextBlock Text="{Binding Checklist.StripText, FallbackValue=''}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="txtSetupStripText" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The status tabs of the V1 workspace (overhaul V1, phase 3): the grid shows every application or one status. The counts are over every
                 application, not over the search. The cue is the primary text with an accent underline, never bold. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" AutomationProperties.AutomationId="pnlStatusTabs" AutomationProperties.Name="Status tabs">
                <RadioButton GroupName="StatusTabs" Style="{StaticResource StatusTab}" Content="{Binding TabAllText}"
                             IsChecked="{Binding StatusTab, Converter={StaticResource EnumEquals}, ConverterParameter=All}"
                             AutomationProperties.AutomationId="tabStatusAll" AutomationProperties.Name="{Binding TabAllText}"
                             ToolTip="Show every application." />
                <RadioButton GroupName="StatusTabs" Style="{StaticResource StatusTab}" Content="{Binding TabUpdateText}"
                             IsChecked="{Binding StatusTab, Converter={StaticResource EnumEquals}, ConverterParameter=Update}"
                             AutomationProperties.AutomationId="tabStatusUpdate" AutomationProperties.Name="{Binding TabUpdateText}"
                             ToolTip="Show the applications whose status says that an update is available." />
                <RadioButton GroupName="StatusTabs" Style="{StaticResource StatusTab}" Content="{Binding TabNotFoundText}"
                             IsChecked="{Binding StatusTab, Converter={StaticResource EnumEquals}, ConverterParameter=NotFound}"
                             AutomationProperties.AutomationId="tabStatusNotFound" AutomationProperties.Name="{Binding TabNotFoundText}"
                             ToolTip="Show the applications that the last Check ConfigMgr did not find on the site." />
                <RadioButton GroupName="StatusTabs" Style="{StaticResource StatusTab}" Content="{Binding TabNotCheckedText}"
                             IsChecked="{Binding StatusTab, Converter={StaticResource EnumEquals}, ConverterParameter=NotChecked}"
                             AutomationProperties.AutomationId="tabStatusNotChecked" AutomationProperties.Name="{Binding TabNotCheckedText}"
                             ToolTip="Show the applications that no check has compared with the site yet." />
            </StackPanel>
            <StackPanel x:Name="AppPackagerToolbar" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" AutomationProperties.AutomationId="pnlAppPackagerToolbar">
                <ui:Button Content="One Click"
                           Icon="{ui:SymbolIcon Play24}"
                           Command="{Binding OneClickCommand}"
                           AutomationProperties.AutomationId="btnOneClick"
                           ToolTip="One Click check (and optionally Stage / Publish) against your tracked apps. Configure tracked apps, action, and destinations in Settings, One Click." />
                <ui:Button x:Name="btnCheckMenu"
                           Content="Check"
                           Icon="{ui:SymbolIcon CheckmarkCircle24}"
                           Margin="8,0,0,0"
                           Click="CheckMenu_Click"
                           ToolTip="Check Latest, Check ConfigMgr or Check CVEs for the checked applications."
                           AutomationProperties.AutomationId="btnCheckMenu" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search applications..."
                        Icon="{ui:SymbolIcon Search24}"
                        AutomationProperties.AutomationId="txtAppPackagerSearch"
                        AutomationProperties.Name="Search applications" ToolTip="Enter part of an application name, vendor or CMName to show only the matching applications." />
            <ui:TextBox Grid.Column="1"
                        Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Administrative Comments"
                        ToolTip="The comment that Publish writes to each published application."
                        AutomationProperties.AutomationId="txtAppPackagerComment"
                        AutomationProperties.Name="Administrative Comments"
                        Width="280" Margin="8,0,0,0" />
            <ui:Button Grid.Column="2" x:Name="btnColumns" Content="Columns" Icon="{ui:SymbolIcon TableSettings24}" Click="Columns_Click" Margin="8,0,0,0"
                       AutomationProperties.AutomationId="btnColumns" ToolTip="Choose the columns of the grid. The columns, their order, their width and the sort are saved." />
            <ui:Button Grid.Column="3" x:Name="btnMore" Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="More_Click" Margin="8,0,0,0"
                       AutomationProperties.AutomationId="btnMore" ToolTip="CVE report, operation history, export of the check results, the setup checklist, Setup and the debug columns." />
        </Grid>

        <Grid x:Name="WorkArea" Grid.Row="4" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailPaneColumn" Width="320" />
            </Grid.ColumnDefinitions>
        <ui:DataGrid Grid.Column="0"
                  x:Name="PackagerGrid"
                  ItemsSource="{Binding FilteredPackagers}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionChanged="PackagerGrid_SelectionChanged"
                  IsReadOnly="False"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  FrozenColumnCount="1"
                  RowStyle="{StaticResource SelectableRow}"
                  MouseDoubleClick="PackagerGrid_MouseDoubleClick"
                  ContextMenuOpening="PackagerGrid_ContextMenuOpening">

            <!-- The items come from RowActions when the menu opens; the More actions menu of the detail pane shows the same ones. -->
            <DataGrid.ContextMenu>
                <ContextMenu Opened="PackagerMenu_Opened" />
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserReorder="False" MinWidth="48" MaxWidth="48">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DensityCell}">
                            <Setter Property="IsHitTestVisible" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="Transparent">
                                            <ContentPresenter
                                                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="SelectAllCheckBox"
                                  IsThreeState="True" IsChecked="False"
                                  AutomationProperties.AutomationId="chkSelectAllPackages"
                                  AutomationProperties.Name="Select applications"
                                  Click="SelectAllCheckBox_Click"
                                  HorizontalAlignment="Center"
                                  Background="Transparent" ToolTip="Select to cycle: every visible application, only those with an update available, then none." />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" MinHeight="0"
                                      IsEnabled="{Binding IsRunnable}"
                                      HorizontalAlignment="Center" ToolTip="Include this application in the run." />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="36" MinWidth="36" MaxWidth="36" CanUserResize="False" CanUserReorder="False" CanUserSort="False" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding IconTooltip}"
                                  AutomationProperties.AutomationId="PackagerIcon">
                                <ui:SymbolIcon Symbol="Box24" FontSize="16" Opacity="0.35" />
                                <Image Source="{Binding IconImage, Mode=OneWay, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Width="24" Height="24" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- A grid narrower than its columns takes width from every column down to its MinWidth,
                     and only then scrolls. Each MinWidth holds the header text and the sort arrow. -->
                <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="2*" MinWidth="160" IsReadOnly="True" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="140" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn x:Name="ColSource" Header="Source" Binding="{Binding SourceLabel}" Width="170" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource TrimCell}"
                                    Visibility="Collapsed" />
                <DataGridTextColumn Header="Current (ConfigMgr)" Binding="{Binding CurrentVersion}" Width="176" MinWidth="176" IsReadOnly="True" />
                <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="120" MinWidth="110" IsReadOnly="True" />

                <DataGridTemplateColumn Header="Status" Width="250" MinWidth="170" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Status by color and by icon: the icon shows the class for a user who cannot tell the colors apart. -->
                            <DockPanel LastChildFill="True" Margin="4,0" ToolTip="{Binding StatusDetail}">
                            <ui:SymbolIcon DockPanel.Dock="Left" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, ElementName=StatusLabel}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Circle24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusCategoryConverter}}" Value="Success">
                                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusCategoryConverter}}" Value="Warning">
                                                <Setter Property="Symbol" Value="Warning24" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusCategoryConverter}}" Value="Info">
                                                <Setter Property="Symbol" Value="Info24" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusCategoryConverter}}" Value="Error">
                                                <Setter Property="Symbol" Value="DismissCircle24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock x:Name="StatusLabel" Text="{Binding Status}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <!-- One trigger for each color class. A dynamic resource follows the theme when the theme changes. -->
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusNeutralBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusCategoryConverter}}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusCategoryConverter}}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusCategoryConverter}}" Value="Info">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status, Converter={StaticResource StatusCategoryConverter}}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                                            </DataTrigger>
                                            <!-- On a selected row the tint lowers the contrast of the status colors, so the text takes the cell color. -->
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="CVEs" Width="120" MinWidth="90" SortMemberPath="CveCountSort" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CveCellButton}" Click="CveCell_Click"
                                    ToolTip="Open the CVE list with links for this application"
                                    AutomationProperties.AutomationId="btnCveCell"
                                    AutomationProperties.Name="{Binding CveCount}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Max CVSS" Binding="{Binding CveCvss}" SortMemberPath="CveCvssSort" Width="116" MinWidth="116" IsReadOnly="True" />
                <DataGridTextColumn Header="KEV" Binding="{Binding CveKev}" Width="66" MinWidth="66" IsReadOnly="True" />
                <DataGridTextColumn Header="In latest" Binding="{Binding CveFixed}" SortMemberPath="CveFixedSort" Width="94" MinWidth="94" IsReadOnly="True" />
                <DataGridTextColumn Header="Newest CVE" Binding="{Binding CveNewest}" Width="120" MinWidth="120" IsReadOnly="True" />
                <DataGridTextColumn x:Name="ColCveEpss" Header="Max EPSS" Binding="{Binding CveEpss}" SortMemberPath="CveEpssSort" Width="110" MinWidth="110" IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ColCveUpdated" Header="NVD updated" Binding="{Binding CveUpdated}" Width="130" MinWidth="130" IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ColCveChecked" Header="CVEs Checked (UTC)" Binding="{Binding CveChecked}" Width="180" MinWidth="180" IsReadOnly="True"
                                    Visibility="Collapsed" />

                <DataGridTextColumn x:Name="ColIntune" Header="Intune" Binding="{Binding IntuneNote}" Width="*" MinWidth="110" IsReadOnly="True"
                                    Visibility="Collapsed" />

                <!-- Debug columns (visibility toggled in code-behind) -->
                <DataGridTextColumn x:Name="ColCMName" Header="CMName" Binding="{Binding CMName}" Width="200" MinWidth="110" IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ColScript" Header="Script" Binding="{Binding Script}" Width="200" MinWidth="110" IsReadOnly="True"
                                    Visibility="Collapsed" />
            </DataGrid.Columns>
        </ui:DataGrid>

            <!-- The detail pane of the focused row (overhaul V1, phase 4): closes with the button in its header, opens with the button in the corner of the grid. -->
            <ui:Button x:Name="btnDetailPane" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0" Visibility="Collapsed"
                       Content="Details" Icon="{ui:SymbolIcon PanelRight24}" Click="DetailOpen_Click" Appearance="Transparent"
                       AutomationProperties.AutomationId="btnDetailPaneOpen" ToolTip="Open the detail pane of the selected application." />
            <GridSplitter x:Name="DetailSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" KeyboardIncrement="16"
                          Focusable="True" IsTabStop="True" Visibility="Collapsed"
                          DragCompleted="DetailSplitter_DragCompleted" KeyUp="DetailSplitter_KeyUp"
                          AutomationProperties.AutomationId="splDetailPane" AutomationProperties.Name="Detail pane width"
                          ToolTip="Drag, or press the left and right arrow keys, to change the width of the detail pane. The width is saved." />
            <Border x:Name="DetailPane" Grid.Column="2" Padding="12" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource SurfacePageBrush}" CornerRadius="8"
                    AutomationProperties.AutomationId="pnlDetailPane" AutomationProperties.Name="Application details">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="Close" Icon="{ui:SymbolIcon Dismiss24}" Click="DetailClose_Click" Appearance="Transparent"
                                   AutomationProperties.AutomationId="btnDetailPaneClose" ToolTip="Close the detail pane." />
                        <TextBlock Text="{Binding DetailPackager.Application, FallbackValue='No application selected'}" Style="{StaticResource CardTitleText}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" AutomationProperties.AutomationId="txtDetailTitle" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ui:Button Content="Open in Workbench" Icon="{ui:SymbolIcon Wrench24}" Click="DetailOpenWorkbench_Click" HorizontalAlignment="Stretch"
                                   AutomationProperties.AutomationId="btnDetailWorkbench" ToolTip="Open the Application Workbench on the selected application." />
                        <ui:Button x:Name="btnDetailMoreActions" Content="More actions" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="DetailMoreActions_Click"
                                   HorizontalAlignment="Stretch" Margin="0,8,0,0" AutomationProperties.AutomationId="btnDetailMoreActions"
                                   ToolTip="The same actions as the menu of the grid row: history, folders, version, vendor page and CVEs.">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DetailPackager}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding DetailLines}" Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="lstDetailLines">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

        </Grid>

        <!-- The setup checklist takes the place of the detail pane while it is open. In a wide page it also takes the height of the batch bar and the log. -->
        <controls:SetupChecklistPanel x:Name="SetupPanel" Grid.Row="4" Grid.Column="1" Width="320" Margin="8,0,0,0" Visibility="Collapsed" />

        <!-- The batch bar (overhaul V1, phase 3): what is checked, where Publish All goes, and the actions on the checked applications. -->
        <DockPanel x:Name="BatchBar" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,8" AutomationProperties.AutomationId="pnlBatchBar" AutomationProperties.Name="Batch actions">
            <StackPanel x:Name="BatchActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" AutomationProperties.AutomationId="pnlBatchActions">
                <!-- Cancel keeps its room while no run is active (Hidden, not Collapsed), so the bar does not change its layout when a run starts. -->
                <Grid Margin="0,0,8,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOperationRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ui:Button Content="Cancel"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Appearance="Danger"
                               Command="{Binding CancelOperationCommand}"
                               AutomationProperties.AutomationId="btnCancelOperation"
                               ToolTip="Stop the run that is active." />
                </Grid>
                <ui:Button x:Name="btnStage"
                           Content="Stage"
                           Icon="{ui:SymbolIcon ArrowCircleDown24}"
                           Command="{Binding StageCommand}"
                           AutomationProperties.AutomationId="btnStage"
                           ToolTip="Stage the installer content of each checked application."
                           Margin="0,0,8,0" />
                <ui:Button x:Name="btnPublishAll"
                           Content="Publish All"
                           Icon="{ui:SymbolIcon ArrowCircleUp24}"
                           Appearance="Primary"
                           Command="{Binding PublishAllCommand}"
                           ToolTip="{Binding PublishAllToolTip}"
                           ToolTipService.ShowOnDisabled="True"
                           AutomationProperties.AutomationId="btnPublishAll" />
            </StackPanel>
            <WrapPanel Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectionText}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           AutomationProperties.AutomationId="txtSelectionCount" AutomationProperties.LiveSetting="Polite"
                           ToolTip="The checked applications. Stage and Publish All act on all of them, also on those that the search or the tab hides." />
                <ui:Button Content="Show selected" Command="{Binding ShowSelectedCommand}" Appearance="Transparent" Margin="0,0,8,0"
                           Visibility="{Binding HasHiddenSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                           AutomationProperties.AutomationId="btnShowSelected" ToolTip="Show only the checked applications, so that you see the ones that the search or the tab hides." />
                <ui:Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Appearance="Transparent" Margin="0,0,8,0"
                           Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                           AutomationProperties.AutomationId="btnClearSelection" ToolTip="Uncheck every application, also those that the search or the tab hides." />
                <ui:Button Content="Select Update Available"
                           Icon="{ui:SymbolIcon CheckboxChecked24}"
                           Command="{Binding SelectUpdateAvailableCommand}"
                           AutomationProperties.AutomationId="btnSelectUpdates"
                           Appearance="Transparent"
                           Margin="0,0,12,0" ToolTip="Check every application whose status shows that an update is available." />
                <TextBlock Text="{Binding PublishScopeText}" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="txtPublishScope"
                           ToolTip="Publish All reaches the systems that Settings, Systems in Use turns on. One run covers all of them." />
            </WrapPanel>
        </DockPanel>

        <TextBox x:Name="LogBox" Grid.Row="6" Grid.ColumnSpan="2"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 TextChanged="LogTextBox_TextChanged" />

        <Grid Grid.Row="7" Grid.ColumnSpan="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="● ConfigMgr" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Connected">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Failed">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Testing...">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Not configured">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="2"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />
            <ProgressBar Grid.Column="3"
                         Width="200" Height="8"
                         Minimum="0"
                         Maximum="{Binding ProgressTotal}"
                         Value="{Binding ProgressCurrent}"
                         Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                         VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Page>
