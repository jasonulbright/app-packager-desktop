<Page
    x:Class="ApplicationPackagerUI.Views.Pages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    ScrollViewer.CanContentScroll="False"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <Style x:Key="ToolbarSeparator" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="4,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="TrimCell" TargetType="TextBlock" BasedOn="{StaticResource DefaultDataGridTextElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <!-- The text takes the cell's own foreground, so the count stays readable on a selected row. -->
            <Style x:Key="CveCellButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="4,0">
                                <TextBlock Text="{Binding CveCount}" TextDecorations="Underline" TextTrimming="CharacterEllipsis"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24,16,24,16" Background="Transparent" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="72" MaxHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="App Packager" TitleAutomationId="txtAppPackagerTitle">
            <controls:PageHeader.Actions>
                <ui:Button
                           Content="Catalog"
                           Icon="{ui:SymbolIcon AppsList24}"
                           Click="Catalog_Click"
                           ToolTip="Show or hide applications in this grid."
                           AutomationProperties.AutomationId="btnCatalog" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <WrapPanel Grid.Row="1" x:Name="AppPackagerToolbar" Margin="0,0,0,8" VerticalAlignment="Center" AutomationProperties.AutomationId="pnlAppPackagerToolbar">
            <WrapPanel.Resources>
                <!-- Tag "Compact" drops the labels; the tooltip then names the button. -->
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=WrapPanel}}" Value="Compact">
                            <Setter Property="Padding" Value="8,5" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Rectangle Width="0" Height="0" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </WrapPanel.Resources>
            <ui:Button Content="Check Latest"
                       Icon="{ui:SymbolIcon ArrowDownload24}"
                       Command="{Binding CheckLatestCommand}"
                       Margin="0,0,4,0" />
            <ui:Button Content="Check ConfigMgr"
                       Icon="{ui:SymbolIcon Search24}"
                       Command="{Binding CheckMecmCommand}"
                       ToolTip="{Binding CheckMecmToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       Margin="0,0,4,0" />
            <ui:Button Content="Discover unmanaged software"
                       Icon="{ui:SymbolIcon BoxSearch24}"
                       Command="{Binding DiscoverCommand}"
                       ToolTip="{Binding DiscoverToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="btnDiscover"
                       Margin="0,0,4,0" />
            <ui:Button Content="Check CVEs"
                       Icon="{ui:SymbolIcon ShieldError24}"
                       Command="{Binding CheckCvesCommand}"
                       ToolTip="Look up the CVEs fixed by updating each checked application from its ConfigMgr version to the latest version. Needs both versions and a CPE."
                       AutomationProperties.AutomationId="btnCheckCves"
                       Margin="0,0,4,0" />
            <Border Style="{StaticResource ToolbarSeparator}" />
            <ui:Button Content="Stage"
                       Icon="{ui:SymbolIcon ArrowCircleDown24}"
                       Command="{Binding StageCommand}"
                       Margin="0,0,4,0" />
            <ui:Button x:Name="btnPublishConfigMgr"
                       Content="Publish to ConfigMgr"
                       Icon="{ui:SymbolIcon Server24}"
                       Command="{Binding PublishConfigMgrCommand}"
                       ToolTip="{Binding PublishConfigMgrToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="btnPublishConfigMgr"
                       Margin="0,0,4,0" />
            <ui:Button x:Name="btnPublishIntune"
                       Content="Publish to Intune"
                       Icon="{ui:SymbolIcon Cloud24}"
                       Command="{Binding PublishIntuneCommand}"
                       ToolTip="{Binding PublishIntuneToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="btnPublishIntune"
                       Margin="0,0,4,0" />
            <ui:Button x:Name="btnPublishWsus"
                       Content="Publish to WSUS"
                       Icon="{ui:SymbolIcon ArrowSyncCircle24}"
                       Command="{Binding PublishWsusCommand}"
                       ToolTip="{Binding PublishWsusToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="btnPublishWsus"
                       Margin="0,0,4,0" />
            <ui:Button x:Name="btnWsusUpdates"
                       Content="WSUS Updates"
                       Icon="{ui:SymbolIcon TextBulletListSquare24}"
                       Command="{Binding WsusUpdatesCommand}"
                       ToolTip="{Binding WsusUpdatesToolTip}"
                       ToolTipService.ShowOnDisabled="True"
                       AutomationProperties.AutomationId="btnWsusUpdates"
                       Margin="0,0,4,0" />
            <Border Style="{StaticResource ToolbarSeparator}" />
            <ui:Button Content="One Click"
                       Icon="{ui:SymbolIcon Play24}"
                       Command="{Binding OneClickCommand}"
                       AutomationProperties.AutomationId="btnOneClick"
                       ToolTip="One Click check (and optionally Stage / Publish) against your tracked apps. Configure tracked apps, action, and destinations in Settings, One Click Settings."
                       Margin="0,0,4,0" />
            <ui:Button Content="CVE Report"
                       Icon="{ui:SymbolIcon DocumentTable24}"
                       Command="{Binding CveReportCommand}"
                       ToolTip="Write the CVE report for the checked applications (all applications when none is checked) as HTML, CSV, XLSX, Markdown and JSON, then open the HTML page."
                       AutomationProperties.AutomationId="btnCveReport"
                       Margin="0,0,4,0" />
            <ui:Button x:Name="btnOperationHistory"
                       Content="Operation history"
                       Icon="{ui:SymbolIcon TextBulletListSquare24}"
                       Click="ViewHistory_Click"
                       IsEnabled="False"
                       ToolTip="View recorded operations for the selected application."
                       AutomationProperties.AutomationId="btnOperationHistory"
                       Margin="0,0,4,0" />
            <ui:Button Content="Cancel"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Appearance="Danger"
                       Command="{Binding CancelOperationCommand}"
                       Visibility="{Binding IsOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search applications..."
                        Icon="{ui:SymbolIcon Search24}"
                        AutomationProperties.AutomationId="txtAppPackagerSearch"
                        AutomationProperties.Name="Search applications" />
            <ui:TextBox Grid.Column="1"
                        Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Administrative Comments"
                        ToolTip="The comment that Publish writes to each published application."
                        AutomationProperties.AutomationId="txtAppPackagerComment"
                        AutomationProperties.Name="Administrative Comments"
                        Width="280" Margin="8,0,0,0" />
        </Grid>


        <ui:DataGrid Grid.Row="3"
                  x:Name="PackagerGrid"
                  ItemsSource="{Binding FilteredPackagers}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionChanged="PackagerGrid_SelectionChanged"
                  IsReadOnly="False"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  FrozenColumnCount="1"
                  RowStyle="{StaticResource SelectableRow}"
                  MouseDoubleClick="PackagerGrid_MouseDoubleClick"
                  ContextMenuOpening="PackagerGrid_ContextMenuOpening">

            <DataGrid.ContextMenu>
                <ContextMenu Opened="PackagerMenu_Opened">
                    <MenuItem Header="View operation history..." Click="ContextMenu_ViewHistory">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="TextBulletListSquare24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Edit application..." Click="ContextMenu_EditApplication">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Wrench24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Open Log Folder" Click="ContextMenu_OpenLogFolder">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Folder24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Staged Folder" Click="ContextMenu_OpenStagedFolder">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Network Share" Click="ContextMenu_OpenNetworkShare">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Globe24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Copy Latest Version" Click="ContextMenu_CopyLatestVersion">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Vendor URL" Click="ContextMenu_OpenVendorUrl">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Link24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuShowCves" Header="Show CVEs..." Click="ContextMenu_ShowCves">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ShieldError24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuOpenCveSources" Header="Open CVE Sources">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Globe24" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuCopyCveIds" Header="Copy CVE IDs" Click="ContextMenu_CopyCveIds">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserReorder="False" MinWidth="48" MaxWidth="48">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="IsHitTestVisible" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="Transparent">
                                            <ContentPresenter
                                                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="SelectAllCheckBox"
                                  Click="SelectAllCheckBox_Click"
                                  HorizontalAlignment="Center"
                                  Background="Transparent" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsRunnable}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- A grid narrower than its columns takes width from every column down to its MinWidth,
                     and only then scrolls. Each MinWidth holds the header text and the sort arrow. -->
                <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="2*" MinWidth="160" IsReadOnly="True" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="140" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource TrimCell}" />
                <DataGridTextColumn Header="Current (ConfigMgr)" Binding="{Binding CurrentVersion}" Width="176" MinWidth="176" IsReadOnly="True" />
                <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="120" MinWidth="110" IsReadOnly="True" />

                <DataGridTemplateColumn Header="Status" Width="250" MinWidth="170" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}"
                                       ToolTip="{Binding StatusDetail}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                       VerticalAlignment="Center" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="CVEs" Width="120" MinWidth="90" SortMemberPath="CveCountSort" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CveCellButton}" Click="CveCell_Click"
                                    ToolTip="Open the CVE list with links for this application"
                                    AutomationProperties.AutomationId="btnCveCell"
                                    AutomationProperties.Name="{Binding CveCount}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Max CVSS" Binding="{Binding CveCvss}" SortMemberPath="CveCvssSort" Width="116" MinWidth="116" IsReadOnly="True" />
                <DataGridTextColumn Header="KEV" Binding="{Binding CveKev}" Width="66" MinWidth="66" IsReadOnly="True" />
                <DataGridTextColumn Header="In latest" Binding="{Binding CveFixed}" SortMemberPath="CveFixedSort" Width="94" MinWidth="94" IsReadOnly="True" />
                <DataGridTextColumn Header="Newest CVE" Binding="{Binding CveNewest}" Width="120" MinWidth="120" IsReadOnly="True" />
                <DataGridTextColumn x:Name="ColCveEpss" Header="Max EPSS" Binding="{Binding CveEpss}" SortMemberPath="CveEpssSort" Width="110" MinWidth="110" IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ColCveUpdated" Header="NVD updated" Binding="{Binding CveUpdated}" Width="130" MinWidth="130" IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ColCveChecked" Header="CVEs Checked (UTC)" Binding="{Binding CveChecked}" Width="180" MinWidth="180" IsReadOnly="True"
                                    Visibility="Collapsed" />

                <DataGridTextColumn x:Name="ColIntune" Header="Intune" Binding="{Binding IntuneNote}" Width="*" MinWidth="110" IsReadOnly="True"
                                    Visibility="Collapsed" />

                <!-- Debug columns (visibility toggled in code-behind) -->
                <DataGridTextColumn x:Name="ColCMName" Header="CMName" Binding="{Binding CMName}" Width="200" MinWidth="110" IsReadOnly="True"
                                    Visibility="Collapsed" />
                <DataGridTextColumn x:Name="ColScript" Header="Script" Binding="{Binding Script}" Width="200" MinWidth="110" IsReadOnly="True"
                                    Visibility="Collapsed" />
            </DataGrid.Columns>
        </ui:DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,6">
            <ui:Button Content="Select Update Available"
                       Icon="{ui:SymbolIcon CheckboxChecked24}"
                       Command="{Binding SelectUpdateAvailableCommand}"
                       Appearance="Transparent"
                       Margin="0,0,12,0" />
            <CheckBox Content="Show debug columns"
                      IsChecked="{Binding ShowDebugColumns}"
                      VerticalAlignment="Center" />
        </StackPanel>

        <TextBox Grid.Row="5"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 TextChanged="LogTextBox_TextChanged" />

        <Grid Grid.Row="6" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="● ConfigMgr" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Connected">
                                <Setter Property="Foreground" Value="#2D7D46" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Failed">
                                <Setter Property="Foreground" Value="#C0392B" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Testing...">
                                <Setter Property="Foreground" Value="#E8A317" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MecmConnectionStatus}" Value="Not configured">
                                <Setter Property="Foreground" Value="#999999" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="2"
                       Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />
            <ProgressBar Grid.Column="3"
                         Width="200" Height="8"
                         Minimum="0"
                         Maximum="{Binding ProgressTotal}"
                         Value="{Binding ProgressCurrent}"
                         Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                         VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Page>
