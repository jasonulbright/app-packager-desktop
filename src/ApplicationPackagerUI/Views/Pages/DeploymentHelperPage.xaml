<Page
    x:Class="ApplicationPackagerUI.Views.Pages.DeploymentHelperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    xmlns:pages="clr-namespace:ApplicationPackagerUI.ViewModels.Pages"
    xmlns:views="clr-namespace:ApplicationPackagerUI.Views.Pages"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <helpers:BindingProxy x:Key="HistoryProxy" Data="{Binding History}" />
            <views:DeploymentReviewSummaryConverter x:Key="ReviewSummary" />

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleText}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- The object type list reads as a row of tabs: the selected type has a tint and an accent underline. The text does not turn bold. -->
            <Style x:Key="ObjectTypeTab" TargetType="ListBoxItem" BasedOn="{StaticResource SelectableListItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Cue" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Cue" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Cue" Property="Background" Value="{DynamicResource SelectedRowBackground}" />
                                    <Setter TargetName="Cue" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Note}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>

            <!-- A string Content renders as one non-wrapping line, which a narrow window clips. -->
            <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,16,8" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="560" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <Style x:Key="Caution" TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <DataTemplate x:Key="TabHeaderTemplate">
                <StackPanel>
                    <TextBlock x:Name="TabHeaderText" Text="{Binding}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="TabHeaderUnderline" Height="2" Margin="0,4,0,0" Background="Transparent" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                        <Setter TargetName="TabHeaderText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter TargetName="TabHeaderUnderline" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- The flat tabs of the V1 workspace: no tab frame; the selected tab has a tint, the primary text color and an accent underline. -->
            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="HeaderTemplate" Value="{StaticResource TabHeaderTemplate}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Cue" Background="Transparent" Padding="12,4,12,0" Margin="0,0,4,0" SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Cue" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Cue" Property="Background" Value="{DynamicResource SelectedRowBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style x:Key="TabStopCell" TargetType="DataGridCell" BasedOn="{StaticResource FocusableCell}">
                <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
            </Style>

            <Style x:Key="GridBase" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="CanUserResizeColumns" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="helpers:DataGridColumnSizing.FixStarWidthsOnResize" Value="True" />
                <Setter Property="RowStyle" Value="{StaticResource SelectableRow}" />
                <Setter Property="CellStyle" Value="{StaticResource TabStopCell}" />
                <Setter Property="helpers:DataGridKeyboard.SelectsFocusedRow" Value="True" />
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnGridPreviewMouseRightButtonDown" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24,8,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Deployment Helper" Icon="Rocket24" Compact="True" TitleAutomationId="txtDeploymentTitle" />

        <Border Grid.Row="1" Style="{StaticResource Caution}" Visibility="{Binding Shared.HasConnectionMessage, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="pnlDeploymentConnection">
            <TextBlock Text="{Binding Shared.ConnectionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtDeploymentConnection" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.AutomationId="tabDeploymentHelper">
            <TabItem Header="Deploy" AutomationProperties.AutomationId="tabDeploy" DataContext="{Binding Deploy}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" x:Name="scrollDeployTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollDeployTab">
                    <StackPanel x:Name="pnlDeploy" SizeChanged="OnDeploySizeChanged">
                        <WrapPanel Margin="0,0,0,4">
                            <ListBox ItemsSource="{Binding TypeNames}" SelectedIndex="{Binding TypeIndex}" ItemContainerStyle="{StaticResource ObjectTypeTab}"
                                     Margin="0,0,16,8" AutomationProperties.Name="Object type" AutomationProperties.AutomationId="lstObjectType">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="8,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" MinWidth="200" Margin="0,0,8,8"
                                      VerticalAlignment="Top" AutomationProperties.Name="Template" ToolTip="Select a deployment template. Apply template fills the purpose, notification, time basis and options from it." AutomationProperties.AutomationId="cboTemplate" />
                            <ui:Button Content="Apply template" Icon="{ui:SymbolIcon DocumentArrowRight24}" Command="{Binding ApplyTemplateCommand}" VerticalAlignment="Top"
                                       ToolTip="Fills the purpose, notification, time basis and options from the template." Style="{StaticResource ToolButton}"
                                       AutomationProperties.AutomationId="btnApplyTemplate" />
                            <ui:Button Content="Save as template" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveAsTemplateCommand}" VerticalAlignment="Top"
                                       ToolTip="Saves the purpose, notification, time basis and options as a user template." Style="{StaticResource ToolButton}"
                                       AutomationProperties.AutomationId="btnSaveTemplate" />
                            <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" VerticalAlignment="Top"
                                       ToolTip="Reads the objects, the collections and the templates again." Style="{StaticResource ToolButton}"
                                       AutomationProperties.Name="Refresh objects and collections" AutomationProperties.AutomationId="btnDeployRefresh" />
                            <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelLoadCommand}" VerticalAlignment="Top"
                                       ToolTip="Stops the read of the objects and collections." Style="{StaticResource ToolButton}"
                                       AutomationProperties.Name="Cancel the read" AutomationProperties.AutomationId="btnDeployCancel" />
                            <TextBlock Text="{Binding TemplateMessage}" Style="{StaticResource Note}" VerticalAlignment="Top" Margin="0,4,0,8" MaxWidth="420"
                                       AutomationProperties.AutomationId="txtTemplateMessage" />
                        </WrapPanel>

                        <Grid x:Name="gridPickers" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="pnlObjects" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlObjects">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ObjectCount}" Style="{StaticResource Note}" Margin="8,0,0,8" AutomationProperties.AutomationId="txtObjectCount" />
                                        <TextBlock Text="{Binding ObjectHeader}" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <ui:TextBox DockPanel.Dock="Top" Text="{Binding ObjectFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, version or ID"
                                                Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,8" AutomationProperties.Name="Object filter" ToolTip="Enter text to show only the objects whose name, version or ID contains it." AutomationProperties.AutomationId="txtObjectFilter" />
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Program" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" AutomationProperties.Name="Program"
                                                  ToolTip="Select the Program of the Package to deploy." AutomationProperties.AutomationId="cboProgram" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ObjectListNote}" Style="{StaticResource Warning}" Margin="0,8,0,0"
                                               Visibility="{Binding HasObjectListNote, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtObjectListNote"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <DataGrid x:Name="dgObjects" Style="{StaticResource GridBase}" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}" Height="240"
                                              AutomationProperties.AutomationId="dgObjects" AutomationProperties.Name="Objects">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Packaged" Binding="{Binding Packaged}" Width="100" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            <Border x:Name="pnlCollections" Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlCollections">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CollectionCount}" Style="{StaticResource Note}" Margin="8,0,0,8" AutomationProperties.AutomationId="txtCollectionCount" />
                                        <TextBlock Text="Device collection" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <ui:TextBox DockPanel.Dock="Top" Text="{Binding CollectionFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, ID or folder"
                                                Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,8" AutomationProperties.Name="Collection filter" ToolTip="Enter text to show only the Device Collections whose name, ID or folder path contains it." AutomationProperties.AutomationId="txtCollectionFilter" />
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CollectionMessage}" Style="{StaticResource Warning}" Margin="0,8,0,0"
                                               Visibility="{Binding HasCollectionMessage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtCollectionMessage"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <DataGrid x:Name="dgCollections" Style="{StaticResource GridBase}" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" Height="240"
                                              AutomationProperties.AutomationId="dgCollections" AutomationProperties.Name="Device collections">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding CollectionId}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Stacked here; the code puts the two cards side by side when the tab is wide enough. -->
                        <Grid x:Name="gridCards" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="pnlSettings" Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlSettings">
                                <StackPanel>
                                    <TextBlock Text="Schedule and options" Style="{StaticResource CardTitle}" />
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,24,8">
                                            <TextBlock Text="Purpose" Style="{StaticResource FieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Available" GroupName="DeploymentPurpose" IsChecked="{Binding IsAvailable}" Margin="0,0,16,0"
                                                             ToolTip="Makes the deployment available: users install the software from Software Center when they choose." AutomationProperties.AutomationId="rbAvailable" />
                                                <RadioButton Content="Required" GroupName="DeploymentPurpose" IsChecked="{Binding IsRequired}" ToolTip="Makes the deployment required: Configuration Manager installs the software at the deadline." AutomationProperties.AutomationId="rbRequired" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,8">
                                            <TextBlock Text="Time basis" Style="{StaticResource FieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Local time" GroupName="DeploymentTimeBasis" IsChecked="{Binding IsLocalTime}" Margin="0,0,16,0"
                                                             ToolTip="Bases the available and deadline times on the local time of each device." AutomationProperties.AutomationId="rbLocalTime" />
                                                <RadioButton Content="UTC" GroupName="DeploymentTimeBasis" IsChecked="{Binding UtcBasis}" ToolTip="Bases the available and deadline times on UTC, so every device uses the same moment." AutomationProperties.AutomationId="rbUtc" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,8">
                                            <TextBlock Text="Available" Style="{StaticResource FieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <DatePicker SelectedDate="{Binding AvailableDate}" SelectedDateFormat="Short" ToolTip="{Binding AvailableDateTip}" Width="150" Margin="0,0,8,0" AutomationProperties.Name="Available date"
                                                            AutomationProperties.AutomationId="dpAvailableDate" />
                                                <ui:TextBox Text="{Binding AvailableTimeText, UpdateSourceTrigger=PropertyChanged}" Width="90" PlaceholderText="08:30"
                                                            AutomationProperties.Name="Available time" ToolTip="Enter the time of day the deployment becomes available, as hours and minutes, for example 08:30." AutomationProperties.AutomationId="txtAvailableTime" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,8" Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Deadline" Style="{StaticResource FieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <DatePicker SelectedDate="{Binding DeadlineDate}" SelectedDateFormat="Short" ToolTip="{Binding DeadlineDateTip}" Width="150" Margin="0,0,8,0" AutomationProperties.Name="Deadline date"
                                                            AutomationProperties.AutomationId="dpDeadlineDate" />
                                                <ui:TextBox Text="{Binding DeadlineTimeText, UpdateSourceTrigger=PropertyChanged}" Width="90" PlaceholderText="18:00"
                                                            AutomationProperties.Name="Deadline time" ToolTip="Enter the time of day of the deadline, as hours and minutes, for example 18:00." AutomationProperties.AutomationId="txtDeadlineTime" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,8" Visibility="{Binding ShowNotification, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="User notification" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding Notifications}" SelectedItem="{Binding Notification}" DisplayMemberPath="Text" MinWidth="280"
                                                      AutomationProperties.Name="User notification" ToolTip="Select whether the deployment shows in Software Center and which notifications users see. An Available deployment cannot hide all notifications." AutomationProperties.AutomationId="cboNotification" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding TimeBasisNote}" Style="{StaticResource Note}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtTimeBasisNote" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <CheckBox Content="{x:Static pages:DeploymentText.ShowProgressLabel}" IsChecked="{Binding ShowProgress}" Style="{StaticResource Option}"
                                                  Visibility="{Binding IsTaskSequence, Converter={StaticResource BoolToVisibility}}" ToolTip="Shows the progress of the Task Sequence on the device while it runs." AutomationProperties.AutomationId="chkShowProgress" />
                                        <CheckBox Content="{x:Static pages:DeploymentText.FallbackLabel}" IsChecked="{Binding AllowFallback}" Style="{StaticResource Option}"
                                                  Visibility="{Binding ShowAllowFallback, Converter={StaticResource BoolToVisibility}}" ToolTip="Lets devices that find no content in their own boundary group use distribution points from the default site boundary group." AutomationProperties.AutomationId="chkAllowFallback" />
                                        <CheckBox Content="{x:Static pages:DeploymentText.FullScanLabel}" IsChecked="{Binding PostRebootScan}" Style="{StaticResource Option}"
                                                  Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" ToolTip="Makes devices run a full scan for software updates after the restart that follows the installation." AutomationProperties.AutomationId="chkPostRebootScan" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <StackPanel Margin="0,0,24,8" Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Fast network" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding NetworkBehaviors}" SelectedItem="{Binding NetworkBehavior}" DisplayMemberPath="Text" MinWidth="300"
                                                      AutomationProperties.Name="Fast network" ToolTip="Select how devices on a fast network get the content of the Package: download it and run locally, or run the program from the distribution point." AutomationProperties.AutomationId="cboNetwork" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,8" Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Slow network" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding SlowNetworkBehaviors}" SelectedItem="{Binding SlowNetworkBehavior}" DisplayMemberPath="Text" MinWidth="300"
                                                      AutomationProperties.Name="Slow network" ToolTip="Select how devices on a slow network get the content of the Package: do not run the program, or download the content and run locally." AutomationProperties.AutomationId="cboSlowNetwork" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,8" Visibility="{Binding IsTaskSequence, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Available to" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding TaskSequenceAvailabilities}" SelectedItem="{Binding TaskSequenceAvailability}" DisplayMemberPath="Text" MinWidth="260"
                                                      AutomationProperties.Name="Available to" ToolTip="Select which devices and boot media can see the Task Sequence deployment." AutomationProperties.AutomationId="cboTaskSequenceAvailability" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,24,8" Visibility="{Binding IsTaskSequence, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Content" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding TaskSequenceContents}" SelectedItem="{Binding TaskSequenceContent}" DisplayMemberPath="Text" MinWidth="320"
                                                      AutomationProperties.Name="Task sequence content" ToolTip="Select when devices download the content of the Task Sequence: when the Task Sequence needs it, or all before it starts." AutomationProperties.AutomationId="cboTaskSequenceContent" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="Required only" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
                                    <TextBlock Text="{Binding RequiredOnlyNote}" Style="{StaticResource Note}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtRequiredOnlyNote" />
                                    <WrapPanel IsEnabled="{Binding RequiredOnlyEnabled}" AutomationProperties.AutomationId="pnlRequiredOnly">
                                        <CheckBox Content="{x:Static pages:DeploymentText.OverrideWindowLabel}" IsChecked="{Binding OverrideServiceWindow}" Style="{StaticResource Option}"
                                                  ToolTip="At the deadline, installs the software even when no maintenance window is open." AutomationProperties.AutomationId="chkOverrideWindow" />
                                        <CheckBox Content="{x:Static pages:DeploymentText.RebootOutsideLabel}" IsChecked="{Binding RebootOutsideServiceWindow}" Style="{StaticResource Option}"
                                                  ToolTip="Lets devices restart after the installation even when no maintenance window is open." AutomationProperties.AutomationId="chkRebootOutside" />
                                        <CheckBox Content="{x:Static pages:DeploymentText.MeteredLabel}" IsChecked="{Binding AllowMetered}" Style="{StaticResource Option}"
                                                  Visibility="{Binding ShowMetered, Converter={StaticResource BoolToVisibility}}" ToolTip="Lets devices on a metered connection download content after the installation deadline. This can cost extra." AutomationProperties.AutomationId="chkMetered" />
                                        <CheckBox Content="{x:Static pages:DeploymentText.FallbackLabel}" IsChecked="{Binding FallbackToDp}" Style="{StaticResource Option}"
                                                  Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" ToolTip="Lets devices that find no software updates on a preferred distribution point use distribution points from the default site boundary group." AutomationProperties.AutomationId="chkFallbackToDp" />
                                        <CheckBox Content="{x:Static pages:DeploymentText.MicrosoftUpdateLabel}" IsChecked="{Binding AllowMicrosoftUpdate}" Style="{StaticResource Option}"
                                                  Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" ToolTip="Lets devices download the software updates from Microsoft Update when no distribution point has them." AutomationProperties.AutomationId="chkMicrosoftUpdate" />
                                        <CheckBox Content="{Binding SuppressRestartLabel}" IsChecked="{Binding SuppressRestart}" Style="{StaticResource Option}"
                                                  Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" ToolTip="Stops servers and workstations from restarting after the installation." AutomationProperties.AutomationId="chkSuppressRestart" />
                                        <StackPanel Margin="0,0,24,8" Visibility="{Binding ShowRerun, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Rerun behavior" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding RerunBehaviors}" SelectedItem="{Binding RerunBehavior}" DisplayMemberPath="Text" MinWidth="280"
                                                      AutomationProperties.Name="Rerun behavior" ToolTip="Select when Configuration Manager reruns the program on a device that ran it before." AutomationProperties.AutomationId="cboRerun" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="pnlDistribution" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlDistribution"
                                    Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Content" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Select an object to see the content status of each distribution point group. Check the groups that get the content."
                                               Style="{StaticResource Note}" Margin="0,0,0,8" />
                                    <DataGrid x:Name="dgDpGroups" Style="{StaticResource GridBase}" ItemsSource="{Binding DpGroups}" MaxHeight="220" MinHeight="96"
                                              AutomationProperties.AutomationId="dgDpGroups" AutomationProperties.Name="Distribution point groups">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="" Width="56" MinWidth="56">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- The default padding leaves the box less width than it draws, which cuts the box in half. -->
                                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" Padding="0"
                                                                  ToolTip="Include this distribution point group when you distribute the content."
                                                                  AutomationProperties.Name="{Binding Name}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Group" Binding="{Binding Name}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="100" ElementStyle="{StaticResource StatusCell}" />
                                            <DataGridTextColumn Header="Targeted" Binding="{Binding Targeted}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Success" Binding="{Binding Success}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="In progress" Binding="{Binding InProgress}" Width="110" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="80" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <WrapPanel Margin="0,8,0,0">
                                        <ui:Button Content="Refresh status" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshDpGroupsCommand}" Style="{StaticResource ToolButton}"
                                                   ToolTip="Reads the content status of the selected object again." AutomationProperties.AutomationId="btnRefreshDpGroups" />
                                        <ui:Button Content="Distribute content" Icon="{ui:SymbolIcon CloudArrowUp24}" Command="{Binding DistributeCommand}" Style="{StaticResource ToolButton}"
                                                   ToolTip="Shows a plan that sends the content to the checked groups." AutomationProperties.AutomationId="btnDistribute" />
                                        <CheckBox Content="Distribute to the checked groups first when I deploy (the plan offers to create the deployment while the content distributes)"
                                                  IsChecked="{Binding DistributeFirst}" Style="{StaticResource Option}" AutomationProperties.AutomationId="chkDistributeFirst" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding DpMessage}" Style="{StaticResource Note}" AutomationProperties.AutomationId="txtDpMessage" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="pnlValidation" Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.AutomationId="pnlValidation">
                            <StackPanel>
                                <TextBlock Text="Checks" Style="{StaticResource CardTitle}" />
                                <DataGrid x:Name="dgChecks" Style="{StaticResource GridBase}" ItemsSource="{Binding Checks}" MinHeight="96"
                                          AutomationProperties.AutomationId="dgChecks" AutomationProperties.Name="Checks">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="96" MinWidth="96" ElementStyle="{StaticResource StatusCell}" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Note}" Margin="0,8,0,0" AutomationProperties.AutomationId="txtValidationMessage"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding FormMessage}" Style="{StaticResource Warning}" Margin="0,8,0,0" Visibility="{Binding HasFormMessage, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.AutomationId="txtFormMessage" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <!-- What Deploy would create, beside the way to the checks. It stays in view at every scroll position. -->
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="View validation checks" Icon="{ui:SymbolIcon CheckmarkCircle24}" Click="OnViewChecksClick" Margin="12,0,0,0" VerticalAlignment="Center"
                                   ToolTip="Scrolls to the Checks list. Select Validate to fill it." AutomationProperties.AutomationId="btnViewChecks" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Deployment to review" Style="{StaticResource FieldLabel}" Margin="0" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtDeploymentReview">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ReviewSummary}">
                                        <Binding Path="SelectedObject" />
                                        <Binding Path="SelectedProgram" />
                                        <Binding Path="SelectedCollection" />
                                        <Binding Path="IsRequired" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel HorizontalAlignment="Right" AutomationProperties.AutomationId="pnlDeployActions">
                        <ui:Button x:Name="btnValidate" Content="Validate" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding ValidateCommand}" Style="{StaticResource ToolButton}"
                                   ToolTip="Runs the checks and the schedule rules. Nothing is changed." AutomationProperties.AutomationId="btnValidate" />
                        <ui:Button Content="Deploy" Appearance="Primary" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding DeployCommand}" Style="{StaticResource ToolButton}"
                                   ToolTip="Shows the plan of the deployment. Nothing is changed before you confirm it." AutomationProperties.AutomationId="btnDeploy" />
                    </WrapPanel>
                </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Rings" AutomationProperties.AutomationId="tabRings" DataContext="{Binding Rings}">
                <views:DeploymentRingsView x:Name="ringsView" />
            </TabItem>

            <TabItem Header="History" AutomationProperties.AutomationId="tabHistory" DataContext="{Binding History}">
                <ScrollViewer x:Name="scrollHistoryTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollHistoryTab">
                    <Grid Height="{Binding ViewportHeight, ElementName=scrollHistoryTab}" MinHeight="480">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                            <ui:TextBox Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by object, collection, deployment ID or user"
                                        Icon="{ui:SymbolIcon Search24}" MinWidth="300" Margin="0,0,8,8" AutomationProperties.Name="History filter" ToolTip="Enter text to show only the audit records whose object, collection, deployment ID, user, result, plan, ring or run contains it." AutomationProperties.AutomationId="txtHistoryFilter" />
                            <ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding EventFilter}" MinWidth="120" Margin="0,0,8,8"
                                      AutomationProperties.Name="Event" ToolTip="Select an event to show only the audit records of that event, or select all." AutomationProperties.AutomationId="cboHistoryEvent" />
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding TypeFilter}" MinWidth="170" Margin="0,0,8,8"
                                      AutomationProperties.Name="Object type" ToolTip="Select an object type to show only the audit records of that type, or select all." AutomationProperties.AutomationId="cboHistoryType" />
                            <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding RunFilter}" MinWidth="170" MaxWidth="320" Margin="0,0,8,8"
                                      ToolTip="Shows only the records of one ring run." AutomationProperties.Name="Ring run" AutomationProperties.AutomationId="cboHistoryRun" />
                            <TextBlock Text="{Binding RowCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtHistoryCount" />
                        </WrapPanel>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                            <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads the audit log again." AutomationProperties.AutomationId="btnHistoryRefresh" />
                            <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelLoadCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Stops the read of the audit log." AutomationProperties.Name="Cancel the read" AutomationProperties.AutomationId="btnHistoryCancel" />
                            <ui:Button Content="Remove deployment" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Command="{Binding RemoveDeploymentCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Shows a plan that removes the deployment of the selected create record." AutomationProperties.AutomationId="btnRemoveDeployment" />
                            <ui:Button Content="Export CSV" Icon="{ui:SymbolIcon DocumentTable24}" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Saves the rows the filters show as a CSV file." AutomationProperties.AutomationId="btnHistoryCsv" />
                            <ui:Button Content="Export HTML" Icon="{ui:SymbolIcon Globe24}" Command="{Binding ExportHtmlCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Saves the rows the filters show as an HTML file." AutomationProperties.AutomationId="btnHistoryHtml" />
                            <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenReportsFolderCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Opens the folder of the last report." AutomationProperties.AutomationId="btnHistoryFolder" />
                        </WrapPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Note}" AutomationProperties.AutomationId="txtHistoryPath">
                                <Run Text="Audit log:" />
                                <Run Text="{Binding LogPath, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding CapNote}" Style="{StaticResource Warning}" Margin="0,4,0,0" Visibility="{Binding IsCapped, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.AutomationId="txtHistoryCap" />
                        </StackPanel>
                        <!-- Result and Deployment ID come before the wide columns, so a narrow window shows them without a sideways scroll; Time stays when the grid scrolls. -->
                        <DataGrid Grid.Row="3" x:Name="dgHistory" Style="{StaticResource GridBase}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" MinHeight="160"
                                  FrozenColumnCount="1" AutomationProperties.AutomationId="dgHistory" AutomationProperties.Name="Audit records">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="130" MinWidth="130" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="72" MinWidth="72" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80" MinWidth="80" ElementStyle="{StaticResource StatusCell}" />
                                <DataGridTextColumn Header="Verified" Binding="{Binding Verified}" Width="98" MinWidth="98" ElementStyle="{StaticResource VerifiedStatusCell}" />
                                <DataGridTextColumn Header="Object" Binding="{Binding Object}" Width="2*" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Deployment ID" Binding="{Binding DeploymentId}" Width="*" MinWidth="120" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Collection" Binding="{Binding Collection}" Width="2*" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="130" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Plan" Binding="{Binding PlanName}" Width="*" MinWidth="72" ElementStyle="{StaticResource TrimmedCell}"
                                                    Visibility="{Binding Data.HasRingRecords, Source={StaticResource HistoryProxy}, Converter={StaticResource BoolToVisibility}}" />
                                <DataGridTextColumn Header="Ring #" Binding="{Binding RingIndex}" Width="68" MinWidth="68" ElementStyle="{StaticResource TrimmedCell}"
                                                    Visibility="{Binding Data.HasRingRecords, Source={StaticResource HistoryProxy}, Converter={StaticResource BoolToVisibility}}" />
                                <DataGridTextColumn Header="Ring" Binding="{Binding RingName}" Width="*" MinWidth="64" ElementStyle="{StaticResource TrimmedCell}"
                                                    Visibility="{Binding Data.HasRingRecords, Source={StaticResource HistoryProxy}, Converter={StaticResource BoolToVisibility}}" />
                                <DataGridTextColumn Header="Run" Binding="{Binding RunId}" Width="*" MinWidth="64" ElementStyle="{StaticResource TrimmedCell}"
                                                    Visibility="{Binding Data.HasRingRecords, Source={StaticResource HistoryProxy}, Converter={StaticResource BoolToVisibility}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Grid.Row="4" x:Name="txtHistoryDetails" Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                 Visibility="{Binding HasSelectedDetails, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Details of the selected record" AutomationProperties.AutomationId="txtHistoryDetails" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Options" AutomationProperties.AutomationId="tabOptions" DataContext="{Binding Options}">
                <ScrollViewer x:Name="scrollOptionsTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollOptionsTab">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,4">
                            <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads the templates, the audit log check and the connection again." AutomationProperties.Name="Refresh options"
                                       AutomationProperties.AutomationId="btnOptionsRefresh" />
                            <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelLoadCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Stops the read of the options." AutomationProperties.Name="Cancel the read" AutomationProperties.AutomationId="btnOptionsCancel" />
                        </WrapPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.AutomationId="pnlAuditLog">
                            <StackPanel>
                                <TextBlock Text="Audit log" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Every create, distribution and removal writes one record. A deployment is created only when the audit log can be written. Leave the path empty for the default under the data root; a share path is allowed."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding AuditLogPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Default under the data root"
                                                AutomationProperties.Name="Audit log path" ToolTip="Enter the path of the audit log file. Leave it empty for the default under the data root." AutomationProperties.AutomationId="txtAuditLogPath" />
                                    <ui:Button Grid.Column="1" Content="Save path" Icon="{ui:SymbolIcon Save24}" Command="{Binding SavePathCommand}" Margin="8,0,0,0"
                                               ToolTip="Saves the audit log path after the page checks it." AutomationProperties.AutomationId="btnSaveAuditPath" />
                                    <ui:Button Grid.Column="2" Content="Check" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding CheckLogCommand}" Margin="8,0,0,0"
                                               ToolTip="Checks that the audit log can be written now." AutomationProperties.AutomationId="btnCheckAuditLog" />
                                </Grid>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="txtAuditLogInUse">
                                    <Run Text="In use:" />
                                    <Run Text="{Binding AuditLogInUse, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ProbeText}" Style="{StaticResource Warning}" Margin="0,4,0,0" AutomationProperties.AutomationId="txtAuditProbe"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding RingFolders}" AutomationProperties.AutomationId="pnlRingFolders">
                            <StackPanel>
                                <TextBlock Text="Ring folders" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="The rings folder holds the plan files; the runs folder holds one file for each run and the lock files. Leave a path empty for the default under the data root. A share path lets sessions on several computers share the runs and their locks."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Rings folder" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,8" />
                                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RingsFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Default under the data root"
                                                Margin="0,0,0,8" AutomationProperties.Name="Rings folder" ToolTip="Enter the path of the folder that holds the ring plan files. Leave it empty for the default under the data root." AutomationProperties.AutomationId="txtRingsFolder" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Runs folder" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,8" />
                                    <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RunsFolder, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Default under the rings folder"
                                                Margin="0,0,0,8" AutomationProperties.Name="Runs folder" ToolTip="Enter the path of the folder that holds the run files and the lock files. Leave it empty for the default under the rings folder." AutomationProperties.AutomationId="txtRunsFolder" />
                                </Grid>
                                <WrapPanel>
                                    <ui:Button Content="Save paths" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveFoldersCommand}" Style="{StaticResource ToolButton}"
                                               AutomationProperties.Name="Save the ring folders" ToolTip="Saves the rings folder and the runs folder paths." AutomationProperties.AutomationId="btnSaveRingFolders" />
                                    <ui:Button Content="Check" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding CheckFoldersCommand}" Style="{StaticResource ToolButton}"
                                               ToolTip="Checks that the folders can be written and that a lock file can be made in the runs folder."
                                               AutomationProperties.Name="Check the ring folders" AutomationProperties.AutomationId="btnCheckRingFolders" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" AutomationProperties.AutomationId="txtRingFoldersInUse">
                                    <Run Text="In use:" />
                                    <Run Text="{Binding PlanFolderInUse, Mode=OneWay}" />
                                    <Run Text="and" />
                                    <Run Text="{Binding RunFolderInUse, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ProbeText}" Style="{StaticResource Warning}" Margin="0,4,0,0" AutomationProperties.AutomationId="txtRingFolderProbe"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding StaleLockText}" Style="{StaticResource Note}" Margin="0,4,0,0" AutomationProperties.AutomationId="txtStaleLockAge" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.AutomationId="pnlTemplates">
                            <StackPanel>
                                <TextBlock Text="Templates" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="A template keeps the purpose, notification, time basis, options and deadline offset. It keeps no object or collection. Shipped templates cannot be changed."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <ui:Button Content="New" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewTemplateCommand}" Style="{StaticResource ToolButton}"
                                               AutomationProperties.Name="New template" ToolTip="Opens the template editor to create a deployment template." AutomationProperties.AutomationId="btnNewTemplate" />
                                    <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit24}" Command="{Binding EditTemplateCommand}" Style="{StaticResource ToolButton}"
                                               AutomationProperties.Name="Edit template" ToolTip="Opens the selected deployment template in the template editor. Shipped templates cannot be changed." AutomationProperties.AutomationId="btnEditTemplate" />
                                    <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteTemplateCommand}" Style="{StaticResource ToolButton}"
                                               AutomationProperties.Name="Delete template" ToolTip="Deletes the selected deployment template after you confirm. Shipped templates cannot be deleted." AutomationProperties.AutomationId="btnDeleteTemplate" />
                                    <TextBlock Text="{Binding TemplateMessage}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="520"
                                               AutomationProperties.AutomationId="txtOptionsTemplateMessage" />
                                </WrapPanel>
                                <DataGrid x:Name="dgTemplates" Style="{StaticResource GridBase}" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MinHeight="120" MaxHeight="280"
                                          AutomationProperties.AutomationId="dgTemplates" AutomationProperties.Name="Templates">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Notification" Binding="{Binding Notification}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="150" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlConnection">
                            <StackPanel>
                                <TextBlock Text="Connection" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Note}" AutomationProperties.AutomationId="txtConnection" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" x:Name="pnlDeploymentResults" Margin="0,12,0,0" Style="{StaticResource Card}" Visibility="{Binding ShowsResultPanel, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="pnlDeploymentResults">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Content="Undo last change" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding Shared.UndoLastCommand}"
                               AutomationProperties.AutomationId="btnDeploymentUndo" ToolTip="Shows a plan that removes the deployments of the last change."
                               Visibility="{Binding Shared.HasUndo, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox DockPanel.Dock="Right" Content="Rows" IsChecked="{Binding Shared.ShowResultRows}" Margin="12,0,12,0" VerticalAlignment="Center"
                              ToolTip="Show or hide the result of each change under the summary." AutomationProperties.AutomationId="chkDeploymentResultRows" />
                    <TextBlock Text="{Binding Shared.ResultSummary}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtDeploymentResultSummary" />
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="dgDeploymentResults" Style="{StaticResource GridBase}" ItemsSource="{Binding Shared.LastResults}" MaxHeight="140"
                          Visibility="{Binding Shared.ShowResultRows, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.AutomationId="dgDeploymentResults" AutomationProperties.Name="Results">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Result" Binding="{Binding OutcomeText}" Width="90" MinWidth="80" ElementStyle="{StaticResource StatusCell}" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Item.Action}" Width="170" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                        <DataGridTextColumn Header="Object" Binding="{Binding Item.Target}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding Shared.HasUnclearDeploymentIds, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Left" Text="New deployments to check in the console:" Style="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding Shared.UnclearDeploymentIds, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AutomationProperties.Name="New deployments to check in the console" AutomationProperties.AutomationId="txtUnclearDeploymentIds" />
                </DockPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                             Visibility="{Binding CurrentTab.IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Shared.StatusMessage}" Style="{StaticResource Note}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="txtDeploymentStatus" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Page>
