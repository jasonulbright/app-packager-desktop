<Page
    x:Class="ApplicationPackagerUI.Views.Pages.DeploymentHelperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock"
    xmlns:pages="clr-namespace:ApplicationPackagerUI.ViewModels.Pages"
    xmlns:views="clr-namespace:ApplicationPackagerUI.Views.Pages"
    FontFamily="Segoe UI"
    FontSize="14"
    TextOptions.TextFormattingMode="Ideal"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Typography.xaml" />
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.WebDeploy.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <helpers:BindingProxy x:Key="HistoryProxy" Data="{Binding History}" />
            <views:DeploymentReviewSummaryConverter x:Key="ReviewSummary" />
            <views:DeploymentReviewSourceConverter x:Key="ReviewSource" />

            <Style TargetType="TabItem" BasedOn="{StaticResource WD.TabItem}" />

            <Style x:Key="GridBase" TargetType="DataGrid" BasedOn="{StaticResource Mk.Grid}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserResizeColumns" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="RowHeight" Value="31" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="helpers:DataGridColumnSizing.FixStarWidthsOnResize" Value="True" />
                <Setter Property="RowStyle" Value="{StaticResource WD.GridRow}" />
                <Setter Property="CellStyle" Value="{StaticResource WD.GridCell}" />
                <Setter Property="helpers:DataGridKeyboard.SelectsFocusedRow" Value="True" />
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnGridPreviewMouseRightButtonDown" />
            </Style>

            <!-- The status of a distribution point group: a glyph and a word in the color of the state, so no state is shown by color alone. -->
            <DataTemplate x:Key="DpStatus">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,4" ToolTip="{Binding StatusText}">
                    <mk:Ico x:Name="Glyph" Glyph="clock" Foreground="{DynamicResource MkTextBrush}" />
                    <TextBlock x:Name="Word" Text="{Binding StatusText}" Margin="6,-1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MkTextBrush}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Distributed">
                        <Setter TargetName="Glyph" Property="Glyph" Value="checkmark_circle" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource MkOkBrush}" />
                        <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource MkOkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                        <Setter TargetName="Glyph" Property="Glyph" Value="error_circle" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource MkBadBrush}" />
                        <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource MkBadBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource MkWarnBrush}" />
                        <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource MkWarnBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <Style x:Key="BareCell" TargetType="DataGridCell" BasedOn="{StaticResource WD.GridCell}">
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- .workspace { padding:0 24px 16px; gap:14px }. The foot of the Deploy tab ends 3 px into the lower padding, as in the mock. -->
    <Grid Margin="24,0,24,12.7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Deployment Helper" Compact="True" TitleAutomationId="txtDeploymentTitle" />

        <Border Grid.Row="1" Style="{StaticResource Mk.Notice.Warn}" Margin="0,0,0,14" Visibility="{Binding Shared.HasConnectionMessage, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="pnlDeploymentConnection">
            <TextBlock Text="{Binding Shared.ConnectionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MkTextBrush}"
                       AutomationProperties.AutomationId="txtDeploymentConnection" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource WD.TabControl}" SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.AutomationId="tabDeploymentHelper">
            <TabItem Header="Deploy" AutomationProperties.AutomationId="tabDeploy" DataContext="{Binding Deploy}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <!-- The scroll bar lies in the page margin, so the content keeps the width of the mock. -->
                <ScrollViewer Grid.Row="0" x:Name="scrollDeployTab" Margin="0,14,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" AutomationProperties.AutomationId="scrollDeployTab">
                    <StackPanel x:Name="pnlDeploy" SizeChanged="OnDeploySizeChanged" Margin="0,0,12,0">
                        <!-- .toolbar: the object types at the left, the template and the reads at the right. -->
                        <Grid x:Name="gridToolbar" UseLayoutRounding="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="36" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox Style="{StaticResource WD.ObjectTabs}" ItemsSource="{Binding TypeNames}" SelectedIndex="{Binding TypeIndex}" VerticalAlignment="Top"
                                     AutomationProperties.Name="Object type" AutomationProperties.AutomationId="lstObjectType" />
                            <TextBlock Grid.Column="1" Text="{Binding TemplateMessage}" Style="{StaticResource QuietNote}" VerticalAlignment="Center" Margin="12,0,12,0"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding TemplateMessage}"
                                       AutomationProperties.AutomationId="txtTemplateMessage" />
                            <WrapPanel x:Name="pnlTemplateActions" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                <Grid Width="180" Height="35" Margin="0,0.5,8,0.5">
                                    <ComboBox x:Name="cboTemplates" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Height="35"
                                              AutomationProperties.Name="Template" ToolTip="Select a deployment template. Apply template fills the purpose, notification, time basis and options from it."
                                              AutomationProperties.AutomationId="cboTemplate" />
                                    <TextBlock Text="Select template" IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,1,24,0" Foreground="{DynamicResource MkTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=cboTemplates}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Style="{StaticResource Mk.Button}" Content="Apply template" Command="{Binding ApplyTemplateCommand}" Margin="0,2,8,2"
                                        ToolTip="Fills the purpose, notification, time basis and options from the template." AutomationProperties.AutomationId="btnApplyTemplate" />
                                <Button Style="{StaticResource Mk.Button}" mk:Mk.Icon="save" Content="Save as template" Command="{Binding SaveAsTemplateCommand}" Margin="0,2,8,2"
                                        ToolTip="Saves the purpose, notification, time basis and options as a user template." AutomationProperties.AutomationId="btnSaveTemplate" />
                                <Button Style="{StaticResource Mk.Button}" mk:Mk.Icon="arrow_sync" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,2,8,2"
                                        ToolTip="Reads the objects, the collections and the templates again."
                                        AutomationProperties.Name="Refresh objects and collections" AutomationProperties.AutomationId="btnDeployRefresh" />
                                <Button Style="{StaticResource Mk.Button}" mk:Mk.Icon="dismiss" Content="Cancel load" Command="{Binding CancelLoadCommand}" Margin="0,2,0,2"
                                        ToolTip="Stops the read of the objects and collections."
                                        AutomationProperties.Name="Cancel the read" AutomationProperties.AutomationId="btnDeployCancel" />
                            </WrapPanel>
                        </Grid>

                        <Grid x:Name="gridPickers" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="pnlObjects" Grid.Row="0" Grid.Column="0" Style="{StaticResource Mk.Panel}" AutomationProperties.AutomationId="pnlObjects">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,14">
                                        <DockPanel Height="20" Margin="0,0,0,14">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ObjectCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="8,2,0,0" AutomationProperties.AutomationId="txtObjectCount" />
                                            <TextBlock Text="{Binding ObjectHeader}" Style="{StaticResource Mk.H3}" />
                                        </DockPanel>
                                        <TextBox Style="{StaticResource Mk.Search}" mk:Mk.IconDrop="-1" HorizontalAlignment="Left" Text="{Binding ObjectFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 mk:Mk.Placeholder="Filter by name, version or ID" AutomationProperties.Name="Object filter"
                                                 ToolTip="Enter text to show only the objects whose name, version or ID contains it." AutomationProperties.AutomationId="txtObjectFilter" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,12" Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Program" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" AutomationProperties.Name="Program"
                                                  ToolTip="Select the Program of the Package to deploy." AutomationProperties.AutomationId="cboProgram" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ObjectListNote}" Style="{StaticResource Warning}" Margin="16,8,16,8"
                                               Visibility="{Binding HasObjectListNote, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtObjectListNote"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <DataGrid x:Name="dgObjects" Style="{StaticResource GridBase}" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}" Height="224" Background="Transparent"
                                              AutomationProperties.AutomationId="dgObjects" AutomationProperties.Name="Objects">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="368.1*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="131.6*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="168.7*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Packaged" Binding="{Binding Packaged}" Width="155.6*" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            <Border x:Name="pnlCollections" Grid.Row="0" Grid.Column="2" Style="{StaticResource Mk.Panel}" AutomationProperties.AutomationId="pnlCollections">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,14">
                                        <DockPanel Height="20" Margin="0,0,0,14">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CollectionCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="8,2,0,0" AutomationProperties.AutomationId="txtCollectionCount" />
                                            <TextBlock Text="Device collection" Style="{StaticResource Mk.H3}" />
                                        </DockPanel>
                                        <TextBox Style="{StaticResource Mk.Search}" mk:Mk.IconDrop="-1" HorizontalAlignment="Left" Text="{Binding CollectionFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 mk:Mk.Placeholder="Filter by name, ID or folder" AutomationProperties.Name="Collection filter"
                                                 ToolTip="Enter text to show only the Device Collections whose name, ID or folder path contains it." AutomationProperties.AutomationId="txtCollectionFilter" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CollectionMessage}" Style="{StaticResource Warning}" Margin="16,8,16,8"
                                               Visibility="{Binding HasCollectionMessage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtCollectionMessage"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <DataGrid x:Name="dgCollections" Style="{StaticResource GridBase}" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" Height="224" Background="Transparent"
                                              AutomationProperties.AutomationId="dgCollections" AutomationProperties.Name="Device collections">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="301.2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding CollectionId}" Width="167.1*" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="131.5*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="102*" MinWidth="64" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="122.2*" MinWidth="72" ElementStyle="{StaticResource TrimmedCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Stacked here; the code puts the two cards side by side when the tab is wide enough. -->
                        <Grid x:Name="gridCards" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="pnlSettings" Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource Mk.Panel}" Padding="20" AutomationProperties.AutomationId="pnlSettings">
                                <StackPanel>
                                    <TextBlock Text="Schedule and options" Style="{StaticResource CardTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Purpose" Style="{StaticResource Mk.FieldName}" Height="19" Margin="2,0,0,6" />
                                            <WrapPanel UseLayoutRounding="False">
                                                <RadioButton Content="Available" GroupName="DeploymentPurpose" IsChecked="{Binding IsAvailable}" Margin="0,0,8,0" Height="29"
                                                             ToolTip="Makes the deployment available: users install the software from Software Center when they choose." AutomationProperties.AutomationId="rbAvailable" />
                                                <RadioButton Content="Required" GroupName="DeploymentPurpose" IsChecked="{Binding IsRequired}" Height="29"
                                                             ToolTip="Makes the deployment required: Configuration Manager installs the software at the deadline." AutomationProperties.AutomationId="rbRequired" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Time basis" Style="{StaticResource Mk.FieldName}" Height="19" Margin="2,0,0,6" />
                                            <WrapPanel UseLayoutRounding="False">
                                                <RadioButton Content="Client local time" GroupName="DeploymentTimeBasis" IsChecked="{Binding IsLocalTime}" Margin="0,0,8,0" Height="29"
                                                             ToolTip="Bases the available and deadline times on the local time of each device." AutomationProperties.AutomationId="rbLocalTime" />
                                                <RadioButton Content="UTC" GroupName="DeploymentTimeBasis" IsChecked="{Binding UtcBasis}" Height="29"
                                                             ToolTip="Bases the available and deadline times on UTC, so every device uses the same moment." AutomationProperties.AutomationId="rbUtc" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Available date" Style="{StaticResource FieldLabel}" />
                                            <DatePicker Style="{StaticResource WD.DatePicker}" helpers:TemplatePartNames.FromOwner="True" SelectedDate="{Binding AvailableDate}" SelectedDateFormat="Short"
                                                        ToolTip="{Binding AvailableDateTip}" AutomationProperties.Name="Available date" AutomationProperties.AutomationId="dpAvailableDate" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Time" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding AvailableTimeText, UpdateSourceTrigger=PropertyChanged}" Height="34" mk:Mk.Placeholder="08:30"
                                                     AutomationProperties.Name="Available time" ToolTip="Enter the time of day the deployment becomes available, as hours and minutes, for example 08:30." AutomationProperties.AutomationId="txtAvailableTime" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Visibility="{Binding ShowNotification, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="User notification" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding Notifications}" SelectedItem="{Binding Notification}" DisplayMemberPath="Text" Height="35" mk:Mk.IconDrop="-1"
                                                      AutomationProperties.Name="User notification" ToolTip="Select whether the deployment shows in Software Center and which notifications users see. An Available deployment cannot hide all notifications." AutomationProperties.AutomationId="cboNotification" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- The settings of one object type; an application has none. -->
                                    <WrapPanel>
                                        <CheckBox Content="{x:Static pages:DeploymentText.ShowProgressLabel}" IsChecked="{Binding ShowProgress}" Style="{StaticResource Option}" Margin="0,14,16,0"
                                                  Visibility="{Binding IsTaskSequence, Converter={StaticResource BoolToVisibility}}" ToolTip="Shows the progress of the Task Sequence on the device while it runs." AutomationProperties.AutomationId="chkShowProgress" />
                                        <CheckBox Content="{x:Static pages:DeploymentText.FallbackLabel}" IsChecked="{Binding AllowFallback}" Style="{StaticResource Option}" Margin="0,14,16,0"
                                                  Visibility="{Binding ShowAllowFallback, Converter={StaticResource BoolToVisibility}}" ToolTip="Lets devices that find no content in their own boundary group use distribution points from the default site boundary group." AutomationProperties.AutomationId="chkAllowFallback" />
                                        <CheckBox Content="{x:Static pages:DeploymentText.FullScanLabel}" IsChecked="{Binding PostRebootScan}" Style="{StaticResource Option}" Margin="0,14,16,0"
                                                  Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" ToolTip="Makes devices run a full scan for software updates after the restart that follows the installation." AutomationProperties.AutomationId="chkPostRebootScan" />
                                        <StackPanel Margin="0,14,14,0" Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Fast network" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding NetworkBehaviors}" SelectedItem="{Binding NetworkBehavior}" DisplayMemberPath="Text" Width="350"
                                                      AutomationProperties.Name="Fast network" ToolTip="Select how devices on a fast network get the content of the Package: download it and run locally, or run the program from the distribution point." AutomationProperties.AutomationId="cboNetwork" />
                                        </StackPanel>
                                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Slow network" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding SlowNetworkBehaviors}" SelectedItem="{Binding SlowNetworkBehavior}" DisplayMemberPath="Text" Width="350"
                                                      AutomationProperties.Name="Slow network" ToolTip="Select how devices on a slow network get the content of the Package: do not run the program, or download the content and run locally." AutomationProperties.AutomationId="cboSlowNetwork" />
                                        </StackPanel>
                                        <StackPanel Margin="0,14,14,0" Visibility="{Binding IsTaskSequence, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Available to" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding TaskSequenceAvailabilities}" SelectedItem="{Binding TaskSequenceAvailability}" DisplayMemberPath="Text" Width="300"
                                                      AutomationProperties.Name="Available to" ToolTip="Select which devices and boot media can see the Task Sequence deployment." AutomationProperties.AutomationId="cboTaskSequenceAvailability" />
                                        </StackPanel>
                                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsTaskSequence, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Content" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding TaskSequenceContents}" SelectedItem="{Binding TaskSequenceContent}" DisplayMemberPath="Text" Width="450"
                                                      AutomationProperties.Name="Task sequence content" ToolTip="Select when devices download the content of the Task Sequence: when the Task Sequence needs it, or all before it starts." AutomationProperties.AutomationId="cboTaskSequenceContent" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- An available application on client local time has this note in the tooltips of the time basis only. -->
                                    <TextBlock Text="{Binding TimeBasisNote}" Margin="0,14,0,0" AutomationProperties.AutomationId="txtTimeBasisNote">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding UtcBasis}" Value="False" />
                                                            <Condition Binding="{Binding IsRequired}" Value="False" />
                                                            <Condition Binding="{Binding ShowRerun}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- .notice: it stands where the Required options stand once Required is selected. -->
                                    <Border Margin="0,14,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Mk.Notice}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Required deployment options" Style="{StaticResource Mk.Strong}" Height="19" />
                                            <TextBlock Text="{Binding RequiredOnlyNote}" Style="{StaticResource Mk.Help}" Margin="0,2.3,0,-1" AutomationProperties.AutomationId="txtRequiredOnlyNote" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="145" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Deadline date" Style="{StaticResource FieldLabel}" />
                                                <DatePicker Style="{StaticResource WD.DatePicker}" helpers:TemplatePartNames.FromOwner="True" SelectedDate="{Binding DeadlineDate}" SelectedDateFormat="Short"
                                                            ToolTip="{Binding DeadlineDateTip}" AutomationProperties.Name="Deadline date" AutomationProperties.AutomationId="dpDeadlineDate" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Time" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding DeadlineTimeText, UpdateSourceTrigger=PropertyChanged}" Height="34" mk:Mk.Placeholder="18:00"
                                                         AutomationProperties.Name="Deadline time" ToolTip="Enter the time of day of the deadline, as hours and minutes, for example 18:00." AutomationProperties.AutomationId="txtDeadlineTime" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Visibility="{Binding ShowRerun, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Rerun behavior" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding RerunBehaviors}" SelectedItem="{Binding RerunBehavior}" DisplayMemberPath="Text" Height="35"
                                                          AutomationProperties.Name="Rerun behavior" ToolTip="Select when Configuration Manager reruns the program on a device that ran it before." AutomationProperties.AutomationId="cboRerun" />
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding RequiredOnlyEnabled}" AutomationProperties.AutomationId="pnlRequiredOnly">
                                            <CheckBox Content="{x:Static pages:DeploymentText.OverrideWindowLabel}" IsChecked="{Binding OverrideServiceWindow}" Style="{StaticResource Option}"
                                                      ToolTip="At the deadline, installs the software even when no maintenance window is open." AutomationProperties.AutomationId="chkOverrideWindow" />
                                            <CheckBox Content="{x:Static pages:DeploymentText.RebootOutsideLabel}" IsChecked="{Binding RebootOutsideServiceWindow}" Style="{StaticResource Option}"
                                                      ToolTip="Lets devices restart after the installation even when no maintenance window is open." AutomationProperties.AutomationId="chkRebootOutside" />
                                            <CheckBox Content="{x:Static pages:DeploymentText.MeteredLabel}" IsChecked="{Binding AllowMetered}" Style="{StaticResource Option}"
                                                      Visibility="{Binding ShowMetered, Converter={StaticResource BoolToVisibility}}" ToolTip="Lets devices on a metered connection download content after the installation deadline. This can cost extra." AutomationProperties.AutomationId="chkMetered" />
                                            <CheckBox Content="{x:Static pages:DeploymentText.FallbackLabel}" IsChecked="{Binding FallbackToDp}" Style="{StaticResource Option}"
                                                      Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" ToolTip="Lets devices that find no software updates on a preferred distribution point use distribution points from the default site boundary group." AutomationProperties.AutomationId="chkFallbackToDp" />
                                            <CheckBox Content="{x:Static pages:DeploymentText.MicrosoftUpdateLabel}" IsChecked="{Binding AllowMicrosoftUpdate}" Style="{StaticResource Option}"
                                                      Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" ToolTip="Lets devices download the software updates from Microsoft Update when no distribution point has them." AutomationProperties.AutomationId="chkMicrosoftUpdate" />
                                            <CheckBox Content="{Binding SuppressRestartLabel}" IsChecked="{Binding SuppressRestart}" Style="{StaticResource Option}"
                                                      Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" ToolTip="Stops servers and workstations from restarting after the installation." AutomationProperties.AutomationId="chkSuppressRestart" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="pnlDistribution" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0" Style="{StaticResource Mk.Panel}" Padding="20" AutomationProperties.AutomationId="pnlDistribution"
                                    Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Content" Style="{StaticResource CardTitle}"
                                               ToolTip="Select an object to see the content status of each distribution point group. Check the groups that get the content." />
                                    <DataGrid x:Name="dgDpGroups" Style="{StaticResource GridBase}" ItemsSource="{Binding DpGroups}" MaxHeight="220" RowHeight="31.5" Background="Transparent"
                                              AutomationProperties.AutomationId="dgDpGroups" AutomationProperties.Name="Distribution point groups">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Distribute" Width="80.3*" MinWidth="76">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6.5,0,2"
                                                                  ToolTip="Include this distribution point group when you distribute the content."
                                                                  AutomationProperties.Name="{Binding Name}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Distribution point group" Binding="{Binding Name}" Width="210.2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTemplateColumn Header="Status" Width="133.3*" MinWidth="116" SortMemberPath="StatusText" CellTemplate="{StaticResource DpStatus}" CellStyle="{StaticResource BareCell}" />
                                            <DataGridTextColumn Header="Targeted" Binding="{Binding Targeted}" Width="95*" MinWidth="76" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Success" Binding="{Binding Success}" Width="85.8*" MinWidth="70" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="In progress" Binding="{Binding InProgress}" Width="112.3*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="67.1*" MinWidth="60" ElementStyle="{StaticResource TrimmedCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <CheckBox Content="Distribute to checked groups when deploying" IsChecked="{Binding DistributeFirst}" Margin="0,15,0,-1" Height="29" HorizontalAlignment="Left"
                                              ToolTip="Distributes the content to the checked groups first when you deploy. The plan offers to create the deployment while the content distributes."
                                              mk:Mk.IconDrop="-1" AutomationProperties.AutomationId="chkDistributeFirst" />
                                    <WrapPanel Margin="0,13,0,1" UseLayoutRounding="False">
                                        <Button Style="{StaticResource Mk.Button}" mk:Mk.Icon="arrow_sync" mk:Mk.IconDrop="1" mk:Mk.FaceDrop="1" Content="Refresh status" Command="{Binding RefreshDpGroupsCommand}" Margin="0,0,8,0"
                                                ToolTip="Reads the content status of the selected object again." AutomationProperties.AutomationId="btnRefreshDpGroups" />
                                        <Button Style="{StaticResource Mk.Button}" mk:Mk.Icon="cloud_arrow_up" mk:Mk.IconDrop="1" mk:Mk.FaceDrop="1" Content="Distribute content" Command="{Binding DistributeCommand}"
                                                ToolTip="Shows a plan that sends the content to the checked groups." AutomationProperties.AutomationId="btnDistribute" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding DpMessage}" Style="{StaticResource QuietNote}" Margin="0,8,0,0" AutomationProperties.AutomationId="txtDpMessage" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- The checks show after Validate, with a message of the form, or when View validation checks asks for them. -->
                        <Border x:Name="pnlValidation" Margin="0,14,0,0" AutomationProperties.AutomationId="pnlValidation">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Mk.Panel}">
                                    <Setter Property="Padding" Value="16" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Checks.Count}" Value="0" />
                                                <Condition Binding="{Binding ValidationMessage}" Value="" />
                                                <Condition Binding="{Binding HasFormMessage}" Value="False" />
                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Checks" Style="{StaticResource CardTitle}" />
                                <DataGrid x:Name="dgChecks" Style="{StaticResource GridBase}" ItemsSource="{Binding Checks}" MinHeight="96"
                                          AutomationProperties.AutomationId="dgChecks" AutomationProperties.Name="Checks">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="96" MinWidth="96" ElementStyle="{StaticResource StatusCell}" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource QuietNote}" Margin="0,8,0,0" AutomationProperties.AutomationId="txtValidationMessage"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding FormMessage}" Style="{StaticResource Warning}" Margin="0,8,0,0" Visibility="{Binding HasFormMessage, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.AutomationId="txtFormMessage" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    <!-- What Deploy would create, beside the way to the checks. It stays in view at every scroll position. -->
                    <DockPanel Grid.Row="1" Margin="0,14,0,0" Height="42">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Mk.Button}" mk:Mk.Icon="checkmark_circle" mk:Mk.FaceDrop="-1" Content="View validation checks" Click="OnViewChecksClick"
                                Margin="12,2,0,0" VerticalAlignment="Center" ToolTip="Shows the Checks list. Select Validate to fill it." AutomationProperties.AutomationId="btnViewChecks" />
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="Deployment to review" Style="{StaticResource Mk.Strong}" Height="19" />
                            <TextBlock Style="{StaticResource Mk.Body}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="txtDeploymentReview">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ReviewSummary}">
                                        <Binding Path="SelectedObject" />
                                        <Binding Path="SelectedProgram" />
                                        <Binding Path="SelectedCollection" />
                                        <Binding Path="IsRequired" />
                                        <Binding Path="PreparedCreate" />
                                    </MultiBinding>
                                </TextBlock.Text>
                                <TextBlock.ToolTip>
                                    <Binding Path="PreparedCreate" Converter="{StaticResource ReviewSource}" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <!-- .foot: the site at the left, Validate and Review deployment at the right. -->
                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MkLineBrush}">
                        <DockPanel Height="32" UseLayoutRounding="False">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" AutomationProperties.AutomationId="pnlDeployActions">
                                <Button x:Name="btnValidate" Style="{StaticResource Mk.Button}" mk:Mk.Icon="checkmark_circle" Content="Validate" Command="{Binding ValidateCommand}"
                                        ToolTip="Runs the checks and the schedule rules. Nothing is changed." AutomationProperties.AutomationId="btnValidate" />
                                <Button Style="{StaticResource Mk.Button.Primary}" mk:Mk.Icon="arrow_right" Content="Review deployment" Command="{Binding DeployCommand}" Margin="8,0,0,0"
                                        ToolTip="Shows the plan of the deployment. Nothing is changed before you confirm it." AutomationProperties.AutomationId="btnDeploy" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <mk:Ico Glyph="info" Foreground="{DynamicResource MkAccentBrush}" />
                                <TextBlock Text="{Binding Shared.SiteText}" Margin="6,1,0,0" Foreground="{DynamicResource MkAccentBrush}" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="txtDeploymentSite" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Rings" AutomationProperties.AutomationId="tabRings" DataContext="{Binding Rings}">
                <views:DeploymentRingsView x:Name="ringsView" />
            </TabItem>

            <TabItem Header="History" AutomationProperties.AutomationId="tabHistory" DataContext="{Binding History}">
                <ScrollViewer x:Name="scrollHistoryTab" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollHistoryTab">
                    <Grid Height="{Binding ViewportHeight, ElementName=scrollHistoryTab}" MinHeight="480">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBox Style="{StaticResource Mk.Search}" Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" mk:Mk.Placeholder="Filter by object, collection, deployment ID or user"
                                        MinWidth="300" Margin="0,0,8,8" AutomationProperties.Name="History filter" ToolTip="Enter text to show only the audit records whose object, collection, deployment ID, user, result, plan, ring or run contains it." AutomationProperties.AutomationId="txtHistoryFilter" />
                            <ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding EventFilter}" MinWidth="120" Margin="0,0,8,8"
                                      AutomationProperties.Name="Event" ToolTip="Select an event to show only the audit records of that event, or select all." AutomationProperties.AutomationId="cboHistoryEvent" />
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding TypeFilter}" MinWidth="170" Margin="0,0,8,8"
                                      AutomationProperties.Name="Object type" ToolTip="Select an object type to show only the audit records of that type, or select all." AutomationProperties.AutomationId="cboHistoryType" />
                            <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding RunFilter}" MinWidth="170" MaxWidth="320" Margin="0,0,8,8"
                                      ToolTip="Shows only the records of one ring run." AutomationProperties.Name="Ring run" AutomationProperties.AutomationId="cboHistoryRun" />
                            <TextBlock Text="{Binding RowCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtHistoryCount" />
                        </WrapPanel>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                            <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="arrow_sync" Content="Refresh" Command="{Binding RefreshCommand}"
                                       ToolTip="Reads the audit log again." AutomationProperties.AutomationId="btnHistoryRefresh" />
                            <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="dismiss" Content="Cancel" Command="{Binding CancelLoadCommand}"
                                       ToolTip="Stops the read of the audit log." AutomationProperties.Name="Cancel the read" AutomationProperties.AutomationId="btnHistoryCancel" />
                            <Button Style="{StaticResource ToolButton.Danger}" Content="Remove deployment" Command="{Binding RemoveDeploymentCommand}"
                                       ToolTip="Shows a plan that removes the deployment of the selected create record." AutomationProperties.AutomationId="btnRemoveDeployment" />
                            <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="document" Content="Export CSV" Command="{Binding ExportCsvCommand}"
                                       ToolTip="Saves the rows the filters show as a CSV file." AutomationProperties.AutomationId="btnHistoryCsv" />
                            <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="globe" Content="Export HTML" Command="{Binding ExportHtmlCommand}"
                                       ToolTip="Saves the rows the filters show as an HTML file." AutomationProperties.AutomationId="btnHistoryHtml" />
                            <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="folder_open" Content="Open folder" Command="{Binding OpenReportsFolderCommand}"
                                       ToolTip="Opens the folder of the last report." AutomationProperties.AutomationId="btnHistoryFolder" />
                        </WrapPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Note}" AutomationProperties.AutomationId="txtHistoryPath">
                                <Run Text="Audit log:" />
                                <Run Text="{Binding LogPath, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding CapNote}" Style="{StaticResource Warning}" Margin="0,4,0,0" Visibility="{Binding IsCapped, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.AutomationId="txtHistoryCap" />
                        </StackPanel>
                        <!-- Result and Deployment ID come before the wide columns, so a narrow window shows them without a sideways scroll; Time stays when the grid scrolls. -->
                        <DataGrid Grid.Row="3" x:Name="dgHistory" Style="{StaticResource GridBase}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" MinHeight="160"
                                  FrozenColumnCount="1" AutomationProperties.AutomationId="dgHistory" AutomationProperties.Name="Audit records">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="130" MinWidth="130" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="72" MinWidth="72" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80" MinWidth="80" ElementStyle="{StaticResource StatusCell}" />
                                <DataGridTextColumn Header="Verified" Binding="{Binding Verified}" Width="102" MinWidth="102" ElementStyle="{StaticResource VerifiedStatusCell}" />
                                <DataGridTextColumn Header="Object" Binding="{Binding Object}" Width="2*" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Deployment ID" Binding="{Binding DeploymentId}" Width="*" MinWidth="120" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Collection" Binding="{Binding Collection}" Width="2*" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="130" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Plan" Binding="{Binding PlanName}" Width="*" MinWidth="72" ElementStyle="{StaticResource TrimmedCell}"
                                                    Visibility="{Binding Data.HasRingRecords, Source={StaticResource HistoryProxy}, Converter={StaticResource BoolToVisibility}}" />
                                <DataGridTextColumn Header="Ring #" Binding="{Binding RingIndex}" Width="68" MinWidth="68" ElementStyle="{StaticResource TrimmedCell}"
                                                    Visibility="{Binding Data.HasRingRecords, Source={StaticResource HistoryProxy}, Converter={StaticResource BoolToVisibility}}" />
                                <DataGridTextColumn Header="Ring" Binding="{Binding RingName}" Width="*" MinWidth="64" ElementStyle="{StaticResource TrimmedCell}"
                                                    Visibility="{Binding Data.HasRingRecords, Source={StaticResource HistoryProxy}, Converter={StaticResource BoolToVisibility}}" />
                                <DataGridTextColumn Header="Run" Binding="{Binding RunId}" Width="*" MinWidth="64" ElementStyle="{StaticResource TrimmedCell}"
                                                    Visibility="{Binding Data.HasRingRecords, Source={StaticResource HistoryProxy}, Converter={StaticResource BoolToVisibility}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Grid.Row="4" x:Name="txtHistoryDetails" Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                 Visibility="{Binding HasSelectedDetails, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Details of the selected record" AutomationProperties.AutomationId="txtHistoryDetails" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Options" AutomationProperties.AutomationId="tabOptions" DataContext="{Binding Options}">
                <ScrollViewer x:Name="scrollOptionsTab" Margin="0,14,-12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollOptionsTab">
                    <StackPanel Margin="0,0,12,0">
                        <WrapPanel Margin="0,0,0,4">
                            <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="arrow_sync" Content="Refresh" Command="{Binding RefreshCommand}"
                                       ToolTip="Reads the templates, the audit log check and the connection again." AutomationProperties.Name="Refresh options"
                                       AutomationProperties.AutomationId="btnOptionsRefresh" />
                            <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="dismiss" Content="Cancel" Command="{Binding CancelLoadCommand}"
                                       ToolTip="Stops the read of the options." AutomationProperties.Name="Cancel the read" AutomationProperties.AutomationId="btnOptionsCancel" />
                        </WrapPanel>
                        <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlAuditLog">
                            <StackPanel>
                                <TextBlock Text="Audit log" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Every create, distribution and removal writes one record. A deployment is created only when the audit log can be written. Leave the path empty for the default under the data root; a share path is allowed."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding AuditLogPath, UpdateSourceTrigger=PropertyChanged}" mk:Mk.Placeholder="Default under the data root"
                                                AutomationProperties.Name="Audit log path" ToolTip="Enter the path of the audit log file. Leave it empty for the default under the data root." AutomationProperties.AutomationId="txtAuditLogPath" />
                                    <Button Style="{StaticResource Mk.Button}" mk:Mk.Icon="save" Grid.Column="1" Content="Save path" Command="{Binding SavePathCommand}" Margin="8,0,0,0"
                                               ToolTip="Saves the audit log path after the page checks it." AutomationProperties.AutomationId="btnSaveAuditPath" />
                                    <Button Style="{StaticResource Mk.Button}" mk:Mk.Icon="checkmark_circle" Grid.Column="2" Content="Check" Command="{Binding CheckLogCommand}" Margin="8,0,0,0"
                                               ToolTip="Checks that the audit log can be written now." AutomationProperties.AutomationId="btnCheckAuditLog" />
                                </Grid>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="txtAuditLogInUse">
                                    <Run Text="In use:" />
                                    <Run Text="{Binding AuditLogInUse, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ProbeText}" Style="{StaticResource Warning}" Margin="0,4,0,0" AutomationProperties.AutomationId="txtAuditProbe"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" DataContext="{Binding RingFolders}" AutomationProperties.AutomationId="pnlRingFolders">
                            <StackPanel>
                                <TextBlock Text="Ring folders" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="The rings folder holds the plan files; the runs folder holds one file for each run and the lock files. Leave a path empty for the default under the data root. A share path lets sessions on several computers share the runs and their locks."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Rings folder" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,8" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RingsFolder, UpdateSourceTrigger=PropertyChanged}" mk:Mk.Placeholder="Default under the data root"
                                                Margin="0,0,0,8" AutomationProperties.Name="Rings folder" ToolTip="Enter the path of the folder that holds the ring plan files. Leave it empty for the default under the data root." AutomationProperties.AutomationId="txtRingsFolder" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Runs folder" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,8" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RunsFolder, UpdateSourceTrigger=PropertyChanged}" mk:Mk.Placeholder="Default under the rings folder"
                                                Margin="0,0,0,8" AutomationProperties.Name="Runs folder" ToolTip="Enter the path of the folder that holds the run files and the lock files. Leave it empty for the default under the rings folder." AutomationProperties.AutomationId="txtRunsFolder" />
                                </Grid>
                                <WrapPanel>
                                    <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="save" Content="Save paths" Command="{Binding SaveFoldersCommand}"
                                               AutomationProperties.Name="Save the ring folders" ToolTip="Saves the rings folder and the runs folder paths." AutomationProperties.AutomationId="btnSaveRingFolders" />
                                    <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="checkmark_circle" Content="Check" Command="{Binding CheckFoldersCommand}"
                                               ToolTip="Checks that the folders can be written and that a lock file can be made in the runs folder."
                                               AutomationProperties.Name="Check the ring folders" AutomationProperties.AutomationId="btnCheckRingFolders" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" AutomationProperties.AutomationId="txtRingFoldersInUse">
                                    <Run Text="In use:" />
                                    <Run Text="{Binding PlanFolderInUse, Mode=OneWay}" />
                                    <Run Text="and" />
                                    <Run Text="{Binding RunFolderInUse, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ProbeText}" Style="{StaticResource Warning}" Margin="0,4,0,0" AutomationProperties.AutomationId="txtRingFolderProbe"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding StaleLockText}" Style="{StaticResource Note}" Margin="0,4,0,0" AutomationProperties.AutomationId="txtStaleLockAge" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlTemplates">
                            <StackPanel>
                                <TextBlock Text="Templates" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="A template keeps the purpose, notification, time basis, options and deadline offset. It keeps no object or collection. Shipped templates cannot be changed."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Style="{StaticResource ToolButton}" mk:Mk.Icon="add" Content="New" Command="{Binding NewTemplateCommand}"
                                               AutomationProperties.Name="New template" ToolTip="Opens the template editor to create a deployment template." AutomationProperties.AutomationId="btnNewTemplate" />
                                    <Button Style="{StaticResource ToolButton}" Content="Edit" Command="{Binding EditTemplateCommand}"
                                               AutomationProperties.Name="Edit template" ToolTip="Opens the selected deployment template in the template editor. Shipped templates cannot be changed." AutomationProperties.AutomationId="btnEditTemplate" />
                                    <Button Style="{StaticResource ToolButton}" Content="Delete" Command="{Binding DeleteTemplateCommand}"
                                               AutomationProperties.Name="Delete template" ToolTip="Deletes the selected deployment template after you confirm. Shipped templates cannot be deleted." AutomationProperties.AutomationId="btnDeleteTemplate" />
                                    <TextBlock Text="{Binding TemplateMessage}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="520"
                                               AutomationProperties.AutomationId="txtOptionsTemplateMessage" />
                                </WrapPanel>
                                <DataGrid x:Name="dgTemplates" Style="{StaticResource GridBase}" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MinHeight="120" MaxHeight="280"
                                          AutomationProperties.AutomationId="dgTemplates" AutomationProperties.Name="Templates">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Notification" Binding="{Binding Notification}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="150" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0" AutomationProperties.AutomationId="pnlConnection">
                            <StackPanel>
                                <TextBlock Text="Connection" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Note}" AutomationProperties.AutomationId="txtConnection" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" x:Name="pnlDeploymentResults" Margin="0,14,0,0" Style="{StaticResource Mk.Panel}" Padding="12" Visibility="{Binding ShowsResultPanel, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="pnlDeploymentResults">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Style="{StaticResource Mk.Button}" DockPanel.Dock="Right" Content="Undo last change" Command="{Binding Shared.UndoLastCommand}"
                               AutomationProperties.AutomationId="btnDeploymentUndo" ToolTip="Shows a plan that removes the deployments of the last change."
                               Visibility="{Binding Shared.HasUndo, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox DockPanel.Dock="Right" Content="Rows" IsChecked="{Binding Shared.ShowResultRows}" Margin="12,0,12,0" VerticalAlignment="Center"
                              ToolTip="Show or hide the result of each change under the summary." AutomationProperties.AutomationId="chkDeploymentResultRows" />
                    <TextBlock Text="{Binding Shared.ResultSummary}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtDeploymentResultSummary" />
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="dgDeploymentResults" Style="{StaticResource GridBase}" ItemsSource="{Binding Shared.LastResults}" MaxHeight="140"
                          Visibility="{Binding Shared.ShowResultRows, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.AutomationId="dgDeploymentResults" AutomationProperties.Name="Results">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Result" Binding="{Binding OutcomeText}" Width="90" MinWidth="80" ElementStyle="{StaticResource StatusCell}" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Item.Action}" Width="170" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                        <DataGridTextColumn Header="Object" Binding="{Binding Item.Target}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding Shared.HasUnclearDeploymentIds, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Left" Text="New deployments to check in the console:" Style="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding Shared.UnclearDeploymentIds, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AutomationProperties.Name="New deployments to check in the console" AutomationProperties.AutomationId="txtUnclearDeploymentIds" />
                </DockPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Margin" Value="0,8,0,0" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Shared.StatusMessage}" Value="" />
                                <Condition Binding="{Binding CurrentTab.IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                             Visibility="{Binding CurrentTab.IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Shared.StatusMessage}" Style="{StaticResource Note}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="txtDeploymentStatus" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Page>
