<Page
    x:Class="ApplicationPackagerUI.Views.Pages.DeploymentHelperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Note}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>

            <Style x:Key="Option" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,16,8" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <Style x:Key="Caution" TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <DataTemplate x:Key="TabHeaderTemplate">
                <StackPanel>
                    <TextBlock x:Name="TabHeaderText" Text="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="TabHeaderUnderline" Height="3" CornerRadius="1.5" Margin="0,4,0,0" Background="Transparent" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                        <Setter TargetName="TabHeaderText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter TargetName="TabHeaderText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="TabHeaderUnderline" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="HeaderTemplate" Value="{StaticResource TabHeaderTemplate}" />
            </Style>

            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style x:Key="TabStopCell" TargetType="DataGridCell" BasedOn="{StaticResource FocusableCell}">
                <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
            </Style>

            <Style x:Key="GridBase" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="CanUserResizeColumns" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="helpers:DataGridColumnSizing.FixStarWidthsOnResize" Value="True" />
                <Setter Property="RowStyle" Value="{StaticResource SelectableRow}" />
                <Setter Property="CellStyle" Value="{StaticResource TabStopCell}" />
                <Setter Property="helpers:DataGridKeyboard.SelectsFocusedRow" Value="True" />
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnGridPreviewMouseRightButtonDown" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Ring deployment" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding StartRingToolCommand}"
                       ToolTip="Starts Deployment Helper from the AppPackager Suite for ring deployments." Margin="8,4,0,0"
                       AutomationProperties.AutomationId="btnRingDeployment" />
            <StackPanel>
                <TextBlock Text="Deployment Helper" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Creates one deployment of an application, a package, a task sequence or a software update group to a device collection. Every write shows a plan first."
                           Style="{StaticResource Note}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Caution}" Visibility="{Binding Shared.HasConnectionMessage, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="pnlDeploymentConnection">
            <TextBlock Text="{Binding Shared.ConnectionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="txtDeploymentConnection" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.AutomationId="tabDeploymentHelper">
            <TabItem Header="Deploy" AutomationProperties.AutomationId="tabDeploy" DataContext="{Binding Deploy}">
                <ScrollViewer x:Name="scrollDeployTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollDeployTab">
                    <StackPanel x:Name="pnlDeploy" SizeChanged="OnDeploySizeChanged">
                        <WrapPanel Margin="0,0,0,4">
                            <ListBox ItemsSource="{Binding TypeNames}" SelectedIndex="{Binding TypeIndex}" ItemContainerStyle="{StaticResource SelectableListItem}"
                                     Margin="0,0,16,8" AutomationProperties.Name="Object type" AutomationProperties.AutomationId="lstObjectType">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="8,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" MinWidth="200" Margin="0,0,8,8"
                                      VerticalAlignment="Top" AutomationProperties.Name="Template" AutomationProperties.AutomationId="cboTemplate" />
                            <ui:Button Content="Apply template" Icon="{ui:SymbolIcon DocumentArrowRight24}" Command="{Binding ApplyTemplateCommand}" VerticalAlignment="Top"
                                       ToolTip="Fills the purpose, notification, time basis and options from the template." Style="{StaticResource ToolButton}"
                                       AutomationProperties.AutomationId="btnApplyTemplate" />
                            <ui:Button Content="Save as template" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveAsTemplateCommand}" VerticalAlignment="Top"
                                       ToolTip="Saves the purpose, notification, time basis and options as a user template." Style="{StaticResource ToolButton}"
                                       AutomationProperties.AutomationId="btnSaveTemplate" />
                            <TextBlock Text="{Binding TemplateMessage}" Style="{StaticResource Note}" VerticalAlignment="Top" Margin="0,6,0,8" MaxWidth="420"
                                       AutomationProperties.AutomationId="txtTemplateMessage" />
                        </WrapPanel>

                        <Grid x:Name="gridPickers" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="pnlObjects" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlObjects">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ObjectCount}" Style="{StaticResource Note}" Margin="8,0,0,8" AutomationProperties.AutomationId="txtObjectCount" />
                                        <TextBlock Text="{Binding ObjectHeader}" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <ui:TextBox DockPanel.Dock="Top" Text="{Binding ObjectFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, version or ID"
                                                Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,8" AutomationProperties.Name="Object filter" AutomationProperties.AutomationId="txtObjectFilter" />
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Program" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" AutomationProperties.Name="Program"
                                                  AutomationProperties.AutomationId="cboProgram" />
                                    </StackPanel>
                                    <DataGrid x:Name="dgObjects" Style="{StaticResource GridBase}" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}" Height="240"
                                              AutomationProperties.AutomationId="dgObjects" AutomationProperties.Name="Objects">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Packaged" Binding="{Binding Packaged}" Width="100" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                            <Border x:Name="pnlCollections" Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlCollections">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CollectionCount}" Style="{StaticResource Note}" Margin="8,0,0,8" AutomationProperties.AutomationId="txtCollectionCount" />
                                        <TextBlock Text="Device collection" Style="{StaticResource CardTitle}" />
                                    </DockPanel>
                                    <ui:TextBox DockPanel.Dock="Top" Text="{Binding CollectionFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, ID or folder"
                                                Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,8" AutomationProperties.Name="Collection filter" AutomationProperties.AutomationId="txtCollectionFilter" />
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CollectionMessage}" Style="{StaticResource Warning}" Margin="0,8,0,0"
                                               Visibility="{Binding HasCollectionMessage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtCollectionMessage"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <DataGrid x:Name="dgCollections" Style="{StaticResource GridBase}" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" Height="240"
                                              AutomationProperties.AutomationId="dgCollections" AutomationProperties.Name="Device collections">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="ID" Binding="{Binding CollectionId}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Members" Binding="{Binding MemberCount}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.AutomationId="pnlSettings">
                            <StackPanel>
                                <TextBlock Text="Schedule and options" Style="{StaticResource CardTitle}" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="Purpose" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Available" GroupName="DeploymentPurpose" IsChecked="{Binding IsAvailable}" Margin="0,0,16,0"
                                                         AutomationProperties.AutomationId="rbAvailable" />
                                            <RadioButton Content="Required" GroupName="DeploymentPurpose" IsChecked="{Binding IsRequired}" AutomationProperties.AutomationId="rbRequired" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="Time basis" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Local time" GroupName="DeploymentTimeBasis" IsChecked="{Binding IsLocalTime}" Margin="0,0,16,0"
                                                         AutomationProperties.AutomationId="rbLocalTime" />
                                            <RadioButton Content="UTC" GroupName="DeploymentTimeBasis" IsChecked="{Binding UtcBasis}" AutomationProperties.AutomationId="rbUtc" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="Available" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <DatePicker SelectedDate="{Binding AvailableDate}" Width="150" Margin="0,0,8,0" AutomationProperties.Name="Available date"
                                                        AutomationProperties.AutomationId="dpAvailableDate" />
                                            <ui:TextBox Text="{Binding AvailableTimeText, UpdateSourceTrigger=PropertyChanged}" Width="90" PlaceholderText="08:30"
                                                        AutomationProperties.Name="Available time" AutomationProperties.AutomationId="txtAvailableTime" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8" Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Deadline" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <DatePicker SelectedDate="{Binding DeadlineDate}" Width="150" Margin="0,0,8,0" AutomationProperties.Name="Deadline date"
                                                        AutomationProperties.AutomationId="dpDeadlineDate" />
                                            <ui:TextBox Text="{Binding DeadlineTimeText, UpdateSourceTrigger=PropertyChanged}" Width="90" PlaceholderText="18:00"
                                                        AutomationProperties.Name="Deadline time" AutomationProperties.AutomationId="txtDeadlineTime" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="User notification" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Notifications}" SelectedItem="{Binding Notification}" DisplayMemberPath="Text" MinWidth="280"
                                                  AutomationProperties.Name="User notification" AutomationProperties.AutomationId="cboNotification" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <CheckBox Content="Override maintenance windows" IsChecked="{Binding OverrideServiceWindow}" Style="{StaticResource Option}"
                                              AutomationProperties.AutomationId="chkOverrideWindow" />
                                    <CheckBox Content="Allow restart outside maintenance windows" IsChecked="{Binding RebootOutsideServiceWindow}" Style="{StaticResource Option}"
                                              AutomationProperties.AutomationId="chkRebootOutside" />
                                    <CheckBox Content="Allow download on a metered connection" IsChecked="{Binding AllowMetered}" Style="{StaticResource Option}"
                                              Visibility="{Binding ShowMetered, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="chkMetered" />
                                    <CheckBox Content="Show task sequence progress" IsChecked="{Binding ShowProgress}" Style="{StaticResource Option}"
                                              Visibility="{Binding IsTaskSequence, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="chkShowProgress" />
                                    <CheckBox Content="Allow fallback to unprotected distribution points" IsChecked="{Binding AllowFallback}" Style="{StaticResource Option}"
                                              Visibility="{Binding IsTaskSequence, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="chkAllowFallback" />
                                    <CheckBox Content="Allow fallback to neighbor boundary groups" IsChecked="{Binding FallbackToDp}" Style="{StaticResource Option}"
                                              Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="chkFallbackToDp" />
                                    <CheckBox Content="Require a full scan after the restart" IsChecked="{Binding PostRebootScan}" Style="{StaticResource Option}"
                                              Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="chkPostRebootScan" />
                                    <CheckBox Content="Suppress restarts" IsChecked="{Binding SuppressRestart}" Style="{StaticResource Option}"
                                              Visibility="{Binding IsUpdateGroup, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="chkSuppressRestart" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <StackPanel Margin="0,0,24,8" Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Network" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding NetworkBehaviors}" SelectedItem="{Binding NetworkBehavior}" DisplayMemberPath="Text" MinWidth="300"
                                                  AutomationProperties.Name="Network" AutomationProperties.AutomationId="cboNetwork" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8" Visibility="{Binding ShowRerun, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Rerun behavior" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding RerunBehaviors}" SelectedItem="{Binding RerunBehavior}" DisplayMemberPath="Text" MinWidth="280"
                                                  AutomationProperties.Name="Rerun behavior" AutomationProperties.AutomationId="cboRerun" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.AutomationId="pnlDistribution">
                            <StackPanel>
                                <TextBlock Text="Content" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Select an object to see the content status of each distribution point group. Check the groups that get the content."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <DataGrid x:Name="dgDpGroups" Style="{StaticResource GridBase}" ItemsSource="{Binding DpGroups}" MaxHeight="220" MinHeight="96"
                                          AutomationProperties.AutomationId="dgDpGroups" AutomationProperties.Name="Distribution point groups">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="44" MinWidth="44">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0"
                                                              AutomationProperties.Name="{Binding Name}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Group" Binding="{Binding Name}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Targeted" Binding="{Binding Targeted}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Success" Binding="{Binding Success}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="In progress" Binding="{Binding InProgress}" Width="110" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="80" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,8,0,0">
                                    <ui:Button Content="Refresh status" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshDpGroupsCommand}" Style="{StaticResource ToolButton}"
                                               ToolTip="Reads the content status of the selected object again." AutomationProperties.AutomationId="btnRefreshDpGroups" />
                                    <ui:Button Content="Distribute content" Icon="{ui:SymbolIcon CloudArrowUp24}" Command="{Binding DistributeCommand}" Style="{StaticResource ToolButton}"
                                               ToolTip="Shows a plan that sends the content to the checked groups." AutomationProperties.AutomationId="btnDistribute" />
                                    <CheckBox Content="Distribute to the checked groups first when I deploy" IsChecked="{Binding DistributeFirst}" Style="{StaticResource Option}"
                                              AutomationProperties.AutomationId="chkDistributeFirst" />
                                    <CheckBox Content="Create the deployment now, while the content still distributes" IsChecked="{Binding CreateNowContentDistributing}"
                                              IsEnabled="{Binding CanChooseCreateNow}" Style="{StaticResource Option}" AutomationProperties.AutomationId="chkCreateNow" />
                                </WrapPanel>
                                <TextBlock Text="{Binding DpMessage}" Style="{StaticResource Note}" AutomationProperties.AutomationId="txtDpMessage" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.AutomationId="pnlValidation">
                            <StackPanel>
                                <TextBlock Text="Checks" Style="{StaticResource CardTitle}" />
                                <DataGrid x:Name="dgChecks" Style="{StaticResource GridBase}" ItemsSource="{Binding Checks}" MinHeight="96"
                                          AutomationProperties.AutomationId="dgChecks" AutomationProperties.Name="Checks">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Note}" Margin="0,8,0,0" AutomationProperties.AutomationId="txtValidationMessage"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding FormMessage}" Style="{StaticResource Warning}" Margin="0,8,0,0" Visibility="{Binding HasFormMessage, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.AutomationId="txtFormMessage" AutomationProperties.LiveSetting="Assertive" />
                                <WrapPanel Margin="0,12,0,0">
                                    <ui:Button Content="Validate" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding ValidateCommand}" Style="{StaticResource ToolButton}"
                                               ToolTip="Runs the five checks and the schedule rules. Nothing is changed." AutomationProperties.AutomationId="btnValidate" />
                                    <ui:Button Content="Deploy" Appearance="Primary" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding DeployCommand}" Style="{StaticResource ToolButton}"
                                               ToolTip="Shows the plan of the deployment. Nothing is changed before you confirm it." AutomationProperties.AutomationId="btnDeploy" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History" AutomationProperties.AutomationId="tabHistory" DataContext="{Binding History}">
                <ScrollViewer x:Name="scrollHistoryTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollHistoryTab">
                    <Grid Height="{Binding ViewportHeight, ElementName=scrollHistoryTab}" MinHeight="480">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                            <ui:TextBox Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by object, collection, deployment ID or user"
                                        Icon="{ui:SymbolIcon Search24}" MinWidth="300" Margin="0,0,8,8" AutomationProperties.Name="History filter" AutomationProperties.AutomationId="txtHistoryFilter" />
                            <ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding EventFilter}" MinWidth="120" Margin="0,0,8,8"
                                      AutomationProperties.Name="Event" AutomationProperties.AutomationId="cboHistoryEvent" />
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding TypeFilter}" MinWidth="170" Margin="0,0,8,8"
                                      AutomationProperties.Name="Object type" AutomationProperties.AutomationId="cboHistoryType" />
                            <TextBlock Text="{Binding RowCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtHistoryCount" />
                        </WrapPanel>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                            <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}"
                                       AutomationProperties.AutomationId="btnHistoryRefresh" />
                            <ui:Button Content="Remove deployment" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveDeploymentCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Shows a plan that removes the deployment of the selected create record." AutomationProperties.AutomationId="btnRemoveDeployment" />
                            <ui:Button Content="Export CSV" Icon="{ui:SymbolIcon DocumentTable24}" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Saves the rows the filters show as a CSV file." AutomationProperties.AutomationId="btnHistoryCsv" />
                            <ui:Button Content="Export HTML" Icon="{ui:SymbolIcon Document24}" Command="{Binding ExportHtmlCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Saves the rows the filters show as an HTML file." AutomationProperties.AutomationId="btnHistoryHtml" />
                            <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenReportsFolderCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Opens the folder of the last report." AutomationProperties.AutomationId="btnHistoryFolder" />
                        </WrapPanel>
                        <TextBlock Grid.Row="2" Style="{StaticResource Note}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtHistoryPath">
                            <Run Text="Audit log:" />
                            <Run Text="{Binding LogPath, Mode=OneWay}" />
                        </TextBlock>
                        <DataGrid Grid.Row="3" x:Name="dgHistory" Style="{StaticResource GridBase}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" MinHeight="160"
                                  AutomationProperties.AutomationId="dgHistory" AutomationProperties.Name="Audit records">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="130" MinWidth="130" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="84" MinWidth="84" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Object" Binding="{Binding Object}" Width="2*" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Collection" Binding="{Binding Collection}" Width="2*" MinWidth="110" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="130" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Deployment ID" Binding="{Binding DeploymentId}" Width="*" MinWidth="130" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Options" AutomationProperties.AutomationId="tabOptions" DataContext="{Binding Options}">
                <ScrollViewer x:Name="scrollOptionsTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollOptionsTab">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.AutomationId="pnlAuditLog">
                            <StackPanel>
                                <TextBlock Text="Audit log" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Every create, distribution and removal writes one record. A deployment is created only when the audit log can be written. Leave the path empty for the default under the data root; a share path is allowed."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding AuditLogPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Default under the data root"
                                                AutomationProperties.Name="Audit log path" AutomationProperties.AutomationId="txtAuditLogPath" />
                                    <ui:Button Grid.Column="1" Content="Save path" Icon="{ui:SymbolIcon Save24}" Command="{Binding SavePathCommand}" Margin="8,0,0,0"
                                               AutomationProperties.AutomationId="btnSaveAuditPath" />
                                    <ui:Button Grid.Column="2" Content="Check" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding CheckLogCommand}" Margin="8,0,0,0"
                                               ToolTip="Checks that the audit log can be written now." AutomationProperties.AutomationId="btnCheckAuditLog" />
                                </Grid>
                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="txtAuditLogInUse">
                                    <Run Text="In use:" />
                                    <Run Text="{Binding AuditLogInUse, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ProbeText}" Style="{StaticResource Warning}" Margin="0,4,0,0" AutomationProperties.AutomationId="txtAuditProbe"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.AutomationId="pnlTemplates">
                            <StackPanel>
                                <TextBlock Text="Templates" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="A template keeps the purpose, notification, time basis, options and deadline offset. It keeps no object or collection. Shipped templates cannot be changed."
                                           Style="{StaticResource Note}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <ui:Button Content="New" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewTemplateCommand}" Style="{StaticResource ToolButton}"
                                               AutomationProperties.Name="New template" AutomationProperties.AutomationId="btnNewTemplate" />
                                    <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit24}" Command="{Binding EditTemplateCommand}" Style="{StaticResource ToolButton}"
                                               AutomationProperties.Name="Edit template" AutomationProperties.AutomationId="btnEditTemplate" />
                                    <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteTemplateCommand}" Style="{StaticResource ToolButton}"
                                               AutomationProperties.Name="Delete template" AutomationProperties.AutomationId="btnDeleteTemplate" />
                                    <TextBlock Text="{Binding TemplateMessage}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="520"
                                               AutomationProperties.AutomationId="txtOptionsTemplateMessage" />
                                </WrapPanel>
                                <DataGrid x:Name="dgTemplates" Style="{StaticResource GridBase}" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MinHeight="120" MaxHeight="280"
                                          AutomationProperties.AutomationId="dgTemplates" AutomationProperties.Name="Templates">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Notification" Binding="{Binding Notification}" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="150" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlConnection">
                            <StackPanel>
                                <TextBlock Text="Connection" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Note}" AutomationProperties.AutomationId="txtConnection" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" x:Name="pnlDeploymentResults" Margin="0,12,0,0" Style="{StaticResource Card}" Visibility="{Binding Shared.HasResults, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="pnlDeploymentResults">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Content="Undo last change" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding Shared.UndoLastCommand}"
                               AutomationProperties.AutomationId="btnDeploymentUndo" ToolTip="Shows a plan that removes the deployments of the last change."
                               Visibility="{Binding Shared.HasUndo, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox DockPanel.Dock="Right" Content="Rows" IsChecked="{Binding Shared.ShowResultRows}" Margin="12,0,12,0" VerticalAlignment="Center"
                              ToolTip="Show or hide the result of each change under the summary." AutomationProperties.AutomationId="chkDeploymentResultRows" />
                    <TextBlock Text="{Binding Shared.ResultSummary}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtDeploymentResultSummary" />
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="dgDeploymentResults" Style="{StaticResource GridBase}" ItemsSource="{Binding Shared.LastResults}" MaxHeight="140"
                          Visibility="{Binding Shared.ShowResultRows, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.AutomationId="dgDeploymentResults" AutomationProperties.Name="Results">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Result" Binding="{Binding OutcomeText}" Width="90" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Item.Action}" Width="170" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                        <DataGridTextColumn Header="Object" Binding="{Binding Item.Target}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                             Visibility="{Binding CurrentTab.IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Shared.StatusMessage}" Style="{StaticResource Note}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="txtDeploymentStatus" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Page>
