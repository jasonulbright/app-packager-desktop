<Page
    x:Class="ApplicationPackagerUI.Views.Pages.SiteHygienePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:ApplicationPackagerUI.Controls"
    xmlns:helpers="clr-namespace:ApplicationPackagerUI.Helpers"
    xmlns:pages="clr-namespace:ApplicationPackagerUI.ViewModels.Pages"
    xmlns:local="clr-namespace:ApplicationPackagerUI.Views.Pages"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/SelectableRows.xaml" />
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/DetailBox.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Note}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- A detail line shows at most three lines; the tooltip holds the whole text. -->
            <Style x:Key="DetailLine" TargetType="TextBlock" BasedOn="{StaticResource Note}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="MaxHeight" Value="48" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <Style x:Key="Caution" TargetType="Border">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <!-- The library template animates the open and close, so the card height depends on time; this template opens and closes at once
                 and keeps the closed card to one header line. -->
            <Style x:Key="ResultCard" TargetType="Expander">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border BorderThickness="1" CornerRadius="6" Padding="12,4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <DockPanel>
                                    <ToggleButton x:Name="ResultCardToggle" DockPanel.Dock="Top" MinHeight="32" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Content="{TemplateBinding Header}" ToolTip="Shows or hides the result rows of the last fix."
                                                  AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" AutomationProperties.AutomationId="btnHygieneResultsToggle">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="0,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                        <ui:SymbolIcon x:Name="Chevron" Grid.Column="1" Symbol="ChevronDown24" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="Symbol" Value="ChevronUp24" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ResultCardBody" Margin="0,2,0,0" Visibility="Collapsed" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ResultCardBody" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="TabHeaderTemplate">
                <StackPanel>
                    <TextBlock x:Name="TabHeaderText" Text="{Binding}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border x:Name="TabHeaderUnderline" Height="3" CornerRadius="1.5" Margin="0,4,0,0" Background="Transparent" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                        <Setter TargetName="TabHeaderText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter TargetName="TabHeaderText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="TabHeaderUnderline" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="HeaderTemplate" Value="{StaticResource TabHeaderTemplate}" />
            </Style>

            <Style x:Key="TrimmedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style x:Key="StatusCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static helpers:OutcomeBrushConverter.Instance}}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WrappedCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>

            <!-- The cells of a row form a Local Tab group, so only the first cell is a Tab stop: Tab enters the grid once and the next Tab leaves it. -->
            <Style x:Key="TabStopCell" TargetType="DataGridCell" BasedOn="{StaticResource FocusableCell}">
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="0">
                        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GridBase" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="CanUserResizeColumns" Value="True" />
                <Setter Property="CanUserSortColumns" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="EnableColumnVirtualization" Value="False" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="helpers:DataGridColumnSizing.FixStarWidthsOnResize" Value="True" />
                <Setter Property="helpers:DataGridRightClick.SelectsRow" Value="True" />
                <Setter Property="RowStyle" Value="{StaticResource SelectableRow}" />
                <Setter Property="CellStyle" Value="{StaticResource TabStopCell}" />
                <Setter Property="helpers:DataGridKeyboard.SelectsFocusedRow" Value="True" />
                <!-- One Tab stop per grid: the arrow keys move inside it, so the next Tab reaches the control after it. -->
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="pageRoot" Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader x:Name="pageHeader" Grid.Row="0" Margin="0,0,0,8" Title="Site Hygiene" TitleAutomationId="txtHygieneTitle" DescriptionAutomationId="txtHygieneIntro"
                             Description="Scans the site for unused, broken and misconfigured objects and fixes a finding with a typed change. Every fix checks the finding again and shows a plan first. A delete cannot be undone." />

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Caution}" Visibility="{Binding HasConnectionMessage, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="pnlHygieneConnection">
                <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           AutomationProperties.AutomationId="txtHygieneConnection" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <!-- One line on every tab while an alert is not seen; the alert list on the Live tab holds every alert. -->
            <Border x:Name="pnlHygieneAlertBanner" Style="{StaticResource Caution}" Padding="12,4" Visibility="{Binding HasAlertBanner, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="pnlHygieneAlertBanner">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Mark as seen" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding MarkAlertsSeenCommand}" Margin="8,0,0,0"
                               ToolTip="Marks every alert as seen. The alerts stay in the list and in the alerts log." AutomationProperties.AutomationId="btnAlertBannerSeen" />
                    <ui:Button DockPanel.Dock="Right" Content="Show alerts" Icon="{ui:SymbolIcon Alert24}" Command="{Binding ShowAlertsCommand}" Margin="8,0,0,0"
                               ToolTip="Opens the alert list on the Live tab." AutomationProperties.AutomationId="btnAlertBannerShow" />
                    <TextBlock x:Name="txtAlertBanner" Text="{Binding AlertBannerText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding AlertBannerText}" AutomationProperties.Name="{Binding AlertBannerText}"
                               AutomationProperties.AutomationId="txtAlertBanner" AutomationProperties.LiveSetting="Assertive" />
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <WrapPanel>
                <ui:Button Content="Scan" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding ScanCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Reads the objects of the selected areas and runs every check of those areas." AutomationProperties.Name="Scan the site"
                           AutomationProperties.AutomationId="btnHygieneScan" />
                <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelScanCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Stops the scan after the current step. The earlier result stays." AutomationProperties.Name="Cancel the scan" AutomationProperties.AutomationId="btnHygieneCancel" />
                <ui:Button Content="Export CSV" Icon="{ui:SymbolIcon DocumentTable24}" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Saves the rows the filters of the active tab show as a CSV file." AutomationProperties.AutomationId="btnHygieneCsv" />
                <ui:Button Content="Export HTML" Icon="{ui:SymbolIcon Document24}" Command="{Binding ExportHtmlCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Saves the rows the filters of the active tab show as an HTML file." AutomationProperties.AutomationId="btnHygieneHtml" />
                <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenReportsFolderCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Opens the report folder." AutomationProperties.AutomationId="btnHygieneFolder" />
            </WrapPanel>
            <DockPanel>
                <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ScanProgress}" Style="{StaticResource Note}" Margin="0,0,0,4" DockPanel.Dock="Top"
                           Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="txtHygieneProgress" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding AreasText}" Style="{StaticResource Note}" Margin="0,0,0,2" DockPanel.Dock="Top" AutomationProperties.AutomationId="txtHygieneAreas" />
                <Grid>
                    <!-- The Live tab shows the summary of the last refresh in place of the scan summary. -->
                    <TextBlock x:Name="txtHygieneSummary" Text="{Binding SummaryLine}" Style="{StaticResource Warning}" AutomationProperties.AutomationId="txtHygieneSummary"
                               Visibility="{Binding IsNotLiveTab, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="txtHygieneLiveSummary" Text="{Binding LiveSummaryLine}" Style="{StaticResource Warning}" AutomationProperties.AutomationId="txtHygieneLiveSummary"
                               Visibility="{Binding IsLiveTab, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </DockPanel>
        </StackPanel>

        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}" AutomationProperties.AutomationId="tabHygiene">
            <TabItem Header="Findings" AutomationProperties.AutomationId="tabHygieneFindings">
                <ScrollViewer x:Name="scrollFindingsTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollFindingsTab">
                    <!-- The view sets MinHeight to the rows above and below the grid and the grid at its MinHeight; below it the tab scrolls instead of cutting the detail. -->
                    <Grid x:Name="gridFindingsTab" Height="{Binding ViewportHeight, ElementName=scrollFindingsTab}" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="{x:Static local:SiteHygienePage.FindingsGridMinHeight}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" x:Name="pnlFindingFilter" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0">
                            <ui:TextBox x:Name="txtFindingFilter" Text="{Binding FindingText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by check, object, evidence or action" Icon="{ui:SymbolIcon Search24}"
                                        MinWidth="300" Margin="0,0,8,8" AutomationProperties.Name="Finding filter" AutomationProperties.AutomationId="txtFindingFilter" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" MinWidth="190" Margin="0,0,8,8"
                                      AutomationProperties.Name="Category" AutomationProperties.AutomationId="cboFindingCategory" />
                            <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding SeverityFilter}" MinWidth="130" Margin="0,0,8,8"
                                      AutomationProperties.Name="Severity" AutomationProperties.AutomationId="cboFindingSeverity" />
                            <CheckBox Content="Show suppressed" IsChecked="{Binding ShowSuppressed}" Margin="0,0,12,8" VerticalAlignment="Center"
                                      ToolTip="Shows the suppressed findings in the list as well." AutomationProperties.AutomationId="chkShowSuppressed" />
                            <TextBlock Text="{Binding FindingCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtFindingCount" />
                        </WrapPanel>
                        <!-- The actions come after the grid in Tab order, so they are next to the findings the operator picked. -->
                        <WrapPanel Grid.Row="1" x:Name="pnlFindingActions" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2">
                            <ui:Button x:Name="btnHygieneRunFix" Content="Run fix" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding RunFixCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Checks the selected findings again on the site, then shows the plan of their fix." AutomationProperties.AutomationId="btnHygieneRunFix" />
                            <ui:Button Content="Suppress" Icon="{ui:SymbolIcon EyeOff24}" Command="{Binding SuppressCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Hides the selected findings with a comment. A suppression is kept by check and object." AutomationProperties.AutomationId="btnHygieneSuppress" />
                            <ui:Button Content="Unsuppress" Icon="{ui:SymbolIcon Eye24}" Command="{Binding UnsuppressCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Removes the suppression of the selected findings." AutomationProperties.AutomationId="btnHygieneUnsuppress" />
                            <TextBlock Text="Select several rows with Shift or Ctrl." Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,12,8" />
                            <TextBlock Text="{Binding RunFixHint}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="720"
                                       Visibility="{Binding HasRunFixHint, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.AutomationId="txtRunFixHint" AutomationProperties.LiveSetting="Polite" />
                        </WrapPanel>
                        <DataGrid Grid.Row="2" x:Name="dgFindings" KeyboardNavigation.TabIndex="1" Tag="findings" Style="{StaticResource GridBase}" ItemsSource="{Binding FindingRows}"
                                  SelectionMode="Extended" SelectionChanged="OnFindingsSelectionChanged" AutomationProperties.AutomationId="dgFindings" AutomationProperties.Name="Findings">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" SortMemberPath="Severity" Width="112" MinWidth="104" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Check" Binding="{Binding CheckId}" SortMemberPath="CheckId" Width="84" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" SortMemberPath="Category" Width="156" MinWidth="150" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" SortMemberPath="ObjectName" Width="2*" MinWidth="120" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" SortMemberPath="Evidence" Width="3*" MinWidth="120" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" SortMemberPath="Recommendation" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="New" Binding="{Binding New}" SortMemberPath="New" Width="64" MinWidth="60" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Suppressed" Binding="{Binding Suppressed}" SortMemberPath="Suppressed" Width="104" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Fix" Binding="{Binding Fix}" SortMemberPath="Fix" Width="216" MinWidth="212" ElementStyle="{StaticResource TrimmedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="3" x:Name="pnlFindingDetail" Style="{StaticResource Card}" Margin="0,6,0,0" Padding="12,6" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="3"
                                AutomationProperties.AutomationId="pnlFindingDetail">
                            <StackPanel>
                                <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource Warning}" FontSize="13" AutomationProperties.AutomationId="txtFindingDetailTitle"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding DetailObject}" Style="{StaticResource DetailLine}" AutomationProperties.AutomationId="txtFindingDetailObject"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding DetailEvidence}" Style="{StaticResource DetailLine}" AutomationProperties.AutomationId="txtFindingDetailEvidence"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding DetailRecommendation}" Style="{StaticResource DetailLine}" AutomationProperties.AutomationId="txtFindingDetailRecommendation"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding DetailFixNote}" Style="{StaticResource DetailLine}" AutomationProperties.AutomationId="txtFindingDetailFixNote"
                                           Visibility="{Binding HasDetailFixNote, Converter={StaticResource BoolToVisibility}}" />
                                <DockPanel Margin="0,6,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                                    <ui:Button DockPanel.Dock="Right" Content="Copy" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyFixTextCommand}" Margin="8,0,0,0" VerticalAlignment="Top"
                                               ToolTip="Copies the PowerShell text of the fix. The page runs the typed fix, not this text." AutomationProperties.Name="Copy the PowerShell text of the fix"
                                               AutomationProperties.AutomationId="btnCopyFixText" />
                                    <!-- The view sets MaxHeight to the whole lines that fit without a scroll of the tab, from MinFixLines to FixLines. -->
                                    <TextBox x:Name="txtFixText" Text="{Binding DetailFixText, Mode=OneWay}" Style="{StaticResource DetailBox}" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                                             AutomationProperties.Name="PowerShell text of the fix, read only" AutomationProperties.AutomationId="txtFixText" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="4" x:Name="txtNotRun" Text="{Binding NotRunText}" Style="{StaticResource Warning}" Margin="0,4,0,0" MaxHeight="48" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NotRunText}" Visibility="{Binding HasNotRun, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtNotRun" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Relationships" AutomationProperties.AutomationId="tabHygieneRelations">
                <ScrollViewer x:Name="scrollRelationsTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollRelationsTab">
                    <Grid x:Name="gridRelationsTab" Height="{Binding ViewportHeight, ElementName=scrollRelationsTab}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="{x:Static local:SiteHygienePage.RelationsGridMinHeight}" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" x:Name="pnlRelationsActions" Margin="0,0,0,4">
                            <ui:Button Content="Read relationships" Icon="{ui:SymbolIcon BranchFork24}" Command="{Binding LoadRelationsCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads every supersedence and dependency relationship of the applications." AutomationProperties.AutomationId="btnReadRelations" />
                            <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelRelationsCommand}" Style="{StaticResource ToolButton}"
                                       AutomationProperties.Name="Cancel the read of the relationships" AutomationProperties.AutomationId="btnCancelRelations" />
                            <TextBlock Text="{Binding RelationsSummary}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtRelationsSummary" />
                        </WrapPanel>
                        <TabControl Grid.Row="1" SelectedIndex="{Binding RelationsTabIndex}" AutomationProperties.AutomationId="tabRelations">
                            <TabItem Header="Inventory" AutomationProperties.AutomationId="tabRelationsInventory">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                                        <ui:TextBox Text="{Binding EdgeText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by application, key or health" Icon="{ui:SymbolIcon Search24}"
                                                    MinWidth="280" Margin="0,0,8,8" AutomationProperties.Name="Relationship filter" AutomationProperties.AutomationId="txtEdgeFilter" />
                                        <ComboBox ItemsSource="{Binding EdgeKinds}" SelectedItem="{Binding EdgeKind}" MinWidth="150" Margin="0,0,8,8"
                                                  AutomationProperties.Name="Relationship kind" AutomationProperties.AutomationId="cboEdgeKind" />
                                        <TextBlock Text="{Binding EdgeCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtEdgeCount" />
                                    </WrapPanel>
                                    <DataGrid Grid.Row="1" x:Name="dgEdges" Tag="edges" Style="{StaticResource GridBase}" ItemsSource="{Binding EdgeRows}" SelectedItem="{Binding SelectedEdge}"
                                              AutomationProperties.AutomationId="dgEdges" AutomationProperties.Name="Relationships">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" SortMemberPath="Kind" Width="124" MinWidth="120" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="From" Binding="{Binding From}" SortMemberPath="From" Width="3*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="To" Binding="{Binding To}" SortMemberPath="To" Width="3*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                            <DataGridTextColumn Header="Health" Binding="{Binding Health}" SortMemberPath="Health" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Tree" AutomationProperties.AutomationId="tabRelationsTree">
                                <TreeView x:Name="treeRelations" Margin="0,8,0,0" ItemsSource="{Binding TreeRoots}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="treeRelations" AutomationProperties.Name="Relationship chains">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type pages:RelationTreeNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Live" AutomationProperties.AutomationId="tabHygieneLive">
                <ScrollViewer x:Name="scrollLiveTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollLiveTab">
                    <!-- The view sets MinHeight to the rows above the view and the view at its MinHeight; below it the tab scrolls instead of cutting the view. -->
                    <Grid x:Name="gridLiveTab" Height="{Binding ViewportHeight, ElementName=scrollLiveTab}" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="rowLiveView" Height="*" MinHeight="{x:Static local:SiteHygienePage.LiveViewMinHeight}" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" x:Name="pnlLiveActions" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0">
                            <ui:Button x:Name="btnLiveRefresh" Content="Refresh all" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Command="{Binding RefreshAllCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads every Live view from the site and the site database. The Live views change nothing on the site."
                                       AutomationProperties.Name="Refresh every Live view" AutomationProperties.AutomationId="btnLiveRefresh" />
                            <ui:Button Content="Cancel refresh" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelRefreshCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Stops the refresh. The earlier result stays." AutomationProperties.AutomationId="btnLiveCancel" />
                            <ui:Button Content="{Binding PauseText}" Icon="{ui:SymbolIcon Pause24}" Command="{Binding PauseAutoRefreshCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Pauses or resumes the auto-refresh. The interval is on the Options tab." AutomationProperties.AutomationId="btnLivePause" />
                            <ui:Button Content="Copy summary" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyLiveSummaryCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Copies the counts of the last refresh as plain text." AutomationProperties.AutomationId="btnLiveCopySummary" />
                            <ui:Button Content="Alerts log" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenAlertsLogCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Opens the alerts log file." AutomationProperties.Name="Open the alerts log" AutomationProperties.AutomationId="btnLiveAlertsLog" />
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,8" VerticalAlignment="Center"
                                             Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding RefreshProgress}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,12,8" MaxWidth="420"
                                       Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.AutomationId="txtLiveProgress" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding AutoRefreshText}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="560"
                                       AutomationProperties.AutomationId="txtAutoRefresh" AutomationProperties.LiveSetting="Polite" />
                        </WrapPanel>
                        <WrapPanel Grid.Row="1" x:Name="pnlLiveFilter" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
                            <ComboBox x:Name="cboLiveView" ItemsSource="{Binding LiveViews}" SelectedItem="{Binding SelectedLiveView}" MinWidth="200" Margin="0,0,8,8"
                                      AutomationProperties.Name="Live view" AutomationProperties.AutomationId="cboLiveView" />
                            <ComboBox ItemsSource="{Binding LiveStatusChoices}" SelectedItem="{Binding LiveStatusFilter}" MinWidth="130" Margin="0,0,8,8"
                                      Visibility="{Binding IsGridPane, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="Status" AutomationProperties.AutomationId="cboLiveStatus" />
                            <ui:TextBox Text="{Binding LiveFilterText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter the rows by any text" Icon="{ui:SymbolIcon Search24}"
                                        MinWidth="280" Margin="0,0,8,8" Visibility="{Binding IsGridPane, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Live filter" AutomationProperties.AutomationId="txtLiveFilter" />
                            <ComboBox ItemsSource="{Binding TrendMetrics}" SelectedItem="{Binding SelectedTrendMetric}" MinWidth="300" Margin="0,0,8,8"
                                      Visibility="{Binding IsTrendsPane, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="Metric" AutomationProperties.AutomationId="cboTrendMetric" />
                            <ComboBox ItemsSource="{Binding TrendDayChoices}" SelectedItem="{Binding TrendDays}" ItemStringFormat="Last {0} days" MinWidth="150" Margin="0,0,8,8"
                                      Visibility="{Binding IsTrendsPane, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="Period" AutomationProperties.AutomationId="cboTrendDays" />
                            <ui:Button Content="Mark as seen" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding MarkAlertsSeenCommand}" Style="{StaticResource ToolButton}"
                                       Visibility="{Binding IsAlertsPane, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Mark every alert as seen"
                                       AutomationProperties.AutomationId="btnAlertsSeen" />
                            <TextBlock Text="{Binding LiveRowCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8"
                                       Visibility="{Binding IsNotTrendsPane, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="txtLiveCount" />
                        </WrapPanel>
                        <StackPanel Grid.Row="2" x:Name="pnlLiveMessages" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2">
                            <Border Style="{StaticResource Caution}" Padding="12,4" Visibility="{Binding HasImportOffer, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.AutomationId="pnlImportOffer">
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Not now" Command="{Binding DismissImportOfferCommand}" Margin="8,0,0,0"
                                               ToolTip="Hides the offer. The import stays on the Options tab." AutomationProperties.AutomationId="btnImportNotNow" />
                                    <ui:Button DockPanel.Dock="Right" Content="Import" Command="{Binding ImportDashboardCommand}" Margin="8,0,0,0"
                                               ToolTip="Shows what the import copies; nothing is copied before you confirm." AutomationProperties.Name="Import from the Health Dashboard"
                                               AutomationProperties.AutomationId="btnImportOffer" />
                                    <TextBlock Text="{Binding ImportOffer}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               AutomationProperties.AutomationId="txtImportOffer" />
                                </DockPanel>
                            </Border>
                            <TextBlock x:Name="txtLiveViewMessage" Text="{Binding LiveViewMessage}" Style="{StaticResource Warning}" Margin="0,0,0,6" MaxHeight="48" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LiveViewMessage}" Visibility="{Binding ShowsLiveViewMessage, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.AutomationId="txtLiveViewMessage" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <Grid Grid.Row="3" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="3">
                            <DataGrid x:Name="dgLive" Style="{StaticResource GridBase}" ItemsSource="{Binding LiveViewRows}" SelectedItem="{Binding SelectedLiveRow}"
                                      Visibility="{Binding IsGridPane, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.AutomationId="dgLive" AutomationProperties.Name="{Binding SelectedLiveView.Title}" />
                            <Grid x:Name="pnlTrends" Visibility="{Binding IsTrendsPane, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="pnlTrends">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3*" MinHeight="{x:Static local:SiteHygienePage.TrendChartMinHeight}" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="rowTrendTable" Height="2*" MinHeight="{x:Static local:SiteHygienePage.TrendTableMinHeight}" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
                                    <helpers:TrendChart x:Name="chartTrend" Points="{Binding TrendRows}" SelectedIndex="{Binding TrendSelectedIndex}" Readout="{Binding TrendReadout}"
                                                        AutomationProperties.Name="{Binding SelectedTrendMetric.Title}" AutomationProperties.HelpText="{Binding TrendReadout}"
                                                        AutomationProperties.AutomationId="chartTrend" ToolTip="{Binding TrendReadout}" />
                                </Border>
                                <StackPanel Grid.Row="1" x:Name="pnlTrendText" Margin="0,6,0,6">
                                    <TextBlock Text="{Binding TrendReadout}" Style="{StaticResource Warning}" AutomationProperties.AutomationId="txtTrendReadout" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{Binding TrendNote}" Style="{StaticResource Note}" AutomationProperties.AutomationId="txtTrendNote" />
                                </StackPanel>
                                <DataGrid Grid.Row="2" x:Name="dgTrend" Style="{StaticResource GridBase}" CanUserSortColumns="False" ItemsSource="{Binding TrendRows}" SelectedItem="{Binding SelectedTrendRow}"
                                          AutomationProperties.AutomationId="dgTrend" AutomationProperties.Name="The points of the chart">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="176" MinWidth="172" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="132" MinWidth="128" ElementStyle="{StaticResource TrimmedCell}" />
                                        <DataGridTextColumn Header="Note" Binding="{Binding Gap}" Width="*" MinWidth="200" ElementStyle="{StaticResource TrimmedCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <DataGrid x:Name="dgAlerts" Style="{StaticResource GridBase}" CanUserSortColumns="False" ItemsSource="{Binding AlertRows}" SelectedItem="{Binding SelectedAlert}"
                                      Visibility="{Binding IsAlertsPane, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.AutomationId="dgAlerts" AutomationProperties.Name="Alerts">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="96" MinWidth="92" ElementStyle="{StaticResource StatusCell}" />
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="176" MinWidth="172" ElementStyle="{StaticResource TrimmedCell}" />
                                    <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="300" MinWidth="296" ElementStyle="{StaticResource TrimmedCell}" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="200" ElementStyle="{StaticResource WrappedCell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Summary" AutomationProperties.AutomationId="tabHygieneSummary">
                <ScrollViewer x:Name="scrollSummaryTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollSummaryTab">
                    <Grid Height="{Binding ViewportHeight, ElementName=scrollSummaryTab}" MinHeight="420">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="160" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Findings by category and severity" Style="{StaticResource CardTitle}" />
                        <DataGrid Grid.Row="1" x:Name="dgCategories" Style="{StaticResource GridBase}" CanUserSortColumns="False" ItemsSource="{Binding CategoryRows}"
                                  AutomationProperties.AutomationId="dgCategories" AutomationProperties.Name="Findings by category and severity">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="132" MinWidth="128" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Warning" Binding="{Binding Warning}" Width="132" MinWidth="128" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="132" MinWidth="128" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="132" MinWidth="128" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Checks not run" Binding="{Binding NotRun}" Width="140" MinWidth="136" ElementStyle="{StaticResource TrimmedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Checks" Style="{StaticResource CardTitle}" Margin="0,12,0,8" />
                        <!-- Layout rounding of the two star rows can give them one pixel more than the tab; the margin keeps the bottom border of the grid inside the tab. -->
                        <DataGrid Grid.Row="3" x:Name="dgChecks" Tag="checks" Style="{StaticResource GridBase}" ItemsSource="{Binding CheckRows}" Margin="0,0,0,1"
                                  AutomationProperties.AutomationId="dgChecks" AutomationProperties.Name="Checks">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Check" Binding="{Binding CheckId}" SortMemberPath="CheckId" Width="84" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="3*" MinWidth="180" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" SortMemberPath="Category" Width="156" MinWidth="150" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" SortMemberPath="State" Width="196" MinWidth="190" ElementStyle="{StaticResource StatusCell}" />
                                <DataGridTextColumn Header="Findings" Binding="{Binding Findings}" SortMemberPath="Findings" Width="104" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" SortMemberPath="Reason" Width="2*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History" AutomationProperties.AutomationId="tabHygieneHistory">
                <ScrollViewer x:Name="scrollHistoryTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollHygieneHistoryTab">
                    <!-- The view sets MinHeight to the intro, the filter row, the detail box and the grid at its MinHeight; below it the tab scrolls instead of cutting the detail box. -->
                    <Grid x:Name="gridHistoryTab" Height="{Binding ViewportHeight, ElementName=scrollHistoryTab}" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="{x:Static local:SiteHygienePage.HistoryGridMinHeight}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="txtHygieneHistoryIntro" Style="{StaticResource Note}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtHygieneHistoryIntro"
                                   Text="The audit log of the fixes of this page, newest first. The list reads the file on this computer only; it reads nothing from the site. A record the hash chain does not verify was changed or added outside the page." />
                        <WrapPanel Grid.Row="1" x:Name="pnlHygieneHistoryFilter" Margin="0,0,0,4" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="0">
                            <ui:TextBox Text="{Binding HistoryText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by action, result, user, site or object" Icon="{ui:SymbolIcon Search24}"
                                        MinWidth="300" Margin="0,0,8,8" AutomationProperties.Name="History filter" AutomationProperties.AutomationId="txtHygieneHistoryFilter" />
                            <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Reads the audit log file again." AutomationProperties.Name="Read the audit log again" AutomationProperties.AutomationId="btnHygieneHistoryRefresh" />
                            <TextBlock Text="{Binding HistoryCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,12,8" AutomationProperties.AutomationId="txtHygieneHistoryCount" />
                            <TextBlock Text="{Binding HistoryCapText}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="560"
                                       AutomationProperties.AutomationId="txtHygieneHistoryCap" />
                        </WrapPanel>
                        <DataGrid Grid.Row="2" x:Name="dgHygieneHistory" KeyboardNavigation.TabIndex="1" Tag="history" Style="{StaticResource GridBase}" ItemsSource="{Binding HistoryRows}"
                                  SelectedItem="{Binding SelectedHistory}" AutomationProperties.AutomationId="dgHygieneHistory" AutomationProperties.Name="Audit log records">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" SortMemberPath="Time" Width="176" MinWidth="172" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" SortMemberPath="Action" Width="216" MinWidth="212" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" SortMemberPath="Result" Width="104" MinWidth="100" ElementStyle="{StaticResource StatusCell}" />
                                <DataGridTextColumn Header="Objects" Binding="{Binding Objects}" SortMemberPath="Objects" Width="2*" MinWidth="120" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Site" Binding="{Binding Site}" SortMemberPath="Site" Width="64" MinWidth="60" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" SortMemberPath="Provider" Width="*" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="User" Binding="{Binding User}" SortMemberPath="User" Width="*" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                                <DataGridTextColumn Header="Verified" Binding="{Binding Verified}" SortMemberPath="Verified" Width="136" MinWidth="132" ElementStyle="{StaticResource StatusCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="3" x:Name="pnlHygieneHistoryDetail" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,8" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2"
                                Visibility="{Binding HasHistoryDetails, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="pnlHygieneHistoryDetail">
                            <TextBox Text="{Binding HistoryDetails, Mode=OneWay}" Style="{StaticResource DetailBox}" MaxLines="{x:Static pages:HygieneHistoryRow.DetailLines}"
                                     AutomationProperties.Name="The selected audit record, read only" AutomationProperties.AutomationId="txtHygieneHistoryDetail" />
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Options" AutomationProperties.AutomationId="tabHygieneOptions">
                <ScrollViewer x:Name="scrollOptionsTab" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="scrollOptionsTab">
                    <StackPanel>
                        <TextBlock Text="Scan areas" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="The scan reads the objects of the checked areas and runs the checks of those areas. Only a scan of every area becomes the last scan that the New column compares with."
                                   Style="{StaticResource Note}" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,4">
                            <ui:Button Content="Select all" Command="{Binding SelectAllAreasCommand}" Style="{StaticResource ToolButton}" AutomationProperties.Name="Select every scan area"
                                       AutomationProperties.AutomationId="btnAreasAll" />
                            <ui:Button Content="Clear" Command="{Binding ClearAreasCommand}" Style="{StaticResource ToolButton}" AutomationProperties.Name="Clear every scan area"
                                       AutomationProperties.AutomationId="btnAreasClear" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding AreaChoices}" AutomationProperties.AutomationId="lstAreas" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:HygieneAreaChoice}">
                                    <CheckBox IsChecked="{Binding IsChecked}" Width="340" Margin="0,0,8,4" AutomationProperties.Name="{Binding Title}"
                                              AutomationProperties.AutomationId="{Binding Id, StringFormat=chkArea{0}}">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Pause between provider calls" Style="{StaticResource CardTitle}" Margin="0,16,0,8" />
                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding Pauses}" SelectedItem="{Binding PauseMilliseconds}" ItemStringFormat="{}{0} ms" MinWidth="130" Margin="0,0,8,8"
                                      AutomationProperties.Name="Pause between provider calls in milliseconds" AutomationProperties.AutomationId="cboPause" />
                            <TextBlock Text="A pause lowers the load on a busy SMS Provider. Each pause adds to the scan time, once per provider call." Style="{StaticResource Note}"
                                       VerticalAlignment="Center" Margin="0,0,0,8" MaxWidth="560" />
                        </WrapPanel>

                        <TextBlock Text="Content source probe" Style="{StaticResource CardTitle}" Margin="0,16,0,8" />
                        <CheckBox IsChecked="{Binding ProbeContentSources}" Margin="0,0,0,8" AutomationProperties.Name="Probe the content source paths of the deployment types"
                                  AutomationProperties.AutomationId="chkProbeSources">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="Probe the content source paths of the deployment types. The scan then connects to the file servers of the paths, for a limited number of paths and with a time limit. Off by default." />
                        </CheckBox>

                        <TextBlock Text="Live views" Style="{StaticResource CardTitle}" Margin="0,16,0,8" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtLiveOptionsIntro"
                                   Text="The Live views read the SMS Provider and the site database and change nothing. Client Health and Inactive Devices read the site database with Windows authentication. The SQL server and database are the ones Discover uses; empty values are found from the site." />
                        <WrapPanel x:Name="pnlLiveSql">
                            <ui:TextBox Text="{Binding LiveSqlServer, UpdateSourceTrigger=LostFocus}" PlaceholderText="SQL server, empty finds it from the site" MinWidth="300" Margin="0,0,8,8"
                                        AutomationProperties.Name="SQL server of the site database" AutomationProperties.AutomationId="txtLiveSqlServer" />
                            <ui:TextBox Text="{Binding LiveSqlDatabase, UpdateSourceTrigger=LostFocus}" PlaceholderText="Database, empty uses CM_ and the site code" MinWidth="300" Margin="0,0,8,8"
                                        AutomationProperties.Name="Site database name" AutomationProperties.AutomationId="txtLiveSqlDatabase" />
                            <ui:Button Content="Test SQL" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding TestSqlCommand}" Style="{StaticResource ToolButton}"
                                       ToolTip="Connects to the site database and runs one read." AutomationProperties.Name="Test the SQL connection" AutomationProperties.AutomationId="btnTestSql" />
                        </WrapPanel>
                        <TextBlock Text="{Binding SqlTestResult}" Style="{StaticResource Note}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtSqlTestResult" AutomationProperties.LiveSetting="Polite" />
                        <CheckBox IsChecked="{Binding TrustSqlCertificate}" Margin="0,0,0,8" AutomationProperties.Name="Trust the SQL server certificate" AutomationProperties.AutomationId="chkTrustSqlCertificate">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="Trust the SQL server certificate without a check. Use this only for a server with a self-signed certificate. Off by default." />
                        </CheckBox>
                        <WrapPanel>
                            <TextBlock Text="Auto-refresh every" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <ComboBox ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding RefreshMinutes}" ItemStringFormat="{}{0} minutes" MinWidth="150" Margin="0,0,16,8"
                                      AutomationProperties.Name="Auto-refresh interval in minutes" AutomationProperties.AutomationId="cboRefreshMinutes" />
                            <TextBlock Text="A device is inactive after" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <ComboBox ItemsSource="{Binding InactiveDayChoices}" SelectedItem="{Binding InactiveDays}" ItemStringFormat="{}{0} days" MinWidth="130" Margin="0,0,8,8"
                                      AutomationProperties.Name="Days without contact after which a device is inactive" AutomationProperties.AutomationId="cboInactiveDays" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8" MaxWidth="900" HorizontalAlignment="Left"
                                   Text="The auto-refresh starts after the first successful Refresh all of the session and runs only while this page shows. Each refresh reads every source once, in bulk; the status line states the query count." />

                        <TextBlock Text="Alerts" Style="{StaticResource CardTitle}" Margin="0,16,0,8" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtAlertsIntro"
                                   Text="An alert fires when a completed refresh finds a threshold crossed, and again only after the value recovered. A view that failed neither raises nor clears an alert. The first complete read of a value after the app starts sets its starting state and raises no alert, also when the threshold is crossed already. When you turn alerts or a threshold off and on again, an alert that fired does not fire again until a complete read shows the recovery. Alerts show on this page and go to the alerts log, only while the app runs." />
                        <CheckBox IsChecked="{Binding AlertsEnabled}" Margin="0,0,0,6" AutomationProperties.Name="Raise alerts" AutomationProperties.AutomationId="chkAlertsEnabled">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Raise alerts" />
                        </CheckBox>
                        <StackPanel Margin="28,0,0,0" IsEnabled="{Binding AlertsEnabled}">
                            <CheckBox IsChecked="{Binding AlertSiteCritical}" Margin="0,0,0,6" AutomationProperties.Name="A site component or site system is critical" AutomationProperties.AutomationId="chkAlertSiteCritical">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="A site component or site system is critical" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding AlertDpCritical}" Margin="0,0,0,6" AutomationProperties.Name="A distribution point is critical" AutomationProperties.AutomationId="chkAlertDpCritical">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="A distribution point is critical" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding AlertContentFailed}" Margin="0,0,0,6" AutomationProperties.Name="A DP-content pair failed" AutomationProperties.AutomationId="chkAlertContentFailed">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="A DP-content pair failed" />
                            </CheckBox>
                            <WrapPanel>
                                <CheckBox IsChecked="{Binding AlertCompliance}" Margin="0,0,8,8" VerticalAlignment="Center" AutomationProperties.Name="Overall deployment compliance is below the floor"
                                          AutomationProperties.AutomationId="chkAlertCompliance">
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Overall deployment compliance is below" />
                                </CheckBox>
                                <ComboBox ItemsSource="{Binding ComplianceFloors}" SelectedItem="{Binding CompliancePctFloor}" ItemStringFormat="{}{0} %" MinWidth="110" Margin="0,0,8,8"
                                          IsEnabled="{Binding AlertCompliance}" AutomationProperties.Name="Compliance floor in percent" AutomationProperties.AutomationId="cboComplianceFloor" />
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel>
                            <ui:Button Content="Open the alerts log" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenAlertsLogCommand}" Style="{StaticResource ToolButton}"
                                       AutomationProperties.AutomationId="btnOptionsAlertsLog" />
                        </WrapPanel>

                        <TextBlock Text="Health Dashboard import" Style="{StaticResource CardTitle}" Margin="0,16,0,8" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtImportIntro"
                                   Text="Copies the metrics history and the settings of the retired Health Dashboard of the suite. The import shows what it copies and asks once. It does not change the old files, and a second import changes nothing." />
                        <WrapPanel>
                            <ui:Button Content="Import from the Health Dashboard" Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportDashboardCommand}" Style="{StaticResource ToolButton}"
                                       AutomationProperties.AutomationId="btnImportDashboard" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ImportNote}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasImportNote, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.AutomationId="txtImportNote" AutomationProperties.LiveSetting="Polite" />

                        <TextBlock Text="Reports" Style="{StaticResource CardTitle}" Margin="0,16,0,8" />
                        <WrapPanel>
                            <TextBlock Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,8,8" AutomationProperties.AutomationId="txtReportFolder">
                                <Run Text="Report folder:" />
                                <Run Text="{Binding ReportFolder, Mode=OneWay}" />
                            </TextBlock>
                            <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenReportsFolderCommand}" Style="{StaticResource ToolButton}"
                                       AutomationProperties.Name="Open the report folder" AutomationProperties.AutomationId="btnOptionsFolder" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Collapsed, the card is one line: the result summary, or the audit warning in its place, which the status line also holds with the summary.
             Open, it shows at most ResultLines result rows; more rows scroll. -->
        <Expander Grid.Row="4" x:Name="pnlHygieneResults" Margin="0,8,0,0" Style="{StaticResource ResultCard}" IsExpanded="{Binding ResultsExpanded}"
                  Visibility="{Binding ShowsResultPanel, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.Name="Results of the last fix" AutomationProperties.AutomationId="pnlHygieneResults">
            <Expander.Header>
                <Grid>
                    <TextBlock x:Name="txtHygieneResultSummary" Text="{Binding ResultSummary}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding ResultSummary}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtHygieneResultSummary" />
                    <Border x:Name="pnlHygieneAuditWarning" Style="{StaticResource Caution}" Margin="0" Padding="8,2" Visibility="{Binding HasAuditWarning, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="pnlHygieneAuditWarning">
                        <TextBlock x:Name="txtHygieneAuditWarning" Text="{Binding AuditWarning}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding AuditWarning}" AutomationProperties.Name="{Binding AuditWarning}"
                                   AutomationProperties.AutomationId="txtHygieneAuditWarning" AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                </Grid>
            </Expander.Header>
            <DataGrid x:Name="dgHygieneResults" Style="{StaticResource GridBase}" CanUserSortColumns="False" ItemsSource="{Binding LastResults}" MaxHeight="140"
                      VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowsResults, Converter={StaticResource BoolToVisibility}}"
                      AutomationProperties.AutomationId="dgHygieneResults" AutomationProperties.Name="Results of the last fix">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Result" Binding="{Binding OutcomeText}" Width="104" MinWidth="100" ElementStyle="{StaticResource StatusCell}" />
                    <DataGridTextColumn Header="Fix" Binding="{Binding Item.Action}" Width="216" MinWidth="212" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="Object" Binding="{Binding Item.Target}" Width="3*" MinWidth="200" ElementStyle="{StaticResource TrimmedCell}" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Style="{StaticResource Note}" Margin="0,8,0,0"
                   AutomationProperties.AutomationId="txtHygieneStatus" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
