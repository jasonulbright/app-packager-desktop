<UserControl
    x:Class="ApplicationPackagerUI.Views.Pages.PivotsResultsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/PivotsScripts.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="pnlResults">
        <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="{Binding ResultHeader}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           AutomationProperties.AutomationId="txtResultHeader" AutomationProperties.LiveSetting="Polite" />
                <DockPanel Margin="0,4,0,0" Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding WaitProgress}" Style="{StaticResource Note}" AutomationProperties.AutomationId="txtWaitProgress" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,4" KeyboardNavigation.TabNavigation="Local">
                <ui:Button Content="Stop waiting" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding StopWaitingCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Ends the wait on the page only. Clients that received the request still run it." AutomationProperties.AutomationId="btnStopWaiting" />
                <ui:Button Content="Export CSV" Icon="{ui:SymbolIcon DocumentTable24}" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Saves the rows the filter of the active result tab shows as a CSV file." AutomationProperties.AutomationId="btnExportCsv" />
                <ui:Button Content="Export JSON" Icon="{ui:SymbolIcon Document24}" Command="{Binding ExportJsonCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Saves the rows the filter of the active result tab shows as a JSON file." AutomationProperties.AutomationId="btnExportJson" />
                <ui:Button Content="Copy as PowerShell" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyAsPowerShellCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Copies the shown rows as a PowerShell expression that gives them back as objects." AutomationProperties.AutomationId="btnCopyPowerShell" />
                <ui:Button Content="Selection to Pivot" Icon="{ui:SymbolIcon ArrowForward24}" Command="{Binding SelectionToPivotCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Sets the devices of the selected rows as the targets of the Pivot tab." AutomationProperties.AutomationId="btnSelectionToPivot" />
                <ui:Button Content="Selection to Script" Icon="{ui:SymbolIcon ArrowForward24}" Command="{Binding SelectionToScriptCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Sets the devices of the selected rows as the targets of the Script tab." AutomationProperties.AutomationId="btnSelectionToScript" />
                <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenReportsFolderCommand}" Style="{StaticResource ToolButton}"
                           ToolTip="Opens the folder of the last report." AutomationProperties.AutomationId="btnResultsFolder" />
                <ui:TextBox Text="{Binding ResultFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter the results" Icon="{ui:SymbolIcon Search24}"
                            MinWidth="220" Margin="0,0,8,8" AutomationProperties.Name="Result filter" AutomationProperties.AutomationId="txtResultFilter" />
                <TextBlock Text="{Binding ResultCount}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.AutomationId="txtResultCount" />
            </WrapPanel>
            <TabControl Grid.Row="2" SelectedIndex="{Binding ResultTabIndex}" AutomationProperties.AutomationId="tabResults">
                <TabItem Header="Results" AutomationProperties.AutomationId="tabResultRows">
                    <DataGrid x:Name="dgResults" Margin="0,8,0,0" Style="{StaticResource GridBase}" SelectionMode="Extended" ItemsSource="{Binding ResultRows}"
                              SelectionChanged="OnResultsSelectionChanged" FrozenColumnCount="1"
                              AutomationProperties.AutomationId="dgResults" AutomationProperties.Name="Results" />
                </TabItem>
                <TabItem Header="Devices" AutomationProperties.AutomationId="tabResultDevices">
                    <DataGrid x:Name="dgDevices" Margin="0,8,0,0" Style="{StaticResource GridBase}" SelectionMode="Extended" ItemsSource="{Binding DeviceRows}"
                              SelectionChanged="OnDevicesSelectionChanged" AutomationProperties.AutomationId="dgDevices" AutomationProperties.Name="Devices">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="2*" MinWidth="160" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="ResourceID" Binding="{Binding ResourceId}" Width="112" MinWidth="112" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" MinWidth="120" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Online" Binding="{Binding Online}" Width="96" MinWidth="96" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Output" Binding="{Binding Output}" Width="2*" MinWidth="140" ElementStyle="{StaticResource MonoCell}" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*" MinWidth="200" ElementStyle="{StaticResource WrappedCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Raw" AutomationProperties.AutomationId="tabResultRaw">
                    <TextBox Margin="0,8,0,0" Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Editor}" AcceptsTab="False"
                             AutomationProperties.Name="Raw responses" AutomationProperties.AutomationId="txtRaw" />
                </TabItem>
                <TabItem Header="Pipeline" AutomationProperties.AutomationId="tabResultPipeline">
                    <DataGrid x:Name="dgPipeline" Margin="0,8,0,0" Style="{StaticResource GridBase}" ItemsSource="{Binding PipelineRows}"
                              AutomationProperties.AutomationId="dgPipeline" AutomationProperties.Name="Runs of this session">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Run" Binding="{Binding Run}" Width="72" MinWidth="64" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" MinWidth="150" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Started" Binding="{Binding Started}" Width="166" MinWidth="166" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Targets" Binding="{Binding Targets}" Width="96" MinWidth="90" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="180" MinWidth="180" ElementStyle="{StaticResource TrimmedCell}" />
                            <DataGridTextColumn Header="Results" Binding="{Binding Results}" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
