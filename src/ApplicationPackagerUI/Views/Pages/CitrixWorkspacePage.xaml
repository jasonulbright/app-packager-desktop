<Page
    x:Class="ApplicationPackagerUI.Views.Pages.CitrixWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Desktop24" FontSize="48"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Citrix Workspace" FontSize="20" Margin="0,16,0,8"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Configure Citrix Workspace App installation switches."
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
