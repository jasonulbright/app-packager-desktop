<UserControl
    x:Class="ApplicationPackagerUI.Controls.CommandOverridePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <StackPanel MinWidth="440">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="Install command" FontSize="13" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ui:TextBox x:Name="InstallBox" FontFamily="Consolas" Margin="0,0,0,12"
                    PlaceholderText="install.bat (packager default)" />

        <TextBlock Text="Uninstall command" FontSize="13" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ui:TextBox x:Name="UninstallBox" FontFamily="Consolas" Margin="0,0,0,12"
                    PlaceholderText="uninstall.bat (packager default)" />

        <ui:Button Content="Revert to default" HorizontalAlignment="Left"
                   Click="RevertButton_Click" />
    </StackPanel>
</UserControl>
