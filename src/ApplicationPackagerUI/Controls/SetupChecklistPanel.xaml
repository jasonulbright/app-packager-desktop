<UserControl
    x:Class="ApplicationPackagerUI.Controls.SetupChecklistPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Focusable="False"
    IsTabStop="False"
    AutomationProperties.AutomationId="pnlSetupChecklist"
    AutomationProperties.Name="Setup checklist">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- The color follows the state; the glyph and the word say it too (R-18). -->
            <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StateKey}" Value="Complete">
                        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StateKey}" Value="Failed">
                        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="12" BorderThickness="1" CornerRadius="8"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource SurfacePageBrush}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Setup checklist" Style="{StaticResource CardTitleText}" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}" AutomationProperties.AutomationId="txtSetupProgress"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <WrapPanel>
                    <ui:Button Content="{Binding CloseText}" Command="{Binding CloseCommand}" Margin="0,0,8,8"
                               AutomationProperties.AutomationId="btnSetupClose"
                               ToolTip="Close the checklist. Nothing is stored. An unfinished checklist opens again at the next start." />
                    <ui:Button Content="Do Not Show Again" Command="{Binding DoNotShowAgainCommand}" Margin="0,0,8,8" Appearance="Transparent"
                               Visibility="{Binding IsDue, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.AutomationId="btnSetupDismiss"
                               ToolTip="Stop opening the checklist at the start. The settings do not change." />
                </WrapPanel>
                <TextBlock Text="To open this checklist again, select More, then Setup checklist." Style="{StaticResource CaptionText}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="lstSetupSteps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <DockPanel>
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="{Binding Glyph}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top"
                                                   Foreground="{Binding Foreground, ElementName=State}" />
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               AutomationProperties.AutomationId="{Binding TitleAutomationId}"
                                               AutomationProperties.Name="{Binding AccessibleName}" />
                                </DockPanel>
                                <StackPanel Margin="24,0,0,0">
                                    <TextBlock x:Name="State" Text="{Binding StateWord}" Style="{StaticResource StateText}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,4,0,8" />
                                    <WrapPanel>
                                        <ui:Button Content="Open Setup" Margin="0,0,8,8" Click="OpenSetup_Click"
                                                   Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisibility}}"
                                                   IsEnabled="{Binding DataContext.CanOpenSetup, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   AutomationProperties.AutomationId="{Binding SetupAutomationId}"
                                                   AutomationProperties.Name="{Binding SetupName}"
                                                   ToolTip="Open the Setup window: the systems, the site and the content folders." />
                                        <ui:Button Content="Test Connection" Margin="0,0,8,8"
                                                   Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   Visibility="{Binding ShowTest, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.AutomationId="btnSetupTestConnection"
                                                   ToolTip="Test the connection to the ConfigMgr site with the saved settings." />
                                        <ui:Button Content="{Binding ScanText}" Margin="0,0,8,8"
                                                   Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   Visibility="{Binding ShowScan, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.AutomationId="btnSetupScan"
                                                   ToolTip="Read application names and versions from the site inventory. You then choose the products." />
                                        <ui:Button Content="Skip Scan" Margin="0,0,8,8" Appearance="Transparent"
                                                   Command="{Binding DataContext.SkipScanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   Visibility="{Binding ShowSkip, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.AutomationId="btnSetupSkipScan"
                                                   ToolTip="Complete this step for this site without a scan. You can scan later." />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
