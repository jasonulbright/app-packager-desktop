<UserControl
    x:Class="ApplicationPackagerUI.Controls.SetupChecklistPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock"
    Focusable="False"
    IsTabStop="False"
    FontFamily="Segoe UI"
    FontSize="14"
    AutomationProperties.AutomationId="pnlSetupChecklist"
    AutomationProperties.Name="Setup checklist">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- The color follows the state; the glyph and the words say it too (R-18). -->
            <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource Mk.H3}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="good">
                        <Setter Property="Foreground" Value="{DynamicResource MkOkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="warn">
                        <Setter Property="Foreground" Value="{DynamicResource MkWarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="bad">
                        <Setter Property="Foreground" Value="{DynamicResource MkBadBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- .panel .stack .block: padding 20, a 14 px gap between the parts. -->
    <Border Style="{StaticResource Mk.Panel}" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <mk:TrackedText Style="{StaticResource Mk.H2}" Text="Setup checklist" AutomationProperties.HeadingLevel="Level2" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Height="19">
                    <mk:Ico Glyph="info" Foreground="{DynamicResource MkAccentBrush}" mk:Mk.Drop="1" />
                    <TextBlock Text="{Binding ProgressText}" Margin="6,-1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MkAccentBrush}"
                               AutomationProperties.AutomationId="txtSetupProgress" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Rectangle Height="1" Fill="{DynamicResource MkLineBrush}" Margin="0,14,0,0" />
                <ItemsControl ItemsSource="{Binding ShownSteps}" Focusable="False" IsTabStop="False" AutomationProperties.AutomationId="lstSetupSteps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <UserControl Focusable="True" IsTabStop="True" FocusVisualStyle="{StaticResource Mk.Focus}" ContextMenuOpening="Step_ContextMenuOpening"
                                         AutomationProperties.Name="{Binding AccessibleName}"
                                         AutomationProperties.HelpText="Press the Apps key or Shift+F10 for the actions of this step.">
                                <UserControl.ContextMenu>
                                    <ContextMenu />
                                </UserControl.ContextMenu>
                            <StackPanel Background="Transparent">
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Height="24">
                                    <mk:Ico Glyph="{Binding Icon}" Foreground="{Binding Foreground, ElementName=Title}" />
                                    <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource StepTitle}" Margin="6,-1,0,0" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="{Binding TitleAutomationId}" AutomationProperties.Name="{Binding AccessibleName}"
                                               ToolTip="{Binding StateWord}" />
                                </StackPanel>
                                <!-- A step without a button is one unit lower than its parts. -->
                                <TextBlock Text="{Binding Detail}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Mk.Help}">
                                            <Setter Property="Margin" Value="0,17,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionText}" Value="">
                                                    <Setter Property="Margin" Value="0,17,0,-1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- The way to the page that finishes the step: the one that needs work next has the filled button. -->
                                <Button Content="{Binding ActionText}" mk:Mk.Icon="{Binding ActionIcon}" mk:Mk.IconDrop="1" mk:Mk.TextDrop="1" Margin="0,13,0,0" Padding="11,0,12,0" HorizontalAlignment="Stretch" Click="StepAction_Click"
                                        IsEnabled="{Binding DataContext.CanOpenSetup, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        AutomationProperties.AutomationId="{Binding SetupAutomationId}" AutomationProperties.Name="{Binding ActionName}"
                                        ToolTip="{Binding ActionTip}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Mk.Button}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource MkAccentBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource MkAccentBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource MkOnBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActionText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            </UserControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Height="1" Fill="{DynamicResource MkLineBrush}" Margin="0,14,0,0" />
                <TextBlock Text="Return to this checklist from Settings." Style="{StaticResource Mk.Help}" Margin="0,15,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
