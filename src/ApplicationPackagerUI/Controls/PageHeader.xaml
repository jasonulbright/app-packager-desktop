<UserControl
    x:Class="ApplicationPackagerUI.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock"
    x:Name="Root"
    Focusable="False"
    IsTabStop="False"
    Margin="0,0,0,8">

    <UserControl.Resources>
        <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Typography.xaml" />
    </UserControl.Resources>

    <!-- The header band: a card surface with a border that passes 3 to 1 on the window, the page icon at the left,
         then the title, the description and the status line. -->
    <Border x:Name="Band" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12,8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- One line is as high as a button (32 px), so the title sits at the same place with or without actions. -->
                <RowDefinition x:Name="TitleRow" Height="Auto" MinHeight="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon x:Name="IconHost" Grid.Row="0" Grid.Column="0"
                           Symbol="{Binding Icon, ElementName=Root}"
                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

            <TextBlock x:Name="TitleText" Grid.Row="0" Grid.Column="1"
                       Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1" />

            <!-- .headline h1 { font-size:30px; weight 650; letter-spacing:-.55px } with the small line above it (.pagealias, 13 px). -->
            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="EyebrowText" Text="{Binding Eyebrow, ElementName=Root}" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource MkMutedBrush}" Visibility="Collapsed" />
                <mk:TrackedText x:Name="LargeTitle" Text="{Binding Title, ElementName=Root}" FontSize="30" Tracking="-0.55" Foreground="{DynamicResource MkTextBrush}"
                                Visibility="Collapsed" AutomationProperties.HeadingLevel="Level1" />
            </StackPanel>

            <ContentPresenter x:Name="ActionsPresenter" Grid.Row="0" Grid.Column="2"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              Content="{Binding Actions, ElementName=Root}" />

            <TextBlock x:Name="DescriptionText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{Binding Description, ElementName=Root}"
                       Style="{StaticResource PageDescription}"
                       Margin="0,4,0,0"
                       AutomationProperties.AutomationId="txtPageDescription" />

            <TextBlock x:Name="StatusText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{Binding Status, ElementName=Root}"
                       Style="{StaticResource CaptionText}"
                       Margin="0,4,0,0"
                       AutomationProperties.AutomationId="txtPageStatus" />
        </Grid>
    </Border>
</UserControl>
