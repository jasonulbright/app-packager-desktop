<UserControl
    x:Class="ApplicationPackagerUI.Controls.WorkbenchSidePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock"
    Focusable="False"
    IsTabStop="False"
    FontFamily="Segoe UI"
    FontSize="14"
    AutomationProperties.AutomationId="pnlSidePanel"
    AutomationProperties.Name="Identity, source and validation">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Mk.Help}">
                <Setter Property="Margin" Value="0,14,0,0" />
            </Style>
            <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Mk.Strong}">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Read-only facts of the open application and the results of the last validation. The window docks this panel at the right of the editor, or
         shows it in place of the editor when the window is narrow. -->
    <Border Style="{StaticResource Mk.Panel}" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <TextBlock Text="Identity and source" Style="{StaticResource Mk.H3}" />
                <TextBlock Text="Stable identity" Style="{StaticResource Label}" />
                <TextBlock x:Name="txtIdentity" Text="{Binding IdentityShort, Mode=OneWay}" ToolTip="{Binding IdentityText}" Style="{StaticResource Value}" />
                <TextBlock Text="Source provenance" Style="{StaticResource Label}" />
                <TextBlock x:Name="txtProvenance" Text="{Binding ProvenanceShort, Mode=OneWay}" ToolTip="{Binding ProvenanceText}" Style="{StaticResource Value}" />
                <TextBlock Text="Renaming a profile keeps the same catalog identity and output folder." Style="{StaticResource Label}" Margin="0,15,0,-1" />
                <Rectangle Height="1" Fill="{DynamicResource MkLineBrush}" Margin="0,14,0,0" />
                <TextBlock Text="Validation" Style="{StaticResource Mk.H3}" Margin="0,14,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <mk:Ico Glyph="clock" Foreground="{DynamicResource MkTextBrush}" />
                    <TextBlock x:Name="chipContent" Margin="6,-1,0,0" VerticalAlignment="Center" Text="{Binding ChipContentShort, Mode=OneWay}" ToolTip="{Binding ChipContent}" Style="{StaticResource Mk.Body}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <mk:Ico Glyph="clock" Foreground="{DynamicResource MkTextBrush}" />
                    <TextBlock x:Name="chipMecm" Margin="6,-1,0,0" VerticalAlignment="Center" Text="{Binding ChipConfigMgrShort, Mode=OneWay}" ToolTip="{Binding ChipConfigMgr}" Style="{StaticResource Mk.Body}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <mk:Ico Glyph="clock" Foreground="{DynamicResource MkTextBrush}" />
                    <TextBlock x:Name="chipIntune" Margin="6,-1,0,0" VerticalAlignment="Center" Text="{Binding ChipIntuneShort, Mode=OneWay}" ToolTip="{Binding ChipIntune}" Style="{StaticResource Mk.Body}" />
                </StackPanel>
                <TextBlock x:Name="txtSaveState" Text="{Binding SaveStateText}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,15,0,-1" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
