<UserControl
    x:Class="ApplicationPackagerUI.Controls.DetectionEditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Detection rule">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/AddFlow.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Grid.IsSharedSizeScope="True">
        <Border Style="{StaticResource AddCaution}" Visibility="{Binding HasWarning, Converter={StaticResource AddBoolToVisibility}}"
                AutomationProperties.AutomationId="pnlDetectionWarning">
            <TextBlock Text="{Binding WarningText}" Style="{StaticResource AddWarningText}" AutomationProperties.AutomationId="txtDetectionWarning" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DetectionLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Rule" Style="{StaticResource AddLabel}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" Style="{StaticResource AddCombo}"
                      ToolTip="The kind of rule that tells ConfigMgr and Intune that the application is installed."
                      AutomationProperties.Name="Detection rule kind" AutomationProperties.AutomationId="cboDetectionKind" />
            <Border Grid.Column="2" Style="{StaticResource EvidenceChip}" ToolTip="{Binding MarkerToolTip}"
                    AutomationProperties.Name="{Binding MarkerText, StringFormat=Detection: {0}}" AutomationProperties.AutomationId="chipDetectionEvidence">
                <TextBlock Text="{Binding MarkerText}" Style="{StaticResource EvidenceChipText}" />
            </Border>
        </Grid>

        <TextBlock Text="{Binding Description}" Style="{StaticResource AddNote}" Margin="0,0,0,8" AutomationProperties.AutomationId="txtDetectionDescription" />

        <Grid Visibility="{Binding ShowRegistry, Converter={StaticResource AddBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DetectionLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Hive" Style="{StaticResource AddLabel}" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding HiveOptions}" SelectedItem="{Binding Hive}" Style="{StaticResource AddCombo}"
                      AutomationProperties.Name="Registry hive" AutomationProperties.AutomationId="cboDetectionHive" />
            <TextBlock Grid.Row="1" Text="Key" Style="{StaticResource AddLabel}" />
            <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddField}"
                        PlaceholderText="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\..."
                        ToolTip="The registry key under the hive. A rule with an empty key is not saved."
                        AutomationProperties.Name="Registry key" AutomationProperties.AutomationId="txtDetectionKey" />
            <TextBlock Grid.Row="2" Text="Value name" Style="{StaticResource AddLabel}" Visibility="{Binding ShowValueName, Converter={StaticResource AddBoolToVisibility}}" />
            <ui:TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ValueName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddField}"
                        Visibility="{Binding ShowValueName, Converter={StaticResource AddBoolToVisibility}}"
                        AutomationProperties.Name="Registry value name" AutomationProperties.AutomationId="txtDetectionValueName" />
            <TextBlock Grid.Row="3" Text="Expected value" Style="{StaticResource AddLabel}" Visibility="{Binding ShowValueName, Converter={StaticResource AddBoolToVisibility}}" />
            <ui:TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ExpectedValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddField}"
                        PlaceholderText="Empty: the staged version"
                        ToolTip="The value to compare. Empty compares the staged version. The tokens {version} and {ProductVersion} are allowed."
                        Visibility="{Binding ShowValueName, Converter={StaticResource AddBoolToVisibility}}"
                        AutomationProperties.Name="Expected value" AutomationProperties.AutomationId="txtDetectionExpected" />
        </Grid>

        <Grid Visibility="{Binding ShowProductCode, Converter={StaticResource AddBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DetectionLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Product code" Style="{StaticResource AddLabel}" />
            <ui:TextBox Grid.Column="1" Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddField}"
                        PlaceholderText="{}{00000000-0000-0000-0000-000000000000}"
                        AutomationProperties.Name="MSI product code" AutomationProperties.AutomationId="txtDetectionProductCode" />
        </Grid>

        <Grid Visibility="{Binding ShowFile, Converter={StaticResource AddBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DetectionLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Folder" Style="{StaticResource AddLabel}" />
            <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddField}"
                        PlaceholderText="%ProgramFiles%\Vendor\Application"
                        AutomationProperties.Name="Detection folder" AutomationProperties.AutomationId="txtDetectionFolder" />
            <TextBlock Grid.Row="1" Text="File name" Style="{StaticResource AddLabel}" />
            <ui:TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddField}"
                        AutomationProperties.Name="Detection file name" AutomationProperties.AutomationId="txtDetectionFileName" />
        </Grid>

        <Grid Visibility="{Binding ShowVersion, Converter={StaticResource AddBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DetectionLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Version" Style="{StaticResource AddLabel}" />
            <ui:TextBox Grid.Column="1" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AddField}"
                        PlaceholderText="Empty: the staged version"
                        AutomationProperties.Name="Detection version" AutomationProperties.AutomationId="txtDetectionVersion" />
        </Grid>

        <CheckBox Content="64-bit registry and file view" IsChecked="{Binding Is64Bit}" Margin="0,0,0,8"
                  ToolTip="Clear for a 32-bit application on a 64-bit computer."
                  AutomationProperties.AutomationId="chkDetection64Bit" />
    </StackPanel>
</UserControl>
