<UserControl
    x:Class="ApplicationPackagerUI.Controls.ContextStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Focusable="False"
    IsTabStop="False"
    AutomationProperties.AutomationId="pnlContextStrip"
    AutomationProperties.Name="{Binding AutomationName}">

    <UserControl.Resources>
        <!-- The color follows the state; the glyph and the text say it too, so no state is shown by color alone (R-18). -->
        <Style x:Key="SystemText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="Off">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="NotConfigured">
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="Connected">
                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- The strip: the site and the host, then one signal per system, then the link to the connection settings. TextBlocks only. -->
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="24,8" MinHeight="40">
        <DockPanel LastChildFill="False">
            <ui:Button x:Name="btnConnections" DockPanel.Dock="Right" Content="Connections" Appearance="Transparent"
                       Icon="{ui:SymbolIcon PlugConnected24}" Click="Connections_Click"
                       ToolTip="Open Settings to change the site, the SMS Provider host and the systems in use."
                       AutomationProperties.AutomationId="btnContextConnections" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtStripSite" Text="{Binding SiteText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="txtStripSite" />
                <TextBlock x:Name="txtStripHost" Text="{Binding HostText}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="txtStripHost" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Systems}" Margin="24,0,0,0" VerticalAlignment="Center" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" ToolTip="{Binding ToolTip}">
                            <ui:SymbolIcon Symbol="{Binding Glyph}" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{Binding Foreground, ElementName=txtSystem}" />
                            <TextBlock x:Name="txtSystem" Text="{Binding Text}" Style="{StaticResource SystemText}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
