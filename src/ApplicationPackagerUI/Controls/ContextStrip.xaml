<UserControl
    x:Class="ApplicationPackagerUI.Controls.ContextStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mk="clr-namespace:ApplicationPackagerUI.Controls.Mock"
    Focusable="False"
    IsTabStop="False"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Ideal"
    AutomationProperties.AutomationId="pnlContextStrip"
    AutomationProperties.Name="{Binding AutomationName}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ApplicationPackagerUI;component/Views/Styles/Mock.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <TranslateTransform x:Key="StripText" />
            <!-- The color follows the state; the glyph and the text say it too, so no state is shown by color alone (R-18). -->
            <Style x:Key="SystemText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource MkTextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StateKey}" Value="Unverified">
                        <Setter Property="Foreground" Value="{DynamicResource MkWarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StateKey}" Value="NotConfigured">
                        <Setter Property="Foreground" Value="{DynamicResource MkWarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StateKey}" Value="Ready">
                        <Setter Property="Foreground" Value="{DynamicResource MkOkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StateKey}" Value="Connected">
                        <Setter Property="Foreground" Value="{DynamicResource MkOkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StateKey}" Value="Failed">
                        <Setter Property="Foreground" Value="{DynamicResource MkBadBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- .context { height:51px; gap:18px; border-bottom:1px solid the color line); font-size:13px }: the site and the host, then one signal per
         system, then the link to the connection settings. -->
    <Border x:Name="Strip" Height="51" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MkLineBrush}" SnapsToDevicePixels="True">
        <DockPanel LastChildFill="False">
            <Button x:Name="btnConnections" DockPanel.Dock="Right" Style="{StaticResource Mk.Button}" mk:Mk.Icon="settings" mk:Mk.IconDrop="-1" mk:Mk.FaceDrop="-1" Content="Connections" FontSize="13"
                    VerticalAlignment="Center" Margin="0,2,0,0" Click="Connections_Click"
                    ToolTip="Open Settings to change the site, the SMS Provider host and the systems in use."
                    AutomationProperties.AutomationId="btnContextConnections" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <mk:Ico Glyph="server" Foreground="{DynamicResource MkTextBrush}" />
                <TextBlock x:Name="txtStripSite" RenderTransform="{DynamicResource StripText}" Text="{Binding SiteText}" FontSize="13" FontWeight="Bold" Margin="8,1,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MkTextBrush}" AutomationProperties.AutomationId="txtStripSite" />
                <TextBlock x:Name="txtStripHost" RenderTransform="{DynamicResource StripText}" Text="{Binding HostText}" FontSize="13" Margin="8,1,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MkMutedBrush}" AutomationProperties.AutomationId="txtStripHost" />
            </StackPanel>
            <!-- The 6 px right margin of the site, the gap of 18 and the divider's own margin of 4. -->
            <Rectangle Style="{StaticResource Mk.Divider}" Margin="27,0,23,0" />
            <ItemsControl ItemsSource="{Binding Systems}" VerticalAlignment="Center" Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding ToolTip}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="0,0,18,0" />
                                    <!-- The words of a state that is not verified are a fraction of a unit wider than in the mock. -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateKey}" Value="Unverified">
                                            <Setter Property="Margin" Value="0,0,17,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <mk:Ico Glyph="{Binding Glyph}" Foreground="{Binding Foreground, ElementName=txtSystem}" />
                            <TextBlock x:Name="txtSystem" Text="{Binding Text}" RenderTransform="{DynamicResource StripText}" Style="{StaticResource SystemText}" Margin="6,1,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
