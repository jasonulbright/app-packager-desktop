{
  "Schema": 1,
  "Id": "12eafe73aa4a7cc4",
  "Vendor": "Blender Foundation",
  "Application": "Blender (x64)",
  "CMName": "Blender",
  "Architecture": "x64",
  "VendorUrl": "https://www.blender.org/",
  "InstallerType": "MSI",
  "InstallerFramework": "NativeMSI",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://www.blender.org/download/",
    "Pattern": "blender-(\\d+\\.\\d+\\.\\d+)-windows-x64\\.msi",
    "VersionTransform": "regex_replace:\\.\\d+$:"
  },
  "DownloadUrl": "https://download.blender.org/release/Blender{display_version}/blender-{version}-windows-x64.msi",
  "DisplayVersionOverride": "{version}",
  "InstallArgs": "/qn /norestart",
  "UninstallArgs": "/x {ProductCode} /qn /norestart",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{ProductCode}",
    "ValueName": "DisplayVersion",
    "PropertyType": "Version",
    "Operator": "GreaterEquals",
    "Is64Bit": true
  },
  "RunningProcess": [
    "blender"
  ]
}
