{
  "Schema": 1,
  "Id": "a1b2c3d4e5f60006",
  "WsusSupport": "Yes",
  "IconSource": "Installer",
  "Vendor": "TeamViewer",
  "Application": "TeamViewer Host (x64)",
  "CMName": "TeamViewer Host",
  "Architecture": "x64",
  "VendorUrl": "https://www.teamviewer.com/",
  "Cpe": "cpe:2.3:a:teamviewer:teamviewer:*:*:*:*:*:*:*:*",
  "ArpName": "TeamViewer Host",
  "SecurityAdvisoryUrl": "https://www.teamviewer.com/en/trust-center/security-bulletins/",
  "InstallerType": "MSI",
  "InstallerFramework": "NativeMSI",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "LocalFile"
  },
  "DownloadUrl": "",
  "InstallerFileName": "TeamViewer_Host.msi",
  "LocalSource": {
    "Mode": "Required",
    "Filter": "TeamViewer_Host*.msi",
    "Exclude": [],
    "Note": "Put the TeamViewer Host MSI (TeamViewer_Host.msi) in that folder. TeamViewer gives it only in the Management Console, under Design and Deploy; unzip the download first when it is a .zip.",
    "VersionFromFile": true
  },
  "InstallArgs": "/qn /norestart",
  "UninstallArgs": "/x {ProductCode} /qn /norestart",
  "InstallerSettings": [
    {
      "Key": "ApiToken",
      "Label": "API token",
      "ControlType": "Text",
      "DefaultValue": "",
      "CommandFragment": "APITOKEN={value}",
      "ValuePattern": "^[^\"\\s]+$",
      "Group": "Assignment",
      "Tooltip": "The script token for APITOKEN, from the Management Console. It is written to the install script of the package in clear text (not to the stage manifest). Leave empty to skip."
    },
    {
      "Key": "CustomConfigId",
      "Label": "Custom config ID",
      "ControlType": "Text",
      "DefaultValue": "",
      "CommandFragment": "CUSTOMCONFIGID={value}",
      "ValuePattern": "^[^\"\\s]+$",
      "Group": "Assignment",
      "Tooltip": "CUSTOMCONFIGID of a custom Host module from the Management Console. Leave empty to skip."
    },
    {
      "Key": "AssignmentId",
      "Label": "Assignment ID",
      "ControlType": "Text",
      "DefaultValue": "",
      "CommandFragment": "ASSIGNMENTID={value}",
      "ValuePattern": "^[^\"\\s]+$",
      "Group": "Assignment",
      "Tooltip": "ASSIGNMENTID from Management Console, Design and Deploy: the assignment ID of your Host module. Leave empty to skip assignment."
    },
    {
      "Key": "AssignmentOptions",
      "Label": "Assignment options",
      "ControlType": "Text",
      "DefaultValue": "",
      "CommandFragment": "ASSIGNMENTOPTIONS=\"{value}\"",
      "ValuePattern": "^[^\"\\r\\n]+$",
      "Group": "Assignment",
      "Tooltip": "The flags of ASSIGNMENTOPTIONS, for example --grant-easy-access or --reassign. Leave empty to skip."
    },
    {
      "Key": "RemoveDesktopShortcut",
      "Label": "Remove the desktop shortcut",
      "ControlType": "Toggle",
      "DefaultValue": "false",
      "CommandFragment": "DESKTOPSHORTCUTS=0",
      "Group": "Options",
      "Tooltip": "Adds DESKTOPSHORTCUTS=0 to the msiexec command line."
    }
  ],
  "Detection": {
    "Type": "ArpEntry",
    "ArpEntry": {
      "View": "Both",
      "DisplayNamePrefix": "TeamViewer Host",
      "WindowsInstaller": true,
      "Version": "{version}"
    }
  },
  "RunningProcess": [
    "TeamViewer",
    "TeamViewer_Service"
  ],
  "InstallerTypeOverrides": {
    "EXE": {
      "InstallerType": "EXE",
      "InstallerFramework": "NSIS",
      "VersionScraper": {
        "Type": "HttpRegex",
        "Url": "https://www.teamviewer.com/en-us/download/windows/",
        "Pattern": "versionNumber&quot;:&quot;(\\d+\\.\\d+\\.\\d+)"
      },
      "DownloadUrl": "https://download.teamviewer.com/download/TeamViewer_Host_Setup.exe",
      "InstallerFileName": "TeamViewer_Host_Setup.exe",
      "LocalSource": null,
      "InstallArgs": "/S",
      "UninstallArgs": "/S",
      "UninstallCommand": "$proc = Start-Process -FilePath 'C:\\Program Files\\TeamViewer\\uninstall.exe' -ArgumentList '/S' -Wait -PassThru -NoNewWindow",
      "InstallerSettings": null,
      "Detection": {
        "Type": "ArpEntry",
        "ArpEntry": {
          "View": "Both",
          "DisplayNamePrefix": "TeamViewer Host",
          "WindowsInstaller": false,
          "Version": "{version}"
        }
      }
    }
  }
}
