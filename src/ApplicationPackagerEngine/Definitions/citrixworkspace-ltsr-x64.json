{
  "Schema": 1,
  "Id": "2b23a02d9dc05a6e",
  "IconSource": "Installer",
  "Vendor": "Cloud Software Group",
  "Application": "Citrix Workspace LTSR (x64)",
  "CMName": "Citrix Workspace LTSR x64",
  "Architecture": "x64",
  "VendorUrl": "https://www.citrix.com/downloads/workspace-app/",
  "Cpe": "cpe:2.3:a:citrix:workspace_app:*:*:*:*:*:*:*:*",
  "SecurityAdvisoryUrl": "https://support.citrix.com/securitybulletins",
  "InstallerType": "EXE",
  "InstallerFramework": "InstallShield",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://downloadplugins.citrix.com/ReceiverUpdates/Prod/catalog_win.xml",
    "Pattern": "<DownloadURL>[^<]+</DownloadURL><Hash>[0-9A-Fa-f]{64}</Hash>(?:(?!</Installer>).)*?<Stream>LTSR</Stream><Version>(\\d+(?:\\.\\d+){1,3})</Version>",
    "SelectHighestVersion": true
  },
  "DownloadUrl": "",
  "InstallerFileName": "CitrixWorkspaceApp-LTSR-x64-{version}.exe",
  "LocalSource": {
    "Mode": "Required",
    "Filter": "CitrixWorkspace*_x64*.exe",
    "Exclude": [],
    "StagedNames": [
      {
        "Match": "*FullInstaller*",
        "FileName": "CitrixWorkspaceFullInstaller-LTSR-x64-{version}.exe"
      }
    ]
  },
  "CitrixSwitchStream": "LTSR",
  "InstallArgs": "/silent",
  "UninstallArgs": "/silent /uninstall",
  "UninstallCommand": "$exe = Get-ChildItem -LiteralPath $PSScriptRoot -Filter 'CitrixWorkspace*-LTSR-x64-*.exe' | Select-Object -First 1\r\nif (-not $exe) { exit 1 }\r\n$proc = Start-Process -FilePath $exe.FullName -ArgumentList @('/silent', '/uninstall') -Wait -PassThru -NoNewWindow",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\CitrixOnlinePluginPackWeb",
    "ValueName": "DisplayVersion",
    "Operator": "GreaterEquals",
    "PropertyType": "Version",
    "Is64Bit": true
  },
  "RunningProcess": [
    "SelfService",
    "AuthManSvr",
    "Receiver"
  ]
}
