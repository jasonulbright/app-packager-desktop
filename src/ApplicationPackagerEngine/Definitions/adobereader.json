{
    "Schema":  1,
    "Id":  "b1a2c3d4e5f60001",
    "WsusSupport":  "Yes",
    "IconSource":  "Installer",
    "Vendor":  "Adobe Inc.",
    "Application":  "Adobe Acrobat (64-bit)",
    "CMName":  "Adobe Acrobat (64-bit)",
    "Architecture":  "x64",
    "VendorUrl":  "https://www.adobe.com/acrobat/pdf-reader.html",
    "Cpe":  "cpe:2.3:a:adobe:acrobat_reader_dc:*:*:*:*:*:*:*:*",
    "ArpName":  "Adobe Acrobat (64-bit)",
    "InstallerType":  "EXE",
    "InstallerFramework":  "NativeEXE",
    "Acquisition":  {

                    },
    "VersionScraper":  {
                           "Type":  "HttpRegex",
                           "Url":  "https://www.adobe.com/devnet-docs/acrobatetk/tools/ReleaseNotesDC/index.html",
                           "Pattern":  "\\b(\\d{2}\\.\\d{3}\\.\\d{5})\\b",
                           "VersionTransform":  "replace:.:",
                           "NoUserAgent":  true
                       },
    "DownloadUrl":  "https://ardownload3.adobe.com/pub/adobe/acrobat/win/AcrobatDC/{display_version}/AcroRdrDCx64{display_version}_MUI.exe",
    "InstallerFileName":  "AcroRdrDCx64-{display_version}.exe",
    "DisplayVersionOverride":  "{version}",
    "InstallArgs":  "/sAll /rs /rps /msi /qn /norestart",
    "UninstallArgs":  "/x /qn /norestart",
    "InstallerSettings":  [
                              {
                                  "Key":  "Languages",
                                  "Label":  "Languages",
                                  "Tooltip":  "Installs the languages checked here; English is always included, and the Reader UI follows the language of the operating system. All installs every language the installer carries (LANG_LIST=ALL). None checked keeps the installer's own language behavior.",
                                  "ControlType":  "LocaleList",
                                  "DefaultValue":  "",
                                  "Options":  [ "ca_ES", "cs_CZ", "da_DK", "de_DE", "es_ES", "eu_ES", "fi_FI", "fr_FR", "hr_HR", "hu_HU", "it_IT", "ja_JP", "ko_KR", "nb_NO", "nl_NL", "pl_PL", "pt_BR", "ro_RO", "ru_RU", "sk_SK", "sl_SI", "sv_SE", "tr_TR", "uk_UA", "zh_CN", "zh_TW" ],
                                  "AlwaysInclude":  "en_US",
                                  "ValueMap":  { "All":  "ALL" },
                                  "CommandFragment":  "LANG_LIST=\"{value}\" SUPPRESSLANGSELECTION=1",
                                  "Group":  "Language"
                              }
                          ],
    "Detection":  {
                      "Type":  "File",
                      "FilePath":  "C:\\Program Files\\Adobe\\Acrobat DC\\Acrobat",
                      "FileName":  "Acrobat.exe",
                      "PropertyType":  "Version",
                      "Operator":  "GreaterEquals",
                      "Is64Bit":  true
                  },
    "RunningProcess":  [
                           "Acrobat",
                           "AcroCEF"
                       ],
    "UninstallCommand":  "$arpKey = Get-ItemProperty \"HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*\" -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -like \"Adobe Acrobat*64-bit*\" }; $proc = Start-Process -FilePath \"msiexec.exe\" -ArgumentList @(\"/x\", $arpKey.PSChildName, \"/qn\", \"/norestart\") -Wait -PassThru -NoNewWindow"
}
