  "Architecture": "x64",
  "VendorUrl": "https://github.com/Devolutions/pwsh-distro",
  "Cpe": "cpe:2.3:a:microsoft:powershell:*:*:*:*:*:*:*:*",
  "ArpName": "PowerShell 7-x64 (repackaged by Devolutions)",
  "SecurityAdvisoryUrl": "https://github.com/PowerShell/PowerShell/security/advisories",
  "InstallerType": "MSI",
  "InstallerFramework": "NativeMSI",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://api.github.com/repos/Devolutions/pwsh-distro/releases?per_page=30",
    "Pattern": "\"name\":\\s*\"Microsoft\\.PowerShell-(\\d+(?:\\.\\d+){2,3})-win-x64\\.msi\"",
    "SelectHighestVersion": true,
    "DownloadUrlQuery": "\"browser_download_url\":\\s*\"(https://github\\.com/Devolutions/pwsh-distro/releases/download/[^\"]+/Microsoft\\.PowerShell-\\d+(?:\\.\\d+){2,3}-win-x64\\.msi)\"",
    "PayloadHashQuery": "\"name\":\\s*\"Microsoft\\.PowerShell-{version}-win-x64\\.msi\"(?:[^{}]|\\{(?:[^{}]|\\{[^{}]*\\})*\\})*?\"digest\":\\s*\"sha256:(?<hash>[0-9a-fA-F]{64})\""
  },
  "DownloadUrl": "",
  "RequirePayloadHash": true,
  "RequireValidSignature": true,
  "StageNotes": [
    "Third party. Devolutions is not Microsoft: Microsoft supports PowerShell only in its own packages, and this MSI is a repackaging of the Microsoft payload by Devolutions. From PowerShell 7.7.0 Microsoft publishes no MSI, and this package keeps an MSI-based installation for all users on the 7.7 line.",
    "The other PowerShell 7 definitions: PowerShell 7 (x64), the Microsoft MSI of the LTS line; and PowerShell 7 Stable (MSIX, per user), the Microsoft MSIX package."
  ],
  "InstallArgs": "/qn /norestart ADD_PATH=1",
  "UninstallArgs": "/x {ProductCode} /qn /norestart",
  "Detection": {
    "Type": "File",
    "FilePath": "C:\\Program Files\\PowerShell\\7",
    "FileName": "pwsh.exe",
    "PropertyType": "Version",
    "Operator": "GreaterEquals",
    "ExpectedValue": "{version}",
    "Is64Bit": true
  },
  "RunningProcess": [
    "pwsh"
  ]
}
