  "WsusSupport": "No (ExitCodes)",
    "IconSource":  "Installer",
  "Vendor": "Dell Inc.",
  "Application": "Dell Command Update (x64)",
  "CMName": "Dell Command Update",
  "Architecture": "x64",
  "VendorUrl": "https://www.dell.com/",
  "Cpe": "cpe:2.3:a:dell:command_update:*:*:*:*:*:*:*:*",
  "ArpName": "Dell Command * Update*",
  "InstallerType": "EXE",
  "InstallerFramework": "Unknown",
  "VersionScraper": {
    "Type": "DellCatalog",
    "Url": "https://downloads.dell.com/catalog/CatalogPC.cab",
    "Pattern": "Dell-Command-Update-Windows-Universal-Application[^\"]*WIN64",
    "DownloadUrlQuery": "CHAINED"
  },
  "DownloadUrl": "",
  "InstallerFileName": "Dell-Command-Update.exe",
  "InstallArgs": "/s",
  "UninstallArgs": "/passthrough /x /s /v\"/qn\"",
  "UninstallCommand": "$exePath = Join-Path $PSScriptRoot 'Dell-Command-Update.exe'; $proc = Start-Process -FilePath $exePath -ArgumentList @('/passthrough', '/x', '/s', '/v\"/qn\"') -Wait -PassThru -NoNewWindow",
  "RebootExitCodes": [2],
  "Detection": {
    "Type": "File",
    "FilePath": "C:\\Program Files\\Dell\\CommandUpdate",
    "FileName": "dcu-cli.exe",
    "PropertyType": "Version",
    "Operator": "GreaterEquals",
    "Is64Bit": true
  },
  "RunningProcess": ["DellCommandUpdate", "dcu-cli"]
}
