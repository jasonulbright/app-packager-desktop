{
    "Schema":  1,
    "Id":  "b1a2c3d4e5f60003",
    "IconSource":  "Installer",
    "Vendor":  "Microsoft",
    "Application":  "Power BI Desktop (x64)",
    "CMName":  "Power BI Desktop",
    "Architecture":  "x64",
    "VendorUrl":  "https://powerbi.microsoft.com/",
    "Cpe":  "cpe:2.3:a:microsoft:power_bi:*:*:*:*:*:*:*:*",
    "SecurityAdvisoryUrl":  "https://msrc.microsoft.com/update-guide",
    "InstallerType":  "EXE",
    "InstallerFramework":  "NativeEXE",
    "Acquisition":  {

                    },
    "VersionScraper":  {
                           "Type":  "HttpRegex",
                           "Url":  "https://www.microsoft.com/en-us/download/details.aspx?id=58494",
                           "Pattern":  "\"version\":\"(\\d+\\.\\d+\\.\\d+\\.\\d+)\"",
                           "DownloadUrlQuery":  "(https://download\\.microsoft\\.com/[^\"]*PBIDesktop[^\"]*x64[^\"]*\\.exe)"
                       },
    "DownloadUrl":  "",
    "InstallerFileName":  "PBIDesktopSetup_x64-{version}.exe",
    "InstallArgs":  "-quiet ACCEPT_EULA=1",
    "UninstallArgs":  "/qn /norestart",
    "Detection":  {
                      "Type":  "File",
                      "FilePath":  "C:\\Program Files\\Microsoft Power BI Desktop\\bin",
                      "FileName":  "PBIDesktop.exe",
                      "PropertyType":  "Version",
                      "Operator":  "GreaterEquals",
                      "Is64Bit":  true
                  },
    "RunningProcess":  [
                           "PBIDesktop"
                       ],
    "UninstallCommand":  "$arpKey = Get-ItemProperty \"HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*\" -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -like \"Microsoft Power BI Desktop*\" -and $_.WindowsInstaller -eq 1 }; $proc = Start-Process -FilePath \"msiexec.exe\" -ArgumentList @(\"/x\", $arpKey.PSChildName, \"/qn\", \"/norestart\") -Wait -PassThru -NoNewWindow"
}
