{
  "Schema": 1,
  "Id": "ea15231fa85301eb",
    "IconSource":  "Installer",
  "Vendor": "Kai Kramer",
  "Application": "KeyStore Explorer (x64)",
  "CMName": "KeyStore Explorer",
  "Architecture": "x64",
  "VendorUrl": "https://keystore-explorer.org/",
  "InstallerType": "EXE",
  "InstallerFramework": "InnoSetup",
  "SupportsInstallModes": ["CurrentUser", "AllUsers"],
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://api.github.com/repos/kaikramer/keystore-explorer/releases/latest",
    "Pattern": "\"name\":\\s*\"kse-(\\d+)-setup\\.exe\"",
    "VersionTransform": "regex_replace:^(\\d)(\\d)(\\d)$:$1.$2.$3"
  },
  "DownloadUrl": "https://github.com/kaikramer/keystore-explorer/releases/download/v{display_version}/kse-{version}-setup.exe",
  "InstallArgs": "/VERYSILENT /NORESTART /SUPPRESSMSGBOXES /SP- /ALLUSERS",
  "UninstallArgs": "/VERYSILENT /NORESTART /SUPPRESSMSGBOXES /SP-",
  "UninstallCommand": "$proc = Start-Process -FilePath \"C:\\Program Files\\KeyStore Explorer\\uninstall\\unins000.exe\" -ArgumentList \"/VERYSILENT\",\"/NORESTART\",\"/SUPPRESSMSGBOXES\",\"/SP-\" -Wait -PassThru -NoNewWindow",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{A771FBEB-F7E1-4443-9181-AFD57F7BFF45}_is1",
    "ValueName": "DisplayVersion",
    "PropertyType": "Version",
    "Operator": "GreaterEquals",
    "Is64Bit": true
  },
  "RunningProcess": ["kse"]
}
