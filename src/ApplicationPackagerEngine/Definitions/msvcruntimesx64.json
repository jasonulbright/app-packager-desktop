    "InstallArgs":  "/install /quiet /norestart",
    "UninstallArgs":  "/uninstall /quiet /norestart",
    "UninstallCommand":  "$exePath = Join-Path $PSScriptRoot (Get-ChildItem $PSScriptRoot -Filter 'vc_redist.x64*.exe' | Select-Object -First 1).Name\r\n$proc = Start-Process -FilePath $exePath -ArgumentList @('/uninstall', '/quiet', '/norestart') -Wait -PassThru -NoNewWindow\r\nif ($proc.ExitCode -eq 0) { '3010' | Out-File (Join-Path $PSScriptRoot 'exitcode.txt') -NoNewline; exit 3010 }",
    "PostInstallScript":  {
                              "Script":  "'3010' | Out-File (Join-Path $PSScriptRoot 'exitcode.txt') -NoNewline\r\nexit 3010"
                          },
    "PostExecutionBehavior":  "ForceReboot",
