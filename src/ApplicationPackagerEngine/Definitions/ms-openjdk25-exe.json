  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://aka.ms/download-jdk/microsoft-jdk-25-windows-x64.msi",
    "Pattern": "REDIR:(?i)/microsoft-jdk-(25(?:\\.\\d+){1,4})-windows-x64\\.msi(?:[?#].*)?$"
