  "UninstallCommand": "$key = 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{3C01F274-867C-4D1D-BE8C-CB488C31B0C9}_is1'; if (-not (Test-Path -LiteralPath $key)) { exit 0 }; $cmd = (Get-ItemProperty -LiteralPath $key -ErrorAction SilentlyContinue).UninstallString; if (-not $cmd) { exit 0 }; if ($cmd -match '^\"([^\"]+)\"') { $exe = $matches[1] } else { $exe = $cmd.Trim() }; $proc = Start-Process -FilePath $exe -ArgumentList '/VERYSILENT','/SUPPRESSMSGBOXES','/NORESTART' -Wait -PassThru -NoNewWindow",
