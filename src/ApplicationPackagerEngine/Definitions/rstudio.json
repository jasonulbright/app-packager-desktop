    "InstallArgs":  "/S",
    "UninstallArgs":  "/S",
    "Detection":  {
                      "Type":  "RegistryKey",
                      "RegistryHive":  "HKLM",
                      "RegistryKeyTemplate":  "SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\RStudio",
                      "Is64Bit":  false
                  },
    "RunningProcess":  [
                           "rstudio"
                       ],
    "UninstallCommand":  "$proc = Start-Process -FilePath \"C:\\Program Files\\RStudio\\Uninstall.exe\" -ArgumentList \"/S\" -Wait -PassThru -NoNewWindow"
