{
  "Schema": 1,
  "Id": "00000036ef822100",
  "IconSource": "Installer",
  "Vendor": "Posit PBC",
  "Application": "RStudio Desktop (x64)",
  "CMName": "RStudio",
  "Architecture": "x64",
  "VendorUrl": "https://posit.co/products/open-source/rstudio/",
  "Cpe": "cpe:2.3:a:posit:rstudio:*:*:*:*:*:*:*:*",
  "InstallerType": "EXE",
  "InstallerFramework": "NativeEXE",
  "SupportsInstallModes": ["CurrentUser", "AllUsers"],
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://api.github.com/repos/rstudio/rstudio/tags?per_page=5",
    "Pattern": "\"name\":\\s*\"v(\\d{4}\\.\\d{2}\\.\\d+\\+\\d+)\"",
    "VersionTransform": "replace:+:-"
  },
  "DownloadUrl": "https://download1.rstudio.org/electron/windows/RStudio-{display_version}.exe",
  "InstallerFileName": "RStudio-{version}.exe",
  "InstallArgs": "/S /allusers",
  "UninstallArgs": "/S /allusers",
  "Detection": {
    "Type": "RegistryKey",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\RStudio",
    "Is64Bit": true
  },
  "RunningProcess": [
    "rstudio"
  ],
  "UninstallCommand": "$proc = Start-Process -FilePath \"C:\\Program Files\\RStudio\\Uninstall.exe\" -ArgumentList \"/S\", \"/allusers\" -Wait -PassThru -NoNewWindow"
}
