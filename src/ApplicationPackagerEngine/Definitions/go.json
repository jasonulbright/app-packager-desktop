{
  "Schema": 1,
  "Id": "e8c47f0d13b95a26",
    "IconSource":  "Installer",
  "Vendor": "Google",
  "Application": "Go Programming Language (x64)",
  "CMName": "Go Programming Language",
  "Architecture": "x64",
  "VendorUrl": "https://go.dev/",
  "Cpe": "cpe:2.3:a:golang:go:*:*:*:*:*:*:*:*",
  "InstallerType": "MSI",
  "InstallerFramework": "NativeMSI",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "JsonQuery",
    "Url": "https://go.dev/dl/?mode=json",
    "Pattern": "[0].version",
    "VersionTransform": "strip_prefix:go",
    "PayloadHashQuery": "[0].files[?os=windows,arch=amd64,kind=installer].sha256"
  },
  "DownloadUrl": "https://go.dev/dl/{version}.windows-amd64.msi",
  "InstallArgs": "/qn /norestart",
  "UninstallArgs": "/x {ProductCode} /qn /norestart",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{ProductCode}",
    "ValueName": "DisplayVersion",
    "PropertyType": "Version",
    "Operator": "GreaterEquals",
    "Is64Bit": true
  },
  "RunningProcess": ["go", "gofmt"]
}
