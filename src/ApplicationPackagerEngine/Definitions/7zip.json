                           "Architecture"
                       ],
    "VendorUrl":  "https://www.7-zip.org/",
    "InstallerType":  "MSI",
    "InstallerFramework":  "NativeMSI",
    "Acquisition":  {

                    },
    "VersionScraper":  {
                           "Type":  "HttpRegex",
                           "Url":  "https://api.github.com/repos/ip7z/7zip/releases/latest",
                           "Pattern":  "\"name\":\\s*\"7z(\\d{4})-x64\\.msi\"",
                           "VersionTransform":  "insert_dot:2",
                           "PayloadHashQuery":  "\"name\":\\s*\"7z{version}-x64\\.msi\"(?:[^{}]|\\{(?:[^{}]|\\{[^{}]*\\})*\\})*?\"digest\":\\s*\"sha256:(?<hash>[0-9a-fA-F]{64})\""
                       },
    "DownloadUrl":  "https://github.com/ip7z/7zip/releases/download/{display_version}/7z{version}-x64.msi",
    "RequirePayloadHash":  true,
    "PayloadVariants":  [
                             {
                                 "NameSuffix":  "ARM64",
                                 "Architecture":  "ARM64",
                                 "ContentSubpath":  "arm64",
                                 "InstallerType":  "EXE",
                                 "DownloadUrl":  "https://github.com/ip7z/7zip/releases/download/{display_version}/7z{version}-arm64.exe",
                                 "InstallArgs":  "/S",
                                 "UninstallArgs":  "/S",
                                 "UninstallCommand":  "$proc = Start-Process -FilePath 'C:\\Program Files\\7-Zip\\Uninstall.exe' -ArgumentList '/S' -Wait -PassThru -NoNewWindow",
                                 "Detection":  {
                                                   "Type":  "RegistryKeyValue",
                                                   "RegistryHive":  "HKLM",
                                                   "RegistryKeyTemplate":  "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\7-Zip",
                                                   "ValueName":  "DisplayVersion",
                                                   "Operator":  "GreaterEquals",
                                                   "PropertyType":  "Version",
                                                   "Is64Bit":  true,
                                                   "ExpectedValue":  "{version}"
                                               },
                                 "PayloadHashQuery":  "\"name\":\\s*\"7z{version}-arm64\\.exe\"(?:[^{}]|\\{(?:[^{}]|\\{[^{}]*\\})*\\})*?\"digest\":\\s*\"sha256:(?<hash>[0-9a-fA-F]{64})\"",
                                 "RequirePayloadHash":  true
                             }
                         ],
    "InstallArgs":  "/qn /norestart",
    "UninstallArgs":  "/x {ProductCode} /qn /norestart",
    "Detection":  {
                      "Type":  "RegistryKeyValue",
                      "RegistryHive":  "HKLM",
                      "RegistryKeyTemplate":  "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{ProductCode}",
                      "ValueName":  "DisplayVersion",
                      "PropertyType":  "Version",
