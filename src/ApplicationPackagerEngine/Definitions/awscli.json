  "Application": "AWS Command Line Interface (x64)",
  "CMName": "AWS Command Line Interface",
  "Architecture": "x64",
  "VendorUrl": "https://aws.amazon.com/cli/",
  "Cpe": "cpe:2.3:a:amazon:aws_command_line_interface:*:*:*:*:*:*:*:*",
  "InstallerType": "MSI",
  "InstallerFramework": "NativeMSI",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
