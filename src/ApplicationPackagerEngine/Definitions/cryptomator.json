  "Cpe": "cpe:2.3:a:cryptomator:cryptomator:*:*:*:*:*:*:*:*",
  "ArpName": "Cryptomator",
  "InstallerType": "MSI",
  "InstallerFramework": "NativeMSI",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://api.github.com/repos/cryptomator/cryptomator/releases/latest",
    "Pattern": "\"name\":\\s*\"Cryptomator-(\\d+(?:\\.\\d+)+)-x64\\.msi\""
  },
  "DownloadUrl": "https://github.com/cryptomator/cryptomator/releases/download/{version}/Cryptomator-{version}-x64.msi",
  "InstallArgs": "/qn /norestart ALLUSERS=1",
  "UninstallArgs": "/x {ProductCode} /qn /norestart",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{ProductCode}",
    "ValueName": "DisplayVersion",
    "PropertyType": "Version",
    "Operator": "GreaterEquals",
    "Is64Bit": true
  },
  "RunningProcess": ["Cryptomator"]
