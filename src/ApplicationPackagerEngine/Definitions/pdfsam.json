  "Application": "PDFsam Basic (x64)",
  "CMName": "PDFsam Basic",
  "Architecture": "x64",
  "VendorUrl": "https://pdfsam.org/",
  "InstallerType": "MSI",
  "InstallerFramework": "NativeMSI",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://api.github.com/repos/torakiki/pdfsam/releases/latest",
    "Pattern": "\"name\":\\s*\"pdfsam-basic-(\\d+(?:\\.\\d+)+)-windows-x64\\.msi\""
  },
