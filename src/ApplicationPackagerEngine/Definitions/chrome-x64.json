{
  "Schema": 1,
  "Id": "a3f0c8e12d4b7961",
    "IconSource":  "Installer",
  "Vendor": "Google",
  "Application": "Google Chrome",
  "CMName": "Google Chrome",
  "Architecture": "x64",
  "VendorUrl": "https://www.google.com/chrome/",
  "InstallerType": "MSI",
    "InstallerFramework":  "NativeMSI",
  "Acquisition": {
    "WingetId": "Google.Chrome"
  },
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://versionhistory.googleapis.com/v1/chrome/platforms/win64/channels/stable/versions/all/releases?order_by=version+desc&filter=fraction=1&pageSize=1",
    "Pattern": "\"version\":\\s*\"(\\d+\\.\\d+\\.\\d+\\.\\d+)\""
  },
  "DownloadUrl": "https://dl.google.com/dl/chrome/install/googlechromestandaloneenterprise64.msi",
  "InstallArgs": "/qn /norestart",
  "UninstallArgs": "/x {ProductCode} /qn /norestart",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{ProductCode}",
    "ValueName": "DisplayVersion",
    "Operator": "IsEquals",
    "Is64Bit": true
  },
  "RunningProcess": ["chrome"]
}
