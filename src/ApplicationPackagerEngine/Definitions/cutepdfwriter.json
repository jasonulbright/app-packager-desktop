                  },
    "RunningProcess":  [

                       ],
    "UninstallCommand":  "$uninstaller = Join-Path ${env:ProgramFiles(x86)} 'CutePDF Writer\\unInstcpw64.exe'; if (-not (Test-Path -LiteralPath $uninstaller)) { exit 0 }; $proc = Start-Process -FilePath $uninstaller -ArgumentList @('/uninstall', '/s') -Wait -PassThru -NoNewWindow"
