{
    "Schema":  1,
    "Id":  "b1a2c3d4e5f60005",
    "WsusSupport":  "No (DetectionNotMappable)",
    "IconSource":  "Installer",
    "Vendor":  "The R Foundation",
    "Application":  "R for Windows (x64)",
    "CMName":  "R",
    "Architecture":  "x64",
    "VendorUrl":  "https://www.r-project.org/",
    "Cpe":  "cpe:2.3:a:r-project:r:*:*:*:*:*:*:*:*",
    "InstallerType":  "EXE",
    "InstallerFramework":  "InnoSetup",
    "Acquisition":  {

                    },
    "VersionScraper":  {
                           "Type":  "JsonQuery",
                           "Url":  "https://api.r-hub.io/rversions/r-release-win",
                           "Pattern":  "version",
                           "DownloadUrlQuery":  "URL"
                       },
    "DownloadUrl":  "",
    "InstallerFileName":  "R-{version}-win.exe",
    "InstallArgs":  "/VERYSILENT /NORESTART",
    "UninstallArgs":  "/VERYSILENT",
    "Detection":  {
                      "Type":  "RegistryKey",
                      "RegistryHive":  "HKLM",
                      "RegistryKeyTemplate":  "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\R for Windows {version}_is1",
                      "Is64Bit":  true
                  },
    "RunningProcess":  [
                           "R",
                           "Rgui"
                       ],
    "UninstallCommand":  "$unins = Get-ChildItem \"C:\\Program Files\\R\" -Recurse -Filter \"unins000.exe\" -ErrorAction SilentlyContinue | Select-Object -First 1; $proc = Start-Process -FilePath $unins.FullName -ArgumentList \"/VERYSILENT /SUPPRESSMSGBOXES /NORESTART\" -Wait -PassThru -NoNewWindow"
}
