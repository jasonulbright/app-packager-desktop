{
  "Schema": 1,
  "Id": "0000063ececba2d8",
  "Vendor": "DBeaver Corp",
  "Application": "DBeaver Community (x64)",
  "CMName": "DBeaver Community",
  "Architecture": "x64",
  "VendorUrl": "https://dbeaver.io/",
  "InstallerType": "EXE",
  "InstallerFramework": "NSIS",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "JsonQuery",
    "Url": "https://api.github.com/repos/dbeaver/dbeaver/releases/latest",
    "Pattern": "tag_name"
  },
  "DownloadUrl": "https://github.com/dbeaver/dbeaver/releases/download/{version}/dbeaver-ce-{version}-windows-x86_64.exe",
  "InstallArgs": "",
  "UninstallArgs": "{setting:InstallScope:UninstallArgs}",
  "InstallerSettings": [
    {
      "Key": "InstallScope",
      "Label": "Install scope",
      "Tooltip": "System installs machine-wide to C:\\Program Files\\DBeaver via /allusers. User installs to %LOCALAPPDATA%\\DBeaver via /currentuser and needs no elevation.",
      "ControlType": "Dropdown",
      "DefaultValue": "System",
      "Options": [
        "System",
        "User"
      ],
      "CommandFragment": "{value}",
      "ValueMap": {
        "System": "/allusers /S",
        "User": "/S /currentuser"
      },
      "ValueMaps": {
        "UninstallArgs": {
          "System": "/allusers /S",
          "User": "/currentuser /S"
        },
        "Root": {
          "System": "C:\\Program Files\\DBeaver",
          "User": "%LOCALAPPDATA%\\DBeaver"
        },
        "RootPs": {
          "System": "$env:ProgramFiles\\DBeaver",
          "User": "$env:LOCALAPPDATA\\DBeaver"
        },
        "EnvScope": {
          "System": "Machine",
          "User": "User"
        }
      },
      "Group": "Install"
    },
    {
      "Key": "DisableAI",
      "Label": "Disable AI features",
      "Tooltip": "Sets DBeaver's documented DBEAVER_AI_DISABLED=true environment variable (Machine scope for a system install, User scope for a user install). Survives upgrades; per vendor documentation the permanent disable cannot be re-enabled from Preferences.",
      "ControlType": "Toggle",
      "DefaultValue": "false",
      "Group": "Install"
    }
  ],
  "PostInstallScript": {
    "WhenSetting": "DisableAI",
    "WhenValue": "true",
    "Script": "[Environment]::SetEnvironmentVariable('DBEAVER_AI_DISABLED', 'true', '{setting:InstallScope:EnvScope}')"
  },
  "Detection": {
    "Type": "File",
    "FilePath": "{setting:InstallScope:Root}",
    "FileName": "dbeaver.exe",
    "PropertyType": "Version",
    "Operator": "GreaterEquals",
    "Is64Bit": true
  },
  "RunningProcess": [
    "dbeaver"
  ],
  "UninstallCommand": "$proc = Start-Process -FilePath \"{setting:InstallScope:RootPs}\\Uninstall.exe\" -ArgumentList '{setting:InstallScope:UninstallArgs}' -Wait -PassThru -NoNewWindow"
}
