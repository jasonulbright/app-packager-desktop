{
  "Schema": 1,
  "Id": "15a007da230156ca",
  "Vendor": "IBM",
  "Application": "IBM Aspera Connect (x64)",
  "CMName": "IBM Aspera Connect",
  "Architecture": "x64",
  "VendorUrl": "https://www.ibm.com/aspera/connect/",
  "InstallerType": "MSI",
  "InstallerFramework": "NativeMSI",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://www.ibm.com/aspera/connect/",
    "Pattern": "ibm-aspera-connect_(\\d+(?:\\.\\d+)+)[^\"/]*_win32_AMD64\\.msi",
    "DownloadUrlQuery": "(https?://[^\"]*?ibm-aspera-connect_\\d+(?:\\.\\d+)+[^\"/]*_win32_AMD64\\.msi)"
  },
  "DownloadUrl": "https://d3gcli72yxqn2z.cloudfront.net/downloads/connect/latest/bin/ibm-aspera-connect_{version}_win32_AMD64.msi",
  "InstallArgs": "/qn /norestart ALLUSERS=1 MSIINSTALLPERUSER=",
  "UninstallArgs": "/x {ProductCode} /qn /norestart",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{ProductCode}",
    "ValueName": "DisplayVersion",
    "PropertyType": "Version",
    "Operator": "GreaterEquals",
    "Is64Bit": true
  },
  "RunningProcess": [
    "asperaconnect",
    "ascp"
  ]
}
