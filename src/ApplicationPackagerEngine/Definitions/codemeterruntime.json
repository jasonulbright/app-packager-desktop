{
  "Schema": 1,
  "Id": "0c0ff28ff49d88ae",
    "IconSource":  "Installer",
  "Vendor": "WIBU-SYSTEMS",
  "Application": "CodeMeter Runtime Kit (x64)",
  "CMName": "CodeMeter Runtime Kit",
  "Architecture": "x64",
  "VendorUrl": "https://www.wibu.com/",
  "InstallerType": "EXE",
  "InstallerFramework": "WixBurn",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "ChainedHttpRegex",
    "Url": "https://www.wibu.com/us/support/user/user-software.html",
    "DownloadUrlQuery": "CHAINED",
    "Hops": [
      {
        "Pattern": "<optgroup[^>]*label=\"Windows 64-bit\"[^>]*>\\s*<option\\s+value=\"(?<capture>\\d+)\"[^>]*>\\s*Version\\s+(?<version>\\d+\\.\\d+[a-z]?)"
      },
      {
        "Url": "/us/support/user/downloads-user-software/file/download/{capture}.html",
        "Pattern": "href=\"(?<url>[^\"]*/file/download/\\d+\\.html\\?[^\"]*directDownload[^\"]*cHash=[0-9a-f]+)\""
      }
    ]
  },
  "DownloadUrl": "",
  "InstallerFileName": "CodeMeterRuntime.exe",
  "InstallArgs": "/q /nosplash /ComponentArgs \"*\":\"/quiet /norestart\"",
  "UninstallArgs": "/qn /norestart",
  "Detection": {
    "Type": "Compound",
    "Connector": "Or",
    "Clauses": [
      {
        "Type": "File",
        "FilePath": "C:\\Program Files\\CodeMeter\\Runtime\\bin",
        "FileName": "CodeMeter.exe",
        "PropertyType": "Version",
        "Operator": "GreaterEquals",
        "Is64Bit": true
      },
      {
        "Type": "File",
        "FilePath": "C:\\Program Files (x86)\\CodeMeter\\Runtime\\bin",
        "FileName": "CodeMeter.exe",
        "PropertyType": "Version",
        "Operator": "GreaterEquals",
        "Is64Bit": true
      }
    ]
  },
  "RunningProcess": [
    "CodeMeter",
    "CodeMeterCC"
  ]
}
