{
    "Schema":  1,
    "Id":  "f1a2b3c4d5e60001",
    "Vendor":  "Salesforce (Tableau)",
    "Application":  "Tableau Desktop (x64)",
    "CMName":  "Tableau Desktop",
    "Architecture":  "x64",
    "VendorUrl":  "https://www.tableau.com/",
    "InstallerType":  "EXE",
    "InstallerFramework":  "WixBurn",
    "Acquisition":  {

                    },
    "VersionScraper":  {
                           "Type":  "HttpRegex",
                           "Url":  "https://www.tableau.com/support/releases",
                           "Pattern":  "\\b(20\\d{2}\\.\\d+(?:\\.\\d+)?)\\b",
                           "VersionTransform":  "regex_replace:^(\\d{4}\\.\\d+)$:$1.0|replace:.:-",
                           "NoUserAgent":  true
                       },
    "DownloadUrl":  "https://downloads.tableau.com/tssoftwareregistered/TableauDesktop-64bit-{display_version}.exe",
    "DisplayVersionOverride":  "{version}",
    "InstallArgs":  "/install /quiet /norestart ACCEPTEULA=1 REMOVEINSTALLEDAPP=1 SENDTELEMETRY=0",
    "UninstallArgs":  "/uninstall /quiet /norestart",
    "Detection":  {
                      "Type":  "RegistryKey",
                      "RegistryHive":  "HKLM",
                      "RegistryKeyTemplate":  "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{ProductCode}",
                      "Is64Bit":  true
                  },
    "RunningProcess":  [
                           "tableau"
                       ],
    "UninstallCommand":  "$exePath = Join-Path $PSScriptRoot (Get-ChildItem $PSScriptRoot -Filter \"TableauDesktop-*.exe\" | Select-Object -First 1).Name; $proc = Start-Process -FilePath $exePath -ArgumentList \"/uninstall /quiet /norestart\" -Wait -PassThru -NoNewWindow"
}
