{
    "Schema":  1,
    "Id":  "f1a2b3c4d5e60003",
    "Vendor":  "Salesforce (Tableau)",
    "Application":  "Tableau Reader (x64)",
    "CMName":  "Tableau Reader",
    "Architecture":  "x64",
    "VendorUrl":  "https://www.tableau.com/",
    "InstallerType":  "EXE",
    "Acquisition":  {

                    },
    "VersionScraper":  {
                           "Type":  "HttpRegex",
                           "Url":  "https://www.tableau.com/support/releases",
                           "Pattern":  "\\b(20\\d{2}\\.\\d+(?:\\.\\d+)?)\\b",
                           "VersionTransform":  "regex_replace:^(\\d{4}\\.\\d+)$:$1.0|replace:.:-",
                           "NoUserAgent":  true
                       },
    "DownloadUrl":  "https://downloads.tableau.com/tssoftware/TableauReader-64bit-{display_version}.exe",
    "DisplayVersionOverride":  "{version}",
    "InstallArgs":  "/install /quiet /norestart ACCEPTEULA=1 SENDTELEMETRY=0",
    "UninstallArgs":  "/uninstall /quiet /norestart",
    "Detection":  {
                      "Type":  "File",
                      "FilePath":  "C:\\Program Files\\Tableau\\Tableau Reader",
                      "FileName":  "tabreader.exe",
                      "PropertyType":  "Version",
                      "Operator":  "GreaterEquals",
                      "Is64Bit":  true
                  },
    "RunningProcess":  [
                           "tabreader"
                       ]
}
