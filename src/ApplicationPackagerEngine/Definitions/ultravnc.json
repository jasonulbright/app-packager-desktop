{
  "Schema": 1,
  "Id": "44ffbc1b76aae099",
    "IconSource":  "Installer",
  "Vendor": "uvnc bvba",
  "Application": "UltraVNC (x64)",
  "CMName": "UltraVNC",
  "Architecture": "x64",
  "VendorUrl": "https://uvnc.com/",
  "InstallerType": "EXE",
  "InstallerFramework": "InnoSetup",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "ChainedHttpRegex",
    "Url": "https://uvnc.com/downloads/ultravnc.html",
    "VersionTransform": "replace:-:.",
    "DownloadUrlQuery": "CHAINED",
    "Hops": [
      {
        "Pattern": "href=\"(?<capture>/downloads/ultravnc/\\d+-ultravnc-(?<version>\\d+-\\d+-\\d+-\\d+)\\.html)\"",
        "SelectHighestVersion": true
      },
      {
        "Url": "{capture}",
        "Pattern": "href=\"/component/jdownloads/summary/(?<capture>3-setup/\\d+-ultravnc-\\d+-x64-setup\\.html\\?Itemid=\\d+)\""
      },
      {
        "Url": "https://uvnc.com/component/jdownloads/send/{capture}",
        "Pattern": "href='(?<url>https?://[^']*UltraVNC[^']*_x64_Setup\\.exe)'"
      }
    ]
  },
  "DownloadUrl": "",
  "InstallerFileName": "UltraVNC_x64_Setup.exe",
  "InstallArgs": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- /COMPONENTS=UltraVNC_Viewer,UltraVNC_Server /TASKS=",
  "UninstallArgs": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
  "UninstallCommand": "\"C:\\Program Files\\uvnc bvba\\UltraVNC\\unins000.exe\" /VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Ultravnc2_is1",
    "ValueName": "DisplayVersion",
    "Operator": "IsEquals",
    "Is64Bit": true
  },
  "RunningProcess": ["vncviewer", "winvnc"]
}
