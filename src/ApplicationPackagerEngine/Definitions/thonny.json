  "Application": "Thonny (x64)",
  "CMName": "Thonny",
  "Architecture": "x64",
  "VendorUrl": "https://thonny.org/",
  "Cpe": "cpe:2.3:a:thonny:thonny:*:*:*:*:*:*:*:*",
  "ArpName": "Thonny*",
  "InstallerType": "EXE",
  "InstallerFramework": "InnoSetup",
  "SupportsInstallModes": ["CurrentUser", "AllUsers"],
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://api.github.com/repos/thonny/thonny/releases/latest",
    "Pattern": "\"name\":\\s*\"thonny-(\\d+(?:\\.\\d+)+)-x64\\.exe\"",
    "DownloadUrlQuery": "\"browser_download_url\":\\s*\"([^\"]*thonny-\\d+(?:\\.\\d+)+-x64\\.exe)\""
  },
  "DownloadUrl": "https://github.com/thonny/thonny/releases/download/v{version}/thonny-{version}-x64.exe",
  "InstallArgs": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /ALLUSERS",
  "UninstallArgs": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Thonny_is1",
    "ValueName": "DisplayVersion",
    "Operator": "IsEquals",
    "Is64Bit": true
  },
  "RunningProcess": ["thonny"]
