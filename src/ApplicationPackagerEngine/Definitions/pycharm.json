{
  "Schema": 1,
  "Id": "b1a2c3d4e5f60004",
  "Vendor": "JetBrains",
  "Application": "PyCharm Community (x64)",
  "CMName": "PyCharm Community",
  "Architecture": "x64",
  "VendorUrl": "https://www.jetbrains.com/pycharm/",
  "InstallerType": "EXE",
  "InstallerFramework": "NSIS",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://data.services.jetbrains.com/products/releases?code=PCC&latest=true&type=release",
    "Pattern": "\"version\":\"(\\d+\\.\\d+(?:\\.\\d+)?)\""
  },
  "DownloadUrl": "https://download.jetbrains.com/python/pycharm-{version}.exe",
  "InstallArgs": "/S",
  "UninstallArgs": "/S",
  "Detection": {
    "Type": "RegistryKey",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\PyCharm {version}",
    "Is64Bit": true
  },
  "RunningProcess": [
    "pycharm64"
  ]
}
