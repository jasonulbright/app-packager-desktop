                           "gvim",
                           "vim"
                       ],
    "UninstallCommand":  "$unins = Get-ChildItem \"C:\\Program Files\\Vim\" -Recurse -Filter \"uninstall-gui.exe\" -ErrorAction SilentlyContinue | Select-Object -First 1; $proc = Start-Process -FilePath $unins.FullName -ArgumentList \"/S\" -Wait -PassThru -NoNewWindow"
