{
    "Schema":  1,
    "Id":  "00001355a7d67152",
    "WsusSupport":  "Yes",
    "IconSource":  "Installer",
    "Vendor":  "Vim",
    "Application":  "Vim (x64)",
    "CMName":  "Vim",
    "Architecture":  "x64",
    "VendorUrl":  "https://www.vim.org/",
    "Cpe":  "cpe:2.3:a:vim:vim:*:*:*:*:*:*:*:*",
    "ArpName":  "Vim [0-9]*",
    "InstallerType":  "EXE",
    "InstallerFramework":  "InnoSetup",
    "Acquisition":  {

                    },
    "VersionScraper":  {
                           "Type":  "JsonQuery",
                           "Url":  "https://api.github.com/repos/vim/vim-win32-installer/releases/latest",
                           "Pattern":  "tag_name",
                           "VersionTransform":  "strip_prefix:v"
                       },
    "DownloadUrl":  "https://github.com/vim/vim-win32-installer/releases/download/v{display_version}/gvim_{display_version}_x64.exe",
    "InstallArgs":  "/S",
    "UninstallArgs":  "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
    "Detection":  {
        "Type":  "RegistryKeyValue",
        "RegistryHive":  "HKLM",
        "RegistryKeyTemplate":  "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Vim",
        "ValueName":  "DisplayVersion",
        "PropertyType":  "Version",
        "Operator":  "GreaterEquals",
        "Is64Bit":  true
    },
    "RunningProcess":  [
                           "gvim",
                           "vim"
                       ],
    "UninstallCommand":  "$unins = Get-ChildItem \"C:\\Program Files\\Vim\" -Recurse -Filter \"uninstall-gui.exe\" -ErrorAction SilentlyContinue | Select-Object -First 1; $proc = Start-Process -FilePath $unins.FullName -ArgumentList \"/S\" -Wait -PassThru -NoNewWindow"
}
