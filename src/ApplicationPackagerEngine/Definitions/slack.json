{
  "Schema": 1,
  "Id": "ab888c50f0dd4b12",
  "Vendor": "Slack Technologies",
  "Application": "Slack (x64)",
  "CMName": "Slack",
  "Architecture": "x64",
  "VendorUrl": "https://slack.com/",
  "InstallerType": "MSI",
  "InstallerFramework": "MSIX",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
    "Url": "https://slack.com/api/desktop.latestRelease?platform=windows&variant=msi&arch=x64",
    "Pattern": "\"version\":\"(\\d+\\.\\d+\\.\\d+)\""
  },
  "DownloadUrl": "https://downloads.slack-edge.com/desktop-releases/windows/x64/{version}/slack-standalone-{version}.0.msi",
  "InstallerFileName": "Slack-{version}.msi",
  "InstallArgs": "/qn /norestart",
  "UninstallArgs": "/x {ProductCode} /qn /norestart",
  "Detection": {
    "Type": "RegistryKeyValue",
    "RegistryHive": "HKLM",
    "RegistryKeyTemplate": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{ProductCode}",
    "ValueName": "DisplayVersion",
    "Operator": "IsEquals",
    "Is64Bit": true
  },
  "RunningProcess": [
    "slack"
  ]
}
