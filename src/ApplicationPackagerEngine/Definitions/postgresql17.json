{
    "Schema":  1,
    "Id":  "cd1d884f66ff41a2",
    "WsusSupport":  "No (CustomInstall)",
    "IconSource":  "Installer",
    "Vendor":  "PostgreSQL Global Development Group",
    "Application":  "PostgreSQL 17 (x64)",
    "CMName":  "PostgreSQL 17",
    "Architecture":  "x64",
    "VendorUrl":  "https://www.postgresql.org/",
    "Cpe":  "cpe:2.3:a:postgresql:postgresql:17.*:*:*:*:*:*:*:*",
    "ArpName":  "PostgreSQL 17*",
    "SecurityAdvisoryUrl":  "https://www.postgresql.org/support/security/",
    "InstallerType":  "EXE",
    "InstallerFramework":  "InstallShield",
    "Acquisition":  {

                    },
    "VersionScraper":  {
                           "Type":  "JsonQuery",
                           "Url":  "https://endoflife.date/api/postgresql.json",
                           "Pattern":  "[?cycle=17].latest"
                       },
    "DownloadUrl":  "https://get.enterprisedb.com/postgresql/postgresql-{version}-1-windows-x64.exe",
    "InstallArgs":  "--mode unattended --unattendedmodeui none --superpassword {TargetSecret} --serverport 5432 --install_runtimes 0 --disable-components stackbuilder",
    "UninstallArgs":  "--mode unattended",
    "Detection":  {
                      "Type":  "RegistryKeyValue",
                      "RegistryHive":  "HKLM",
                      "RegistryKeyTemplate":  "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\PostgreSQL 17",
                      "ValueName":  "DisplayVersion",
                      "PropertyType":  "String",
                      "Operator":  "BeginsWith",
                      "Is64Bit":  true
                  },
    "TargetSecret":  {
        "FolderName":  "PostgreSQL-Superuser-Secret",
        "FileName":  "postgresql-17.dpapi",
        "Label":  "PostgreSQL superuser"
    },
    "RunningProcess":  [
                           "postgres",
                           "pgAdmin4"
                       ],
    "UninstallCommand":  "$proc = Start-Process -FilePath \"C:\\Program Files\\PostgreSQL\\17\\uninstall-postgresql.exe\" -ArgumentList \"--mode unattended\" -Wait -PassThru -NoNewWindow"
}
