<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ApplicationPackagerEngine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SQLite" Version="2.0.4" />
    <PackageReference Include="SQLite" Version="3.53.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApplicationPackagerEngine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Definitions\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Definitions\Icons\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services\Wsus\WsusAdapter.ps1" LogicalName="ApplicationPackagerEngine.Services.Wsus.WsusAdapter.ps1" />
    <EmbeddedResource Include="Services\DiscoveryScripts\DiscoveryInventory.ps1" LogicalName="ApplicationPackagerEngine.Services.DiscoveryScripts.DiscoveryInventory.ps1" />
    <EmbeddedResource Include="Services\DiscoveryScripts\DiscoverySiteDefinition.ps1" LogicalName="ApplicationPackagerEngine.Services.DiscoveryScripts.DiscoverySiteDefinition.ps1" />
    <EmbeddedResource Include="Services\ConfigMgrSession\Scripts\ConfigMgrSessionHost.ps1" LogicalName="ApplicationPackagerEngine.Services.ConfigMgrSession.Scripts.ConfigMgrSessionHost.ps1" />
    <EmbeddedResource Include="Services\ConfigMgrSession\Scripts\GetSites.ps1" LogicalName="ApplicationPackagerEngine.Services.ConfigMgrSession.Scripts.GetSites.ps1" />
    <EmbeddedResource Include="Services\ConfigMgrSession\Scripts\GetCollections.ps1" LogicalName="ApplicationPackagerEngine.Services.ConfigMgrSession.Scripts.GetCollections.ps1" />
    <EmbeddedResource Include="Services\MaintenanceWindows\Scripts\*.ps1" LogicalName="ApplicationPackagerEngine.Services.MaintenanceWindows.Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Collections\Scripts\*.ps1" LogicalName="ApplicationPackagerEngine.Services.Collections.Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Collections\Templates\*.json" LogicalName="ApplicationPackagerEngine.Services.Collections.Templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\MaintenanceWindows\Templates\*.json" LogicalName="ApplicationPackagerEngine.Services.MaintenanceWindows.Templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Deployments\Scripts\*.ps1" LogicalName="ApplicationPackagerEngine.Services.Deployments.Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\DpContent\Scripts\*.ps1" LogicalName="ApplicationPackagerEngine.Services.DpContent.Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\PivotsScripts\Scripts\*.ps1" LogicalName="ApplicationPackagerEngine.Services.PivotsScripts.Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\SiteHygiene\Scripts\*.ps1" LogicalName="ApplicationPackagerEngine.Services.SiteHygiene.Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\PivotsScripts\Library\Queries\*.cmpivot" LogicalName="ApplicationPackagerEngine.Services.PivotsScripts.Library.Queries.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\PivotsScripts\Library\Scripts\*.ps1" LogicalName="ApplicationPackagerEngine.Services.PivotsScripts.Library.Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Compliance\Scripts\*.ps1" LogicalName="ApplicationPackagerEngine.Services.Compliance.Scripts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Compliance\Catalog\Entries\*.json" LogicalName="ApplicationPackagerEngine.Services.Compliance.Catalog.Entries.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Services\Compliance\Catalog\Builders\*.ps1" LogicalName="ApplicationPackagerEngine.Services.Compliance.Catalog.Builders.%(Filename)%(Extension)" />
  </ItemGroup>


</Project>
