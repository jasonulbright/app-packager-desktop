{
  "Id": "lsa-protection-runasppl",
  "Version": "1.0.0",
  "DisplayName": "LSA Protection (RunAsPPL)",
  "Subcategory": "Hardening",
  "Mechanism": "NativeRegistry",
  "Status": "Draft",
  "Description": "Requires LSA Protection through RunAsPPL = 1 (with a UEFI lock) or 2 (without a UEFI lock). REBOOT REQUIRED to engage; validate LSA plugin signing first.",
  "Severity": "Critical",
  "RemediationSupported": false,
  "Cves": [],
  "TenablePlugins": [],
  "KbReferences": [
    "https://learn.microsoft.com/windows-server/security/credentials-protection-and-management/configuring-additional-lsa-protection"
  ],
  "OsScope": {
    "Client": [
      "Windows 8.1",
      "Windows 10",
      "Windows 11"
    ],
    "Server": [
      "Server 2012 R2",
      "Server 2016",
      "Server 2019",
      "Server 2022",
      "Server 2025"
    ]
  },
  "RebootRequired": true,
  "RegistrySurface": [
    {
      "Hive": "HKLM",
      "KeyPath": "SYSTEM\\CurrentControlSet\\Control\\Lsa",
      "Values": [
        "RunAsPPL"
      ]
    }
  ],
  "Builder": {
    "ScriptPath": "New-LSAProtectionBaseline.ps1",
    "Parameters": [
      {
        "Name": "SiteCode",
        "Type": "String",
        "Required": true,
        "Default": null,
        "Description": "Configuration Manager site code."
      },
      {
        "Name": "SiteServer",
        "Type": "String",
        "Required": true,
        "Default": null,
        "Description": "Configuration Manager site server FQDN."
      },
      {
        "Name": "CollectionName",
        "Type": "String",
        "Required": false,
        "Default": null,
        "Description": "If specified, deploys the baseline to this collection daily."
      }
    ]
  },
  "DependsOn": [],
  "Produces": {
    "ConfigurationItems": [
      "Hardening: LSA Protection (RunAsPPL)"
    ],
    "ConfigurationBaselines": [
      "Hardening LSA Protection RunAsPPL"
    ]
  }
}
