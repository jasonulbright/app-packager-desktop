$ErrorActionPreference = 'Stop'
$cmModule = Join-Path $env:SMS_ADMIN_UI_PATH '..\ConfigurationManager.psd1'
if (Test-Path $cmModule) { Import-Module $cmModule }
else { Import-Module ConfigurationManager }
if (-not (Get-PSDrive -Name 'P01' -ErrorAction SilentlyContinue)) {
    New-PSDrive -Name 'P01' -PSProvider CMSite -Root $env:COMPUTERNAME | Out-Null
}
Set-Location 'P01:'
Write-Host 'Connected to MECM'
$expectedDts = @('App')
$existing = @()
try { $existing = @(Get-CMApplication -Name 'App' -DisableWildcardHandling -ErrorAction SilentlyContinue) } catch { }
if ($existing.Count -gt 1) { throw "Multiple existing MECM applications matched 'App'; refusing to package until the duplicate names are resolved." }
$app = $null
$replaceExisting = $false
$replaceDtNames = @()
if ($existing.Count -eq 1) {
    $app = $existing[0]
    $currentDts = @(Get-CMDeploymentType -ApplicationName 'App' -ErrorAction Stop | ForEach-Object { [string]$_.LocalizedDisplayName })
    $missingDts = @($expectedDts | Where-Object { $currentDts -notcontains $_ })
    Write-Host 'On-existing behavior         : Skip'
    if ($missingDts.Count -eq 0) {
        Write-Host "Application already exists    : App (v$($app.SoftwareVersion), unchanged)"
        Write-Host "Deployment type(s) validated : $($expectedDts -join ', ')"
        Write-Host ('[APP_PACKAGER_CONFLICT] existing app=''App'' version=' + "'$($app.SoftwareVersion)'" + ' incoming=''1.0''')
        Write-Host "CI_ID: $($app.CI_ID)"
        exit 0
    }
    throw "Existing MECM application 'App' is missing deployment type(s): $($missingDts -join ', '). This looks like a partial prior package run; fix or remove the partial app before packaging again."
    if ($replaceExisting) { $replaceDtNames = $currentDts }
}
if (-not $app) {
    Write-Host 'Creating application...'
    $app = New-CMApplication -Name 'App' -Publisher 'Vendor' -SoftwareVersion '1.0' -Description 'comment' -AutoInstall $true
}
Write-Host "CI_ID: $($app.CI_ID)"
$dtName0 = 'App'
$dtCreateName0 = if ($replaceDtNames.Count -gt 0) { "$dtName0 (staging)" } else { $dtName0 }
$detectScript0 = @'
if (Test-Path 'C:\Program Files\App\app.exe') { Write-Output 'Installed' }
exit 0
'@
Write-Host "Adding deployment type       : $dtCreateName0"
Add-CMScriptDeploymentType -ApplicationName 'App' -DeploymentTypeName $dtCreateName0 -ContentLocation '\\server\share\Apps\Vendor\App\1.0' -InstallCommand 'install.bat' -UninstallCommand 'uninstall.bat' -InstallationBehaviorType InstallForSystem -LogonRequirementType WhetherOrNotUserLoggedOn -EstimatedRuntimeMins 15 -MaximumRuntimeMins 30 -ContentFallback -SlowNetworkDeploymentMode Download -ScriptLanguage PowerShell -ScriptText $detectScript0 | Out-Null
foreach ($oldDt in $replaceDtNames) {
    Remove-CMDeploymentType -ApplicationName 'App' -DeploymentTypeName $oldDt -Force -ErrorAction Stop
    Write-Host "Removed old deployment type  : $oldDt"
}
if ($dtCreateName0 -ne $dtName0) {
    Set-CMDeploymentType -ApplicationName 'App' -DeploymentTypeName $dtCreateName0 -NewDeploymentTypeName $dtName0 -ErrorAction Stop
    Write-Host "Renamed deployment type      : $dtName0"
}
if ($existing.Count -eq 1) {
    Set-CMApplication -Name 'App' -SoftwareVersion '1.0' -Publisher 'Vendor' -Description 'comment' -ErrorAction Stop
    Write-Host 'Updated application version  : 1.0'
}
try {
  $revisions = Get-CMApplicationRevisionHistory -Id $app.CI_ID -ErrorAction Stop
  if (@($revisions).Count -gt 1) {
    @($revisions) | Sort-Object -Property @{Expression={if ($_.Revision) {$_.Revision} else {$_.CIVersion}}} -Descending | Select-Object -Skip 1 | ForEach-Object {
      Remove-CMApplicationRevisionHistory -InputObject $_ -Force -ErrorAction SilentlyContinue
    }
    Write-Host 'Cleaned revision history'
  }
} catch { Write-Host "Revision cleanup skipped: $($_.Exception.Message)" }
Write-Host 'Application created successfully'
