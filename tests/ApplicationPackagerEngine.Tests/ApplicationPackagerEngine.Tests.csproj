<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ApplicationPackagerEngine\ApplicationPackagerEngine.csproj" />
    <ProjectReference Include="..\..\src\ApplicationPackagerUI\ApplicationPackagerUI.csproj" />
    <ProjectReference Include="..\..\src\ApplicationPackagerBuild\ApplicationPackagerBuild.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\*.bin" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\PlanDigest\*.json;Fixtures\PlanDigest\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\Vulnerability\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\SiteHygiene\*.json;Fixtures\SiteHygiene\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\Discovery\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\DetectionTester\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\WsusRules\*.json;Fixtures\WsusRules\*.msi;Fixtures\WsusRules\*.ps1;Fixtures\WsusAdapter\*.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\write-checksums.ps1" Link="Tools\write-checksums.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>