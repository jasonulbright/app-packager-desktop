<Project Sdk="Microsoft.NET.Sdk">
  <!-- The lab capture of the One Click plan with the step Supersedence (Capture-PackagesSupersedence.ps1) needs an application whose
       ConfigMgr publish left the supersedence step pending. A publish records that state in the inventory; this tool writes the same record
       through the engine's own inventory service, into the isolated data folder of the capture run. Not part of the app or its tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ApplicationPackagerEngine\ApplicationPackagerEngine.csproj" />
  </ItemGroup>
</Project>
