  "Application": "ZZAPD Everything (x64)",
  "CMName": "ZZAPD Everything",
  "Architecture": "x64",
  "VendorUrl": "https://www.voidtools.com/",
  "Cpe": "cpe:2.3:a:voidtools:everything:*:*:*:*:*:*:*:*",
  "ArpName": "none",
  "InstallerType": "MSI",
  "InstallerFramework": "NativeEXE",
  "Acquisition": {},
  "VersionScraper": {
    "Type": "HttpRegex",
